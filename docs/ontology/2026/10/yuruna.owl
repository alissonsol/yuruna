    <skos:altLabel xml:lang="en">ARP table</skos:altLabel>
    <skos:altLabel xml:lang="en">neighbor cache</skos:altLabel>
    <skos:scopeNote xml:lang="en">Entries can be stale; the first matching entry is not necessarily the best guest address.</skos:scopeNote>
