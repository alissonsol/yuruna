    <skos:prefLabel xml:lang="en">time series</skos:prefLabel>
    <skos:definition xml:lang="en">A sequence of measurements distinguished by a metric identity and label set.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">No individual host series is included in this ontology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Metric" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Timeout">
    <rdfs:label xml:lang="en">timeout</rdfs:label>
    <skos:prefLabel xml:lang="en">timeout</skos:prefLabel>
    <skos:definition xml:lang="en">Expiration of an operation's allowed duration before its required completion condition is established.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Does not identify the root cause by itself.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Topology">
    <rdfs:label xml:lang="en">topology</rdfs:label>
    <skos:prefLabel xml:lang="en">topology</skos:prefLabel>
    <skos:definition xml:lang="en">The arrangement of hosts, guests, interfaces, links, and services relevant to a communication path.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TopologySelectionPolicy">
    <rdfs:label xml:lang="en">topology selection policy</rdfs:label>
    <skos:prefLabel xml:lang="en">topology selection policy</skos:prefLabel>
    <skos:definition xml:lang="en">Provider-specific rules selecting a supported bridge or NAT path from the current uplink and virtual-network state.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">An intentional NAT selection is normal operation; a previously valid bridge losing its binding is a different condition.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Transcript">
    <rdfs:label xml:lang="en">transcript</rdfs:label>
    <skos:prefLabel xml:lang="en">transcript</skos:prefLabel>
    <skos:definition xml:lang="en">A retained textual record of console output and command progress.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/loglevels.md" />
    <skos:scopeNote xml:lang="en">Raw transcripts may contain sensitive material and are not copied into the ontology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Translation">
    <rdfs:label xml:lang="en">translation</rdfs:label>
    <skos:prefLabel xml:lang="en">translation</skos:prefLabel>
    <skos:definition xml:lang="en">A rendering of source-language user-facing content in another language while preserving its intended meaning and protected tokens.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">No non-English translations are authored in this English-only ontology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#translates" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProtectedToken" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TranslationProvenance">
    <rdfs:label xml:lang="en">translation provenance</rdfs:label>
    <skos:prefLabel xml:lang="en">translation provenance</skos:prefLabel>
    <skos:definition xml:lang="en">Metadata identifying the English source and generation or review history of a translation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Generation does not establish human linguistic approval.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SourceHash" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TranslationReview">
    <rdfs:label xml:lang="en">translation review</rdfs:label>
    <skos:prefLabel xml:lang="en">translation review</skos:prefLabel>
    <skos:definition xml:lang="en">Human assessment of whether a translated message preserves meaning, terminology, and protected tokens.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#usesGlossary" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TerminologyGlossary" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TrustStore">
    <rdfs:label xml:lang="en">trust store</rdfs:label>
    <skos:prefLabel xml:lang="en">trust store</skos:prefLabel>
    <skos:definition xml:lang="en">The set of accepted certificate authorities or trust anchors used by a client.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CertificateAuthority" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UDP">
    <rdfs:label xml:lang="en">UDP</rdfs:label>
    <skos:prefLabel xml:lang="en">UDP</skos:prefLabel>
    <skos:definition xml:lang="en">A datagram transport used by services such as DHCP and DNS without TCP's stream-delivery contract.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">User Datagram Protocol</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UEFI">
    <rdfs:label xml:lang="en">UEFI</rdfs:label>
    <skos:prefLabel xml:lang="en">UEFI</skos:prefLabel>
    <skos:definition xml:lang="en">The firmware interface used by supported modern guest boot configurations.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">Unified Extensible Firmware Interface</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Firmware" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#URL">
    <rdfs:label xml:lang="en">URL</rdfs:label>
    <skos:prefLabel xml:lang="en">URL</skos:prefLabel>
    <skos:definition xml:lang="en">A resource locator carrying a scheme and addressing components used by fetches, APIs, and documentation links.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">uniform resource locator</skos:altLabel>
    <skos:scopeNote xml:lang="en">Credentials, control proofs, and deployment-specific addresses are not included in this ontology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#USBNetworkAdapter">
    <rdfs:label xml:lang="en">USB network adapter</rdfs:label>
    <skos:prefLabel xml:lang="en">USB network adapter</skos:prefLabel>
    <skos:definition xml:lang="en">A network adapter attached through USB and distinguished by the host's uplink eligibility checks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Yuruna's Hyper-V selection excludes USB uplinks from its supported external-bridge path; this is a project policy, not a claim about every adapter's hardware capabilities.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkAdapter" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TopologySelectionPolicy" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UTM">
    <rdfs:label xml:lang="en">UTM</rdfs:label>
    <skos:prefLabel xml:lang="en">UTM</skos:prefLabel>
    <skos:definition xml:lang="en">The macOS VM application used by Yuruna to manage guests through supported QEMU and Apple virtualization backends.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <skos:scopeNote xml:lang="en">UTM is a management application, not a synonym for one virtualization backend.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UTMSharedNetworking">
    <rdfs:label xml:lang="en">UTM Shared networking</rdfs:label>
    <skos:prefLabel xml:lang="en">UTM Shared networking</skos:prefLabel>
    <skos:definition xml:lang="en">The UTM shared NAT topology selected for supported macOS configurations whose uplink is not bridged.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">UTM Shared</skos:altLabel>
    <skos:scopeNote xml:lang="en">The host address must be reachable through the selected shared network rather than assumed to equal the host's LAN address.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NATNetwork" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestReachableHostAddress" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UbuntuOperatingSystem">
    <rdfs:label xml:lang="en">Ubuntu</rdfs:label>
    <skos:prefLabel xml:lang="en">Ubuntu</skos:prefLabel>
    <skos:definition xml:lang="en">The Ubuntu distribution family used for Yuruna KVM hosts and Ubuntu Server guests.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <skos:scopeNote xml:lang="en">A family concept, not a claim that every release is supported.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#LinuxOperatingSystem" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UnattendedInstallation">
    <rdfs:label xml:lang="en">unattended installation</rdfs:label>
    <skos:prefLabel xml:lang="en">unattended installation</skos:prefLabel>
    <skos:definition xml:lang="en">An operating-system or application installation that proceeds from supplied configuration without interactive operator input.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Unavailability">
    <rdfs:label xml:lang="en">unavailability</rdfs:label>
    <skos:prefLabel xml:lang="en">unavailability</skos:prefLabel>
    <skos:definition xml:lang="en">Required outcomes absent from the Implementation: the Baseline's required outcomes minus Implementation; legitimate access blocked by misconfiguration in the controls themselves.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <dcterms:source rdf:resource="https://csrc.nist.gov/pubs/sp/800/66/r2/final" />
    <skos:altLabel xml:lang="en">access denial</skos:altLabel>
    <skos:scopeNote xml:lang="en">More specific than a generic outage. NIST defines availability as being accessible and usable upon demand by an authorized person.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Baseline" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Implementation" />
    <y:retiredLabel xml:lang="en">lockout</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UnknownFailure">
    <rdfs:label xml:lang="en">unknown failure</rdfs:label>
    <skos:prefLabel xml:lang="en">unknown failure</skos:prefLabel>
    <skos:definition xml:lang="en">A failure for which the current classifier cannot supply a more specific registered class.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">May mean missing verb metadata rather than an unprecedented operational cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureClassification" />
    <y:codeToken>unknown</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UnknownFailureSeverity">
    <rdfs:label xml:lang="en">unknown failure severity</rdfs:label>
    <skos:prefLabel xml:lang="en">unknown failure severity</skos:prefLabel>
    <skos:definition xml:lang="en">An unresolved severity designation when the applicable classification metadata is unavailable.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureSeverity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>unknown</y:codeToken>
    <y:codeVocabulary>failureSeverity</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Unmonitored">
    <rdfs:label xml:lang="en">unmonitored</rdfs:label>
    <skos:prefLabel xml:lang="en">unmonitored</skos:prefLabel>
    <skos:definition xml:lang="en">Implemented outcomes not represented in the Telemetry: Implementation minus Telemetry; the hidden difference between the actual environment and what the tools observe.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">monitoring blind spot</skos:altLabel>
    <skos:scopeNote xml:lang="en">Missing observations alone do not establish which outcomes are implemented.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Implementation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Telemetry" />
    <y:retiredLabel xml:lang="en">blindspot</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Uplink">
    <rdfs:label xml:lang="en">uplink</rdfs:label>
    <skos:prefLabel xml:lang="en">uplink</skos:prefLabel>
    <skos:definition xml:lang="en">The connection by which a host's virtual network reaches an upstream physical network.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Link" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UplinkBinding">
    <rdfs:label xml:lang="en">uplink binding</rdfs:label>
    <skos:prefLabel xml:lang="en">uplink binding</skos:prefLabel>
    <skos:definition xml:lang="en">The association between a virtual switch or bridge and the adapter intended to carry its upstream traffic.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A persisted switch can outlive a valid binding after a reboot or adapter change.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#UplinkBindingCheck">
    <rdfs:label xml:lang="en">uplink binding check</rdfs:label>
    <skos:prefLabel xml:lang="en">uplink binding check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of the switch, physical adapter binding, management virtual adapter, and address placement to determine whether the bridge still has a working host leg.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A MAC match or existing switch object alone is insufficient evidence because aliases can change and MAC values can be shared.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HyperVManagementAdapter" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#UplinkBinding" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VLAN">
    <rdfs:label xml:lang="en">VLAN</rdfs:label>
    <skos:prefLabel xml:lang="en">VLAN</skos:prefLabel>
    <skos:definition xml:lang="en">A logical link-layer network segmentation mechanism relevant to bridge and DHCP reachability.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">virtual LAN</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Network" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VMAdmission">
    <rdfs:label xml:lang="en">VM admission</rdfs:label>
    <skos:prefLabel xml:lang="en">VM admission</skos:prefLabel>
    <skos:definition xml:lang="en">Checking whether a new test VM may be started without conflicting with existing ownership or capacity constraints.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Unknown occupancy is not the same finding as confirmed occupancy.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VMAdmissionOccupiedFault">
    <rdfs:label xml:lang="en">VM admission occupied</rdfs:label>
    <skos:prefLabel xml:lang="en">VM admission occupied</skos:prefLabel>
    <skos:definition xml:lang="en">Admission detects an existing VM occupancy that prevents safe test startup.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RunnerFault" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VMAdmission" />
    <y:codeToken>vm_admission_occupied</y:codeToken>
    <y:codeVocabulary>runnerFault</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VMAdmissionUnknownFault">
    <rdfs:label xml:lang="en">VM admission unknown</rdfs:label>
    <skos:prefLabel xml:lang="en">VM admission unknown</skos:prefLabel>
    <skos:definition xml:lang="en">Admission cannot establish whether the required VM slot is available.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Unknown occupancy must not be equated with an empty slot.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RunnerFault" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VMAdmission" />
    <y:codeToken>vm_admission_unknown</y:codeToken>
    <y:codeVocabulary>runnerFault</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VNCConnectionStale">
    <rdfs:label xml:lang="en">stale VNC connection</rdfs:label>
    <skos:prefLabel xml:lang="en">stale VNC connection</skos:prefLabel>
    <skos:definition xml:lang="en">A cached VNC handle no longer provides a working display or input channel after the connection's environment changes.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <skos:scopeNote xml:lang="en">Reconnection can restore the transport; replaying text through the stale handle can silently lose input.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIOBlockedFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ReconnectRecommendation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VNCTransport" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VNCTransport">
    <rdfs:label xml:lang="en">VNC transport</rdfs:label>
    <skos:prefLabel xml:lang="en">VNC transport</skos:prefLabel>
    <skos:definition xml:lang="en">The remote display and input path used by supported Yuruna guest-console providers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc6143.html" />
    <skos:altLabel xml:lang="en">VNC</skos:altLabel>
    <skos:scopeNote xml:lang="en">VNC uses the remote framebuffer protocol; it is not the same path as SSH command execution.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#usesProtocol" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RemoteFramebufferProtocol" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Framebuffer" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Vault">
    <rdfs:label xml:lang="en">vault</rdfs:label>
    <skos:prefLabel xml:lang="en">vault</skos:prefLabel>
    <skos:definition xml:lang="en">The configured credential store supplying project or runner secrets to authorized operations.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <skos:scopeNote xml:lang="en">Its presence alone does not establish encryption against a compromised host account.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VersionFloor">
    <rdfs:label xml:lang="en">version floor</rdfs:label>
    <skos:prefLabel xml:lang="en">version floor</skos:prefLabel>
    <skos:definition xml:lang="en">The lowest supported version of a dependency for a specified environment.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Requirement.yml" />
    <skos:scopeNote xml:lang="en">A floor below the latest upstream release is not automatically a defect.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VersionPin" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VersionPin">
    <rdfs:label xml:lang="en">version pin</rdfs:label>
    <skos:prefLabel xml:lang="en">version pin</skos:prefLabel>
    <skos:definition xml:lang="en">A selected dependency version used to make provisioning or builds reproducible.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/yuruna-versions.sh" />
    <skos:scopeNote xml:lang="en">A pin and a host minimum version serve different purposes.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VirtualDisk">
    <rdfs:label xml:lang="en">virtual disk</rdfs:label>
    <skos:prefLabel xml:lang="en">virtual disk</skos:prefLabel>
    <skos:definition xml:lang="en">A block-storage device presented to a VM and backed by a disk image or other storage allocation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VirtualMachine">
    <rdfs:label xml:lang="en">virtual machine</rdfs:label>
    <skos:prefLabel xml:lang="en">virtual machine</skos:prefLabel>
    <skos:definition xml:lang="en">An isolated machine environment presented by a hypervisor with virtual processors, memory, storage, and devices.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">VM</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ComputingNode" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VirtualNetworkInterface">
    <rdfs:label xml:lang="en">virtual interface</rdfs:label>
    <skos:prefLabel xml:lang="en">virtual interface</skos:prefLabel>
    <skos:definition xml:lang="en">An interface implemented by virtualization or the host networking stack rather than a separate physical adapter.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">vNIC</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkInterface" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VirtualProcessor">
    <rdfs:label xml:lang="en">virtual processor</rdfs:label>
    <skos:prefLabel xml:lang="en">virtual processor</skos:prefLabel>
    <skos:definition xml:lang="en">A processor presented to a VM whose configured count must fit host capacity and provider constraints.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">vCPU</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VirtualSwitch">
    <rdfs:label xml:lang="en">virtual switch</rdfs:label>
    <skos:prefLabel xml:lang="en">virtual switch</skos:prefLabel>
    <skos:definition xml:lang="en">A software-defined switch connecting virtual adapters and, where configured, a physical uplink.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">vSwitch</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Switch" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#VirtualizationExtension">
    <rdfs:label xml:lang="en">virtualization extension</rdfs:label>
    <skos:prefLabel xml:lang="en">virtualization extension</skos:prefLabel>
    <skos:definition xml:lang="en">Processor virtualization support that a provider may expose to a guest for nested virtualization.</skos:definition>
