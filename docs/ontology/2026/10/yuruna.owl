  <owl:ObjectProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#managedByHypervisor">
    <rdfs:label xml:lang="en">managed by hypervisor</rdfs:label>
    <skos:prefLabel xml:lang="en">managed by hypervisor</skos:prefLabel>
