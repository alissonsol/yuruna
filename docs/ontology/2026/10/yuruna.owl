    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NoDataState">
    <rdfs:label xml:lang="en">no-data state</rdfs:label>
    <skos:prefLabel xml:lang="en">no-data state</skos:prefLabel>
    <skos:definition xml:lang="en">A query result without matching observations in the selected interval.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/alerts.md" />
    <skos:scopeNote xml:lang="en">Can mean no failure occurred, the selection excluded it, or reporting was absent; it is not automatically a healthy or failed machine.</skos:scopeNote>
