    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDraftCampaign">
    <rdfs:label xml:lang="en">draft campaign</rdfs:label>
    <skos:prefLabel xml:lang="en">draft campaign</skos:prefLabel>
    <skos:definition xml:lang="en">An AmisAd campaign that has been created but not activated by placing approved creative.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/components/services/ads-svc/src/main.rs" />
    <skos:scopeNote xml:lang="en">Creation starts in draft state with no placed asset; a draft does not imply an existing matching offer.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCampaign" />
