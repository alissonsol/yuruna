    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design/05-ads.md" />
    <rdfs:domain rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdAttribution" />
    <rdfs:range rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCreativeAsset" />
