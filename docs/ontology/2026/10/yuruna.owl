  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NestedHost">
    <rdfs:label xml:lang="en">nested host</rdfs:label>
    <skos:prefLabel xml:lang="en">nested host</skos:prefLabel>
    <skos:definition xml:lang="en">A guest VM that also runs host automation and provisions an inner virtual machine under nested virtualization.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/nested.host/README.md" />
