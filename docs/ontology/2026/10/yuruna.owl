    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIdentity" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PoolStorage">
    <rdfs:label xml:lang="en">pool storage</rdfs:label>
    <skos:prefLabel xml:lang="en">pool storage</skos:prefLabel>
    <skos:definition xml:lang="en">The shared durable storage tier for host registration, archived test cycles, pool configuration, service state, and downloaded images.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:altLabel xml:lang="en">ypool-nas</skos:altLabel>
    <skos:altLabel xml:lang="en">yuruna pool storage</skos:altLabel>
    <skos:scopeNote xml:lang="en">Only the archived-cycle subtree is a cold archive; other subtrees contain live service data.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PoolStorageFullFailure">
    <rdfs:label xml:lang="en">pool storage full</rdfs:label>
    <skos:prefLabel xml:lang="en">pool storage full</skos:prefLabel>
    <skos:definition xml:lang="en">The shared pool storage lacks capacity needed by the operation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Local free space does not resolve a full remote share.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageCapacityCheck" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
