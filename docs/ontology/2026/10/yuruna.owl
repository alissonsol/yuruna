<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:dcterms="http://purl.org/dc/terms/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:y="https://yuruna.com/ontology/2026/10/yuruna#">
  <owl:Ontology rdf:about="https://yuruna.com/ontology/2026/10/yuruna">
    <dcterms:title xml:lang="en">Yuruna English terminology and diagnostic ontology</dcterms:title>
    <dcterms:description xml:lang="en">Concepts and relationships for localization, discovery, configuration diagnosis, and incident recurrence. No deployed hosts, people, secrets, or incident occurrences are asserted.</dcterms:description>
    <owl:versionInfo>2026/10</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://yuruna.com/ontology/2026/10/yuruna"/>
    <y:observationWindowStart>2026-09-10T11:21:10.932263+00:00</y:observationWindowStart>
    <y:observationWindowEnd>2026-10-10T11:21:10.932263+00:00</y:observationWindowEnd>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#canonicalRoutingCategory">
    <rdfs:label xml:lang="en">canonical routing category</rdfs:label>
    <skos:prefLabel xml:lang="en">canonical routing category</skos:prefLabel>
    <skos:definition xml:lang="en">The canonical dispatcher category selected by the automation result adapter; a routing conversion does not assert equivalent causes or interchangeable classifications.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#codeToken">
    <rdfs:label xml:lang="en">code token</rdfs:label>
    <skos:prefLabel xml:lang="en">code token</skos:prefLabel>
    <skos:definition xml:lang="en">A stable machine-facing token that translations must preserve verbatim.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#codeVocabulary">
    <rdfs:label xml:lang="en">code vocabulary</rdfs:label>
    <skos:prefLabel xml:lang="en">code vocabulary</skos:prefLabel>
    <skos:definition xml:lang="en">The machine-facing enum or grammar in which a code token has its stated meaning.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#context">
    <rdfs:label xml:lang="en">context</rdfs:label>
    <skos:prefLabel xml:lang="en">context</skos:prefLabel>
    <skos:definition xml:lang="en">The project or conceptual scope in which a label and definition have the stated meaning.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#diagnosticCheck">
    <rdfs:label xml:lang="en">diagnostic check</rdfs:label>
    <skos:prefLabel xml:lang="en">diagnostic check</skos:prefLabel>
    <skos:definition xml:lang="en">A relevant check category to discriminate possible explanations; not an instruction to execute it automatically.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#evidenceBasis">
    <rdfs:label xml:lang="en">evidence basis</rdfs:label>
    <skos:prefLabel xml:lang="en">evidence basis</skos:prefLabel>
    <skos:definition xml:lang="en">The distinction between source-defined categories and categories also found in the selected telemetry.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#expectedInput">
    <rdfs:label xml:lang="en">expected input</rdfs:label>
    <skos:prefLabel xml:lang="en">expected input</skos:prefLabel>
    <skos:definition xml:lang="en">An input category expected by an operation type; an attempt may fail before acquiring it.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#expectedOutput">
    <rdfs:label xml:lang="en">expected output</rdfs:label>
    <skos:prefLabel xml:lang="en">expected output</skos:prefLabel>
    <skos:definition xml:lang="en">An output category expected from successful work; no output existence or successful completion is entailed.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#implementationStatus">
    <rdfs:label xml:lang="en">implementation status</rdfs:label>
    <skos:prefLabel xml:lang="en">implementation status</skos:prefLabel>
    <skos:definition xml:lang="en">A qualification about implemented, prototype, planned, or modeled behavior.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#nextPhase">
    <rdfs:label xml:lang="en">next phase</rdfs:label>
    <skos:prefLabel xml:lang="en">next phase</skos:prefLabel>
    <skos:definition xml:lang="en">The next phase category in the intended workflow; failure or cancellation can prevent that phase from running.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#observationWindowEnd">
    <rdfs:label xml:lang="en">observation window end</rdfs:label>
    <skos:prefLabel xml:lang="en">observation window end</skos:prefLabel>
    <skos:definition xml:lang="en">The inclusive end of the evidence selection window, not an incident timestamp.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#observationWindowStart">
    <rdfs:label xml:lang="en">observation window start</rdfs:label>
    <skos:prefLabel xml:lang="en">observation window start</skos:prefLabel>
    <skos:definition xml:lang="en">The inclusive beginning of the evidence selection window, not an incident timestamp.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#possibleCause">
    <rdfs:label xml:lang="en">possible cause</rdfs:label>
    <skos:prefLabel xml:lang="en">possible cause</skos:prefLabel>
    <skos:definition xml:lang="en">A candidate cause category requiring evidence; this annotation does not assert inevitable causation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#relatedConcept">
    <rdfs:label xml:lang="en">related concept</rdfs:label>
    <skos:prefLabel xml:lang="en">related concept</skos:prefLabel>
    <skos:definition xml:lang="en">A non-taxonomic association between concept categories, without asserting instance identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#retiredLabel">
    <rdfs:label xml:lang="en">retired label</rdfs:label>
    <skos:prefLabel xml:lang="en">retired label</skos:prefLabel>
    <skos:definition xml:lang="en">A historical name retained for recognition but not recommended for new user-facing text.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#suggestedRecovery">
    <rdfs:label xml:lang="en">suggested recovery</rdfs:label>
    <skos:prefLabel xml:lang="en">suggested recovery</skos:prefLabel>
    <skos:definition xml:lang="en">An advisory recovery category; not an assertion of authorization or execution.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-syntax/" />
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel" />
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel" />
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition" />
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote" />
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source" />
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title" />
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description" />
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AMD64Architecture">
    <rdfs:label xml:lang="en">AMD64</rdfs:label>
    <skos:prefLabel xml:lang="en">AMD64</skos:prefLabel>
    <skos:definition xml:lang="en">The 64-bit x86 architecture used as an image and binary selection dimension.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:altLabel xml:lang="en">x64</skos:altLabel>
    <skos:altLabel xml:lang="en">x86-64</skos:altLabel>
    <skos:scopeNote xml:lang="en">Preserve architecture identifiers used in artifact names and configuration.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProcessorArchitecture" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#APIPA">
    <rdfs:label xml:lang="en">APIPA</rdfs:label>
    <skos:prefLabel xml:lang="en">APIPA</skos:prefLabel>
    <skos:definition xml:lang="en">Windows automatic private IPv4 address configuration used for link-local operation when a normal dynamic assignment is unavailable.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">automatic private IP addressing</skos:altLabel>
    <skos:scopeNote xml:lang="en">Its presence can be diagnostic evidence; it does not identify which DHCP or uplink condition caused the fallback.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPv4LinkLocalAddress" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ARM64Architecture">
    <rdfs:label xml:lang="en">ARM64</rdfs:label>
    <skos:prefLabel xml:lang="en">ARM64</skos:prefLabel>
    <skos:definition xml:lang="en">The 64-bit Arm architecture used as an image and binary selection dimension.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:altLabel xml:lang="en">AArch64</skos:altLabel>
    <skos:scopeNote xml:lang="en">Product and configuration identifiers may use arm64 rather than the preferred display label.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProcessorArchitecture" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ARP">
    <rdfs:label xml:lang="en">ARP</rdfs:label>
    <skos:prefLabel xml:lang="en">ARP</skos:prefLabel>
    <skos:definition xml:lang="en">The IPv4-link mechanism used to discover a link-layer address for a protocol address.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">Address Resolution Protocol</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AbortedRequest">
    <rdfs:label xml:lang="en">aborted request</rdfs:label>
    <skos:prefLabel xml:lang="en">aborted request</skos:prefLabel>
    <skos:definition xml:lang="en">A request that ends before its expected completion, as classified by the serving or proxy layer.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labservices" />
    <skos:scopeNote xml:lang="en">An aborted log result alone does not identify which participant ended the request or why.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AccessKey">
    <rdfs:label xml:lang="en">access key</rdfs:label>
    <skos:prefLabel xml:lang="en">access key</skos:prefLabel>
    <skos:definition xml:lang="en">An authentication identifier or key material accepted by a cloud or service API.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AccessibilityPermission">
    <rdfs:label xml:lang="en">accessibility permission</rdfs:label>
    <skos:prefLabel xml:lang="en">accessibility permission</skos:prefLabel>
    <skos:definition xml:lang="en">A host OS permission enabling automation of supported UI interactions.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <skos:scopeNote xml:lang="en">Permission success does not prove that a particular virtualization UI accepts injected events.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AddressChurn">
    <rdfs:label xml:lang="en">address churn</rdfs:label>
    <skos:prefLabel xml:lang="en">address churn</skos:prefLabel>
    <skos:definition xml:lang="en">Change in assigned addresses over time, potentially disrupting cached coordinates and long-running communication.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">renumbering</skos:altLabel>
    <skos:scopeNote xml:lang="en">Address churn alone does not prove that the DHCP server has exhausted its pool.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressFootprint" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AddressConflict">
    <rdfs:label xml:lang="en">address conflict</rdfs:label>
    <skos:prefLabel xml:lang="en">address conflict</skos:prefLabel>
    <skos:definition xml:lang="en">An address assignment or listening endpoint conflicts with another use in the relevant scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A port binding conflict differs from two machines using the same IP address.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AddressDiscoveryCheck">
    <rdfs:label xml:lang="en">address discovery check</rdfs:label>
    <skos:prefLabel xml:lang="en">address discovery check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of guest interfaces, leases, neighbor tables, or provider information to identify a usable address.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AddressFootprint">
    <rdfs:label xml:lang="en">address footprint</rdfs:label>
    <skos:prefLabel xml:lang="en">address footprint</skos:prefLabel>
    <skos:definition xml:lang="en">The set or count of addresses consumed by declared guest identities across rebuilds in a lab.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The intended bound follows identity count rather than the number of rebuilds.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AgentTimeline">
    <rdfs:label xml:lang="en">agent timeline</rdfs:label>
    <skos:prefLabel xml:lang="en">agent timeline</skos:prefLabel>
    <skos:definition xml:lang="en">The observer view of pipeline stages, outcomes, timing, and diagnostic notes.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AlertNotification">
    <rdfs:label xml:lang="en">alert notification</rdfs:label>
    <skos:prefLabel xml:lang="en">alert notification</skos:prefLabel>
    <skos:definition xml:lang="en">A message delivered through a configured contact point when alert policy requires it.</skos:definition>
