  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Nonconformity">
    <rdfs:label xml:lang="en">nonconformity</rdfs:label>
    <skos:prefLabel xml:lang="en">nonconformity</skos:prefLabel>
    <skos:definition xml:lang="en">Observed outcomes outside the Baseline: Telemetry minus Baseline; the observed difference between the detected state and the original Baseline.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">non-compliance</skos:altLabel>
    <skos:scopeNote xml:lang="en">ISO/IEC 27000 defines nonconformity as non-fulfilment of a requirement. Not an incident classification: a failed test, an absent namespace, a stale configuration revision, or an invalid runner-state transition does not by itself prove one.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Telemetry" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Baseline" />
    <y:retiredLabel xml:lang="en">violation</y:retiredLabel>
    <y:retiredLabel xml:lang="en">gap</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NonzeroScriptExitMarker">
    <rdfs:label xml:lang="en">nonzero script exit marker</rdfs:label>
    <skos:prefLabel xml:lang="en">nonzero script exit marker</skos:prefLabel>
    <skos:definition xml:lang="en">A wrapper's textual guard indicating that its script operation ended with a nonzero status.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
    <skos:scopeNote xml:lang="en">A wrapper can emit this marker when validation fails before a downstream payload executes.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextPattern" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PatternMatchedFailure" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PayloadIntegrityMismatch" />
    <y:codeToken>NONZERO SCRIPT EXIT:</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NotificationPolicy">
    <rdfs:label xml:lang="en">notification policy</rdfs:label>
    <skos:prefLabel xml:lang="en">notification policy</skos:prefLabel>
    <skos:definition xml:lang="en">Routing, grouping, and timing rules applied to alerts before delivery.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/alerts.md" />
    <skos:scopeNote xml:lang="en">Grouping by cycle in the application avoids merging distinct failed cycles; the ontology retains only the grouping concept.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ContactPoint" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OAuth2">
    <rdfs:label xml:lang="en">OAuth 2.0</rdfs:label>
    <skos:prefLabel xml:lang="en">OAuth 2.0</skos:prefLabel>
    <skos:definition xml:lang="en">An authorization framework through which a client obtains delegated access to protected resources.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://openid.net/specs/openid-connect-core-1_0.html" />
    <skos:scopeNote xml:lang="en">Authorization is distinct from establishing an end user's identity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OCRCombinePolicy">
    <rdfs:label xml:lang="en">OCR combine policy</rdfs:label>
    <skos:prefLabel xml:lang="en">OCR combine policy</skos:prefLabel>
    <skos:definition xml:lang="en">The rule selecting whether one enabled OCR provider or all enabled providers must match a pattern.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">The Or mode short-circuits on success; And requires every enabled provider to match.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OCRNearMiss">
    <rdfs:label xml:lang="en">OCR near miss</rdfs:label>
    <skos:prefLabel xml:lang="en">OCR near miss</skos:prefLabel>
    <skos:definition xml:lang="en">Recognized text close to a requested pattern but below the required matching threshold.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">Similarity is not successful recognition of the requested state.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OCRText" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextPattern" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OCRProvider">
    <rdfs:label xml:lang="en">OCR provider</rdfs:label>
    <skos:prefLabel xml:lang="en">OCR provider</skos:prefLabel>
    <skos:definition xml:lang="en">An OCR engine backend selected for the host and available dependencies.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">Tesseract, Windows OCR, and Apple Vision have different availability and execution paths.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OCRText">
    <rdfs:label xml:lang="en">OCR text</rdfs:label>
    <skos:prefLabel xml:lang="en">OCR text</skos:prefLabel>
    <skos:definition xml:lang="en">Text recognized from a captured frame and used for matching or diagnosis.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">Recognition errors can distort addresses, identifiers, punctuation, and language; do not treat every recognized character as ground truth.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OCRTimeoutFailure">
    <rdfs:label xml:lang="en">OCR timeout</rdfs:label>
    <skos:prefLabel xml:lang="en">OCR timeout</skos:prefLabel>
    <skos:definition xml:lang="en">The requested screen text was not established within the allowed OCR wait interval.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">Absence of the requested text alone does not establish a network outage or a failed installer.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CaptureHealthCheck" />
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestProcessCheck" />
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIOBlockedFailure" />
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InputLostFailure" />
    <y:codeToken>ocr_timeout</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ObservedAddressCount">
    <rdfs:label xml:lang="en">observed address count</rdfs:label>
    <skos:prefLabel xml:lang="en">observed address count</skos:prefLabel>
    <skos:definition xml:lang="en">The deduplicated addresses visible to the proxy and registered-host reporting sources.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A lower bound on the visible footprint, not a measurement of DHCP scope capacity or utilization.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPAddressPool" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressFootprint" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OfflineMode">
    <rdfs:label xml:lang="en">offline mode</rdfs:label>
    <skos:prefLabel xml:lang="en">offline mode</skos:prefLabel>
    <skos:definition xml:lang="en">A cache policy favoring available cached content when upstream access is unavailable or intentionally restricted.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">Squid offline behavior and a complete prohibition on upstream communication are separate settings.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NoUpstreamMode" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OpenClaw">
    <rdfs:label xml:lang="en">OpenClaw</rdfs:label>
    <skos:prefLabel xml:lang="en">OpenClaw</skos:prefLabel>
    <skos:definition xml:lang="en">The application installed and onboarded by Yuruna's dedicated guest setup scripts.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/shared/ubuntu.openclaw.sh" />
    <skos:scopeNote xml:lang="en">The ontology records the provisioning role, not unverified product capabilities.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#dependsOn" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NodeJS" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OpenGLContext">
    <rdfs:label xml:lang="en">OpenGL context</rdfs:label>
    <skos:prefLabel xml:lang="en">OpenGL context</skos:prefLabel>
    <skos:definition xml:lang="en">The rendering context required by an OpenGL-based graphics path.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.qemu.org/docs/master/system/invocation.html" />
    <skos:altLabel xml:lang="en">GL context</skos:altLabel>
    <skos:scopeNote xml:lang="en">Availability depends on the selected backend and host support.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OpenIDConnect">
    <rdfs:label xml:lang="en">OpenID Connect</rdfs:label>
    <skos:prefLabel xml:lang="en">OpenID Connect</skos:prefLabel>
    <skos:definition xml:lang="en">An identity layer over OAuth 2.0 that allows a client to obtain authenticated identity claims.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labregistrylogs" />
    <dcterms:source rdf:resource="https://openid.net/specs/openid-connect-core-1_0.html" />
    <skos:altLabel xml:lang="en">OIDC</skos:altLabel>
    <skos:scopeNote xml:lang="en">A registry startup message naming this capability does not prove it is configured for the installation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OAuth2" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#JSONWebToken" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OpenIncidentState">
    <rdfs:label xml:lang="en">open incident state</rdfs:label>
    <skos:prefLabel xml:lang="en">open incident state</skos:prefLabel>
    <skos:definition xml:lang="en">The detector state while an incident's qualifying failure condition remains active.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OpenTofuConfiguration">
    <rdfs:label xml:lang="en">OpenTofu configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">OpenTofu configuration</skos:prefLabel>
    <skos:definition xml:lang="en">Infrastructure declarations evaluated by OpenTofu during resource provisioning.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Resource.ps1" />
    <skos:altLabel xml:lang="en">Terraform configuration</skos:altLabel>
    <skos:scopeNote xml:lang="en">Terraform-compatible syntax does not imply that the Terraform executable is the selected tool.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureAsCode" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystem">
    <rdfs:label xml:lang="en">operating system</rdfs:label>
    <skos:prefLabel xml:lang="en">operating system</skos:prefLabel>
    <skos:definition xml:lang="en">System software that manages a computing node's hardware resources, processes, files, and communication facilities.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:altLabel xml:lang="en">OS</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystemProcess">
    <rdfs:label xml:lang="en">operating-system process</rdfs:label>
    <skos:prefLabel xml:lang="en">operating-system process</skos:prefLabel>
    <skos:definition xml:lang="en">A running program with an OS-managed identity, lifetime, resources, and input/output streams.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:altLabel xml:lang="en">OS process</skos:altLabel>
    <skos:scopeNote xml:lang="en">A PID alone is insufficient to establish identity after PID reuse.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation">
    <rdfs:label xml:lang="en">operator intervention required</rdfs:label>
    <skos:prefLabel xml:lang="en">operator intervention required</skos:prefLabel>
    <skos:definition xml:lang="en">Advice that an operator must address an unmet condition before safe progress.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryRecommendation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>operator_intervention_required</y:codeToken>
    <y:codeVocabulary>recoveryRecommendation</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OpticalCharacterRecognition">
    <rdfs:label xml:lang="en">optical character recognition</rdfs:label>
    <skos:prefLabel xml:lang="en">optical character recognition</skos:prefLabel>
    <skos:definition xml:lang="en">Extracting text and optionally position information from a screenshot.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:altLabel xml:lang="en">OCR</skos:altLabel>
    <skos:scopeNote xml:lang="en">Recognition output is evidence, not a direct guest-state API.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:expectedInput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Screenshot" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextPattern" />
    <y:expectedOutput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OCRText" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OriginServer">
    <rdfs:label xml:lang="en">origin server</rdfs:label>
    <skos:prefLabel xml:lang="en">origin server</skos:prefLabel>
    <skos:definition xml:lang="en">The upstream source from which a proxy obtains the requested representation on a miss or revalidation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9110.html" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OutcomeUnrecordedFault">
    <rdfs:label xml:lang="en">outcome unrecorded</rdfs:label>
    <skos:prefLabel xml:lang="en">outcome unrecorded</skos:prefLabel>
    <skos:definition xml:lang="en">A cycle terminates without a usable recorded final outcome.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RunnerFault" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureRecord" />
    <y:codeToken>outcome_unrecorded</y:codeToken>
    <y:codeVocabulary>runnerFault</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#OuterLoop">
    <rdfs:label xml:lang="en">outer loop</rdfs:label>
    <skos:prefLabel xml:lang="en">outer loop</skos:prefLabel>
    <skos:definition xml:lang="en">The runner supervision loop that prepares a cycle, launches its inner process, handles termination, and decides whether to start again.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InnerLoop" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Watchdog" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PackageManager">
    <rdfs:label xml:lang="en">package manager</rdfs:label>
    <skos:prefLabel xml:lang="en">package manager</skos:prefLabel>
    <skos:definition xml:lang="en">Software that resolves, obtains, installs, and updates operating-system or application packages.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PackageRepository" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PackageMetadata">
    <rdfs:label xml:lang="en">package metadata</rdfs:label>
    <skos:prefLabel xml:lang="en">package metadata</skos:prefLabel>
    <skos:definition xml:lang="en">Indexes, signatures, and release descriptions used to locate and validate packages.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">A stalled InRelease fetch is a metadata-path problem, not evidence that a package binary is corrupt.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PackageRepository">
    <rdfs:label xml:lang="en">package repository</rdfs:label>
    <skos:prefLabel xml:lang="en">package repository</skos:prefLabel>
    <skos:definition xml:lang="en">A source of package metadata and payloads used by a package manager.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:scopeNote xml:lang="en">Not necessarily a Git source repository.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PackageMetadata" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PackageTransactionStall">
    <rdfs:label xml:lang="en">package transaction stall</rdfs:label>
    <skos:prefLabel xml:lang="en">package transaction stall</skos:prefLabel>
    <skos:definition xml:lang="en">A package operation stops making progress while waiting on a hook, terminal stream, child process, or transaction completion condition.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:scopeNote xml:lang="en">Distinct from a package download stalled on the network; inspect process waits and descriptors before choosing recovery.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProcessWaitCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#EndOfFile" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PacketCapture">
    <rdfs:label xml:lang="en">packet capture</rdfs:label>
    <skos:prefLabel xml:lang="en">packet capture</skos:prefLabel>
    <skos:definition xml:lang="en">Observation of packets on a selected interface to inspect protocol exchange and traffic evidence.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Capture requires the appropriate interface and permissions; a missing capture is not proof that no traffic occurred.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCP" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CapturePermission" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PacketLoss">
    <rdfs:label xml:lang="en">packet loss</rdfs:label>
    <skos:prefLabel xml:lang="en">packet loss</skos:prefLabel>
    <skos:definition xml:lang="en">Failure of transmitted packets to reach the expected receiver, inferred from an appropriate observation or measurement.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A single failed application request does not uniquely identify packet loss.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Patch">
    <rdfs:label xml:lang="en">patch</rdfs:label>
    <skos:prefLabel xml:lang="en">patch</skos:prefLabel>
    <skos:definition xml:lang="en">A configured Shortfall absent from the Implementation: Configuration minus Baseline, minus Implementation; a shortfall fixed directly in the running implementation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">fix</skos:altLabel>
    <skos:scopeNote xml:lang="en">It may be beneficial but still needs reconciliation with the Configuration. Not an operating-system or software update.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Shortfall" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Implementation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PatternMatch">
    <rdfs:label xml:lang="en">pattern match</rdfs:label>
    <skos:prefLabel xml:lang="en">pattern match</skos:prefLabel>
    <skos:definition xml:lang="en">Evaluating whether evidence satisfies a requested text pattern under the configured matching mode.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PatternMatchedFailure">
    <rdfs:label xml:lang="en">failure pattern matched</rdfs:label>
    <skos:prefLabel xml:lang="en">failure pattern matched</skos:prefLabel>
    <skos:definition xml:lang="en">Captured text matches a configured hard-block pattern that explicitly indicates failure.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">A failure pattern is stronger evidence than simply not seeing a success pattern.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextPattern" />
    <y:codeToken>pattern_matched_failure</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PauseAndInspectRecommendation">
    <rdfs:label xml:lang="en">pause and inspect</rdfs:label>
    <skos:prefLabel xml:lang="en">pause and inspect</skos:prefLabel>
    <skos:definition xml:lang="en">Advice to preserve the current state for diagnosis before further execution.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryRecommendation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>pause_and_inspect</y:codeToken>
    <y:codeVocabulary>recoveryRecommendation</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PauseRequest">
    <rdfs:label xml:lang="en">pause</rdfs:label>
    <skos:prefLabel xml:lang="en">pause</skos:prefLabel>
    <skos:definition xml:lang="en">An operator request to stop test progress at a supported step or cycle boundary.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/globalization/terminology/pt-BR.terms.json" />
    <skos:scopeNote xml:lang="en">Different from forcibly killing a cycle or from a timed failure-inspection pause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PausedIntent" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailurePause" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PausedIntent">
    <rdfs:label xml:lang="en">paused setting</rdfs:label>
    <skos:prefLabel xml:lang="en">paused setting</skos:prefLabel>
    <skos:definition xml:lang="en">The configured state in which pool members pause new work according to outer-loop reconciliation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DesiredState" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>paused</y:codeToken>
    <y:retiredLabel xml:lang="en">paused intent</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PayloadIntegrityMismatch">
    <rdfs:label xml:lang="en">payload integrity mismatch</rdfs:label>
    <skos:prefLabel xml:lang="en">payload integrity mismatch</skos:prefLabel>
    <skos:definition xml:lang="en">Retrieved script bytes do not match the expected integrity digest, so validation refuses the payload before its intended execution.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
    <skos:scopeNote xml:lang="en">Different from an unavailable payload and from an error inside an executed script; a mismatch alone does not establish malicious modification.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ArtifactIntegrityCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IntegrityManifest" />
    <y:codeToken>INTEGRITY MISMATCH</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PayloadUnavailableFailure">
    <rdfs:label xml:lang="en">payload unavailable</rdfs:label>
    <skos:prefLabel xml:lang="en">payload unavailable</skos:prefLabel>
    <skos:definition xml:lang="en">The guest wrapper is reached but cannot retrieve the script payload it is meant to execute.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Distinguish stale fetch addresses or unavailable sources from failures inside the absent script.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TCPReachabilityCheck" />
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProxyCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#BaseURL" />
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostAddressRenumbering" />
    <y:codeToken>payload_unavailable</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PersistentVolume">
    <rdfs:label xml:lang="en">persistent volume</rdfs:label>
    <skos:prefLabel xml:lang="en">persistent volume</skos:prefLabel>
    <skos:definition xml:lang="en">Storage represented to Kubernetes with a lifecycle distinct from an individual consuming pod.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PersistentVolumeClaim">
    <rdfs:label xml:lang="en">persistent volume claim</rdfs:label>
    <skos:prefLabel xml:lang="en">persistent volume claim</skos:prefLabel>
    <skos:definition xml:lang="en">A Kubernetes request for storage that can bind to a persistent volume.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PersistentVolume" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PhysicalHost">
    <rdfs:label xml:lang="en">physical host</rdfs:label>
    <skos:prefLabel xml:lang="en">physical host</skos:prefLabel>
    <skos:definition xml:lang="en">A host role fulfilled directly by a physical machine rather than by a nested guest.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/nested.host/README.md" />
    <skos:scopeNote xml:lang="en">PhysicalHost and NestedHost are distinct specializations; the generic Host class remains compatible with either.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Host" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PhysicalMachine" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PhysicalMachine">
    <rdfs:label xml:lang="en">physical machine</rdfs:label>
    <skos:prefLabel xml:lang="en">physical machine</skos:prefLabel>
    <skos:definition xml:lang="en">A computing node realized directly by physical hardware rather than by a virtual machine monitor.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
