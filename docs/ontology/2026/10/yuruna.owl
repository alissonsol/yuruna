    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCreativePartner" />
    <y:implementationStatus xml:lang="en">Design concept; implementation coverage is limited as described in the scope note.</y:implementationStatus>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCreativePartner">
    <rdfs:label xml:lang="en">creative partner</rdfs:label>
    <skos:prefLabel xml:lang="en">creative partner</skos:prefLabel>
    <skos:definition xml:lang="en">The role producing creative assets for campaigns or seller briefs.</skos:definition>
