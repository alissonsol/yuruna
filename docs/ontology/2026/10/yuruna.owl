  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDisclosureGrant">
    <rdfs:label xml:lang="en">disclosure grant</rdfs:label>
    <skos:prefLabel xml:lang="en">disclosure grant</skos:prefLabel>
    <skos:definition xml:lang="en">A narrowly scoped and time-limited authorization to disclose evidence for a support case.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">Not blanket permission to inspect a buyer's need history.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdConsentGrant" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSupportCase" />
    <y:codeToken>disclosure</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity">
    <rdfs:label xml:lang="en">AmisAd domain entity</rdfs:label>
    <skos:prefLabel xml:lang="en">AmisAd domain entity</skos:prefLabel>
    <skos:definition xml:lang="en">A concept specific to the AmisAd privacy-oriented matching and settlement example.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/README.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design.md" />
    <skos:scopeNote xml:lang="en">Design commitments and prototype guarantees are distinguished in the concept notes.</skos:scopeNote>
