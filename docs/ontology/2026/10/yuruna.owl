  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NameResolution">
    <rdfs:label xml:lang="en">name resolution</rdfs:label>
    <skos:prefLabel xml:lang="en">name resolution</skos:prefLabel>
