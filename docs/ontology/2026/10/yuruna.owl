    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCreativeAsset">
    <rdfs:label xml:lang="en">creative asset</rdfs:label>
    <skos:prefLabel xml:lang="en">creative asset</skos:prefLabel>
    <skos:definition xml:lang="en">A creative reference and associated metadata supplied for use in an AmisAd campaign.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
