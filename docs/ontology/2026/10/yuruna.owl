  <owl:ObjectProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#hasRoute">
    <rdfs:label xml:lang="en">has route</rdfs:label>
    <skos:prefLabel xml:lang="en">has route</skos:prefLabel>
