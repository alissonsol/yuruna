    <skos:scopeNote xml:lang="en">Support depends on host architecture, hypervisor, and exposed virtualization extensions.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Netplan">
    <rdfs:label xml:lang="en">netplan</rdfs:label>
    <skos:prefLabel xml:lang="en">netplan</skos:prefLabel>
    <skos:definition xml:lang="en">The declarative Linux network configuration layer used to supply renderer-specific interface settings.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
