  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NestedVirtualization">
    <rdfs:label xml:lang="en">nested virtualization</rdfs:label>
    <skos:prefLabel xml:lang="en">nested virtualization</skos:prefLabel>
    <skos:definition xml:lang="en">Execution of a hypervisor inside a VM, allowing that VM to create and run inner guests.</skos:definition>
