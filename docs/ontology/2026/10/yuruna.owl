    <skos:prefLabel xml:lang="en">retry budget</skos:prefLabel>
    <skos:definition xml:lang="en">The total time allowance for attempts, body reads, and backoff in a dependency call.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">Distinct from the per-attempt timeout and the caller's cancellation signal.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RetryExhaustedFailure">
    <rdfs:label xml:lang="en">retry exhausted</rdfs:label>
    <skos:prefLabel xml:lang="en">retry exhausted</skos:prefLabel>
    <skos:definition xml:lang="en">All attempts allowed by a retry policy have been used without success.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">A wrapper classification; retain the inner failure class to route diagnosis and recovery.</skos:scopeNote>
