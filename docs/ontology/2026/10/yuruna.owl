  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Port">
    <rdfs:label xml:lang="en">port</rdfs:label>
    <skos:prefLabel xml:lang="en">port</skos:prefLabel>
    <skos:definition xml:lang="en">A transport-layer number identifying a listening or communicating service endpoint within an address and protocol scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">TCP port</skos:altLabel>
    <skos:altLabel xml:lang="en">UDP port</skos:altLabel>
    <skos:scopeNote xml:lang="en">A number alone is insufficient to identify a service across protocols and hosts.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PortBindingConflict">
    <rdfs:label xml:lang="en">port binding conflict</rdfs:label>
    <skos:prefLabel xml:lang="en">port binding conflict</skos:prefLabel>
    <skos:definition xml:lang="en">A process cannot bind its requested local listening endpoint because another binding conflicts with it.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Different from a duplicate IP assignment or an unreachable remote port.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressConflict" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TCPReachabilityCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Listener" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PortForwarding">
    <rdfs:label xml:lang="en">port forwarding</rdfs:label>
    <skos:prefLabel xml:lang="en">port forwarding</skos:prefLabel>
    <skos:definition xml:lang="en">Forwarding traffic received at one listening address and port to another endpoint.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">port mapping</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PostgreSQL">
    <rdfs:label xml:lang="en">PostgreSQL</rdfs:label>
    <skos:prefLabel xml:lang="en">PostgreSQL</skos:prefLabel>
    <skos:definition xml:lang="en">The relational database software used by the subscription and AmisAd examples.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/db/schema.sql" />
