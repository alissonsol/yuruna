  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NetworkProfile">
    <rdfs:label xml:lang="en">network profile</rdfs:label>
    <skos:prefLabel xml:lang="en">network profile</skos:prefLabel>
    <skos:definition xml:lang="en">A renderer-specific set of interface settings used to claim and configure an adapter.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
