  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NeighborTable">
    <rdfs:label xml:lang="en">neighbor table</rdfs:label>
    <skos:prefLabel xml:lang="en">neighbor table</skos:prefLabel>
    <skos:definition xml:lang="en">Cached associations and reachability states for neighbors on directly connected links.</skos:definition>
