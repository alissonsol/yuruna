    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCreativeBrief">
    <rdfs:label xml:lang="en">creative brief</rdfs:label>
    <skos:prefLabel xml:lang="en">creative brief</skos:prefLabel>
    <skos:definition xml:lang="en">A request describing advertising creative work sought from a creative partner.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design/05-ads.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
