  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSettlementLedger">
    <rdfs:label xml:lang="en">settlement ledger</rdfs:label>
    <skos:prefLabel xml:lang="en">settlement ledger</skos:prefLabel>
    <skos:definition xml:lang="en">The append-only accounting record of settlement and compensating entries.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">Different from Yuruna's replication or recovery ledger.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdShortlist">
    <rdfs:label xml:lang="en">shortlist</rdfs:label>
    <skos:prefLabel xml:lang="en">shortlist</skos:prefLabel>
    <skos:definition xml:lang="en">The candidate matching offers presented for a buyer's explicit choice.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">Prototype shortlist handles are memory-resident and do not survive coordinator restart.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSlice">
    <rdfs:label xml:lang="en">matching slice</rdfs:label>
    <skos:prefLabel xml:lang="en">matching slice</skos:prefLabel>
    <skos:definition xml:lang="en">An allocated ephemeral environment in which an AmisAd match is evaluated.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design.md" />
    <skos:scopeNote xml:lang="en">The prototype simulates the sealed environment lifecycle; do not infer hardware isolation or attestation guarantees.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdResource" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdAttestation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSovereigntyPolicy" />
    <y:implementationStatus xml:lang="en">Prototype; stronger isolation or cryptographic guarantees described in design are not established by the implementation.</y:implementationStatus>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSovereigntyPolicy">
    <rdfs:label xml:lang="en">sovereignty policy</rdfs:label>
    <skos:prefLabel xml:lang="en">sovereignty policy</skos:prefLabel>
    <skos:definition xml:lang="en">Placement constraints restricting where matching may execute under residency and jurisdiction requirements.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">A declared policy is distinct from independently verified compliance.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSupportCase">
    <rdfs:label xml:lang="en">support case</rdfs:label>
    <skos:prefLabel xml:lang="en">support case</skos:prefLabel>
    <skos:definition xml:lang="en">A structured operational dispute or support request worked from authorized evidence.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">A case is not identical to a runner failure record or actual host incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdTenant">
    <rdfs:label xml:lang="en">tenant</rdfs:label>
    <skos:prefLabel xml:lang="en">tenant</skos:prefLabel>
    <skos:definition xml:lang="en">An ownership and isolation scope for an AmisAd business workspace and its records.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">Not a virtual-machine host, a Kubernetes namespace, or a particular customer account.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdValueSplit">
    <rdfs:label xml:lang="en">value split</rdfs:label>
    <skos:prefLabel xml:lang="en">value split</skos:prefLabel>
    <skos:definition xml:lang="en">The allocation of a match's value among seller, network, platform, and advertising parties.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">Auditing compares exact party amounts with the confirmed instruction.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AppleVirtualizationFramework">
    <rdfs:label xml:lang="en">Apple Virtualization Framework</rdfs:label>
    <skos:prefLabel xml:lang="en">Apple Virtualization Framework</skos:prefLabel>
    <skos:definition xml:lang="en">Apple's virtualization API used by the native macOS VM backend supported through UTM.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <skos:altLabel xml:lang="en">AVF</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ApplicationWorkload">
    <rdfs:label xml:lang="en">workload</rdfs:label>
    <skos:prefLabel xml:lang="en">workload</skos:prefLabel>
    <skos:definition xml:lang="en">An application deployment assembled from published components and workload configuration, commonly installed through Helm.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Workload.ps1" />
    <skos:scopeNote xml:lang="en">Distinguish the framework workload from a test workload phase and a Kubernetes workload controller.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#usesComponent" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DeployableComponent" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ArchitectureCompatibility">
    <rdfs:label xml:lang="en">architecture compatibility</rdfs:label>
    <skos:prefLabel xml:lang="en">architecture compatibility</skos:prefLabel>
    <skos:definition xml:lang="en">Agreement between an artifact's processor architecture and the execution environment that will use it.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Archive">
    <rdfs:label xml:lang="en">archive</rdfs:label>
    <skos:prefLabel xml:lang="en">archive</skos:prefLabel>
    <skos:definition xml:lang="en">A retained collection of files or records, commonly representing a completed cycle or packaged artifact.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Distinguish a compressed archive file from the shared storage tier that retains archives.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Artifact">
    <rdfs:label xml:lang="en">artifact</rdfs:label>
    <skos:prefLabel xml:lang="en">artifact</skos:prefLabel>
    <skos:definition xml:lang="en">An output or input retained for execution, distribution, inspection, or evidence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <skos:altLabel xml:lang="en">artifact file</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ArtifactGeneration">
    <rdfs:label xml:lang="en">artifact generation</rdfs:label>
    <skos:prefLabel xml:lang="en">artifact generation</skos:prefLabel>
    <skos:definition xml:lang="en">A retained version of an artifact whose content-based name allows safe promotion and continued reading of earlier bytes.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">Generation is a versioning concept, not the act of generating a language-model response.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ContentDigest" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ArtifactIntegrityCheck">
    <rdfs:label xml:lang="en">artifact integrity check</rdfs:label>
    <skos:prefLabel xml:lang="en">artifact integrity check</skos:prefLabel>
    <skos:definition xml:lang="en">Comparison of the retrieved bytes and expected digest or signature against the intended source revision.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <skos:scopeNote xml:lang="en">Check that the expectation and payload refer to the same revision before attributing a mismatch to transport corruption.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SourceRevision" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ChecksumVerification" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SignatureVerification" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ArtifactManifest">
    <rdfs:label xml:lang="en">artifact manifest</rdfs:label>
    <skos:prefLabel xml:lang="en">artifact manifest</skos:prefLabel>
    <skos:definition xml:lang="en">An inventory describing artifacts and metadata such as their paths, kinds, sizes, and content digests.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">A manifest's digest describes particular bytes; a changing file may no longer match it.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition">
    <rdfs:label xml:lang="en">assessment condition</rdfs:label>
    <skos:prefLabel xml:lang="en">assessment condition</skos:prefLabel>
    <skos:definition xml:lang="en">A difference or access condition obtained by comparing assessment views over the same scope, outcome representation, and observation period.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:scopeNote xml:lang="en">Not an incident classification: a failed test, an absent namespace, a stale configuration revision, or an invalid runner-state transition does not by itself prove one. Diagnostics describe their evidence as a configuration mismatch, diagnostic observation, outdated configuration, or unexpected transition; operational incidents keep their existing meaning and workflow.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentView" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AssessmentView">
    <rdfs:label xml:lang="en">assessment view</rdfs:label>
    <skos:prefLabel xml:lang="en">assessment view</skos:prefLabel>
    <skos:definition xml:lang="en">One of four kinds of evidence compared in a security assessment of the same scope: the Baseline, the Configuration, the Implementation, or the Telemetry.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">ring</skos:altLabel>
    <skos:scopeNote xml:lang="en">Comparisons require the same scope, outcome representation, and observation period. The views are related evidence, not four interchangeable names for configuration files.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Entity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AtomicPromotion">
    <rdfs:label xml:lang="en">atomic promotion</rdfs:label>
    <skos:prefLabel xml:lang="en">atomic promotion</skos:prefLabel>
    <skos:definition xml:lang="en">A controlled transition that makes a prepared candidate live while preserving the required consistency and rollback contract.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">The achievable atomicity depends on the filesystem and the operation; do not assume all multi-file changes are atomic.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Authentication">
    <rdfs:label xml:lang="en">authentication</rdfs:label>
    <skos:prefLabel xml:lang="en">authentication</skos:prefLabel>
    <skos:definition xml:lang="en">Verification of a claimed identity or possession of required authentication material.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <skos:scopeNote xml:lang="en">Different from deciding which operations an authenticated caller may perform.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Authorization">
    <rdfs:label xml:lang="en">authorization</rdfs:label>
    <skos:prefLabel xml:lang="en">authorization</skos:prefLabel>
    <skos:definition xml:lang="en">Determination of whether a caller is permitted to perform a requested operation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Authorized">
    <rdfs:label xml:lang="en">authorized</rdfs:label>
    <skos:prefLabel xml:lang="en">authorized</skos:prefLabel>
    <skos:definition xml:lang="en">Access the Baseline permits: an intentional, controlled way through the shields.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">authorized access</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinct from a tool's authorization decision, which is the authorization concept. An earlier draft of the article called this Gate; Yuruna's gates are checks that stop a run and keep that name.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Baseline" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Authorization" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Autoinstall">
    <rdfs:label xml:lang="en">autoinstall</rdfs:label>
    <skos:prefLabel xml:lang="en">autoinstall</skos:prefLabel>
    <skos:definition xml:lang="en">An unattended Ubuntu installation driven by installer and cloud-init configuration.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationChartInvalid">
    <rdfs:label xml:lang="en">invalid automation chart</rdfs:label>
    <skos:prefLabel xml:lang="en">invalid automation chart</skos:prefLabel>
    <skos:definition xml:lang="en">A deployment result classified as a rejected or invalid Helm chart.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The adapter routes chart_invalid to plan_invalid; it remains a distinct deploy-side classification.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:canonicalRoutingCategory rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InvalidPlanFailure" />
    <y:codeToken>chart_invalid</y:codeToken>
    <y:codeVocabulary>automationFailureClass</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationClusterUnreachable">
    <rdfs:label xml:lang="en">automation cluster unreachable</rdfs:label>
    <skos:prefLabel xml:lang="en">automation cluster unreachable</skos:prefLabel>
    <skos:definition xml:lang="en">A deployment result classified as unable to reach its target cluster.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The adapter routes cluster_unreachable to network_timeout; routing does not prove a transport timeout was the underlying cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:canonicalRoutingCategory rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkTimeoutFailure" />
    <y:codeToken>cluster_unreachable</y:codeToken>
    <y:codeVocabulary>automationFailureClass</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationConfigError">
    <rdfs:label xml:lang="en">automation configuration error</rdfs:label>
    <skos:prefLabel xml:lang="en">automation configuration error</skos:prefLabel>
    <skos:definition xml:lang="en">A deployment result classified as an invalid or unsatisfiable configuration.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The adapter routes config_error to plan_invalid.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:canonicalRoutingCategory rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InvalidPlanFailure" />
    <y:codeToken>config_error</y:codeToken>
    <y:codeVocabulary>automationFailureClass</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure">
    <rdfs:label xml:lang="en">automation failure</rdfs:label>
    <skos:prefLabel xml:lang="en">automation failure</skos:prefLabel>
    <skos:definition xml:lang="en">A failed deployment operation represented by the automation result contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The result adapter chooses a canonical routing category without making deploy-side and runner classifications equivalent.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationResultManifest">
    <rdfs:label xml:lang="en">automation result manifest</rdfs:label>
    <skos:prefLabel xml:lang="en">automation result manifest</skos:prefLabel>
    <skos:definition xml:lang="en">A deployment result carrying success, skipped, error text, failure classification, exit code, duration, and artifact metadata.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">Its deploy-side failure vocabulary differs from the runner taxonomy; callers bridging into remediation translate the classification first.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationSuccessStatus" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationSuccessStatus">
    <rdfs:label xml:lang="en">automation success status</rdfs:label>
    <skos:prefLabel xml:lang="en">automation success status</skos:prefLabel>
    <skos:definition xml:lang="en">The non-failure ok classification used by the deployment result contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The adapter passes ok through. Success, skipped, and failureClass are separate fields with defaults; this token alone is not an axiom proving execution or completion.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>ok</y:codeToken>
    <y:codeVocabulary>automationFailureClass</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationToolFailed">
    <rdfs:label xml:lang="en">automation tool failure</rdfs:label>
    <skos:prefLabel xml:lang="en">automation tool failure</skos:prefLabel>
    <skos:definition xml:lang="en">A deployment result classified as a failed external tool invocation, such as a nonzero Helm, Docker, or OpenTofu exit.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The adapter routes tool_failed to provisioning_failure; command failure is distinct from a verified network diagnosis.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:canonicalRoutingCategory rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProvisioningFailure" />
    <y:codeToken>tool_failed</y:codeToken>
    <y:codeVocabulary>automationFailureClass</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AutomationUnknownFailure">
    <rdfs:label xml:lang="en">unknown automation failure</rdfs:label>
    <skos:prefLabel xml:lang="en">unknown automation failure</skos:prefLabel>
    <skos:definition xml:lang="en">A failed deployment result whose deploy-side classification does not identify a more specific category.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <skos:scopeNote xml:lang="en">The adapter preserves unknown; unrecognized adapter inputs also fall back to the canonical unknown classification.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AutomationFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:canonicalRoutingCategory rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#UnknownFailure" />
    <y:codeToken>unknown</y:codeToken>
    <y:codeVocabulary>automationFailureClass</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#BackingImage">
    <rdfs:label xml:lang="en">backing image</rdfs:label>
    <skos:prefLabel xml:lang="en">backing image</skos:prefLabel>
    <skos:definition xml:lang="en">A parent disk image from which a differencing image reads unchanged blocks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">backing file</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiskImage" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Backoff">
    <rdfs:label xml:lang="en">backoff</rdfs:label>
    <skos:prefLabel xml:lang="en">backoff</skos:prefLabel>
    <skos:definition xml:lang="en">Delaying another attempt, often with increasing intervals, to avoid repeating a failure too aggressively.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Bandwidth">
    <rdfs:label xml:lang="en">bandwidth</rdfs:label>
    <skos:prefLabel xml:lang="en">bandwidth</skos:prefLabel>
    <skos:definition xml:lang="en">The available or provisioned data-transfer capacity of a communication path.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <skos:scopeNote xml:lang="en">Distinct from measured throughput during one workload.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#BaseURL">
    <rdfs:label xml:lang="en">base URL</rdfs:label>
    <skos:prefLabel xml:lang="en">base URL</skos:prefLabel>
    <skos:definition xml:lang="en">The common URL prefix against which related paths are resolved.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A stale base URL can affect many payload and diagnostic operations at once.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#URL" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Baseline">
    <rdfs:label xml:lang="en">baseline</rdfs:label>
    <skos:prefLabel xml:lang="en">baseline</skos:prefLabel>
    <skos:definition xml:lang="en">Intended requirements: the permitted outcomes and the required outcomes that the other assessment views are compared against.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <dcterms:source rdf:resource="https://csrc.nist.gov/pubs/sp/800/128/upd1/final" />
    <skos:scopeNote xml:lang="en">State the requirement separately from settings and observations; a test expectation can express a requirement, but a snapshot named baseline is still a snapshot. The pool's configured state is Configuration, not Baseline. Earlier drafts of the article called this view Intent and, in ISO terms, policy; Yuruna's former pool intent is now pool configuration, and its policy classes are configured rules. A NIST configuration baseline is a formally approved configuration, a narrower sense than this requirement view.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentView" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#BearerToken">
    <rdfs:label xml:lang="en">bearer token</rdfs:label>
    <skos:prefLabel xml:lang="en">bearer token</skos:prefLabel>
    <skos:definition xml:lang="en">A credential whose possession is sufficient for its holder to use the associated authorization.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc6750.html" />
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labregistrylogs" />
    <skos:scopeNote xml:lang="en">Different from proof-of-possession schemes; no token values are included.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Secret" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Authorization" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Bootstrap">
    <rdfs:label xml:lang="en">bootstrap</rdfs:label>
    <skos:prefLabel xml:lang="en">bootstrap</skos:prefLabel>
    <skos:definition xml:lang="en">The initial preparation that obtains required code, tools, and configuration before normal runner or guest operations.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Bootstrap synchronization failures differ from project authorization failures.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#BootstrapSyncFailure">
    <rdfs:label xml:lang="en">bootstrap synchronization failure</rdfs:label>
    <skos:prefLabel xml:lang="en">bootstrap synchronization failure</skos:prefLabel>
    <skos:definition xml:lang="en">Runner bootstrap cannot synchronize its configured framework or project checkout.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Separate from an administrator's inaccessible pool-assigned project.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecloneProject" />
    <y:codeToken>bootstrap_sync</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Bridge">
    <rdfs:label xml:lang="en">bridge</rdfs:label>
    <skos:prefLabel xml:lang="en">bridge</skos:prefLabel>
    <skos:definition xml:lang="en">A link-layer forwarding resource joining interfaces or segments into a connected forwarding domain.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">network bridge</skos:altLabel>
    <skos:scopeNote xml:lang="en">The bridge object's existence does not establish that its uplink binding is healthy.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Uplink" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#BridgePort">
    <rdfs:label xml:lang="en">bridge port</rdfs:label>
    <skos:prefLabel xml:lang="en">bridge port</skos:prefLabel>
    <skos:definition xml:lang="en">An interface attachment participating in a bridge's forwarding configuration and state.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#BridgedNetworking">
    <rdfs:label xml:lang="en">bridged networking</rdfs:label>
    <skos:prefLabel xml:lang="en">bridged networking</skos:prefLabel>
    <skos:definition xml:lang="en">A topology in which a guest participates through a bridge on the network reached by the host uplink.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CIFS">
    <rdfs:label xml:lang="en">CIFS</rdfs:label>
    <skos:prefLabel xml:lang="en">CIFS</skos:prefLabel>
    <skos:definition xml:lang="en">The file-sharing name used by Linux mount tooling for the SMB-backed storage paths in the lab.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">The label in mount tooling does not imply that Yuruna requires an obsolete SMB dialect.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Cache">
    <rdfs:label xml:lang="en">cache</rdfs:label>
    <skos:prefLabel xml:lang="en">cache</skos:prefLabel>
    <skos:definition xml:lang="en">Stored data retained for reuse to reduce repeated computation, transfer, or upstream access.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">The existing translation glossary defines one registry-mirror use; this broader class separates that sense from HTTP and DNS caches.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheBust">
    <rdfs:label xml:lang="en">cache busting</rdfs:label>
    <skos:prefLabel xml:lang="en">cache busting</skos:prefLabel>
    <skos:definition xml:lang="en">Changing a request's cache identity to request a fresh upstream fetch rather than reuse a cached response.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <skos:altLabel xml:lang="en">cache-busting</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheFreshness">
    <rdfs:label xml:lang="en">cache freshness</rdfs:label>
    <skos:prefLabel xml:lang="en">cache freshness</skos:prefLabel>
    <skos:definition xml:lang="en">Whether cached content is considered current under the applicable validation and expiration rules.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">Freshness and reachability are different properties.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheHit">
    <rdfs:label xml:lang="en">cache hit</rdfs:label>
    <skos:prefLabel xml:lang="en">cache hit</skos:prefLabel>
    <skos:definition xml:lang="en">A request satisfied from reusable cached content at the cache layer being measured.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">A hit at one layer does not imply a hit at every downstream cache.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheHitRatio">
    <rdfs:label xml:lang="en">cache hit ratio</rdfs:label>
    <skos:prefLabel xml:lang="en">cache hit ratio</skos:prefLabel>
    <skos:definition xml:lang="en">The fraction of requests or bytes satisfied from cache within a specified layer and interval.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">State whether the denominator counts requests or bytes; the two ratios need not agree.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CacheHit" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CacheMiss" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheMiss">
    <rdfs:label xml:lang="en">cache miss</rdfs:label>
    <skos:prefLabel xml:lang="en">cache miss</skos:prefLabel>
    <skos:definition xml:lang="en">A request for which the cache cannot supply reusable content and must consult another source or fail.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">A miss is not necessarily an error.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheRevalidation">
    <rdfs:label xml:lang="en">cache revalidation</rdfs:label>
    <skos:prefLabel xml:lang="en">cache revalidation</skos:prefLabel>
    <skos:definition xml:lang="en">Checking an origin to determine whether cached content remains reusable.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">Revalidation may stall even when the cache can answer other requests.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OriginServer" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheWarmSet">
    <rdfs:label xml:lang="en">warm set</rdfs:label>
    <skos:prefLabel xml:lang="en">warm set</skos:prefLabel>
    <skos:definition xml:lang="en">A selected set of registry manifests or artifacts whose presence is checked or prepared to support expected workloads.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CacheWarmup">
    <rdfs:label xml:lang="en">cache warmup</rdfs:label>
    <skos:prefLabel xml:lang="en">cache warmup</skos:prefLabel>
    <skos:definition xml:lang="en">Fetching or validating selected content in advance so later requests can use a populated cache.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:altLabel xml:lang="en">pre-warming</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CachingProxyService">
    <rdfs:label xml:lang="en">caching-proxy service</rdfs:label>
    <skos:prefLabel xml:lang="en">caching-proxy service</skos:prefLabel>
    <skos:definition xml:lang="en">The Yuruna extension service combining HTTP caching, registry mirroring, monitoring, and related lab endpoints.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <skos:scopeNote xml:lang="en">The service is broader than Squid alone and distinct from its host-side TCP forwarder.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Squid" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Zot" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CallerCancellation">
    <rdfs:label xml:lang="en">caller cancellation</rdfs:label>
    <skos:prefLabel xml:lang="en">caller cancellation</skos:prefLabel>
    <skos:definition xml:lang="en">Termination requested by the caller rather than by the dependency retry budget.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">Cancellation must not be relabeled as a dependency timeout.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RetryBudget" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CapabilityMatrix">
    <rdfs:label xml:lang="en">capability matrix</rdfs:label>
    <skos:prefLabel xml:lang="en">capability matrix</skos:prefLabel>
    <skos:definition xml:lang="en">An enumeration of supported host and action or provider combinations used to reject unwired plans before execution.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CaptureHealthCheck">
    <rdfs:label xml:lang="en">capture health check</rdfs:label>
    <skos:prefLabel xml:lang="en">capture health check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of screenshot freshness and OCR output to distinguish frozen capture from a changing or flooded console.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CapturePermission">
    <rdfs:label xml:lang="en">capture permission</rdfs:label>
    <skos:prefLabel xml:lang="en">capture permission</skos:prefLabel>
    <skos:definition xml:lang="en">Operating-system authorization required by the packet capture tool to open the selected interface.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:scopeNote xml:lang="en">A replaced capture binary can lose its file capability even though the user account and command name are unchanged.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CertificateAuthority">
    <rdfs:label xml:lang="en">certificate authority</rdfs:label>
    <skos:prefLabel xml:lang="en">certificate authority</skos:prefLabel>
    <skos:definition xml:lang="en">An authority whose trusted signing key is used to validate issued certificates.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">CA</skos:altLabel>
    <skos:scopeNote xml:lang="en">Installing a proxy CA changes the trust relationship for intercepted TLS traffic.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CertificatePinning">
    <rdfs:label xml:lang="en">certificate pinning</rdfs:label>
    <skos:prefLabel xml:lang="en">certificate pinning</skos:prefLabel>
    <skos:definition xml:lang="en">A client trust restriction requiring an expected certificate or public key in addition to its ordinary validation policy.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc8446.html" />
    <skos:scopeNote xml:lang="en">A client using pinning can reject interception even when the proxy CA is installed in a general trust store.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CertificateTrustFailure">
    <rdfs:label xml:lang="en">certificate trust failure</rdfs:label>
    <skos:prefLabel xml:lang="en">certificate trust failure</skos:prefLabel>
    <skos:definition xml:lang="en">TLS validation cannot establish the required certificate trust relationship.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">A missing proxy CA, an expired certificate, and an identity mismatch require different evidence.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TrustStore" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TLSCertificate" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ChecksumVerification">
    <rdfs:label xml:lang="en">checksum verification</rdfs:label>
    <skos:prefLabel xml:lang="en">checksum verification</skos:prefLabel>
    <skos:definition xml:lang="en">Comparison of an artifact's computed digest with an expected value from a specified source.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#verifiesArtifact" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ClearStaleGitLock">
    <rdfs:label xml:lang="en">clear stale Git lock</rdfs:label>
    <skos:prefLabel xml:lang="en">clear stale Git lock</skos:prefLabel>
    <skos:definition xml:lang="en">Removal of a verified stale repository lock by the supported bounded recovery handler.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">A live process's lock must not be treated as stale.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryAction" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>clear_stale_git_lock</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ClientAddressAttribution">
    <rdfs:label xml:lang="en">client address attribution</rdfs:label>
    <skos:prefLabel xml:lang="en">client address attribution</skos:prefLabel>
    <skos:definition xml:lang="en">Associating a request with its originating client's address across forwarding layers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">The forwarder's peer address alone can collapse several clients into one apparent source; no actual client addresses are retained here.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ObservedAddressCount" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ClockSkew">
    <rdfs:label xml:lang="en">clock skew</rdfs:label>
    <skos:prefLabel xml:lang="en">clock skew</skos:prefLabel>
    <skos:definition xml:lang="en">A difference between clocks that can distort event ordering, deadlines, or validity checks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <skos:scopeNote xml:lang="en">Timestamp disagreement is evidence to investigate rather than proof that a host incident occurred at a particular instant.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CloudConfiguration">
    <rdfs:label xml:lang="en">cloud configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">cloud configuration</skos:prefLabel>
    <skos:definition xml:lang="en">The project configuration selected for a deployment target such as localhost, AWS, Azure, or GCP.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <skos:scopeNote xml:lang="en">A configuration directory alone does not prove that every provider resource template is implemented.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CloudImage">
    <rdfs:label xml:lang="en">cloud image</rdfs:label>
    <skos:prefLabel xml:lang="en">cloud image</skos:prefLabel>
    <skos:definition xml:lang="en">A prebuilt OS disk image intended to be instantiated and configured with metadata or cloud-init.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InstallationImage" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CloudInitConfiguration">
    <rdfs:label xml:lang="en">cloud-init configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">cloud-init configuration</skos:prefLabel>
    <skos:definition xml:lang="en">Guest initialization data that creates users, configures packages and networking, and schedules first-boot commands.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CloudInitOverlay">
    <rdfs:label xml:lang="en">cloud-init overlay</rdfs:label>
    <skos:prefLabel xml:lang="en">cloud-init overlay</skos:prefLabel>
    <skos:definition xml:lang="en">An additional configuration fragment merged at supported anchors into a guest's base initialization data.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">Overlay anchor names are machine-parsed and must remain stable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CloudInitSeed">
    <rdfs:label xml:lang="en">cloud-init seed</rdfs:label>
    <skos:prefLabel xml:lang="en">cloud-init seed</skos:prefLabel>
    <skos:definition xml:lang="en">A guest initialization input assembled from base data and overlays for a selected VM configuration.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">Not a database sample-data seed.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CloudInitOverlay" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CloudProvider">
    <rdfs:label xml:lang="en">cloud provider</rdfs:label>
    <skos:prefLabel xml:lang="en">cloud provider</skos:prefLabel>
    <skos:definition xml:lang="en">A provider of remotely managed infrastructure and related deployment APIs.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <skos:scopeNote xml:lang="en">GCP configuration and authentication preparation must not be mistaken for complete resource provisioning support.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ColdCacheState">
    <rdfs:label xml:lang="en">cold cache</rdfs:label>
    <skos:prefLabel xml:lang="en">cold cache</skos:prefLabel>
    <skos:definition xml:lang="en">The requested content is not resident in the cache layer being considered and needs a permitted source fetch.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">Cold is relative to the requested content and cache layer, not necessarily an empty entire cache or an expired object.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CacheMiss" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CommittedMemory">
    <rdfs:label xml:lang="en">committed memory</rdfs:label>
    <skos:prefLabel xml:lang="en">committed memory</skos:prefLabel>
    <skos:definition xml:lang="en">Memory promised to processes or guests under the operating system's commitment accounting.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <skos:scopeNote xml:lang="en">Do not equate this measure with resident physical memory.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CompletionSentinel">
    <rdfs:label xml:lang="en">completion sentinel</rdfs:label>
    <skos:prefLabel xml:lang="en">completion sentinel</skos:prefLabel>
    <skos:definition xml:lang="en">A marker written after successful completion of an operation, such as the verified copy of a cycle archive.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">A directory without its required sentinel is not evidence that the operation finished.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ComponentPublication">
    <rdfs:label xml:lang="en">component publication</rdfs:label>
    <skos:prefLabel xml:lang="en">component publication</skos:prefLabel>
    <skos:definition xml:lang="en">The deployment phase that builds, tags, authenticates, and pushes component images to a registry.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Component.ps1" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DeploymentOperation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:nextPhase rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#WorkloadDeployment" />
    <y:expectedOutput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ContainerImage" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RegistryAuthentication" />
    <y:codeToken>Set-Component.ps1</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ComponentTestPhase">
    <rdfs:label xml:lang="en">component test phase</rdfs:label>
    <skos:prefLabel xml:lang="en">component test phase</skos:prefLabel>
    <skos:definition xml:lang="en">The sequence group used to build or validate components after resource preparation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>component</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ComputingNode">
    <rdfs:label xml:lang="en">computing node</rdfs:label>
    <skos:prefLabel xml:lang="en">computing node</skos:prefLabel>
    <skos:definition xml:lang="en">A physical or virtual execution environment capable of running an operating system and workloads.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/nested.host/README.md" />
    <skos:altLabel xml:lang="en">node</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinguish this broad sense from a Kubernetes node and from a graphical diagram node.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact">
    <rdfs:label xml:lang="en">configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">configuration</skos:prefLabel>
    <skos:definition xml:lang="en">Explicit settings in code, files, and management tools that specify parameters or deployment behavior; the Configuration view of a system.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-config.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">configuration artifact</skos:altLabel>
    <skos:altLabel xml:lang="en">configuration settings</skos:altLabel>
    <skos:scopeNote xml:lang="en">Records settings, not the independent requirement they should satisfy: pool configuration and the configured state are Configuration, not Baseline. An earlier draft of the article called this view Manifest; Kubernetes, artifact, release, and snapshot manifests keep their established names and are not views.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentView" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationService">
    <rdfs:label xml:lang="en">configuration service</rdfs:label>
    <skos:prefLabel xml:lang="en">configuration service</skos:prefLabel>
    <skos:definition xml:lang="en">The host-side service surface that exposes and updates supported runner configuration under control authorization.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:scopeNote xml:lang="en">The current implementation name is ConfigService; HostConfigService is retired terminology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ControlProof" />
    <y:codeToken>ConfigService</y:codeToken>
    <y:retiredLabel xml:lang="en">HostConfigService</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConnectionRefused">
    <rdfs:label xml:lang="en">connection refused</rdfs:label>
    <skos:prefLabel xml:lang="en">connection refused</skos:prefLabel>
    <skos:definition xml:lang="en">A connection attempt is explicitly rejected rather than silently exceeding its deadline.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Often points toward listener or firewall state; it does not alone identify which one.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TCPReachabilityCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Listener" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConnectionReset">
    <rdfs:label xml:lang="en">connection reset</rdfs:label>
    <skos:prefLabel xml:lang="en">connection reset</skos:prefLabel>
    <skos:definition xml:lang="en">An established or attempted transport connection is abruptly reset.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">An intermediary may cause the reset; do not assume the application intentionally closed it.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProxyCheck" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Connectivity">
    <rdfs:label xml:lang="en">connectivity</rdfs:label>
    <skos:prefLabel xml:lang="en">connectivity</skos:prefLabel>
    <skos:definition xml:lang="en">The availability of communication between endpoints under stated addressing, routing, and protocol assumptions.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Always retain the endpoints' roles and the tested protocol when interpreting a connectivity result.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Reachability" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConsoleFloodedFailure">
    <rdfs:label xml:lang="en">console flooded</rdfs:label>
    <skos:prefLabel xml:lang="en">console flooded</skos:prefLabel>
    <skos:definition xml:lang="en">Continuously overwritten console output prevents a stable requested prompt from being recognized even though frames and text are arriving.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Different from a frozen capture channel; blindly replaying input does not remove the flood.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CaptureHealthCheck" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PauseAndInspectRecommendation" />
    <y:codeToken>console_flooded</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConsoleInput">
    <rdfs:label xml:lang="en">console input</rdfs:label>
    <skos:prefLabel xml:lang="en">console input</skos:prefLabel>
    <skos:definition xml:lang="en">Sending keys, text, or pointer actions through a guest's display/input channel.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ConsoleStaticDuration">
    <rdfs:label xml:lang="en">console static duration</rdfs:label>
    <skos:prefLabel xml:lang="en">console static duration</skos:prefLabel>
    <skos:definition xml:lang="en">The interval over which the captured console remains unchanged under the capture comparison policy.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">A static console can reflect an idle prompt, stalled execution, or a frozen capture path.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CaptureHealthCheck" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ContactPoint">
    <rdfs:label xml:lang="en">contact point</rdfs:label>
    <skos:prefLabel xml:lang="en">contact point</skos:prefLabel>
    <skos:definition xml:lang="en">A configured destination and delivery integration for alert notifications.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/alerts.md" />
    <skos:scopeNote xml:lang="en">No email addresses or individual recipients are modeled.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Container">
    <rdfs:label xml:lang="en">container</rdfs:label>
    <skos:prefLabel xml:lang="en">container</skos:prefLabel>
    <skos:definition xml:lang="en">An isolated application execution environment instantiated from a container image.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://kubernetes.io/docs/concepts/workloads/pods/" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ContainerImage">
    <rdfs:label xml:lang="en">container image</rdfs:label>
    <skos:prefLabel xml:lang="en">container image</skos:prefLabel>
    <skos:definition xml:lang="en">A packaged filesystem and execution configuration used to create containers.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Component.ps1" />
    <skos:scopeNote xml:lang="en">Different from a VM disk image.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ContentAddressing">
    <rdfs:label xml:lang="en">content addressing</rdfs:label>
    <skos:prefLabel xml:lang="en">content addressing</skos:prefLabel>
    <skos:definition xml:lang="en">Identifying stored artifacts by a value derived from their contents so identical bytes can share an identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ContentDigest">
    <rdfs:label xml:lang="en">content digest</rdfs:label>
    <skos:prefLabel xml:lang="en">content digest</skos:prefLabel>
    <skos:definition xml:lang="en">A hash derived from artifact bytes and used for integrity checks or content-based identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <skos:altLabel xml:lang="en">checksum</skos:altLabel>
    <skos:altLabel xml:lang="en">content hash</skos:altLabel>
    <skos:scopeNote xml:lang="en">A digest alone does not establish the identity or trustworthiness of its publisher.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ControlProof">
    <rdfs:label xml:lang="en">control proof</rdfs:label>
    <skos:prefLabel xml:lang="en">control proof</skos:prefLabel>
    <skos:definition xml:lang="en">A bounded browser authorization proof used when opening protected service controls.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <skos:scopeNote xml:lang="en">Do not retain URL fragments or proof values as source provenance.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#LabToken" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CopyMode">
    <rdfs:label xml:lang="en">copy mode</rdfs:label>
    <skos:prefLabel xml:lang="en">copy mode</skos:prefLabel>
    <skos:definition xml:lang="en">The pool-storage mode that keeps the local cycle directory after archiving its contents to the share.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CounterMetric">
    <rdfs:label xml:lang="en">counter metric</rdfs:label>
    <skos:prefLabel xml:lang="en">counter metric</skos:prefLabel>
    <skos:definition xml:lang="en">A measurement accumulating occurrences or amounts, normally increasing until a reset.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">A restart can reset a counter; a raw difference needs reset-aware interpretation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Metric" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Credential">
    <rdfs:label xml:lang="en">credential</rdfs:label>
    <skos:prefLabel xml:lang="en">credential</skos:prefLabel>
    <skos:definition xml:lang="en">Authentication material used to demonstrate an identity or authorization to a system.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <skos:scopeNote xml:lang="en">The ontology contains credential types, never their values.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CredentialExpiredFailure">
    <rdfs:label xml:lang="en">credential expired</rdfs:label>
    <skos:prefLabel xml:lang="en">credential expired</skos:prefLabel>
    <skos:definition xml:lang="en">Authentication cannot proceed because required credential validity has expired.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Not every authorization denial proves expiration.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CredentialProvider" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
    <y:codeToken>credential_expired</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CredentialProvider">
    <rdfs:label xml:lang="en">credential provider</rdfs:label>
    <skos:prefLabel xml:lang="en">credential provider</skos:prefLabel>
    <skos:definition xml:lang="en">A registered implementation that supplies authentication or login behavior for a matched target.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <skos:scopeNote xml:lang="en">A provider's existence does not imply automatic reauthentication is invoked after every failure.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RegistryAuthentication" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CrossHostIncident">
    <rdfs:label xml:lang="en">cross-host incident</rdfs:label>
    <skos:prefLabel xml:lang="en">cross-host incident</skos:prefLabel>
    <skos:definition xml:lang="en">An aggregator incident correlating a shared failure class across hosts.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">A shared class supports correlation, not proof that all hosts share the same underlying cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RepeatedFailureIncident" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DominantFailureClass" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CurrentArtifactPointer">
    <rdfs:label xml:lang="en">current artifact pointer</rdfs:label>
    <skos:prefLabel xml:lang="en">current artifact pointer</skos:prefLabel>
    <skos:definition xml:lang="en">A small reference selecting the committed artifact generation that a service may serve.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">It is published after the generation and metadata are verified.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AtomicPromotion" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CycleArchive">
    <rdfs:label xml:lang="en">cycle archive</rdfs:label>
    <skos:prefLabel xml:lang="en">cycle archive</skos:prefLabel>
    <skos:definition xml:lang="en">The retained output of a test cycle, including its logs, evidence, and completion metadata.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Archive" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ArtifactManifest" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CycleKilledFault">
    <rdfs:label xml:lang="en">cycle killed</rdfs:label>
    <skos:prefLabel xml:lang="en">cycle killed</skos:prefLabel>
    <skos:definition xml:lang="en">The supervised cycle process is terminated before normal completion.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Termination alone does not identify the original cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RunnerFault" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Watchdog" />
    <y:codeToken>cycle_killed</y:codeToken>
    <y:codeVocabulary>runnerFault</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CycleOutcome">
    <rdfs:label xml:lang="en">cycle outcome</rdfs:label>
    <skos:prefLabel xml:lang="en">cycle outcome</skos:prefLabel>
    <skos:definition xml:lang="en">The recorded terminal result of a runner cycle.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">An in-progress cycle is excluded from completed-cycle success percentages.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CycleSpawnFailure">
    <rdfs:label xml:lang="en">cycle spawn failed</rdfs:label>
    <skos:prefLabel xml:lang="en">cycle spawn failed</skos:prefLabel>
    <skos:definition xml:lang="en">The outer runner cannot successfully launch the intended cycle process.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RunnerFault" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>cycle_spawn_failed</y:codeToken>
    <y:codeVocabulary>runnerFault</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#CycleSuccessRatio">
    <rdfs:label xml:lang="en">cycle success ratio</rdfs:label>
    <skos:prefLabel xml:lang="en">cycle success ratio</skos:prefLabel>
    <skos:definition xml:lang="en">The fraction of terminal cycles that passed in the selected reporting scope and interval.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">An empty denominator is unavailable rather than one hundred percent success.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CycleOutcome" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCP">
    <rdfs:label xml:lang="en">DHCP</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP</skos:prefLabel>
    <skos:definition xml:lang="en">A client-server protocol that distributes address assignments and configuration parameters.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">Dynamic Host Configuration Protocol</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPAddressPool">
    <rdfs:label xml:lang="en">DHCP address pool</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP address pool</skos:prefLabel>
    <skos:definition xml:lang="en">The set of addresses a DHCP service can allocate to clients under a configured scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">address pool</skos:altLabel>
    <skos:scopeNote xml:lang="en">Do not confuse this pool with a Yuruna host pool or the Download pool.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Subnet" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPClient">
    <rdfs:label xml:lang="en">DHCP client</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP client</skos:prefLabel>
    <skos:definition xml:lang="en">A client that requests address and configuration information from a DHCP server.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPClientIdentifier">
    <rdfs:label xml:lang="en">DHCP client identifier</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP client identifier</skos:prefLabel>
    <skos:definition xml:lang="en">The identity presented by a DHCP client when the server associates it with an address allocation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">DHCP client ID</skos:altLabel>
    <skos:scopeNote xml:lang="en">A stable MAC does not bound allocations if the client identifier changes independently.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#identifiesClient" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPClient" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MACAddress" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPIdentityUnboundedFailure">
    <rdfs:label xml:lang="en">unbounded DHCP identity</rdfs:label>
    <skos:prefLabel xml:lang="en">unbounded DHCP identity</skos:prefLabel>
    <skos:definition xml:lang="en">Repeated provisioning creates an expanding address footprint instead of reusing a stable intended DHCP identity.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Another VM retry can worsen the address footprint; inspect identity and lease evidence first.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPLeaseCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressChurn" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
    <y:codeToken>dhcp_identity_unbounded</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPLease">
    <rdfs:label xml:lang="en">DHCP lease</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP lease</skos:prefLabel>
    <skos:definition xml:lang="en">A time-bounded assignment of an address and associated configuration to a DHCP client.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">lease</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinct from a storage-writer lease or a pool execution lease.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#leasesAddress" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPAddress" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPLeaseCheck">
    <rdfs:label xml:lang="en">DHCP lease check</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP lease check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of lease and client-identity data to distinguish missing assignment, identity churn, and address capacity problems.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPPoolExhaustion">
    <rdfs:label xml:lang="en">DHCP pool exhaustion</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP pool exhaustion</skos:prefLabel>
    <skos:definition xml:lang="en">The configured address allocation scope has no eligible free address for the requesting client.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Must be supported by scope and lease evidence; a missing guest address or observed-address lower bound is insufficient proof.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPLeaseCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPAddressPool" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPReservation">
    <rdfs:label xml:lang="en">DHCP reservation</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP reservation</skos:prefLabel>
    <skos:definition xml:lang="en">A server-side policy that associates a chosen address with a specified client identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">address reservation</skos:altLabel>
    <skos:scopeNote xml:lang="en">A reservation is distinct from statically assigning an address inside a guest.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPLease" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DHCPServer">
    <rdfs:label xml:lang="en">DHCP server</rdfs:label>
    <skos:prefLabel xml:lang="en">DHCP server</skos:prefLabel>
    <skos:definition xml:lang="en">A service that assigns or supplies client addresses and other network configuration through DHCP.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The server's lease information is needed to establish address-pool exhaustion.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DNS">
    <rdfs:label xml:lang="en">DNS</rdfs:label>
    <skos:prefLabel xml:lang="en">DNS</skos:prefLabel>
    <skos:definition xml:lang="en">The distributed naming system that resolves domain names and associated resource records.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc1034" />
    <skos:altLabel xml:lang="en">Domain Name System</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DNSCache">
    <rdfs:label xml:lang="en">DNS cache</rdfs:label>
    <skos:prefLabel xml:lang="en">DNS cache</skos:prefLabel>
    <skos:definition xml:lang="en">Stored DNS answers retained for reuse under their validity and expiration rules.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc1034" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Cache" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DNSResolver" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DNSRecord">
    <rdfs:label xml:lang="en">DNS record</rdfs:label>
    <skos:prefLabel xml:lang="en">DNS record</skos:prefLabel>
    <skos:definition xml:lang="en">A typed DNS resource record associating a name with address or other naming information.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc1034" />
    <skos:altLabel xml:lang="en">resource record</skos:altLabel>
    <skos:scopeNote xml:lang="en">This sense of resource record is unrelated to the Yuruna resource deployment phase.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DNSResolutionCheck">
    <rdfs:label xml:lang="en">DNS resolution check</rdfs:label>
    <skos:prefLabel xml:lang="en">DNS resolution check</skos:prefLabel>
    <skos:definition xml:lang="en">Testing whether the configured resolver can answer the relevant name lookup.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A name lookup result does not prove the application port is reachable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DNSResolver">
    <rdfs:label xml:lang="en">DNS resolver</rdfs:label>
    <skos:prefLabel xml:lang="en">DNS resolver</skos:prefLabel>
    <skos:definition xml:lang="en">A component that obtains DNS answers on behalf of clients, potentially using caches or upstream name servers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc1034" />
    <skos:altLabel xml:lang="en">resolver</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DUID">
    <rdfs:label xml:lang="en">DUID</rdfs:label>
    <skos:prefLabel xml:lang="en">DUID</skos:prefLabel>
    <skos:definition xml:lang="en">A DHCP unique identifier that may be derived from machine state and used in a client's identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">DHCP unique identifier</skos:altLabel>
    <skos:scopeNote xml:lang="en">The guest network renderer's identity policy matters; a rebuilt machine ID can change the client identity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MachineIdentifier" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DashboardPanel">
    <rdfs:label xml:lang="en">dashboard panel</rdfs:label>
    <skos:prefLabel xml:lang="en">dashboard panel</skos:prefLabel>
    <skos:definition xml:lang="en">A configured visualization of one or more data-source queries.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DataSourceError">
    <rdfs:label xml:lang="en">data-source error</rdfs:label>
    <skos:prefLabel xml:lang="en">data-source error</skos:prefLabel>
    <skos:definition xml:lang="en">A query or collection source fails to provide the requested observation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/alerts.md" />
    <skos:scopeNote xml:lang="en">Do not equate it with a failure of the monitored guest.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NoDataState" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Deadline">
    <rdfs:label xml:lang="en">deadline</rdfs:label>
    <skos:prefLabel xml:lang="en">deadline</skos:prefLabel>
    <skos:definition xml:lang="en">The time boundary after which an operation must stop or be treated as overdue.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Deduplication">
    <rdfs:label xml:lang="en">deduplication</rdfs:label>
    <skos:prefLabel xml:lang="en">deduplication</skos:prefLabel>
    <skos:definition xml:lang="en">Recognizing equivalent content or work so redundant storage or repeated processing can be avoided.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <skos:scopeNote xml:lang="en">Content identity and semantic similarity are different deduplication criteria.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DefaultRoute">
    <rdfs:label xml:lang="en">default route</rdfs:label>
    <skos:prefLabel xml:lang="en">default route</skos:prefLabel>
    <skos:definition xml:lang="en">The routing-table entry used when no more specific route matches a destination.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Route" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Gateway" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DependencyFailure">
    <rdfs:label xml:lang="en">dependency failure</rdfs:label>
    <skos:prefLabel xml:lang="en">dependency failure</skos:prefLabel>
    <skos:definition xml:lang="en">A failed call to an external model or database dependency, preserving the error category and bounded-attempt context.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">An exhausted retry budget does not erase the last transport, status, rate-limit, or parse failure.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RetryBudget" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DeployableComponent">
    <rdfs:label xml:lang="en">component</rdfs:label>
    <skos:prefLabel xml:lang="en">component</skos:prefLabel>
    <skos:definition xml:lang="en">An application building block built and published as a container image by the component phase.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Component.ps1" />
    <skos:scopeNote xml:lang="en">Not every software part in the workspace is a component in this deployment sense.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ContainerImage" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DeploymentOperation">
    <rdfs:label xml:lang="en">operation</rdfs:label>
    <skos:prefLabel xml:lang="en">operation</skos:prefLabel>
    <skos:definition xml:lang="en">One of the framework's three umbrella deployment stages: resources, components, or workloads.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/globalization/terminology/pt-BR.terms.json" />
    <skos:scopeNote xml:lang="en">In this CLI sense an operation is not an arbitrary sequence step.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ResourceProvisioning" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ComponentPublication" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#WorkloadDeployment" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DeploymentPipeline">
    <rdfs:label xml:lang="en">deployment pipeline</rdfs:label>
    <skos:prefLabel xml:lang="en">deployment pipeline</skos:prefLabel>
    <skos:definition xml:lang="en">The ordered resource provisioning, component publication, and workload deployment operations for a project.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hasPart" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ResourceProvisioning" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hasPart" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ComponentPublication" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hasPart" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#WorkloadDeployment" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DeploymentResource">
    <rdfs:label xml:lang="en">resource</rdfs:label>
    <skos:prefLabel xml:lang="en">resource</skos:prefLabel>
    <skos:definition xml:lang="en">Infrastructure provisioned in the resource phase from a project's resource definitions, commonly through OpenTofu.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Resource.ps1" />
    <skos:scopeNote xml:lang="en">Yuruna deployment sense; distinguish test resource phases, computing capacity, and Kubernetes API resources.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DeploymentTarget">
    <rdfs:label xml:lang="en">deployment target</rdfs:label>
    <skos:prefLabel xml:lang="en">deployment target</skos:prefLabel>
    <skos:definition xml:lang="en">The local or cloud environment to which project resources and workloads are directed.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DesiredState">
    <rdfs:label xml:lang="en">configured state</rdfs:label>
    <skos:prefLabel xml:lang="en">configured state</skos:prefLabel>
    <skos:definition xml:lang="en">The pool's saved run, paused, or drain setting that members pull and reconcile with observed operation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <skos:scopeNote xml:lang="en">Different from the measured current state and from a member's reported status; a service start or stop request is a requested state. An explicit setting, so Configuration rather than Baseline.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:codeToken>configuredState</y:codeToken>
    <y:retiredLabel xml:lang="en">desired state</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DeterministicMACAddress">
    <rdfs:label xml:lang="en">deterministic MAC address</rdfs:label>
    <skos:prefLabel xml:lang="en">deterministic MAC address</skos:prefLabel>
    <skos:definition xml:lang="en">A guest adapter address derived reproducibly from stable host and guest identity inputs.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Renaming a VM must not accidentally change a guest identity already embedded in cluster state.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MACAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestIdentity" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck">
    <rdfs:label xml:lang="en">diagnostic check</rdfs:label>
    <skos:prefLabel xml:lang="en">diagnostic check</skos:prefLabel>
    <skos:definition xml:lang="en">A bounded observation or test chosen to discriminate between possible explanations of a symptom.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">A check may fail independently of the system it observes.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence">
    <rdfs:label xml:lang="en">diagnostic evidence</rdfs:label>
    <skos:prefLabel xml:lang="en">diagnostic evidence</skos:prefLabel>
    <skos:definition xml:lang="en">A captured observation used to support or reject an operational explanation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Evidence can be incomplete, stale, or unavailable; none of those states alone proves a guest failure.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticLadder">
    <rdfs:label xml:lang="en">diagnostic ladder</rdfs:label>
    <skos:prefLabel xml:lang="en">diagnostic ladder</skos:prefLabel>
    <skos:definition xml:lang="en">An ordered set of evidence collection paths chosen so one unavailable transport does not prevent all diagnosis.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">A console fallback can supply evidence when SSH or address discovery is unavailable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DifferencingDisk">
    <rdfs:label xml:lang="en">differencing disk</rdfs:label>
    <skos:prefLabel xml:lang="en">differencing disk</skos:prefLabel>
    <skos:definition xml:lang="en">A virtual disk that stores changes relative to a parent image rather than duplicating all parent data.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">copy-on-write disk</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VirtualDisk" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DiskImage">
    <rdfs:label xml:lang="en">disk image</rdfs:label>
    <skos:prefLabel xml:lang="en">disk image</skos:prefLabel>
    <skos:definition xml:lang="en">An artifact representing virtual disk contents and, depending on format, metadata or backing-file relationships.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">Do not conflate an installed disk image with bootable installation media.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DiskSnapshot">
    <rdfs:label xml:lang="en">disk snapshot</rdfs:label>
    <skos:prefLabel xml:lang="en">disk snapshot</skos:prefLabel>
    <skos:definition xml:lang="en">A restore point for guest disk state saved and loaded by the sequence engine.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <skos:scopeNote xml:lang="en">Restoring disk state does not guarantee monotonic guest wall-clock evidence.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Snapshot" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#BackingImage" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DispatchRegistry">
    <rdfs:label xml:lang="en">dispatch registry</rdfs:label>
    <skos:prefLabel xml:lang="en">dispatch registry</skos:prefLabel>
    <skos:definition xml:lang="en">A mapping from a capability or action key to its implementation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <skos:scopeNote xml:lang="en">Not a container registry or the Windows Registry.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DisplayBackend">
    <rdfs:label xml:lang="en">display backend</rdfs:label>
    <skos:prefLabel xml:lang="en">display backend</skos:prefLabel>
    <skos:definition xml:lang="en">The selected mechanism through which a virtual machine presents or exports its graphical output.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <dcterms:source rdf:resource="https://www.qemu.org/docs/master/system/invocation.html" />
    <skos:scopeNote xml:lang="en">The display backend and emulated graphics device are separate configuration choices.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GraphicsDeviceModel" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DisplayContextFailure">
    <rdfs:label xml:lang="en">display context unavailable</rdfs:label>
    <skos:prefLabel xml:lang="en">display context unavailable</skos:prefLabel>
    <skos:definition xml:lang="en">VM startup fails because the selected console or graphics path cannot supply its required rendering context.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labstash" />
    <skos:scopeNote xml:lang="en">The selected text evidence reports a missing GL context during QEMU startup; it does not establish a universal fix for every platform.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProvisioningFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GraphicsConfigurationCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OpenGLContext" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Dnsmasq">
    <rdfs:label xml:lang="en">dnsmasq</rdfs:label>
    <skos:prefLabel xml:lang="en">dnsmasq</skos:prefLabel>
    <skos:definition xml:lang="en">The DNS and DHCP service used by libvirt-managed guest networks and inspected for lease and transaction evidence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DocumentIdentifier">
    <rdfs:label xml:lang="en">document identifier</rdfs:label>
    <skos:prefLabel xml:lang="en">document identifier</skos:prefLabel>
    <skos:definition xml:lang="en">A stable identifier assigned to a registered document for language-independent linking.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <skos:scopeNote xml:lang="en">Only IDs created by the document-anchor tooling are valid registered document IDs.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HeadingAnchor" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DominantFailureClass">
    <rdfs:label xml:lang="en">dominant failure class</rdfs:label>
    <skos:prefLabel xml:lang="en">dominant failure class</skos:prefLabel>
    <skos:definition xml:lang="en">The failure-class category selected to summarize an incident's observed class distribution.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">Different from a verified root cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureClassHistogram" />
    <y:codeToken>dominantClass</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DownloadAgentService">
    <rdfs:label xml:lang="en">download-agent service</rdfs:label>
    <skos:prefLabel xml:lang="en">download-agent service</skos:prefLabel>
    <skos:definition xml:lang="en">A Yuruna extension that resolves, downloads, verifies, retains, and serves guest installation images from shared pool storage.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">Failure of this optimization falls back to the publisher path rather than automatically failing a test cycle.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DownloadPool" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DownloadPool">
    <rdfs:label xml:lang="en">download pool</rdfs:label>
    <skos:prefLabel xml:lang="en">download pool</skos:prefLabel>
    <skos:definition xml:lang="en">The shared image inventory owned by the download-agent service, indexed by host type, image key, architecture, and requested variant.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">Distinct from a host coordination pool and a DHCP address pool.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ArtifactGeneration" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DownloadResume">
    <rdfs:label xml:lang="en">download resume</rdfs:label>
    <skos:prefLabel xml:lang="en">download resume</skos:prefLabel>
    <skos:definition xml:lang="en">Continuing a partial transfer using range and artifact-identity checks rather than treating incomplete bytes as a completed image.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DrainingIntent">
    <rdfs:label xml:lang="en">drain setting</rdfs:label>
    <skos:prefLabel xml:lang="en">drain setting</skos:prefLabel>
    <skos:definition xml:lang="en">The configured state in which pool members finish current work and refrain from starting further cycles.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">Draining is not forcibly terminating an in-flight step.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DesiredState" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>drain</y:codeToken>
    <y:retiredLabel xml:lang="en">drain intent</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Drift">
    <rdfs:label xml:lang="en">drift</rdfs:label>
    <skos:prefLabel xml:lang="en">drift</skos:prefLabel>
    <skos:definition xml:lang="en">Implemented outcomes outside the Configuration, together with any Patch: Implementation minus Configuration, union Patch; openings that exist at runtime but were not declared, or that were patched.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">configuration drift</skos:altLabel>
    <skos:scopeNote xml:lang="en">Drift includes beneficial differences. Not an incident classification: a failed test, an absent namespace, a stale configuration revision, or an invalid runner-state transition does not by itself prove one.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Implementation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Patch" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DuplicateIPAddress">
    <rdfs:label xml:lang="en">duplicate IP address</rdfs:label>
    <skos:prefLabel xml:lang="en">duplicate IP address</skos:prefLabel>
    <skos:definition xml:lang="en">Two active interfaces claim the same address within a scope where their traffic conflicts.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A reused address after guest replacement is not automatically a simultaneous conflict.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressConflict" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressDiscoveryCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ARP" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#DurableStorage">
    <rdfs:label xml:lang="en">durable storage</rdfs:label>
    <skos:prefLabel xml:lang="en">durable storage</skos:prefLabel>
    <skos:definition xml:lang="en">Storage intended to retain required data across the loss or replacement of a host or service VM.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Durability intent does not imply that every copy has already been verified.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Egress">
    <rdfs:label xml:lang="en">egress</rdfs:label>
    <skos:prefLabel xml:lang="en">egress</skos:prefLabel>
    <skos:definition xml:lang="en">Traffic leaving a defined network or execution boundary toward an external destination.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">The boundary must be stated when reasoning about privacy or connectivity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ElevationRequiredFailure">
    <rdfs:label xml:lang="en">elevation required</rdfs:label>
    <skos:prefLabel xml:lang="en">elevation required</skos:prefLabel>
    <skos:definition xml:lang="en">An unattended host operation requires privileges that the current execution context cannot supply.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Requires privilege configuration or operator action, not blind retry.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
    <y:codeToken>elevation_required</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EndFailurePauseEarly">
    <rdfs:label xml:lang="en">end failure pause early</rdfs:label>
    <skos:prefLabel xml:lang="en">end failure pause early</skos:prefLabel>
    <skos:definition xml:lang="en">Finishing a failure inspection pause early when the recovery policy permits the next cycle.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryAction" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>end_failure_pause_early</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EndOfFile">
    <rdfs:label xml:lang="en">end of file</rdfs:label>
    <skos:prefLabel xml:lang="en">end of file</skos:prefLabel>
    <skos:definition xml:lang="en">The stream condition indicating that further input is no longer available under the stream's contract.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:altLabel xml:lang="en">EOF</skos:altLabel>
    <skos:scopeNote xml:lang="en">A process waiting for EOF can remain blocked when another process still holds the writing end open.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StreamDrain" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EndToEndFetchCheck">
    <rdfs:label xml:lang="en">end-to-end fetch check</rdfs:label>
    <skos:prefLabel xml:lang="en">end-to-end fetch check</skos:prefLabel>
    <skos:definition xml:lang="en">Fetching the relevant response body through the configured path to test transfer completion, not merely connection or headers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">An unrelated small directory listing can succeed while the required package metadata stalls.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Endpoint">
    <rdfs:label xml:lang="en">endpoint</rdfs:label>
    <skos:prefLabel xml:lang="en">endpoint</skos:prefLabel>
    <skos:definition xml:lang="en">An addressable communication target identified by the coordinates and protocol needed by its caller.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Entity">
    <rdfs:label xml:lang="en">entity</rdfs:label>
    <skos:prefLabel xml:lang="en">entity</skos:prefLabel>
    <skos:definition xml:lang="en">A kind of thing described by the ontology, rather than a particular deployed object or recorded occurrence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-primer/" />
    <skos:scopeNote xml:lang="en">Top-level modeling category; the ontology contains terminology and schema, not a populated infrastructure inventory.</skos:scopeNote>
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EphemeralStorage">
    <rdfs:label xml:lang="en">ephemeral storage</rdfs:label>
    <skos:prefLabel xml:lang="en">ephemeral storage</skos:prefLabel>
    <skos:definition xml:lang="en">Storage whose contents are not relied on to survive replacement or destruction of its execution environment.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Ephemeral describes a durability contract rather than a specific disk technology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EscalateRecommendation">
    <rdfs:label xml:lang="en">escalate</rdfs:label>
    <skos:prefLabel xml:lang="en">escalate</skos:prefLabel>
    <skos:definition xml:lang="en">The reserved recommendation to hand a problem beyond the built-in recovery path.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">A vocabulary member does not establish a built-in escalation handler.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryRecommendation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>escalate</y:codeToken>
    <y:codeVocabulary>recoveryRecommendation</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EstimatedRowCount">
    <rdfs:label xml:lang="en">estimated row count</rdfs:label>
    <skos:prefLabel xml:lang="en">estimated row count</skos:prefLabel>
    <skos:definition xml:lang="en">The planner's estimated number of rows at a query-plan node.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">An outer LIMIT does not remove a large underlying scan or join estimate.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Ethernet">
    <rdfs:label xml:lang="en">Ethernet</rdfs:label>
    <skos:prefLabel xml:lang="en">Ethernet</skos:prefLabel>
    <skos:definition xml:lang="en">The wired link-layer networking technology used by supported physical uplinks and virtual Ethernet interfaces.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A virtual Ethernet interface does not establish that its physical uplink binding is healthy.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#EventRecord">
    <rdfs:label xml:lang="en">event record</rdfs:label>
    <skos:prefLabel xml:lang="en">event record</skos:prefLabel>
    <skos:definition xml:lang="en">A structured description emitted for a runner or service transition or observation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:scopeNote xml:lang="en">Several events can refer to one incident and must not be counted as independent incidents.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ExampleProject">
    <rdfs:label xml:lang="en">example project</rdfs:label>
    <skos:prefLabel xml:lang="en">example project</skos:prefLabel>
    <skos:definition xml:lang="en">A project demonstrating a concrete application or host configuration supported by the framework.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <skos:scopeNote xml:lang="en">Example terminology retains its application context.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Project" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ExplainCardinalityGate">
    <rdfs:label xml:lang="en">EXPLAIN cardinality gate</rdfs:label>
    <skos:prefLabel xml:lang="en">EXPLAIN cardinality gate</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of every JSON query-plan node to reject estimates exceeding the configured row threshold.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:altLabel xml:lang="en">EXPLAIN cost gate</skos:altLabel>
    <skos:scopeNote xml:lang="en">Despite the UI's cost label, this is not a monetary or execution-time estimator.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#EstimatedRowCount" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Exposure">
    <rdfs:label xml:lang="en">exposure</rdfs:label>
    <skos:prefLabel xml:lang="en">exposure</skos:prefLabel>
    <skos:definition xml:lang="en">Implemented outcomes outside the Baseline: Implementation minus Baseline; the underlying difference between actual running conditions and the target Baseline.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">risk exposure</skos:altLabel>
    <skos:scopeNote xml:lang="en">Narrower than the NIST glossary sense of exposure as the extent to which a party is subject to a risk; kept because no better term exists.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Implementation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Baseline" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ExtensionCall">
    <rdfs:label xml:lang="en">extension call</rdfs:label>
    <skos:prefLabel xml:lang="en">extension call</skos:prefLabel>
    <skos:definition xml:lang="en">A bounded invocation of an extension endpoint with validation of its response contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ExtensionCapability">
    <rdfs:label xml:lang="en">extension capability</rdfs:label>
    <skos:prefLabel xml:lang="en">extension capability</skos:prefLabel>
    <skos:definition xml:lang="en">A declared operation offered by an extension and available for sequence dispatch.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ExtensionErrorFailure">
    <rdfs:label xml:lang="en">extension error</rdfs:label>
    <skos:prefLabel xml:lang="en">extension error</skos:prefLabel>
    <skos:definition xml:lang="en">An extension invocation fails or violates its expected response contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>extension_error</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ExtensionService">
    <rdfs:label xml:lang="en">extension service</rdfs:label>
    <skos:prefLabel xml:lang="en">extension service</skos:prefLabel>
    <skos:definition xml:lang="en">A separately hosted capability called by the harness through a defined extension API.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FQDN">
    <rdfs:label xml:lang="en">fully qualified domain name</rdfs:label>
    <skos:prefLabel xml:lang="en">fully qualified domain name</skos:prefLabel>
    <skos:definition xml:lang="en">A domain name specifying its complete position in the DNS hierarchy.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc1034" />
    <skos:altLabel xml:lang="en">FQDN</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Failure">
    <rdfs:label xml:lang="en">failure</rdfs:label>
    <skos:prefLabel xml:lang="en">failure</skos:prefLabel>
    <skos:definition xml:lang="en">A condition in which an operation does not establish its required completion or success.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">A failure classification describes available evidence and need not identify a verified cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FailureClassHistogram">
    <rdfs:label xml:lang="en">failure-class histogram</rdfs:label>
    <skos:prefLabel xml:lang="en">failure-class histogram</skos:prefLabel>
    <skos:definition xml:lang="en">A distribution counting failure classifications within a defined event or incident scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">Step-failure histograms and incident histograms count different things.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>classHistogram</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FailureClassification">
    <rdfs:label xml:lang="en">failure classification</rdfs:label>
    <skos:prefLabel xml:lang="en">failure classification</skos:prefLabel>
    <skos:definition xml:lang="en">Assigning a machine-routable failure category from registered metadata, patterns, infrastructure checks, or synthetic records.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FailurePause">
    <rdfs:label xml:lang="en">failure pause</rdfs:label>
    <skos:prefLabel xml:lang="en">failure pause</skos:prefLabel>
    <skos:definition xml:lang="en">A bounded inspection interval after failure in which evidence can be examined before cycling resumes.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FailureRecord">
    <rdfs:label xml:lang="en">failure record</rdfs:label>
    <skos:prefLabel xml:lang="en">failure record</skos:prefLabel>
    <skos:definition xml:lang="en">Structured failure metadata including classification, context, replay boundaries, and suggested recoveries.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">The schema is represented here; real records containing host and occurrence identities are excluded.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hasSeverity" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureSeverity" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IncidentFingerprint" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryRecommendation" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FailureSeverity">
    <rdfs:label xml:lang="en">failure severity</rdfs:label>
    <skos:prefLabel xml:lang="en">failure severity</skos:prefLabel>
    <skos:definition xml:lang="en">The hard, soft, or unknown impact category carried by the canonical failure record contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Event-level advisory and ok values belong to other reporting contracts and are not extra failure severity enum members.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FetchAndExecute">
    <rdfs:label xml:lang="en">fetch and execute</rdfs:label>
    <skos:prefLabel xml:lang="en">fetch and execute</skos:prefLabel>
    <skos:definition xml:lang="en">Retrieving a script payload into a guest and executing it through a sequence transport.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <skos:scopeNote xml:lang="en">Payload fetch failure and script execution failure have different diagnostic ownership.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PayloadUnavailableFailure" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FileDescriptor">
    <rdfs:label xml:lang="en">file descriptor</rdfs:label>
    <skos:prefLabel xml:lang="en">file descriptor</skos:prefLabel>
    <skos:definition xml:lang="en">A process-local handle used to refer to an open file, pipe, socket, terminal, or other I/O resource.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:altLabel xml:lang="en">fd</skos:altLabel>
    <skos:scopeNote xml:lang="en">It is local to a process and can be reused; this ontology contains no actual descriptor values.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FileSystem">
    <rdfs:label xml:lang="en">filesystem</rdfs:label>
    <skos:prefLabel xml:lang="en">filesystem</skos:prefLabel>
    <skos:definition xml:lang="en">An organized storage namespace containing files, directories, permissions, and capacity information.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:altLabel xml:lang="en">file system</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Finding">
    <rdfs:label xml:lang="en">finding</rdfs:label>
    <skos:prefLabel xml:lang="en">finding</skos:prefLabel>
    <skos:definition xml:lang="en">Observed outcomes outside the Configuration: Telemetry minus Configuration; openings the tools observe that the Configuration does not declare, the part of Drift that is seen.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">audit finding</skos:altLabel>
    <skos:scopeNote xml:lang="en">The name follows ISO 19011 audit practice. Not an incident classification: a failed test, an absent namespace, a stale configuration revision, or an invalid runner-state transition does not by itself prove one.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Telemetry" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Drift" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Firewall">
    <rdfs:label xml:lang="en">firewall</rdfs:label>
    <skos:prefLabel xml:lang="en">firewall</skos:prefLabel>
    <skos:definition xml:lang="en">A filtering facility that permits or blocks traffic according to configured rules and connection context.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FirewallRule">
    <rdfs:label xml:lang="en">firewall rule</rdfs:label>
    <skos:prefLabel xml:lang="en">firewall rule</skos:prefLabel>
    <skos:definition xml:lang="en">A traffic policy matching criteria such as direction, protocol, address scope, or port and specifying a filtering action.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Firmware">
    <rdfs:label xml:lang="en">firmware</rdfs:label>
    <skos:prefLabel xml:lang="en">firmware</skos:prefLabel>
    <skos:definition xml:lang="en">Low-level machine software used during startup before the operating system takes control.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ForeignKey">
    <rdfs:label xml:lang="en">foreign key</rdfs:label>
    <skos:prefLabel xml:lang="en">foreign key</skos:prefLabel>
    <skos:definition xml:lang="en">A database constraint connecting referencing columns to a referenced key.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/db/schema.sql" />
    <skos:scopeNote xml:lang="en">The retriever's expansion direction follows outgoing references.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ForwardProxy">
    <rdfs:label xml:lang="en">forward proxy</rdfs:label>
    <skos:prefLabel xml:lang="en">forward proxy</skos:prefLabel>
    <skos:definition xml:lang="en">A proxy selected by a client to reach upstream resources, including package repositories and HTTPS origins.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:altLabel xml:lang="en">HTTP proxy</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Proxy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Forwarder">
    <rdfs:label xml:lang="en">forwarder</rdfs:label>
    <skos:prefLabel xml:lang="en">forwarder</skos:prefLabel>
    <skos:definition xml:lang="en">A relay that accepts a connection and forwards its data to a configured downstream service.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <skos:altLabel xml:lang="en">TCP forwarder</skos:altLabel>
    <skos:scopeNote xml:lang="en">The canonical Yuruna use is the host-side Squid TCP forwarder.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProxyProtocol" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Framebuffer">
    <rdfs:label xml:lang="en">framebuffer</rdfs:label>
    <skos:prefLabel xml:lang="en">framebuffer</skos:prefLabel>
    <skos:definition xml:lang="en">Pixel data representing a display surface that can be captured or transmitted for remote viewing.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc6143.html" />
    <skos:scopeNote xml:lang="en">A frozen frame can be a transport symptom rather than a stopped guest.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#FreeSpace">
    <rdfs:label xml:lang="en">free space</rdfs:label>
    <skos:prefLabel xml:lang="en">free space</skos:prefLabel>
    <skos:definition xml:lang="en">Unused storage capacity visible to a specified filesystem, share, or application.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Local filesystem space does not establish the capacity available on a remote share.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Gateway">
    <rdfs:label xml:lang="en">gateway</rdfs:label>
    <skos:prefLabel xml:lang="en">gateway</skos:prefLabel>
    <skos:definition xml:lang="en">A next-hop forwarding endpoint used to reach destinations beyond a node's directly connected networks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Do not infer that every application gateway has the same role as a default IP gateway.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GaugeMetric">
    <rdfs:label xml:lang="en">gauge metric</rdfs:label>
    <skos:prefLabel xml:lang="en">gauge metric</skos:prefLabel>
    <skos:definition xml:lang="en">A measurement of current state or quantity that can rise or fall.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Metric" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Globalization">
    <rdfs:label xml:lang="en">globalization</rdfs:label>
    <skos:prefLabel xml:lang="en">globalization</skos:prefLabel>
    <skos:definition xml:lang="en">Preparing application text, formatting, and protocols to work across languages and locales.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Grafana">
    <rdfs:label xml:lang="en">Grafana</rdfs:label>
    <skos:prefLabel xml:lang="en">Grafana</skos:prefLabel>
    <skos:definition xml:lang="en">The dashboard and alerting application presenting queried lab metrics and logs.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/alerts.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">Anonymous dashboard viewing does not authorize control actions or alert configuration.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Loki" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Prometheus" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GraphicsConfigurationCheck">
    <rdfs:label xml:lang="en">graphics configuration check</rdfs:label>
    <skos:prefLabel xml:lang="en">graphics configuration check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of the virtual graphics device, display backend, and required rendering-context support.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labstash" />
    <dcterms:source rdf:resource="https://www.qemu.org/docs/master/system/invocation.html" />
    <skos:scopeNote xml:lang="en">A diagnostic suggestion derived from the reported requirement; no guest configuration change or repair was performed.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DisplayBackend" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GraphicsDeviceModel" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GraphicsDeviceModel">
    <rdfs:label xml:lang="en">graphics device model</rdfs:label>
    <skos:prefLabel xml:lang="en">graphics device model</skos:prefLabel>
    <skos:definition xml:lang="en">The virtual graphics hardware model presented to a guest.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.qemu.org/docs/master/system/invocation.html" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">An accelerated device can require rendering support that the selected display path does not provide.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Guest">
    <rdfs:label xml:lang="en">guest</rdfs:label>
    <skos:prefLabel xml:lang="en">guest</skos:prefLabel>
    <skos:definition xml:lang="en">A virtual machine provisioned and driven by a host to execute a test or service workload.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/globalization/terminology/pt-BR.terms.json" />
    <skos:altLabel xml:lang="en">guest VM</skos:altLabel>
    <skos:scopeNote xml:lang="en">Guest describes the hosted role; the same VM can also host nested guests.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VirtualMachine" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hostedBy" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Host" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#managedByHypervisor" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Hypervisor" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#runsOperatingSystem" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestOperatingSystem" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestAddressDiscovery">
    <rdfs:label xml:lang="en">guest address discovery</rdfs:label>
    <skos:prefLabel xml:lang="en">guest address discovery</skos:prefLabel>
    <skos:definition xml:lang="en">Resolution of a guest's current address using provider information, guest agents, leases, or ranked neighbor evidence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Failure to discover an address precedes and differs from failure to connect to a known address.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkDiscovery" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NeighborTable" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPLease" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestHostBinding">
    <rdfs:label xml:lang="en">guest-host binding</rdfs:label>
    <skos:prefLabel xml:lang="en">guest-host binding</skos:prefLabel>
    <skos:definition xml:lang="en">The resolved pairing of a guest network with the host address reachable from that network.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The address and network must be selected together; independently choosing each can create an unusable combination.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestReachableHostAddress" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TopologySelectionPolicy" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestIdentity">
    <rdfs:label xml:lang="en">guest identity</rdfs:label>
    <skos:prefLabel xml:lang="en">guest identity</skos:prefLabel>
    <skos:definition xml:lang="en">The stable logical identity used to associate a guest with its declared name, adapter identity, and retained configuration across rebuilds.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <skos:scopeNote xml:lang="en">A reusable construction slot and the guest's enduring identity are not interchangeable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestIncident">
    <rdfs:label xml:lang="en">guest incident</rdfs:label>
    <skos:prefLabel xml:lang="en">guest incident</skos:prefLabel>
    <skos:definition xml:lang="en">An operational problem recognized as affecting a guest's operation or hosted workload.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:scopeNote xml:lang="en">A workload problem need not mean that the guest operating system is unhealthy. Host and guest incident categories can overlap for nested hosts.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#affects" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Guest" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestOperatingSystem">
    <rdfs:label xml:lang="en">guest operating system</rdfs:label>
    <skos:prefLabel xml:lang="en">guest operating system</skos:prefLabel>
    <skos:definition xml:lang="en">An operating system installed inside a guest VM.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:scopeNote xml:lang="en">Do not treat a guest OS release as the same concept as its installation image.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystem" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestProcessCheck">
    <rdfs:label xml:lang="en">guest process check</rdfs:label>
    <skos:prefLabel xml:lang="en">guest process check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of guest process or command-guard evidence to determine whether intended work started or is still running.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#GuestReachableHostAddress">
    <rdfs:label xml:lang="en">guest-reachable host address</rdfs:label>
    <skos:prefLabel xml:lang="en">guest-reachable host address</skos:prefLabel>
    <skos:definition xml:lang="en">A host address selected for reachability from the guest's chosen virtual network.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The host's LAN address and a NAT gateway address are not interchangeable across guest topologies.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HTTP">
    <rdfs:label xml:lang="en">HTTP</rdfs:label>
    <skos:prefLabel xml:lang="en">HTTP</skos:prefLabel>
    <skos:definition xml:lang="en">The application protocol used for requests and responses between clients, services, proxies, and artifact endpoints.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9110.html" />
    <skos:altLabel xml:lang="en">Hypertext Transfer Protocol</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HTTPCache">
    <rdfs:label xml:lang="en">HTTP cache</rdfs:label>
    <skos:prefLabel xml:lang="en">HTTP cache</skos:prefLabel>
    <skos:definition xml:lang="en">Stored HTTP responses or payloads reused under cache policy and freshness rules.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Cache" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HTTPConnectTunnel">
    <rdfs:label xml:lang="en">CONNECT tunnel</rdfs:label>
    <skos:prefLabel xml:lang="en">CONNECT tunnel</skos:prefLabel>
    <skos:definition xml:lang="en">A byte-forwarding path established through an HTTP proxy by the CONNECT method.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9110.html" />
    <skos:altLabel xml:lang="en">HTTPS tunnel</skos:altLabel>
    <skos:scopeNote xml:lang="en">Successful tunnel establishment does not mean the proxy decrypted or cached the subsequent HTTPS body.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProxyTunnelCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TLSInterception" />
    <y:codeToken>CONNECT</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HTTPRangeRequest">
    <rdfs:label xml:lang="en">range request</rdfs:label>
    <skos:prefLabel xml:lang="en">range request</skos:prefLabel>
    <skos:definition xml:lang="en">An HTTP request for selected byte ranges of a representation, used by resumable artifact downloads.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9110.html" />
    <skos:altLabel xml:lang="en">HTTP Range request</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HTTPS">
    <rdfs:label xml:lang="en">HTTPS</rdfs:label>
    <skos:prefLabel xml:lang="en">HTTPS</skos:prefLabel>
    <skos:definition xml:lang="en">HTTP communication protected by TLS, including server authentication under the client's trust policy.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9110.html" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HardFailureSeverity">
    <rdfs:label xml:lang="en">hard failure severity</rdfs:label>
    <skos:prefLabel xml:lang="en">hard failure severity</skos:prefLabel>
    <skos:definition xml:lang="en">The hard severity designation assigned by the failure classification contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureSeverity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>hard</y:codeToken>
    <y:codeVocabulary>failureSeverity</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HeadingAnchor">
    <rdfs:label xml:lang="en">heading anchor</rdfs:label>
    <skos:prefLabel xml:lang="en">heading anchor</skos:prefLabel>
    <skos:definition xml:lang="en">A document-local address for a section, either an explicit stable ID or a heading-derived fragment.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <skos:scopeNote xml:lang="en">Changing heading text can change a generated fragment while explicit IDs remain stable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HealthProbe">
    <rdfs:label xml:lang="en">health probe</rdfs:label>
    <skos:prefLabel xml:lang="en">health probe</skos:prefLabel>
    <skos:definition xml:lang="en">A bounded check of whether an endpoint or process exhibits a required health condition.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <skos:scopeNote xml:lang="en">A successful probe supports only the property it actually tests.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Heartbeat">
    <rdfs:label xml:lang="en">heartbeat</rdfs:label>
    <skos:prefLabel xml:lang="en">heartbeat</skos:prefLabel>
    <skos:definition xml:lang="en">A periodic liveness signal used to judge whether a runner or service is still reporting.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">A missing heartbeat can reflect lost reporting connectivity rather than a stopped process.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HelmChart">
    <rdfs:label xml:lang="en">Helm chart</rdfs:label>
    <skos:prefLabel xml:lang="en">Helm chart</skos:prefLabel>
    <skos:definition xml:lang="en">A package of Kubernetes templates and default values consumed by Helm to deploy a workload.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Workload.ps1" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HelmRelease">
    <rdfs:label xml:lang="en">Helm release</rdfs:label>
    <skos:prefLabel xml:lang="en">Helm release</skos:prefLabel>
    <skos:definition xml:lang="en">An installation of a Helm chart with a release identity and configured values.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Workload.ps1" />
    <skos:scopeNote xml:lang="en">Different from a source repository release or an image generation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HelmValues">
    <rdfs:label xml:lang="en">Helm values</rdfs:label>
    <skos:prefLabel xml:lang="en">Helm values</skos:prefLabel>
    <skos:definition xml:lang="en">Values supplied to a chart to render its Kubernetes manifests for a deployment.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Workload.ps1" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HistoryBackfill">
    <rdfs:label xml:lang="en">history backfill</rdfs:label>
    <skos:prefLabel xml:lang="en">history backfill</skos:prefLabel>
    <skos:definition xml:lang="en">Reconstructing retained cycle and event history from readable host or committed archive evidence after collector history is missing.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">Does not reconstruct missing evidence, historical memory measurements, or every pool-wide incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CycleArchive" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#EventRecord" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Host">
    <rdfs:label xml:lang="en">host</rdfs:label>
    <skos:prefLabel xml:lang="en">host</skos:prefLabel>
    <skos:definition xml:lang="en">A computing node that runs Yuruna host automation and provisions or drives guest machines and host-side services.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/nested.host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/globalization/terminology/pt-BR.terms.json" />
    <skos:altLabel xml:lang="en">Yuruna host</skos:altLabel>
    <skos:scopeNote xml:lang="en">The nested-host example allows a VM to act as a host. The existing translation glossary's physical-machine wording is narrower than this implemented use.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ComputingNode" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#runsOperatingSystem" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostOperatingSystem" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIncident" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostAddressRenumbering">
    <rdfs:label xml:lang="en">host address renumbering</rdfs:label>
    <skos:prefLabel xml:lang="en">host address renumbering</skos:prefLabel>
    <skos:definition xml:lang="en">A host's reachable address changes while consumers may still hold an earlier base URL.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Stable host identity supports rediscovery; it does not make an old network address valid.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIdentity" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostAnnouncement">
    <rdfs:label xml:lang="en">host announcement</rdfs:label>
    <skos:prefLabel xml:lang="en">host announcement</skos:prefLabel>
    <skos:definition xml:lang="en">A report advertising a host's identity, addresses, and service availability for discovery.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#BaseURL" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostCondition">
    <rdfs:label xml:lang="en">host condition</rdfs:label>
    <skos:prefLabel xml:lang="en">host condition</skos:prefLabel>
    <skos:definition xml:lang="en">A predicate evaluated against host capabilities or properties when deciding whether a test operation applies.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostIOBlockedFailure">
    <rdfs:label xml:lang="en">host I/O blocked</rdfs:label>
    <skos:prefLabel xml:lang="en">host I/O blocked</skos:prefLabel>
    <skos:definition xml:lang="en">The host's guest input or display transport cannot perform the requested interaction.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <skos:scopeNote xml:lang="en">May require transport repair rather than guest script replay.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CaptureHealthCheck" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ReconnectRecommendation" />
    <y:codeToken>host_io_blocked</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostIOProvider">
    <rdfs:label xml:lang="en">host I/O provider</rdfs:label>
    <skos:prefLabel xml:lang="en">host I/O provider</skos:prefLabel>
    <skos:definition xml:lang="en">A registered backend that translates a guest-input operation into the current host platform's mechanism.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <skos:scopeNote xml:lang="en">The SSH driver is a separate transport path rather than a GUI provider backend.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConsoleInput" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostIdentity">
    <rdfs:label xml:lang="en">host identity</rdfs:label>
    <skos:prefLabel xml:lang="en">host identity</skos:prefLabel>
    <skos:definition xml:lang="en">The stable logical identity by which pool coordination and storage recognize a host across addresses and supported reimage reclaim.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:altLabel xml:lang="en">host ID</skos:altLabel>
    <skos:scopeNote xml:lang="en">The ontology defines this kind of identifier without containing any real host identifiers.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>hostId</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostIncident">
    <rdfs:label xml:lang="en">host incident</rdfs:label>
    <skos:prefLabel xml:lang="en">host incident</skos:prefLabel>
    <skos:definition xml:lang="en">An operational problem recognized as affecting a host's operation or service role.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">The cause can lie in a shared dependency or guest; this class does not blame host hardware or assert that every host has an incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#affects" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Host" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecurringHostIncident" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostNetworkDegradedFailure">
    <rdfs:label xml:lang="en">host network degraded</rdfs:label>
    <skos:prefLabel xml:lang="en">host network degraded</skos:prefLabel>
    <skos:definition xml:lang="en">A host bridge, uplink, or related network prerequisite is unhealthy enough to block guest operations.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Guest retries cannot repair a broken host uplink.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIncident" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StaleUplinkBinding" />
    <y:codeToken>host_network_degraded</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostOperatingSystem">
    <rdfs:label xml:lang="en">host operating system</rdfs:label>
    <skos:prefLabel xml:lang="en">host operating system</skos:prefLabel>
    <skos:definition xml:lang="en">An operating system on a computing node acting as a Yuruna host.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystem" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostPool">
    <rdfs:label xml:lang="en">host pool</rdfs:label>
    <skos:prefLabel xml:lang="en">host pool</skos:prefLabel>
    <skos:definition xml:lang="en">A named group of test hosts sharing administrative intent and a reporting label.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:altLabel xml:lang="en">pool</skos:altLabel>
    <skos:scopeNote xml:lang="en">Members execute their own complete plans; this is not a central work queue or a DHCP address pool.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PoolIntent" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HostPresence">
    <rdfs:label xml:lang="en">host presence</rdfs:label>
    <skos:prefLabel xml:lang="en">host presence</skos:prefLabel>
    <skos:definition xml:lang="en">The observed availability of a host's reports within a freshness interval.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">Presence is evidence of reporting, not a guarantee that every guest or extension works.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Hostname">
    <rdfs:label xml:lang="en">hostname</rdfs:label>
    <skos:prefLabel xml:lang="en">hostname</skos:prefLabel>
    <skos:definition xml:lang="en">A human-readable name assigned to a computing node for naming and operational use.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">host name</skos:altLabel>
    <skos:scopeNote xml:lang="en">A hostname is not proof of stable machine identity or current address ownership.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HyperV">
    <rdfs:label xml:lang="en">Hyper-V</rdfs:label>
    <skos:prefLabel xml:lang="en">Hyper-V</skos:prefLabel>
    <skos:definition xml:lang="en">Microsoft's hypervisor and VM-management platform used by the Windows host provider.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <skos:scopeNote xml:lang="en">Keep the product name distinct from the host OS.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Hypervisor" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HyperVDefaultSwitch">
    <rdfs:label xml:lang="en">Hyper-V Default Switch</rdfs:label>
    <skos:prefLabel xml:lang="en">Hyper-V Default Switch</skos:prefLabel>
    <skos:definition xml:lang="en">The Hyper-V-managed switch supplying a NAT and DHCP path used when external bridging is not selected.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">Default Switch</skos:altLabel>
    <skos:scopeNote xml:lang="en">Its managed addressing is not a promise of a fixed host or guest address.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VirtualSwitch" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NATNetwork" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HyperVExternalSwitch">
    <rdfs:label xml:lang="en">Hyper-V external switch</rdfs:label>
    <skos:prefLabel xml:lang="en">Hyper-V external switch</skos:prefLabel>
    <skos:definition xml:lang="en">A switch configured to bridge guest traffic through a physical host uplink.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">External vSwitch</skos:altLabel>
    <skos:scopeNote xml:lang="en">The persisted switch object's existence does not establish that the adapter binding or management host leg still forwards traffic.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VirtualSwitch" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#BridgedNetworking" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#HyperVManagementAdapter">
    <rdfs:label xml:lang="en">Hyper-V management adapter</rdfs:label>
    <skos:prefLabel xml:lang="en">Hyper-V management adapter</skos:prefLabel>
    <skos:definition xml:lang="en">The host operating system's virtual adapter associated with a Hyper-V switch.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Its MAC can be shared with the physical adapter or another management adapter. Alias and switch context are needed to avoid attributing the bare adapter's address to a broken virtual host leg.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkAdapter" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VirtualNetworkInterface" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InterfaceAlias" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MACAddress" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Hypervisor">
    <rdfs:label xml:lang="en">hypervisor</rdfs:label>
    <skos:prefLabel xml:lang="en">hypervisor</skos:prefLabel>
    <skos:definition xml:lang="en">A virtualization layer that creates, runs, and controls virtual machines and their virtual devices.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">virtual machine monitor</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ICMP">
    <rdfs:label xml:lang="en">ICMP</rdfs:label>
    <skos:prefLabel xml:lang="en">ICMP</skos:prefLabel>
    <skos:definition xml:lang="en">A protocol used for IP control and diagnostic messages, including echo and error reporting.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">Internet Control Message Protocol</skos:altLabel>
    <skos:scopeNote xml:lang="en">Failure to receive an echo reply alone does not establish that an application service is unreachable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IPAddress">
    <rdfs:label xml:lang="en">IP address</rdfs:label>
    <skos:prefLabel xml:lang="en">IP address</skos:prefLabel>
    <skos:definition xml:lang="en">An address used by the Internet Protocol to identify an interface or endpoint within an address family and routing scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">An address can change without changing the logical identity of a host.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IPNotDiscoveredFailure">
    <rdfs:label xml:lang="en">IP address not discovered</rdfs:label>
    <skos:prefLabel xml:lang="en">IP address not discovered</skos:prefLabel>
    <skos:definition xml:lang="en">A required guest address cannot be discovered before attempting the guest transport.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The target script has not run; lack of an address is not proof of DHCP pool exhaustion.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AddressDiscoveryCheck" />
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPLeaseCheck" />
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostNetworkDegradedFailure" />
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPIdentityUnboundedFailure" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PauseAndInspectRecommendation" />
    <y:possibleCause rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DHCPPoolExhaustion" />
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PacketCapture" />
    <y:codeToken>ip_not_discovered</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IPv4Address">
    <rdfs:label xml:lang="en">IPv4 address</rdfs:label>
    <skos:prefLabel xml:lang="en">IPv4 address</skos:prefLabel>
    <skos:definition xml:lang="en">An address in the 32-bit IPv4 address family.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">IPv6 connectivity does not prove that an IPv4 lease has been acquired.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IPv4LinkLocalAddress">
    <rdfs:label xml:lang="en">IPv4 link-local address</rdfs:label>
    <skos:prefLabel xml:lang="en">IPv4 link-local address</skos:prefLabel>
    <skos:definition xml:lang="en">An IPv4 address scoped to its directly attached link rather than the routed service network.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A management adapter with only this address type does not establish that the intended DHCP and uplink path is healthy.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPv4Address" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#LinkLocalAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IPv6Address">
    <rdfs:label xml:lang="en">IPv6 address</rdfs:label>
    <skos:prefLabel xml:lang="en">IPv6 address</skos:prefLabel>
    <skos:definition xml:lang="en">An address in the 128-bit IPv6 address family.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ISOImage">
    <rdfs:label xml:lang="en">ISO image</rdfs:label>
    <skos:prefLabel xml:lang="en">ISO image</skos:prefLabel>
    <skos:definition xml:lang="en">An optical-disc image used as guest installation or bootstrap media.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">ISO</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InstallationImage" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IdempotentOperation">
    <rdfs:label xml:lang="en">idempotent operation</rdfs:label>
    <skos:prefLabel xml:lang="en">idempotent operation</skos:prefLabel>
    <skos:definition xml:lang="en">An operation whose permitted repeated application preserves its specified externally relevant effect.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <skos:scopeNote xml:lang="en">Idempotence is contract-specific and must not be inferred merely from having retry code.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Identifier">
    <rdfs:label xml:lang="en">identifier</rdfs:label>
    <skos:prefLabel xml:lang="en">identifier</skos:prefLabel>
    <skos:definition xml:lang="en">A value used to distinguish a logical object, code, or contract element within an explicit scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:altLabel xml:lang="en">ID</skos:altLabel>
    <skos:scopeNote xml:lang="en">Identifiers used by protocols or code are preserved verbatim during translation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ImageArchitectureMismatch">
    <rdfs:label xml:lang="en">image architecture mismatch</rdfs:label>
    <skos:prefLabel xml:lang="en">image architecture mismatch</skos:prefLabel>
    <skos:definition xml:lang="en">An image or executable architecture is incompatible with the selected machine or virtualization path.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">Architecture must be detected independently from whether a machine is virtualized.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProvisioningFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ArchitectureCompatibility" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ImageBuild">
    <rdfs:label xml:lang="en">image build</rdfs:label>
    <skos:prefLabel xml:lang="en">image build</skos:prefLabel>
    <skos:definition xml:lang="en">Construction of a container image from component source and build instructions.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Component.ps1" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ImageResolver">
    <rdfs:label xml:lang="en">image resolver</rdfs:label>
    <skos:prefLabel xml:lang="en">image resolver</skos:prefLabel>
    <skos:definition xml:lang="en">Determination of the publisher artifact and verification metadata for an image request.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">A resolver refusal is not the same as corruption of an already downloaded image.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ImageTag">
    <rdfs:label xml:lang="en">image tag</rdfs:label>
    <skos:prefLabel xml:lang="en">image tag</skos:prefLabel>
    <skos:definition xml:lang="en">A registry name that refers to an image manifest and may move to a different manifest.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Component.ps1" />
    <skos:scopeNote xml:lang="en">A digest is preferable when immutable content identity is required.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ImageVariant">
    <rdfs:label xml:lang="en">image variant</rdfs:label>
    <skos:prefLabel xml:lang="en">image variant</skos:prefLabel>
    <skos:definition xml:lang="en">A requested image preference, such as stable or daily, used as part of the download-pool identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">Two variants can temporarily resolve to identical artifact bytes while retaining separate pointers.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Implementation">
    <rdfs:label xml:lang="en">implementation</rdfs:label>
    <skos:prefLabel xml:lang="en">implementation</skos:prefLabel>
    <skos:definition xml:lang="en">What the running system actually does: running hosts, guests, services, and their effective behavior; the Implementation view of a system.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">running implementation</skos:altLabel>
    <skos:altLabel xml:lang="en">operational state</skos:altLabel>
    <skos:scopeNote xml:lang="en">Say running implementation when implementation could mean source code; source code and an SBOM alone do not establish this view. The nearest earlier ontology concept is state. An earlier draft of the article called this view Runtime; container runtime keeps its established name.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentView" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Incident">
    <rdfs:label xml:lang="en">incident</rdfs:label>
    <skos:prefLabel xml:lang="en">incident</skos:prefLabel>
    <skos:definition xml:lang="en">An operational problem recognized as requiring diagnosis, recovery, or operator attention.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">This is a category of occurrences; no actual host, occurrence, or timestamp is instantiated.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecurringIncident" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IncidentDetectionPolicy">
    <rdfs:label xml:lang="en">incident detection policy</rdfs:label>
    <skos:prefLabel xml:lang="en">incident detection policy</skos:prefLabel>
    <skos:definition xml:lang="en">The threshold and trailing window used by the pool aggregator to recognize repeated failed cycles as an incident.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">The documented default is three failed cycles in two hours; this is a configurable detector policy, not the definition of every operational incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IncidentFingerprint">
    <rdfs:label xml:lang="en">incident fingerprint</rdfs:label>
    <skos:prefLabel xml:lang="en">incident fingerprint</skos:prefLabel>
    <skos:definition xml:lang="en">A normalized grouping key derived from failure characteristics such as class, stage, sequence, and action.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Do not include actual timestamps or host identities in this ontology; grouping does not establish causation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact">
    <rdfs:label xml:lang="en">information artifact</rdfs:label>
    <skos:prefLabel xml:lang="en">information artifact</skos:prefLabel>
    <skos:definition xml:lang="en">Recorded information with a role in configuration, execution, communication, or evidence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://www.w3.org/TR/owl2-primer/" />
    <skos:scopeNote xml:lang="en">A modeling category used to distinguish information from the resource it describes.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Entity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureAsCode">
    <rdfs:label xml:lang="en">infrastructure as code</rdfs:label>
    <skos:prefLabel xml:lang="en">infrastructure as code</skos:prefLabel>
    <skos:definition xml:lang="en">A machine-readable infrastructure description used to create and reconcile resources.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <skos:altLabel xml:lang="en">IaC</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure">
    <rdfs:label xml:lang="en">infrastructure failure</rdfs:label>
    <skos:prefLabel xml:lang="en">infrastructure failure</skos:prefLabel>
    <skos:definition xml:lang="en">A failure in host, provisioning, planning, storage, or other prerequisites outside an ordinary guest sequence action.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Ingress">
    <rdfs:label xml:lang="en">ingress</rdfs:label>
    <skos:prefLabel xml:lang="en">ingress</skos:prefLabel>
    <skos:definition xml:lang="en">Traffic entering a defined network or execution boundary.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Distinct from the Kubernetes Ingress resource and from AmisAd environment ingress evidence.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InnerLoop">
    <rdfs:label xml:lang="en">inner loop</rdfs:label>
    <skos:prefLabel xml:lang="en">inner loop</skos:prefLabel>
    <skos:definition xml:lang="en">The cycle execution process that performs the resolved sequences and records their steps and outcomes.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InputLostFailure">
    <rdfs:label xml:lang="en">input lost</rdfs:label>
    <skos:prefLabel xml:lang="en">input lost</skos:prefLabel>
    <skos:definition xml:lang="en">Guest evidence shows that input reported as sent did not start the expected command guard or process.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <skos:scopeNote xml:lang="en">Eligible replay depends on proof that the intended work never started.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestProcessCheck" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RetryImmediatelyRecommendation" />
    <y:codeToken>input_lost</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InstallationImage">
    <rdfs:label xml:lang="en">installation image</rdfs:label>
    <skos:prefLabel xml:lang="en">installation image</skos:prefLabel>
    <skos:definition xml:lang="en">Bootable or importable OS media used to initialize a guest, such as an ISO or cloud image.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:altLabel xml:lang="en">guest image</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InstrumentationFailure">
    <rdfs:label xml:lang="en">instrumentation failure</rdfs:label>
    <skos:prefLabel xml:lang="en">instrumentation failure</skos:prefLabel>
    <skos:definition xml:lang="en">The mechanism intended to measure or record execution fails to produce reliable evidence.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Do not infer the observed workload failed merely because its instrumentation failed.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemDiagnostic" />
    <y:codeToken>instrumentation_failure</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#IntegrityManifest">
    <rdfs:label xml:lang="en">integrity manifest</rdfs:label>
    <skos:prefLabel xml:lang="en">integrity manifest</skos:prefLabel>
    <skos:definition xml:lang="en">Expected artifact identities and digests used to check that fetched content belongs to the intended source or release.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/dev-only/release.md" />
    <skos:scopeNote xml:lang="en">A correct digest comparison requires the manifest and payload to describe the same revision.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ArtifactManifest" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SourceRevision" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InterfaceAlias">
    <rdfs:label xml:lang="en">interface alias</rdfs:label>
    <skos:prefLabel xml:lang="en">interface alias</skos:prefLabel>
    <skos:definition xml:lang="en">The operating system's human-readable name for an interface.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">An alias can be renamed or disambiguated; it is not a permanent machine identity or a universally unique MAC binding.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InterfaceMetric">
    <rdfs:label xml:lang="en">interface metric</rdfs:label>
    <skos:prefLabel xml:lang="en">interface metric</skos:prefLabel>
    <skos:definition xml:lang="en">An interface preference value that can contribute to route selection on the host.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Keep the interface metric distinct from a route's own metric and from measured link latency.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InternalServiceKey">
    <rdfs:label xml:lang="en">internal authentication key</rdfs:label>
    <skos:prefLabel xml:lang="en">internal authentication key</skos:prefLabel>
    <skos:definition xml:lang="en">Stable authentication material used by internal lab service-to-service requests.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <skos:altLabel xml:lang="en">internal service key</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinct from the rotating operator Lab token.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Secret" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Authentication" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#InvalidPlanFailure">
    <rdfs:label xml:lang="en">invalid plan</rdfs:label>
    <skos:prefLabel xml:lang="en">invalid plan</skos:prefLabel>
    <skos:definition xml:lang="en">The resolved test plan fails validation of actions, prerequisites, or capability support.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:scopeNote xml:lang="en">Retrying the same uncorrected plan does not supply a missing capability.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CapabilityMatrix" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
    <y:codeToken>plan_invalid</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#JSONWebToken">
    <rdfs:label xml:lang="en">JSON Web Token</rdfs:label>
    <skos:prefLabel xml:lang="en">JSON Web Token</skos:prefLabel>
    <skos:definition xml:lang="en">A compact representation of claims used in signing and encryption profiles.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc7519.html" />
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labregistrylogs" />
    <skos:altLabel xml:lang="en">JWT</skos:altLabel>
    <skos:scopeNote xml:lang="en">The format name does not establish that a signature was verified or that the claims are encrypted.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#BearerToken" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KVM">
    <rdfs:label xml:lang="en">KVM</rdfs:label>
    <skos:prefLabel xml:lang="en">KVM</skos:prefLabel>
    <skos:definition xml:lang="en">Linux kernel virtualization used with QEMU and libvirt by the Ubuntu host provider.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <skos:altLabel xml:lang="en">Kernel-based Virtual Machine</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Hypervisor" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Keystroke">
    <rdfs:label xml:lang="en">keystroke</rdfs:label>
    <skos:prefLabel xml:lang="en">keystroke</skos:prefLabel>
    <skos:definition xml:lang="en">A key or key chord represented for delivery to a guest's console input mechanism.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <skos:scopeNote xml:lang="en">Delivery success is not proof that a guest command started.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Kubeconfig">
    <rdfs:label xml:lang="en">kubeconfig</rdfs:label>
    <skos:prefLabel xml:lang="en">kubeconfig</skos:prefLabel>
    <skos:definition xml:lang="en">Client configuration selecting Kubernetes API endpoints, credentials, and contexts.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesCluster">
    <rdfs:label xml:lang="en">Kubernetes cluster</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes cluster</skos:prefLabel>
    <skos:definition xml:lang="en">A control plane and worker execution environment that manages Kubernetes API objects and workloads.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#KubernetesNode" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesConfigMap">
    <rdfs:label xml:lang="en">Kubernetes ConfigMap</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes ConfigMap</skos:prefLabel>
    <skos:definition xml:lang="en">A Kubernetes object providing non-secret configuration to workloads.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesContext">
    <rdfs:label xml:lang="en">Kubernetes context</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes context</skos:prefLabel>
    <skos:definition xml:lang="en">A kubeconfig selection combining a cluster, user credentials, and an optional namespace.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesDeployment">
    <rdfs:label xml:lang="en">Kubernetes Deployment</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes Deployment</skos:prefLabel>
    <skos:definition xml:lang="en">A Kubernetes workload controller describing desired replicated pods and their update behavior.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/website/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesIngress">
    <rdfs:label xml:lang="en">Kubernetes Ingress</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes Ingress</skos:prefLabel>
    <skos:definition xml:lang="en">Rules exposing HTTP routes from outside a cluster to services through an ingress controller.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/website/README.md" />
    <skos:scopeNote xml:lang="en">The resource requires an implementing controller; the definition alone does not provide traffic handling.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#KubernetesService" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesNamespace">
    <rdfs:label xml:lang="en">Kubernetes namespace</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes namespace</skos:prefLabel>
    <skos:definition xml:lang="en">A scope for names of namespaced Kubernetes resources within a cluster.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <skos:scopeNote xml:lang="en">Not a DNS namespace or an ontology namespace.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesNode">
    <rdfs:label xml:lang="en">Kubernetes node</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes node</skos:prefLabel>
    <skos:definition xml:lang="en">A machine registered with a Kubernetes cluster to run pods and node services.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <skos:scopeNote xml:lang="en">Not synonymous with a Yuruna host; a guest may run a Kubernetes node.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ComputingNode" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesPod">
    <rdfs:label xml:lang="en">pod</rdfs:label>
    <skos:prefLabel xml:lang="en">pod</skos:prefLabel>
    <skos:definition xml:lang="en">Kubernetes' scheduling unit containing one or more closely related containers with shared networking and storage context.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://kubernetes.io/docs/concepts/workloads/pods/" />
    <skos:scopeNote xml:lang="en">A pod can contain multiple containers; a component need not map one-to-one to a pod.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hasPart" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Container" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesSecret">
    <rdfs:label xml:lang="en">Kubernetes Secret</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes Secret</skos:prefLabel>
    <skos:definition xml:lang="en">A Kubernetes object used to deliver sensitive configuration such as credentials or TLS material to workloads.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/website/README.md" />
    <skos:scopeNote xml:lang="en">Its name does not establish that the backing datastore encrypts it at rest.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#KubernetesService">
    <rdfs:label xml:lang="en">Kubernetes Service</rdfs:label>
    <skos:prefLabel xml:lang="en">Kubernetes Service</skos:prefLabel>
    <skos:definition xml:lang="en">A Kubernetes API object exposing a set of endpoints through a stable service abstraction.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://kubernetes.io/docs/concepts/services-networking/service/" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <skos:scopeNote xml:lang="en">The capitalized API kind is distinct from the general idea of a running software service.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#KubernetesPod" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LabDependencyDownFailure">
    <rdfs:label xml:lang="en">lab dependency down</rdfs:label>
    <skos:prefLabel xml:lang="en">lab dependency down</skos:prefLabel>
    <skos:definition xml:lang="en">A required lab service remains unavailable after the bounded dependency-health waiting policy.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">This classification follows sustained dependency failure, not a single failed probe.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TCPReachabilityCheck" />
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
    <y:codeToken>lab_dependency_down</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LabToken">
    <rdfs:label xml:lang="en">lab token</rdfs:label>
    <skos:prefLabel xml:lang="en">lab token</skos:prefLabel>
    <skos:definition xml:lang="en">The operator-facing rotating credential used to unlock protected lab controls.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">Not the stable internal service key, a language-model token, or a permanent host identity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Secret" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Authorization" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LanguageFallback">
    <rdfs:label xml:lang="en">language fallback</rdfs:label>
    <skos:prefLabel xml:lang="en">language fallback</skos:prefLabel>
    <skos:definition xml:lang="en">Rules selecting a supported language when the requested locale or translation is unavailable.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LanguageModelClient">
    <rdfs:label xml:lang="en">language-model client</rdfs:label>
    <skos:prefLabel xml:lang="en">language-model client</skos:prefLabel>
    <skos:definition xml:lang="en">The interface and implementation used to request structured SQL decisions from a selected model backend.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LanguageModelToken">
    <rdfs:label xml:lang="en">language-model token</rdfs:label>
    <skos:prefLabel xml:lang="en">language-model token</skos:prefLabel>
    <skos:definition xml:lang="en">A unit of text representation or generation counted by a language-model interface.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">Distinct from the Lab token, an API credential, or a protected translation token.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Latency">
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <skos:prefLabel xml:lang="en">latency</skos:prefLabel>
    <skos:definition xml:lang="en">Elapsed time for a communication or operation whose start, completion, and measurement scope are defined.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <skos:scopeNote xml:lang="en">Do not conflate a latency measurement with a timeout budget.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LatencyPercentile">
    <rdfs:label xml:lang="en">latency percentile</rdfs:label>
    <skos:prefLabel xml:lang="en">latency percentile</skos:prefLabel>
    <skos:definition xml:lang="en">A latency value below which a stated fraction of measured operations falls.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labservices" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <skos:scopeNote xml:lang="en">Percentiles depend on the measurement population and interval; a percentile is not a maximum.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Latency" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LeaseRelease">
    <rdfs:label xml:lang="en">lease release</rdfs:label>
    <skos:prefLabel xml:lang="en">lease release</skos:prefLabel>
    <skos:definition xml:lang="en">A client operation that relinquishes a DHCP address assignment when the network context allows it.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">DHCP release</skos:altLabel>
    <skos:scopeNote xml:lang="en">Teardown release is best-effort and does not replace stable identity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LeaseRenewal">
    <rdfs:label xml:lang="en">lease renewal</rdfs:label>
    <skos:prefLabel xml:lang="en">lease renewal</skos:prefLabel>
    <skos:definition xml:lang="en">A DHCP client operation that seeks to extend an existing address assignment.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Libvirt">
    <rdfs:label xml:lang="en">libvirt</rdfs:label>
    <skos:prefLabel xml:lang="en">libvirt</skos:prefLabel>
    <skos:definition xml:lang="en">A virtualization management layer used to inspect and control KVM domains, storage, and virtual networks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">libvirt management layer</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Link">
    <rdfs:label xml:lang="en">link</rdfs:label>
    <skos:prefLabel xml:lang="en">link</skos:prefLabel>
    <skos:definition xml:lang="en">A connection between interfaces over which link-layer frames can be exchanged.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Distinct from a documentation hyperlink.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LinkAlias">
    <rdfs:label xml:lang="en">link alias</rdfs:label>
    <skos:prefLabel xml:lang="en">link alias</skos:prefLabel>
    <skos:definition xml:lang="en">An additional key resolving through the same short-link catalog row.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LinkLocalAddress">
    <rdfs:label xml:lang="en">link-local address</rdfs:label>
    <skos:prefLabel xml:lang="en">link-local address</skos:prefLabel>
    <skos:definition xml:lang="en">An address usable within its local link scope and not as a generally routed destination.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A link-local address alone does not establish access to the configured service network.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LinkState">
    <rdfs:label xml:lang="en">link state</rdfs:label>
    <skos:prefLabel xml:lang="en">link state</skos:prefLabel>
    <skos:definition xml:lang="en">The operational condition of an interface or its carrier, which can differ from whether it is administratively enabled.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">carrier state</skos:altLabel>
    <skos:scopeNote xml:lang="en">An interface marked up is not sufficient evidence of forwarding or end-to-end connectivity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LinuxOperatingSystem">
    <rdfs:label xml:lang="en">Linux</rdfs:label>
    <skos:prefLabel xml:lang="en">Linux</skos:prefLabel>
    <skos:definition xml:lang="en">The operating-system family built around the Linux kernel and used by several host and guest distributions.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystem" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Listener">
    <rdfs:label xml:lang="en">listener</rdfs:label>
    <skos:prefLabel xml:lang="en">listener</skos:prefLabel>
    <skos:definition xml:lang="en">A server-side endpoint waiting to accept requests or connections on a configured address and port.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">A listening socket is not proof that the application behind it is ready.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LivenessProbe">
    <rdfs:label xml:lang="en">liveness probe</rdfs:label>
    <skos:prefLabel xml:lang="en">liveness probe</skos:prefLabel>
    <skos:definition xml:lang="en">A check used to detect an application that should be restarted because it is no longer functioning.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HealthProbe" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LocalDeploymentTarget">
    <rdfs:label xml:lang="en">local deployment target</rdfs:label>
    <skos:prefLabel xml:lang="en">local deployment target</skos:prefLabel>
    <skos:definition xml:lang="en">A target using the operator's local container and Kubernetes environment.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DeploymentTarget" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LocalFirstImagePull">
    <rdfs:label xml:lang="en">local-first image pull</rdfs:label>
    <skos:prefLabel xml:lang="en">local-first image pull</skos:prefLabel>
    <skos:definition xml:lang="en">Image resolution that prefers an available local image or configured mirror before an allowed upstream path.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">Local-first and no-upstream are different policies.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LocalStorage">
    <rdfs:label xml:lang="en">local storage</rdfs:label>
    <skos:prefLabel xml:lang="en">local storage</skos:prefLabel>
    <skos:definition xml:lang="en">Storage attached to or managed locally by a host or guest.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Local host storage is treated as replaceable in the durable-replication design.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Locale">
    <rdfs:label xml:lang="en">locale</rdfs:label>
    <skos:prefLabel xml:lang="en">locale</skos:prefLabel>
    <skos:definition xml:lang="en">A language and optional regional selection used to choose localized text and formatting.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">A language preference is not necessarily the operating system's locale.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LocaleNegotiation">
    <rdfs:label xml:lang="en">locale negotiation</rdfs:label>
    <skos:prefLabel xml:lang="en">locale negotiation</skos:prefLabel>
    <skos:definition xml:lang="en">Choosing a supported locale from explicit settings, request preferences, and documented fallbacks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Precedence is product- and interface-specific; do not assume one universal negotiation order.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#selectsLocale" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Locale" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#LanguageFallback" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LocaleRedirect">
    <rdfs:label xml:lang="en">locale redirect</rdfs:label>
    <skos:prefLabel xml:lang="en">locale redirect</skos:prefLabel>
    <skos:definition xml:lang="en">Selecting a localized target for a short link while preserving its document or section identity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#LocaleNegotiation" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Localization">
    <rdfs:label xml:lang="en">localization</rdfs:label>
    <skos:prefLabel xml:lang="en">localization</skos:prefLabel>
    <skos:definition xml:lang="en">Adapting supported user-facing content and presentation for a selected locale.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Protocol keys and diagnostic classification codes remain stable across translations.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LogLevel">
    <rdfs:label xml:lang="en">log level</rdfs:label>
    <skos:prefLabel xml:lang="en">log level</skos:prefLabel>
    <skos:definition xml:lang="en">The configured priority threshold controlling visible and inherited logging streams.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/loglevels.md" />
    <skos:scopeNote xml:lang="en">Different from failure severity and the final cycle outcome.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureSeverity" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LogRotation">
    <rdfs:label xml:lang="en">log rotation</rdfs:label>
    <skos:prefLabel xml:lang="en">log rotation</skos:prefLabel>
    <skos:definition xml:lang="en">Reorganizing or retiring logs under a retention policy while preserving required identities and evidence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LogStream">
    <rdfs:label xml:lang="en">log stream</rdfs:label>
    <skos:prefLabel xml:lang="en">log stream</skos:prefLabel>
    <skos:definition xml:lang="en">An ordered flow of log entries sharing a source or label context.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Loki">
    <rdfs:label xml:lang="en">Loki</rdfs:label>
    <skos:prefLabel xml:lang="en">Loki</skos:prefLabel>
    <skos:definition xml:lang="en">The log storage and query service used for pool events and proxy logs.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#LoopbackInterface">
    <rdfs:label xml:lang="en">loopback interface</rdfs:label>
    <skos:prefLabel xml:lang="en">loopback interface</skos:prefLabel>
    <skos:definition xml:lang="en">An interface used for communication within the same network stack rather than transmission onto a physical link.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">loopback</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkInterface" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MACAddress">
    <rdfs:label xml:lang="en">MAC address</rdfs:label>
    <skos:prefLabel xml:lang="en">MAC address</skos:prefLabel>
    <skos:definition xml:lang="en">A link-layer address associated with a network adapter and used in guest identity and discovery.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">media access control address</skos:altLabel>
    <skos:scopeNote xml:lang="en">It is distinct from an IP address and from an OS machine identifier.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MTU">
    <rdfs:label xml:lang="en">MTU</rdfs:label>
    <skos:prefLabel xml:lang="en">MTU</skos:prefLabel>
    <skos:definition xml:lang="en">The maximum packet size permitted by an interface or path before applicable fragmentation or size handling.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">maximum transmission unit</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MacOSOperatingSystem">
    <rdfs:label xml:lang="en">macOS</rdfs:label>
    <skos:prefLabel xml:lang="en">macOS</skos:prefLabel>
    <skos:definition xml:lang="en">The Apple operating-system family used by the UTM host provider and macOS guest provider.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystem" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MachineIdentifier">
    <rdfs:label xml:lang="en">machine identifier</rdfs:label>
    <skos:prefLabel xml:lang="en">machine identifier</skos:prefLabel>
    <skos:definition xml:lang="en">An operating-system identifier used by components that derive machine-specific identity or configuration.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">machine ID</skos:altLabel>
    <skos:scopeNote xml:lang="en">Do not equate it with a Yuruna host ID, MAC address, or DHCP client identifier.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ManualImageDrop">
    <rdfs:label xml:lang="en">manual image drop</rdfs:label>
    <skos:prefLabel xml:lang="en">manual image drop</skos:prefLabel>
    <skos:definition xml:lang="en">Supplying an externally downloaded image through the agent's designated manual area for validation and adoption.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">Manual source files are outside ordinary generation-retention pruning.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Memory">
    <rdfs:label xml:lang="en">memory</rdfs:label>
    <skos:prefLabel xml:lang="en">memory</skos:prefLabel>
    <skos:definition xml:lang="en">Working storage used by the host OS, hypervisor, guests, and processes while they execute.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <skos:altLabel xml:lang="en">RAM</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinguish installed memory, available memory, committed memory, and configured guest memory.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MemoryBallooning">
    <rdfs:label xml:lang="en">memory ballooning</rdfs:label>
    <skos:prefLabel xml:lang="en">memory ballooning</skos:prefLabel>
    <skos:definition xml:lang="en">A mechanism for changing guest memory use through cooperation between a hypervisor and a guest balloon driver.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <skos:scopeNote xml:lang="en">Service VM sizing in Yuruna uses explicit commitments rather than assuming ballooning will supply missing capacity.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MemoryCapacity">
    <rdfs:label xml:lang="en">memory capacity</rdfs:label>
    <skos:prefLabel xml:lang="en">memory capacity</skos:prefLabel>
    <skos:definition xml:lang="en">An amount of memory available or reserved for a specified computing scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MemoryExhaustion">
    <rdfs:label xml:lang="en">memory exhaustion</rdfs:label>
    <skos:prefLabel xml:lang="en">memory exhaustion</skos:prefLabel>
    <skos:definition xml:lang="en">Available memory or allocation headroom is insufficient for the requested operation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <skos:scopeNote xml:lang="en">Assigned VM memory and actual host-resident memory are different measurements.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MemoryHeadroom" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MemoryHeadroom">
    <rdfs:label xml:lang="en">memory headroom</rdfs:label>
    <skos:prefLabel xml:lang="en">memory headroom</skos:prefLabel>
    <skos:definition xml:lang="en">Capacity left after current commitments and required reserves, used to judge whether more work can be admitted.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/memory.md" />
    <skos:altLabel xml:lang="en">available headroom</skos:altLabel>
    <skos:scopeNote xml:lang="en">Available physical memory and commit headroom are different measures.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#VMAdmission" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MessageCatalog">
    <rdfs:label xml:lang="en">message catalog</rdfs:label>
    <skos:prefLabel xml:lang="en">message catalog</skos:prefLabel>
    <skos:definition xml:lang="en">A keyed collection of user-facing message definitions and their translations.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Distinct from the short-link catalog and a database schema catalog.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#containsMessage" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MessageTemplate" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MessageKey">
    <rdfs:label xml:lang="en">message key</rdfs:label>
    <skos:prefLabel xml:lang="en">message key</skos:prefLabel>
    <skos:definition xml:lang="en">A stable machine identifier used to retrieve a localized message independently of its displayed wording.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Must not be translated as if it were ordinary prose.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MessagePlaceholder">
    <rdfs:label xml:lang="en">message placeholder</rdfs:label>
    <skos:prefLabel xml:lang="en">message placeholder</skos:prefLabel>
    <skos:definition xml:lang="en">A named insertion point whose contract identifies a value supplied to a message renderer.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Not an invitation to translate a command, path, or identifier value.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MessageTemplate">
    <rdfs:label xml:lang="en">message template</rdfs:label>
    <skos:prefLabel xml:lang="en">message template</skos:prefLabel>
    <skos:definition xml:lang="en">A user-facing message with placeholders or conditional forms resolved at rendering time.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#identifiedByKey" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MessageKey" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MessagePlaceholder" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Metric">
    <rdfs:label xml:lang="en">metric</rdfs:label>
    <skos:prefLabel xml:lang="en">metric</skos:prefLabel>
    <skos:definition xml:lang="en">A numeric measurement with a defined meaning, labels, and collection context.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <skos:scopeNote xml:lang="en">A metric sample is not necessarily a unique event or incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Telemetry" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MetricLabel" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MetricExporter">
    <rdfs:label xml:lang="en">metric exporter</rdfs:label>
    <skos:prefLabel xml:lang="en">metric exporter</skos:prefLabel>
    <skos:definition xml:lang="en">A service exposing system or application measurements in the monitoring format.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">A host without the relevant exporter can lack a metric series while still running correctly.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MetricLabel">
    <rdfs:label xml:lang="en">metric label</rdfs:label>
    <skos:prefLabel xml:lang="en">metric label</skos:prefLabel>
    <skos:definition xml:lang="en">A dimension identifying or grouping a metric or log stream.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/alerts.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">Labels carrying host or cycle identities are excluded from the ontology's evidence summaries.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MetricScrape">
    <rdfs:label xml:lang="en">metric scrape</rdfs:label>
    <skos:prefLabel xml:lang="en">metric scrape</skos:prefLabel>
    <skos:definition xml:lang="en">Retrieval of current measurements from an exporter by the monitoring service.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <skos:scopeNote xml:lang="en">Historic values absent from durable telemetry cannot be recovered merely by scraping current state.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#MetricExporter" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Mount">
    <rdfs:label xml:lang="en">mount</rdfs:label>
    <skos:prefLabel xml:lang="en">mount</skos:prefLabel>
    <skos:definition xml:lang="en">An attachment that exposes a filesystem or remote share at a local path.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">A configured mount path can exist even when the remote share is not mounted.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MountPoint">
    <rdfs:label xml:lang="en">mount point</rdfs:label>
    <skos:prefLabel xml:lang="en">mount point</skos:prefLabel>
    <skos:definition xml:lang="en">The local filesystem location through which a mounted storage resource is accessed.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MoveMode">
    <rdfs:label xml:lang="en">move mode</rdfs:label>
    <skos:prefLabel xml:lang="en">move mode</skos:prefLabel>
    <skos:definition xml:lang="en">The pool-storage mode that removes the local cycle directory only after its copy on the share is verified.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">A failed or unverified copy must not authorize local deletion.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ChecksumVerification" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#MutualTLSAuthentication">
    <rdfs:label xml:lang="en">mutual TLS authentication</rdfs:label>
    <skos:prefLabel xml:lang="en">mutual TLS authentication</skos:prefLabel>
    <skos:definition xml:lang="en">TLS authentication in which both peers authenticate with certificates under the selected policy.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labregistrylogs" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc8446.html" />
    <skos:altLabel xml:lang="en">mTLS</skos:altLabel>
    <skos:scopeNote xml:lang="en">Different from server-only TLS; an advertised authentication capability is not evidence of enabled client-certificate enforcement.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Authentication" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TLSCertificate" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TrustStore" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#N8n">
    <rdfs:label xml:lang="en">n8n</rdfs:label>
    <skos:prefLabel xml:lang="en">n8n</skos:prefLabel>
    <skos:definition xml:lang="en">The workflow application installed by Yuruna's dedicated guest setup scripts.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/shared/ubuntu.n8n.sh" />
    <skos:scopeNote xml:lang="en">Installation support does not imply that user workflows are preconfigured.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#dependsOn" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NodeJS" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NAT">
    <rdfs:label xml:lang="en">NAT</rdfs:label>
    <skos:prefLabel xml:lang="en">NAT</skos:prefLabel>
    <skos:definition xml:lang="en">Translation of addresses, and sometimes ports, between network realms while forwarding traffic.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">network address translation</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PortForwarding" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NATFallback">
    <rdfs:label xml:lang="en">NAT fallback</rdfs:label>
    <skos:prefLabel xml:lang="en">NAT fallback</skos:prefLabel>
    <skos:definition xml:lang="en">Selection of the supported NAT path when a provider declines or cannot safely reuse external bridging.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The ordinary Wi-Fi or USB eligibility divert is not an incident. A stale bridge that triggered fallback can still be an independently reportable fault.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TopologySelectionPolicy" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HyperVDefaultSwitch" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#UTMSharedNetworking" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NATNetwork">
    <rdfs:label xml:lang="en">NAT network</rdfs:label>
    <skos:prefLabel xml:lang="en">NAT network</skos:prefLabel>
    <skos:definition xml:lang="en">A guest network whose external traffic passes through network address translation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">shared NAT network</skos:altLabel>
    <skos:scopeNote xml:lang="en">A NAT topology changes which addresses and forwarding rules make guest services reachable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Network" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#NDJSON">
    <rdfs:label xml:lang="en">NDJSON</rdfs:label>
    <skos:prefLabel xml:lang="en">NDJSON</skos:prefLabel>
    <skos:definition xml:lang="en">A serialization in which each line carries one independently parseable JSON value.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:altLabel xml:lang="en">newline-delimited JSON</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
