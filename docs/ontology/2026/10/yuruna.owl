    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdPrivacyThreshold">
    <rdfs:label xml:lang="en">privacy threshold</rdfs:label>
    <skos:prefLabel xml:lang="en">privacy threshold</skos:prefLabel>
    <skos:definition xml:lang="en">A minimum aggregation condition intended to prevent publication of individual-level demand information.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:implementationStatus xml:lang="en">Design concept; implementation coverage is limited as described in the scope note.</y:implementationStatus>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdRefund">
    <rdfs:label xml:lang="en">refund</rdfs:label>
    <skos:prefLabel xml:lang="en">refund</skos:prefLabel>
    <skos:definition xml:lang="en">A compensating settlement operation reversing the original party amounts for a match and case.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">The durable adjustment entries serve as the replay record; historical entries are not silently rewritten.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCompensatingEntry" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSupportCase" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdResource">
    <rdfs:label xml:lang="en">matching resource</rdfs:label>
    <skos:prefLabel xml:lang="en">matching resource</skos:prefLabel>
    <skos:definition xml:lang="en">Capacity available to host an AmisAd matching environment under placement and jurisdiction constraints.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">Distinct from a Yuruna deployment resource.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
