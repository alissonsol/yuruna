    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WaitChannel">
    <rdfs:label xml:lang="en">wait channel</rdfs:label>
    <skos:prefLabel xml:lang="en">wait channel</skos:prefLabel>
    <skos:definition xml:lang="en">The kernel wait location reported for a blocked or sleeping operating-system process.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:altLabel xml:lang="en">wchan</skos:altLabel>
    <skos:scopeNote xml:lang="en">A wait location is diagnostic evidence and does not establish the complete cause of a stall.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WaitTimeoutFailure">
    <rdfs:label xml:lang="en">wait timeout</rdfs:label>
    <skos:prefLabel xml:lang="en">wait timeout</skos:prefLabel>
    <skos:definition xml:lang="en">A requested wait condition is not established before its limit.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Broader than OCR timeout and distinct from evidence that a command was never started.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#GuestProcessCheck" />
    <y:codeToken>wait_timeout</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WarmCacheState">
    <rdfs:label xml:lang="en">warm cache</rdfs:label>
    <skos:prefLabel xml:lang="en">warm cache</skos:prefLabel>
    <skos:definition xml:lang="en">The relevant content has been populated in the considered cache layer for possible reuse.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">Resident content can still need validation; a warm cache does not imply a no-upstream policy or prove a cold fetch would work.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CacheWarmup" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CacheRevalidation" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WarmResume">
    <rdfs:label xml:lang="en">warm resume</rdfs:label>
    <skos:prefLabel xml:lang="en">warm resume</skos:prefLabel>
    <skos:definition xml:lang="en">Continuing from retained execution state when compatibility and validity checks permit reuse.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">A declined warm resume is not automatically a guest failure.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Watchdog">
    <rdfs:label xml:lang="en">watchdog</rdfs:label>
    <skos:prefLabel xml:lang="en">watchdog</skos:prefLabel>
    <skos:definition xml:lang="en">A supervising mechanism that detects a cycle exceeding its permitted progress or time bounds and initiates termination or restart handling.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">Not every long operation is a hang; watchdog decisions use configured limits and available progress evidence.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WebsiteFrontend">
    <rdfs:label xml:lang="en">website frontend</rdfs:label>
    <skos:prefLabel xml:lang="en">website frontend</skos:prefLabel>
    <skos:definition xml:lang="en">The website example's web-facing application deployed from its frontend component.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/website/README.md" />
    <skos:scopeNote xml:lang="en">Context: yuruna-project website example.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ApplicationWorkload" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WiFi">
    <rdfs:label xml:lang="en">Wi-Fi</rdfs:label>
    <skos:prefLabel xml:lang="en">Wi-Fi</skos:prefLabel>
    <skos:definition xml:lang="en">Wireless local-area networking based on IEEE 802.11 and used by some host uplinks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">WiFi</skos:altLabel>
    <skos:scopeNote xml:lang="en">Yuruna's provider selection can choose NAT for this uplink; that choice is not itself an incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WindowsOperatingSystem">
    <rdfs:label xml:lang="en">Windows</rdfs:label>
    <skos:prefLabel xml:lang="en">Windows</skos:prefLabel>
    <skos:definition xml:lang="en">The Windows operating-system family used by the Hyper-V host provider and Windows guest providers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatingSystem" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WiredUplink">
    <rdfs:label xml:lang="en">wired uplink</rdfs:label>
    <skos:prefLabel xml:lang="en">wired uplink</skos:prefLabel>
    <skos:definition xml:lang="en">An upstream host connection carried by a wired adapter.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The provider still validates the adapter type and binding rather than assuming every wired adapter supports the chosen bridge.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Uplink" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Ethernet" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WirelessUplink">
    <rdfs:label xml:lang="en">wireless uplink</rdfs:label>
    <skos:prefLabel xml:lang="en">wireless uplink</skos:prefLabel>
    <skos:definition xml:lang="en">An upstream host connection carried over Wi-Fi in the supported host topology checks.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Yuruna uses a shared or default NAT network when its provider declines to bridge this uplink.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Uplink" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#WiFi" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WorkerCapacity">
    <rdfs:label xml:lang="en">worker capacity</rdfs:label>
    <skos:prefLabel xml:lang="en">worker capacity</skos:prefLabel>
    <skos:definition xml:lang="en">The workers available or occupied within a service's task-processing scheduler.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labservices" />
    <skos:scopeNote xml:lang="en">Not the number of pool hosts.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WorkloadDeployment">
    <rdfs:label xml:lang="en">workload deployment</rdfs:label>
    <skos:prefLabel xml:lang="en">workload deployment</skos:prefLabel>
    <skos:definition xml:lang="en">The deployment phase that installs or updates application workloads using Helm and target configuration.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Set-Workload.ps1" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DeploymentOperation" />
