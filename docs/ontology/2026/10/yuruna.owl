      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#offeredBySeller" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdSeller" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdOfferCatalog">
    <rdfs:label xml:lang="en">offer catalog</rdfs:label>
    <skos:prefLabel xml:lang="en">offer catalog</skos:prefLabel>
    <skos:definition xml:lang="en">The supply-side collection of offers made available to the matching fabric.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">Different from a translation catalog or container registry.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdOrder">
    <rdfs:label xml:lang="en">order</rdfs:label>
    <skos:prefLabel xml:lang="en">order</skos:prefLabel>
    <skos:definition xml:lang="en">A committed offer selection whose fulfillment and settlement progress is tracked.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/db/schema.sql" />
    <skos:scopeNote xml:lang="en">An identical replay must not create a second order; conflicting contents are rejected.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdIdempotentReplay" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdParticipantRole">
    <rdfs:label xml:lang="en">participant role</rdfs:label>
    <skos:prefLabel xml:lang="en">participant role</skos:prefLabel>
    <skos:definition xml:lang="en">A role through which an actor participates in the AmisAd marketplace.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">Roles are modeled as categories; no people, accounts, or fictional persona instances are included.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdParticipationGrant">
    <rdfs:label xml:lang="en">participation grant</rdfs:label>
    <skos:prefLabel xml:lang="en">participation grant</skos:prefLabel>
    <skos:definition xml:lang="en">A consent category governing participation in the AmisAd matching ecosystem.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/db/schema.sql" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdConsentGrant" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>participation</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdPrincipal">
    <rdfs:label xml:lang="en">principal</rdfs:label>
    <skos:prefLabel xml:lang="en">principal</skos:prefLabel>
    <skos:definition xml:lang="en">The party whose authority and interests are represented by a delegate's mandate.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">Not an operating-system security principal in this context.</skos:scopeNote>
