    <skos:prefLabel xml:lang="en">SSH</skos:prefLabel>
    <skos:definition xml:lang="en">A secure remote-session protocol used for guest command execution, transport recovery, and artifact transfer.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <skos:altLabel xml:lang="en">Secure Shell</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SSHExecution">
    <rdfs:label xml:lang="en">SSH execution</rdfs:label>
    <skos:prefLabel xml:lang="en">SSH execution</skos:prefLabel>
    <skos:definition xml:lang="en">Running an operation in a guest through the SSH transport rather than GUI keystrokes.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SSH" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SSHHostKey">
    <rdfs:label xml:lang="en">SSH host key</rdfs:label>
    <skos:prefLabel xml:lang="en">SSH host key</skos:prefLabel>
    <skos:definition xml:lang="en">Key material used by an SSH server to authenticate its identity to a connecting client.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">server host key</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinct from a user's SSH authentication key; rejecting a changed server key is not evidence of user-credential expiration.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SSHKeyPair" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SSHKeyPair">
    <rdfs:label xml:lang="en">SSH key pair</rdfs:label>
    <skos:prefLabel xml:lang="en">SSH key pair</skos:prefLabel>
    <skos:definition xml:lang="en">Public and private key material used to authenticate SSH access.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <skos:scopeNote xml:lang="en">Only the type and purpose are represented.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SchemaCatalog">
    <rdfs:label xml:lang="en">schema catalog</rdfs:label>
    <skos:prefLabel xml:lang="en">schema catalog</skos:prefLabel>
    <skos:definition xml:lang="en">The database table, column, comment, and foreign-key metadata indexed for query generation.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">Collects no sample row values; not a message or short-link catalog.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SchemaRetrieval">
    <rdfs:label xml:lang="en">schema retrieval</rdfs:label>
    <skos:prefLabel xml:lang="en">schema retrieval</skos:prefLabel>
    <skos:definition xml:lang="en">Selection of relevant schema metadata using question terms and expansion through direct outgoing foreign keys.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">The implemented retriever is deterministic lexical scoring, not a deployed vector index.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:expectedOutput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SchemaSlice" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ForeignKey" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SchemaSlice">
    <rdfs:label xml:lang="en">schema slice</rdfs:label>
    <skos:prefLabel xml:lang="en">schema slice</skos:prefLabel>
    <skos:definition xml:lang="en">The selected tables and foreign-key neighbors supplied as context to SQL generation.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">Not an AmisAd execution slice.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ScreenRecordingPermission">
    <rdfs:label xml:lang="en">screen recording permission</rdfs:label>
    <skos:prefLabel xml:lang="en">screen recording permission</skos:prefLabel>
    <skos:definition xml:lang="en">The host OS authorization needed by some screen capture paths.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <skos:scopeNote xml:lang="en">Separate from accessibility input permission.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Screenshot">
    <rdfs:label xml:lang="en">screenshot</rdfs:label>
    <skos:prefLabel xml:lang="en">screenshot</skos:prefLabel>
    <skos:definition xml:lang="en">A captured frame of the guest display used as visual evidence or OCR input.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/ocr.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Framebuffer" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ScreenshotProvider">
    <rdfs:label xml:lang="en">screenshot provider</rdfs:label>
    <skos:prefLabel xml:lang="en">screenshot provider</skos:prefLabel>
    <skos:definition xml:lang="en">A registered implementation for capturing guest display frames on a host platform.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-io.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ScriptErrorFailure">
    <rdfs:label xml:lang="en">script error</rdfs:label>
    <skos:prefLabel xml:lang="en">script error</skos:prefLabel>
    <skos:definition xml:lang="en">Script execution throws or reports an error that prevents completion.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">A payload that never arrived should not be classified as having executed and failed.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>script_error</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Secret">
    <rdfs:label xml:lang="en">secret</rdfs:label>
    <skos:prefLabel xml:lang="en">secret</skos:prefLabel>
    <skos:definition xml:lang="en">Information whose disclosure is restricted because it grants access or reveals protected material.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <skos:scopeNote xml:lang="en">The concept is modeled without any actual secret data.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SecureBoot">
    <rdfs:label xml:lang="en">Secure Boot</rdfs:label>
    <skos:prefLabel xml:lang="en">Secure Boot</skos:prefLabel>
    <skos:definition xml:lang="en">A boot integrity mechanism that verifies permitted boot software through a firmware trust policy.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">It is distinct from verifying the checksum of a downloaded image.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SeedImage">
    <rdfs:label xml:lang="en">seed image</rdfs:label>
    <skos:prefLabel xml:lang="en">seed image</skos:prefLabel>
    <skos:definition xml:lang="en">Bootstrap media carrying guest configuration and instance metadata for unattended initialization.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">seed ISO</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SequenceAction">
    <rdfs:label xml:lang="en">sequence action</rdfs:label>
    <skos:prefLabel xml:lang="en">sequence action</skos:prefLabel>
    <skos:definition xml:lang="en">A named test operation and its parameters, dispatched to a registered handler.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure">
    <rdfs:label xml:lang="en">sequence failure</rdfs:label>
    <skos:prefLabel xml:lang="en">sequence failure</skos:prefLabel>
    <skos:definition xml:lang="en">A failure associated with execution of a test sequence action.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SequenceHandler">
    <rdfs:label xml:lang="en">sequence handler</rdfs:label>
    <skos:prefLabel xml:lang="en">sequence handler</skos:prefLabel>
    <skos:definition xml:lang="en">The registered implementation of a sequence action verb.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#implementsAction" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceAction" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ServerNameIndication">
    <rdfs:label xml:lang="en">server name indication</rdfs:label>
    <skos:prefLabel xml:lang="en">server name indication</skos:prefLabel>
    <skos:definition xml:lang="en">The TLS ClientHello extension carrying the server name requested by a client for connection setup.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc8446.html" />
    <skos:altLabel xml:lang="en">SNI</skos:altLabel>
    <skos:scopeNote xml:lang="en">A presented name is not proof of certificate validity or authorization.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ServiceDiscovery">
    <rdfs:label xml:lang="en">service discovery</rdfs:label>
    <skos:prefLabel xml:lang="en">service discovery</skos:prefLabel>
    <skos:definition xml:lang="en">Resolution of the location and usable address of a service from available registration and reachability evidence.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A registered address can be stale or unreachable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkDiscovery" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ServiceGuest">
    <rdfs:label xml:lang="en">service guest</rdfs:label>
    <skos:prefLabel xml:lang="en">service guest</skos:prefLabel>
    <skos:definition xml:lang="en">A guest that provides a shared lab service, such as caching, stash storage, pool control, or image downloads.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">service VM</skos:altLabel>
    <skos:scopeNote xml:lang="en">Its lifecycle and admission treatment differ from disposable test guests.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Guest" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#hosts" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ShortLink">
    <rdfs:label xml:lang="en">short link</rdfs:label>
    <skos:prefLabel xml:lang="en">short link</skos:prefLabel>
    <skos:definition xml:lang="en">A compact published URL that resolves through the yuruna.link catalog to a target.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ShortLinkCatalog" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ShortLinkCatalog">
    <rdfs:label xml:lang="en">short-link catalog</rdfs:label>
    <skos:prefLabel xml:lang="en">short-link catalog</skos:prefLabel>
    <skos:definition xml:lang="en">The mapping of document IDs, tags, aliases, and optional locale targets used by yuruna.link.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yuruna.link/blob/bf87a8eff20cb9f16d6a53513b1d73debc5d735b/README.md" />
    <skos:scopeNote xml:lang="en">Not a message catalog.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Shortfall">
    <rdfs:label xml:lang="en">shortfall</rdfs:label>
    <skos:prefLabel xml:lang="en">shortfall</skos:prefLabel>
    <skos:definition xml:lang="en">Outcomes the Configuration permits outside the Baseline: Configuration minus Baseline; what the tools and code could not express or capture of the Baseline.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:altLabel xml:lang="en">control gap</skos:altLabel>
    <skos:scopeNote xml:lang="en">Not an incident classification: a failed test, an absent namespace, a stale configuration revision, or an invalid runner-state transition does not by itself prove one.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Baseline" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SignatureVerification">
    <rdfs:label xml:lang="en">signature verification</rdfs:label>
    <skos:prefLabel xml:lang="en">signature verification</skos:prefLabel>
    <skos:definition xml:lang="en">Checking a digital signature against trusted key material to validate a signed artifact or manifest.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/dev-only/release.md" />
    <skos:scopeNote xml:lang="en">This establishes a different assurance from comparing an untrusted checksum.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#verifiesArtifact" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SingleFlightDownload">
    <rdfs:label xml:lang="en">single-flight download</rdfs:label>
    <skos:prefLabel xml:lang="en">single-flight download</skos:prefLabel>
    <skos:definition xml:lang="en">Coalescing concurrent requests for the same missing image into one shared transfer.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Situation">
    <rdfs:label xml:lang="en">situation</rdfs:label>
    <skos:prefLabel xml:lang="en">situation</skos:prefLabel>
    <skos:definition xml:lang="en">A state of affairs relevant to operation or diagnosis, including conditions and incidents.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Entity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Snapshot">
    <rdfs:label xml:lang="en">snapshot</rdfs:label>
    <skos:prefLabel xml:lang="en">snapshot</skos:prefLabel>
    <skos:definition xml:lang="en">A captured VM or disk state used as a restore point under a provider-specific snapshot contract.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <skos:scopeNote xml:lang="en">A snapshot is not automatically a complete or portable backup.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SnapshotManifest" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SnapshotManifest">
    <rdfs:label xml:lang="en">snapshot manifest</rdfs:label>
    <skos:prefLabel xml:lang="en">snapshot manifest</skos:prefLabel>
    <skos:definition xml:lang="en">Metadata used to validate a snapshot's identity, compatibility, and restore expectations.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SnapshotRestoreFailure">
    <rdfs:label xml:lang="en">snapshot restore failed</rdfs:label>
    <skos:prefLabel xml:lang="en">snapshot restore failed</skos:prefLabel>
    <skos:definition xml:lang="en">A requested restore cannot establish the saved VM baseline.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SequenceFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SnapshotManifest" />
    <y:codeToken>snapshot_restore_failed</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Snippet">
    <rdfs:label xml:lang="en">snippet</rdfs:label>
    <skos:prefLabel xml:lang="en">snippet</skos:prefLabel>
    <skos:definition xml:lang="en">A small text item stored or executed in a context that determines its format and purpose.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <skos:scopeNote xml:lang="en">A stored text snippet is not automatically executable or trusted.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Socket">
    <rdfs:label xml:lang="en">socket</rdfs:label>
    <skos:prefLabel xml:lang="en">socket</skos:prefLabel>
    <skos:definition xml:lang="en">An operating-system communication endpoint associated with a protocol and local or remote addressing information.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SocketReceiveQueue">
    <rdfs:label xml:lang="en">socket receive queue</rdfs:label>
    <skos:prefLabel xml:lang="en">socket receive queue</skos:prefLabel>
    <skos:definition xml:lang="en">The incoming data or receive-side accounting reported for a socket by the host's socket inspection tools.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9293" />
    <skos:altLabel xml:lang="en">receive queue</skos:altLabel>
    <skos:scopeNote xml:lang="en">A nonempty queue does not by itself identify a network outage or an application deadlock.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SocketSendQueue">
    <rdfs:label xml:lang="en">socket send queue</rdfs:label>
    <skos:prefLabel xml:lang="en">socket send queue</skos:prefLabel>
    <skos:definition xml:lang="en">The outgoing data or pending transmission accounting reported for a socket by the host's socket inspection tools.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9293" />
    <skos:altLabel xml:lang="en">send queue</skos:altLabel>
    <skos:scopeNote xml:lang="en">Interpret units and exact semantics according to the platform and socket state.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SocketStateCheck">
    <rdfs:label xml:lang="en">socket state check</rdfs:label>
    <skos:prefLabel xml:lang="en">socket state check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of connection states, queues, process ownership, and transport timers to assess communication progress.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:scopeNote xml:lang="en">Listening endpoints alone omit evidence from an already established but stalled transfer.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TCPConnectionState" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SocketSendQueue" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SocketReceiveQueue" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RetransmissionTimer" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SoftFailureSeverity">
    <rdfs:label xml:lang="en">soft failure severity</rdfs:label>
    <skos:prefLabel xml:lang="en">soft failure severity</skos:prefLabel>
    <skos:definition xml:lang="en">The soft severity designation assigned by the failure classification contract.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FailureSeverity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>soft</y:codeToken>
    <y:codeVocabulary>failureSeverity</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact">
    <rdfs:label xml:lang="en">software artifact</rdfs:label>
    <skos:prefLabel xml:lang="en">software artifact</skos:prefLabel>
    <skos:definition xml:lang="en">A distributable or executable representation of software, such as a script, binary, package, or image.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SoftwareBillOfMaterials">
    <rdfs:label xml:lang="en">software bill of materials</rdfs:label>
    <skos:prefLabel xml:lang="en">software bill of materials</skos:prefLabel>
    <skos:definition xml:lang="en">A structured inventory of software components and their dependency or provenance information.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/sbom/README.md" />
    <skos:altLabel xml:lang="en">SBOM</skos:altLabel>
    <skos:scopeNote xml:lang="en">Not proof that every listed dependency is currently executing on a host.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareDependency" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SoftwareDependency">
    <rdfs:label xml:lang="en">software dependency</rdfs:label>
    <skos:prefLabel xml:lang="en">software dependency</skos:prefLabel>
    <skos:definition xml:lang="en">A software package, tool, or component required by another artifact or operation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/sbom/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService">
    <rdfs:label xml:lang="en">software service</rdfs:label>
    <skos:prefLabel xml:lang="en">software service</skos:prefLabel>
    <skos:definition xml:lang="en">A software component that provides an operational capability through a defined interface or background activity.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <skos:altLabel xml:lang="en">service</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinguish a service implementation from the VM hosting it and from a Kubernetes Service resource.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SoftwareVersion">
    <rdfs:label xml:lang="en">software version</rdfs:label>
    <skos:prefLabel xml:lang="en">software version</skos:prefLabel>
    <skos:definition xml:lang="en">A version designation used to select, compare, or pin a software release.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <skos:altLabel xml:lang="en">version</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SourceHash">
    <rdfs:label xml:lang="en">source hash</rdfs:label>
    <skos:prefLabel xml:lang="en">source hash</skos:prefLabel>
    <skos:definition xml:lang="en">A content digest used to detect whether a translation still corresponds to its recorded source text.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">An unchanged hash indicates byte identity, not linguistic quality.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SourceRevision">
    <rdfs:label xml:lang="en">source revision</rdfs:label>
    <skos:prefLabel xml:lang="en">source revision</skos:prefLabel>
    <skos:definition xml:lang="en">An immutable source-control revision identifying the repository contents used for a build, release, or provenance claim.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/install/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/dev-only/release.md" />
    <skos:scopeNote xml:lang="en">Different from a movable branch reference or an application release label.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Squid">
    <rdfs:label xml:lang="en">Squid</rdfs:label>
    <skos:prefLabel xml:lang="en">Squid</skos:prefLabel>
    <skos:definition xml:lang="en">The proxy software used to cache package and HTTPS traffic for Yuruna hosts and guests.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ForwardProxy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StagingArea">
    <rdfs:label xml:lang="en">staging area</rdfs:label>
    <skos:prefLabel xml:lang="en">staging area</skos:prefLabel>
    <skos:definition xml:lang="en">Temporary storage used to prepare and verify a candidate before it replaces a live artifact or work directory.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StaleContent">
    <rdfs:label xml:lang="en">stale content</rdfs:label>
    <skos:prefLabel xml:lang="en">stale content</skos:prefLabel>
    <skos:definition xml:lang="en">Cached content whose freshness period or validation status no longer qualifies it as fresh.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">Some offline policies permit serving stale successful content; they do not justify caching failures as successes.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StaleMount">
    <rdfs:label xml:lang="en">stale mount</rdfs:label>
    <skos:prefLabel xml:lang="en">stale mount</skos:prefLabel>
    <skos:definition xml:lang="en">A previously configured remote filesystem attachment no longer provides reliable access to its backing share.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">The local directory can still exist even when the intended share is unavailable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageCapacityCheck" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StaleUplinkBinding">
    <rdfs:label xml:lang="en">stale uplink binding</rdfs:label>
    <skos:prefLabel xml:lang="en">stale uplink binding</skos:prefLabel>
    <skos:definition xml:lang="en">A persisted virtual switch no longer has a usable intended uplink or management host leg despite the switch object still existing.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Different from an intentional NAT topology selected for an ineligible bridge uplink.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#UplinkBindingCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HyperVExternalSwitch" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NATFallback" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StalledTransfer">
    <rdfs:label xml:lang="en">stalled transfer</rdfs:label>
    <skos:prefLabel xml:lang="en">stalled transfer</skos:prefLabel>
    <skos:definition xml:lang="en">A transfer stops making required progress before its body is complete, potentially after successful headers or tunnel setup.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">A healthy CONNECT check does not exclude this condition.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#EndToEndFetchCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProxyTunnelCheck" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CacheRevalidation" />
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SocketStateCheck" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StashEntry">
    <rdfs:label xml:lang="en">stash entry</rdfs:label>
    <skos:prefLabel xml:lang="en">stash entry</skos:prefLabel>
    <skos:definition xml:lang="en">One content item or grouped upload managed by the stash service and described by its metadata.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <skos:altLabel xml:lang="en">stash item</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Artifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#storedIn" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StashStorage" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StashService">
    <rdfs:label xml:lang="en">stash service</rdfs:label>
    <skos:prefLabel xml:lang="en">stash service</skos:prefLabel>
    <skos:definition xml:lang="en">The shared upload and retrieval service that stores artifacts alongside metadata and exposes browser and SSH upload interfaces.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/extensions-api.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <skos:altLabel xml:lang="en">stash</skos:altLabel>
    <skos:scopeNote xml:lang="en">The service sense is distinct from one uploaded stash entry.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StashEntry" />
    <y:retiredLabel xml:lang="en">stash appliance</y:retiredLabel>
    <y:retiredLabel xml:lang="en">stash-server</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StashStorage">
    <rdfs:label xml:lang="en">stash storage</rdfs:label>
    <skos:prefLabel xml:lang="en">stash storage</skos:prefLabel>
    <skos:definition xml:lang="en">The storage tier used by the stash service for uploaded artifacts and its metadata.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">It is separate from the pool storage tier even when both are hosted by the same machine.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StashUpload">
    <rdfs:label xml:lang="en">stash upload</rdfs:label>
    <skos:prefLabel xml:lang="en">stash upload</skos:prefLabel>
    <skos:definition xml:lang="en">Submission of file or snippet content through a supported stash interface.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/stash-guide.md" />
    <skos:scopeNote xml:lang="en">Modern scp and legacy scp can group uploads differently.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#State">
    <rdfs:label xml:lang="en">state</rdfs:label>
    <skos:prefLabel xml:lang="en">state</skos:prefLabel>
    <skos:definition xml:lang="en">A named or measured condition of a resource or operation at a point in its lifecycle.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <skos:scopeNote xml:lang="en">A state name has meaning within its owning state machine.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StaticAddressConfiguration">
    <rdfs:label xml:lang="en">static address configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">static address configuration</skos:prefLabel>
    <skos:definition xml:lang="en">Configuration that assigns an interface address directly rather than acquiring it dynamically from DHCP.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StaticHostMapping">
    <rdfs:label xml:lang="en">static host mapping</rdfs:label>
    <skos:prefLabel xml:lang="en">static host mapping</skos:prefLabel>
    <skos:definition xml:lang="en">A local association of a host name and address used by the operating system's name service.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:scopeNote xml:lang="en">A local hosts-file entry is not a DNS resource record and can diverge from DNS answers.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StaticSQLValidation">
    <rdfs:label xml:lang="en">static SQL validation</rdfs:label>
    <skos:prefLabel xml:lang="en">static SQL validation</skos:prefLabel>
    <skos:definition xml:lang="en">Conservative checks limiting generated SQL to the permitted single-statement read form and explicit projections.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">The policy tokenizes SQL but is not a complete PostgreSQL parser.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ReadOnlyRole" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StatusDashboard">
    <rdfs:label xml:lang="en">status dashboard</rdfs:label>
    <skos:prefLabel xml:lang="en">status dashboard</skos:prefLabel>
    <skos:definition xml:lang="en">A browser presentation of status and diagnostic data from a host or pool.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StatusService">
    <rdfs:label xml:lang="en">status service</rdfs:label>
    <skos:prefLabel xml:lang="en">status service</skos:prefLabel>
    <skos:definition xml:lang="en">The host-side HTTP service exposing runner status and existing runtime artifacts.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:scopeNote xml:lang="en">Read endpoints and control endpoints have different effects and authorization requirements.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RunnerStatus" />
    <y:retiredLabel xml:lang="en">status server</y:retiredLabel>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageCapacity">
    <rdfs:label xml:lang="en">storage capacity</rdfs:label>
    <skos:prefLabel xml:lang="en">storage capacity</skos:prefLabel>
    <skos:definition xml:lang="en">The amount of data a storage resource can hold within the relevant allocation or quota.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageCapacityCheck">
    <rdfs:label xml:lang="en">storage capacity check</rdfs:label>
    <skos:prefLabel xml:lang="en">storage capacity check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of available space and mount state on the storage tier used by the failing operation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageCredential">
    <rdfs:label xml:lang="en">storage credential</rdfs:label>
    <skos:prefLabel xml:lang="en">storage credential</skos:prefLabel>
    <skos:definition xml:lang="en">Authentication material used to access a configured pool or stash share.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-config.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Pool storage and stash storage use separate configuration and credentials.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Credential" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageIOFailure">
    <rdfs:label xml:lang="en">storage I/O failure</rdfs:label>
    <skos:prefLabel xml:lang="en">storage I/O failure</skos:prefLabel>
    <skos:definition xml:lang="en">A read or write cannot complete because the relevant storage path or device reports an I/O problem.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">Different from an explicit capacity exhaustion condition.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Failure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:diagnosticCheck rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageCapacityCheck" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageReplication">
    <rdfs:label xml:lang="en">storage replication</rdfs:label>
    <skos:prefLabel xml:lang="en">storage replication</skos:prefLabel>
    <skos:definition xml:lang="en">Copying completed cycle output from host-local storage into durable pool storage and recording verified completion.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:scopeNote xml:lang="en">The running cycle's active files remain local.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#replicatesTo" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PoolStorage" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CompletionSentinel" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageResource">
    <rdfs:label xml:lang="en">storage resource</rdfs:label>
    <skos:prefLabel xml:lang="en">storage resource</skos:prefLabel>
    <skos:definition xml:lang="en">A device, filesystem, share, or managed store used to retain data.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StorageShare">
    <rdfs:label xml:lang="en">share</rdfs:label>
    <skos:prefLabel xml:lang="en">share</skos:prefLabel>
    <skos:definition xml:lang="en">A named storage namespace exposed to clients through a network file-sharing service.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-config.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-storage.md" />
    <skos:altLabel xml:lang="en">network share</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinct from sharing a cycle through a browser share sheet.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#StorageResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StreamDrain">
    <rdfs:label xml:lang="en">drain</rdfs:label>
    <skos:prefLabel xml:lang="en">drain</skos:prefLabel>
    <skos:definition xml:lang="en">Consumption of a child process's standard input until the required stream boundary before producing its response.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/globalization/terminology/pt-BR.terms.json" />
    <skos:scopeNote xml:lang="en">Different from a pool drain request that lets a current cycle finish without starting another.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DrainingIntent" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#StructuredLog">
    <rdfs:label xml:lang="en">structured log</rdfs:label>
    <skos:prefLabel xml:lang="en">structured log</skos:prefLabel>
    <skos:definition xml:lang="en">Log records with explicit fields rather than only free-form prose.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#LogStream" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Subnet">
    <rdfs:label xml:lang="en">subnet</rdfs:label>
    <skos:prefLabel xml:lang="en">subnet</skos:prefLabel>
    <skos:definition xml:lang="en">An IP network identified by a prefix within an address family.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Network" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Switch">
    <rdfs:label xml:lang="en">switch</rdfs:label>
    <skos:prefLabel xml:lang="en">switch</skos:prefLabel>
    <skos:definition xml:lang="en">A device or function that forwards link-layer frames among connected ports.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-hyperv.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Distinct from a feature toggle and from a command-line switch.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#NetworkingResource" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SystemDiagnostic">
    <rdfs:label xml:lang="en">system diagnostic</rdfs:label>
    <skos:prefLabel xml:lang="en">system diagnostic</skos:prefLabel>
    <skos:definition xml:lang="en">Collection of system, network, process, storage, and runtime facts using Yuruna's diagnostic tooling.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SystemElement">
    <rdfs:label xml:lang="en">system element</rdfs:label>
    <skos:prefLabel xml:lang="en">system element</skos:prefLabel>
    <skos:definition xml:lang="en">A hardware, software, or logical part of a computing installation that can participate in an operational relationship.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Entity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#SystemdNetworkd">
    <rdfs:label xml:lang="en">systemd-networkd</rdfs:label>
    <skos:prefLabel xml:lang="en">systemd-networkd</skos:prefLabel>
    <skos:definition xml:lang="en">A Linux network management service whose link and DHCP configuration is inspected and configured by the guest networking helpers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TCP">
    <rdfs:label xml:lang="en">TCP</rdfs:label>
    <skos:prefLabel xml:lang="en">TCP</skos:prefLabel>
    <skos:definition xml:lang="en">A transport protocol providing an ordered, reliable byte stream between endpoints.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9293" />
    <skos:altLabel xml:lang="en">Transmission Control Protocol</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TCPConnectionState">
    <rdfs:label xml:lang="en">TCP connection state</rdfs:label>
    <skos:prefLabel xml:lang="en">TCP connection state</skos:prefLabel>
    <skos:definition xml:lang="en">The TCP protocol state of a connection or listening endpoint.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc9293" />
    <skos:scopeNote xml:lang="en">ESTABLISHED does not prove that the application is making progress or that a response body has completed.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TCPReachabilityCheck">
    <rdfs:label xml:lang="en">TCP reachability check</rdfs:label>
    <skos:prefLabel xml:lang="en">TCP reachability check</skos:prefLabel>
    <skos:definition xml:lang="en">Testing whether a TCP endpoint can be contacted within a bounded interval.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">An open TCP port does not establish successful application authentication.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Port" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Listener" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TLS">
    <rdfs:label xml:lang="en">TLS</rdfs:label>
    <skos:prefLabel xml:lang="en">TLS</skos:prefLabel>
    <skos:definition xml:lang="en">A protocol that protects a communication channel and authenticates peers according to configured credentials and trust.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc8446.html" />
    <skos:altLabel xml:lang="en">Transport Layer Security</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TLSCertificate" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TLSCertificate">
    <rdfs:label xml:lang="en">TLS certificate</rdfs:label>
    <skos:prefLabel xml:lang="en">TLS certificate</skos:prefLabel>
    <skos:definition xml:lang="en">A certificate binding identity information to a public key for TLS authentication.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc8446.html" />
    <skos:scopeNote xml:lang="en">A valid certificate does not by itself grant application authorization.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CertificateAuthority" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TLSCertificateSecret">
    <rdfs:label xml:lang="en">TLS certificate secret</rdfs:label>
    <skos:prefLabel xml:lang="en">TLS certificate secret</skos:prefLabel>
    <skos:definition xml:lang="en">A Kubernetes Secret carrying certificate and private-key material for an application's TLS endpoint.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/website/README.md" />
    <skos:scopeNote xml:lang="en">The ontology describes the material's role, never a certificate or key value.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#KubernetesSecret" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TLSInterception">
    <rdfs:label xml:lang="en">TLS interception</rdfs:label>
    <skos:prefLabel xml:lang="en">TLS interception</skos:prefLabel>
    <skos:definition xml:lang="en">A proxy terminates the client's TLS connection and establishes a separate upstream connection so it can inspect permitted HTTP traffic.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc8446.html" />
    <skos:altLabel xml:lang="en">SSL bump</skos:altLabel>
    <skos:scopeNote xml:lang="en">Distinct from CONNECT tunneling; the client must trust the interception certificate authority for intercepted connections.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CertificateAuthority" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TrustStore" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CertificatePinning" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ServerNameIndication" />
    <y:codeToken>ssl_bump</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TPM">
    <rdfs:label xml:lang="en">TPM</rdfs:label>
    <skos:prefLabel xml:lang="en">TPM</skos:prefLabel>
    <skos:definition xml:lang="en">A trusted platform module, physical or virtual, exposed where an operating system requires platform security support.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">Trusted Platform Module</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TaskQueue">
    <rdfs:label xml:lang="en">task queue</rdfs:label>
    <skos:prefLabel xml:lang="en">task queue</skos:prefLabel>
    <skos:definition xml:lang="en">A collection of scheduled work awaiting available service workers.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labservices" />
    <skos:scopeNote xml:lang="en">The Zot dashboard's queue is distinct from Yuruna pool configuration, which does not centrally divide test plans.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#WorkerCapacity" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Telemetry">
    <rdfs:label xml:lang="en">telemetry</rdfs:label>
    <skos:prefLabel xml:lang="en">telemetry</skos:prefLabel>
    <skos:definition xml:lang="en">Measurements, events, probe results, and structured reports collected from hosts and services for operational observation; the Telemetry view of a system.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/definition.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/content/blob/78d52c574aada850bbdcaf003e6c4f81ef50cad9/article/2026.security/draft02.linked.identity/protect-sequence.txt" />
    <skos:scopeNote xml:lang="en">Often called monitoring. Observations may cover only part of the Implementation, and a missing observation is not evidence of absence.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentView" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AssessmentCondition" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Unmonitored" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TerminologyGlossary">
    <rdfs:label xml:lang="en">terminology glossary</rdfs:label>
    <skos:prefLabel xml:lang="en">terminology glossary</skos:prefLabel>
    <skos:definition xml:lang="en">A controlled set of concepts, preferred terms, definitions, and context notes used to keep translations consistent.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/globalization/terminology/pt-BR.terms.json" />
    <skos:scopeNote xml:lang="en">A term can have distinct concepts in different project contexts.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#TestCycle">
    <rdfs:label xml:lang="en">test cycle</rdfs:label>
    <skos:prefLabel xml:lang="en">test cycle</skos:prefLabel>
    <skos:definition xml:lang="en">One bounded traversal of a runner's selected plan, including its preparation, sequence execution, and final outcome.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/runner-outer-loop.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:altLabel xml:lang="en">cycle</skos:altLabel>
    <skos:scopeNote xml:lang="en">The ontology contains this category, not particular dated cycles.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TestStep" />
