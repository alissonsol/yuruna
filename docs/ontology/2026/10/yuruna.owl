    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>contribution</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdCoordinator">
    <rdfs:label xml:lang="en">fabric coordinator</rdfs:label>
    <skos:prefLabel xml:lang="en">fabric coordinator</skos:prefLabel>
