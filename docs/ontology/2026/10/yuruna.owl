  <owl:ObjectProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#identifiesClient">
    <rdfs:label xml:lang="en">identifies client</rdfs:label>
    <skos:prefLabel xml:lang="en">identifies client</skos:prefLabel>
    <skos:definition xml:lang="en">Relates a DHCP client identifier to the client it identifies in the applicable protocol scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://www.rfc-editor.org/rfc/rfc2131" />
