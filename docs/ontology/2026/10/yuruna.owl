  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Network">
    <rdfs:label xml:lang="en">network</rdfs:label>
    <skos:prefLabel xml:lang="en">network</skos:prefLabel>
    <skos:definition xml:lang="en">An arrangement of connected interfaces and forwarding resources through which computing nodes exchange data.</skos:definition>
