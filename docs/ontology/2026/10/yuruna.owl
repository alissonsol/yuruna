    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdContributionGrant">
    <rdfs:label xml:lang="en">contribution grant</rdfs:label>
    <skos:prefLabel xml:lang="en">contribution grant</skos:prefLabel>
