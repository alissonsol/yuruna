    <skos:prefLabel xml:lang="en">no-upstream mode</skos:prefLabel>
    <skos:definition xml:lang="en">A policy that prevents contacting upstream sources and therefore cannot satisfy a cold request without local content.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
