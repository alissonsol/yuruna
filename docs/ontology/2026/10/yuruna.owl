  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Prefix">
    <rdfs:label xml:lang="en">prefix</rdfs:label>
    <skos:prefLabel xml:lang="en">prefix</skos:prefLabel>
    <skos:definition xml:lang="en">The leading address bits and prefix length that identify an IP network or route scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:altLabel xml:lang="en">network prefix</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PrefixLength" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PrefixLength">
    <rdfs:label xml:lang="en">prefix length</rdfs:label>
    <skos:prefLabel xml:lang="en">prefix length</skos:prefLabel>
    <skos:definition xml:lang="en">The number of leading address bits belonging to an IP network prefix.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A prefix length describes an address boundary, not the number of usable addresses currently allocated.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Quantity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PrivateAddress">
    <rdfs:label xml:lang="en">private address</rdfs:label>
    <skos:prefLabel xml:lang="en">private address</skos:prefLabel>
    <skos:definition xml:lang="en">An address reserved for use within private addressing scopes rather than global public routing.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/control-routes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">The control-route allowlist also considers loopback and link-local scopes separately.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IPAddress" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PrivilegeElevation">
    <rdfs:label xml:lang="en">privilege elevation</rdfs:label>
    <skos:prefLabel xml:lang="en">privilege elevation</skos:prefLabel>
    <skos:definition xml:lang="en">Obtaining the operating-system privileges required for a protected action.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/authentication.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Process">
    <rdfs:label xml:lang="en">process</rdfs:label>
    <skos:prefLabel xml:lang="en">process</skos:prefLabel>
    <skos:definition xml:lang="en">An activity or execution that changes, checks, or observes system state.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-harness.md" />
    <skos:scopeNote xml:lang="en">Distinguish this activity sense from an operating-system process.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Entity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProcessTree">
    <rdfs:label xml:lang="en">process tree</rdfs:label>
    <skos:prefLabel xml:lang="en">process tree</skos:prefLabel>
    <skos:definition xml:lang="en">The parent-child relationships among operating-system processes relevant to an execution or diagnostic scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:scopeNote xml:lang="en">A blocking descendant can be deeper than the direct child of the initially inspected command.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProcessWaitCheck">
    <rdfs:label xml:lang="en">process wait check</rdfs:label>
    <skos:prefLabel xml:lang="en">process wait check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of a process tree, file descriptors, wait locations, and child activity to determine what blocks progress.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:scopeNote xml:lang="en">Inspect descendants as well as the initial command; aggregate CPU use can conceal a blocked package hook.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProcessTree" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#FileDescriptor" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#WaitChannel" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PseudoTerminal" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Processor">
    <rdfs:label xml:lang="en">processor</rdfs:label>
    <skos:prefLabel xml:lang="en">processor</skos:prefLabel>
    <skos:definition xml:lang="en">A physical processing device whose capacity and architecture constrain guest execution.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:altLabel xml:lang="en">CPU</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProcessorArchitecture">
    <rdfs:label xml:lang="en">processor architecture</rdfs:label>
    <skos:prefLabel xml:lang="en">processor architecture</skos:prefLabel>
    <skos:definition xml:lang="en">An instruction-set and execution architecture relevant to image compatibility and workload binaries.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/guest/README.md" />
    <skos:altLabel xml:lang="en">CPU architecture</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProgressAdvisory">
    <rdfs:label xml:lang="en">progress advisory</rdfs:label>
    <skos:prefLabel xml:lang="en">progress advisory</skos:prefLabel>
    <skos:definition xml:lang="en">A report of degraded, delayed, or uncertain progress intended to aid diagnosis while preserving the action's actual outcome.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <skos:scopeNote xml:lang="en">An advisory is not itself a terminal cycle failure.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Project">
    <rdfs:label xml:lang="en">project</rdfs:label>
    <skos:prefLabel xml:lang="en">project</skos:prefLabel>
    <skos:definition xml:lang="en">A directory-organized deployment definition containing configuration and resource, component, and workload inputs.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <skos:scopeNote xml:lang="en">A project is not the deployed application or the source-control repository that stores it.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#selectsConfiguration" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#CloudConfiguration" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProjectAccessDeniedFailure">
    <rdfs:label xml:lang="en">project access denied</rdfs:label>
    <skos:prefLabel xml:lang="en">project access denied</skos:prefLabel>
    <skos:definition xml:lang="en">The host's credentials cannot read the project assigned by pool configuration.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">The pool assignment and host-local credential permissions must be reconciled.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:suggestedRecovery rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#OperatorInterventionRecommendation" />
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#PoolIntent" />
    <y:codeToken>project_access_denied</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProjectTemplate">
    <rdfs:label xml:lang="en">project template</rdfs:label>
    <skos:prefLabel xml:lang="en">project template</skos:prefLabel>
    <skos:definition xml:lang="en">A reusable project skeleton intended to be copied and specialized for an application.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Project" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Prometheus">
    <rdfs:label xml:lang="en">Prometheus</rdfs:label>
    <skos:prefLabel xml:lang="en">Prometheus</skos:prefLabel>
    <skos:definition xml:lang="en">The metric collection and query service used by the lab dashboards.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/pool-dashboard.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProtectedToken">
    <rdfs:label xml:lang="en">protected token</rdfs:label>
    <skos:prefLabel xml:lang="en">protected token</skos:prefLabel>
    <skos:definition xml:lang="en">A command, parameter, path, protocol key, or other machine-facing string that translations must preserve verbatim.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Different from an authentication token or language-model token.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Protocol">
    <rdfs:label xml:lang="en">protocol</rdfs:label>
    <skos:prefLabel xml:lang="en">protocol</skos:prefLabel>
    <skos:definition xml:lang="en">A defined set of communication rules and message meanings used between participating endpoints.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">A protocol name is not a translated display string when it is used as a machine-readable identifier.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Provisioning">
    <rdfs:label xml:lang="en">provisioning</rdfs:label>
    <skos:prefLabel xml:lang="en">provisioning</skos:prefLabel>
    <skos:definition xml:lang="en">Preparation of a machine or service with the resources and configuration required for its intended role.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/architecture.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">Broader than the deployment engine's specific resource phase.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProvisioningFailure">
    <rdfs:label xml:lang="en">provisioning failure</rdfs:label>
    <skos:prefLabel xml:lang="en">provisioning failure</skos:prefLabel>
    <skos:definition xml:lang="en">Machine preparation or deployment tooling fails to establish the intended setup.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Yuruna.Result.psm1" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/vmconfig.md" />
    <skos:scopeNote xml:lang="en">Includes the canonical routing target of deploy-side tool_failed; the classification alone does not establish the tool failure cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InfrastructureFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>provisioning_failure</y:codeToken>
    <y:codeVocabulary>failureClass</y:codeVocabulary>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/test/modules/Test.FailureTaxonomy.psm1" />
    <y:evidenceBasis xml:lang="en">Classification token observed in the selected central event history; repeated and nested fields are not independent incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labevents" />
    <y:evidenceBasis xml:lang="en">Classification token observed in a selected host failure file; deduplicated file contents are not unique incident counts.</y:evidenceBasis>
    <dcterms:source rdf:resource="urn:yuruna:ontology:source:labhostlogs" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Proxy">
    <rdfs:label xml:lang="en">proxy</rdfs:label>
    <skos:prefLabel xml:lang="en">proxy</skos:prefLabel>
    <skos:definition xml:lang="en">An intermediary that handles requests or connections on behalf of a client.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">Specify whether the context is HTTP forwarding, registry mirroring, or another relay.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SoftwareService" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProxyBypass">
    <rdfs:label xml:lang="en">proxy bypass</rdfs:label>
    <skos:prefLabel xml:lang="en">proxy bypass</skos:prefLabel>
    <skos:definition xml:lang="en">A rule selecting destinations that a client should reach directly rather than through its configured proxy.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:altLabel xml:lang="en">NO_PROXY</skos:altLabel>
    <skos:scopeNote xml:lang="en">Preserve the environment variable name when it is used as configuration syntax.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ConfigurationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Proxy" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProxyCheck">
    <rdfs:label xml:lang="en">proxy check</rdfs:label>
    <skos:prefLabel xml:lang="en">proxy check</skos:prefLabel>
    <skos:definition xml:lang="en">Inspection of configured proxy routes and request behavior to distinguish direct and proxied connectivity failures.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProxyProtocol">
    <rdfs:label xml:lang="en">PROXY protocol</rdfs:label>
    <skos:prefLabel xml:lang="en">PROXY protocol</skos:prefLabel>
    <skos:definition xml:lang="en">A connection preface protocol used by the host forwarder to convey original client addressing to the downstream proxy listener.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:altLabel xml:lang="en">PROXY v1</skos:altLabel>
    <skos:scopeNote xml:lang="en">Not HTTP proxy configuration, an HTTP forwarding header, or the application request itself.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Protocol" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ProxyProtocolHeader" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProxyProtocolHeader">
    <rdfs:label xml:lang="en">PROXY protocol header</rdfs:label>
    <skos:prefLabel xml:lang="en">PROXY protocol header</skos:prefLabel>
    <skos:definition xml:lang="en">The connection preface carrying client and destination coordinates before the forwarded application bytes.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <skos:scopeNote xml:lang="en">Both ends must agree on the preface; an ordinary listener can misinterpret it as application traffic.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ClientAddressAttribution" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ProxyTunnelCheck">
    <rdfs:label xml:lang="en">proxy tunnel check</rdfs:label>
    <skos:prefLabel xml:lang="en">proxy tunnel check</skos:prefLabel>
    <skos:definition xml:lang="en">Testing whether the proxy can establish an HTTP CONNECT path to a target.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <skos:scopeNote xml:lang="en">Does not prove that a package GET body can finish through the cache path.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticCheck" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PseudoTerminal">
    <rdfs:label xml:lang="en">pseudoterminal</rdfs:label>
    <skos:prefLabel xml:lang="en">pseudoterminal</skos:prefLabel>
    <skos:definition xml:lang="en">A terminal interface pair used to connect a process to terminal-style input and output without a physical terminal.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/automation/Get-SystemDiagnostic.ps1" />
    <skos:altLabel xml:lang="en">PTY</skos:altLabel>
    <skos:scopeNote xml:lang="en">Terminal stream behavior differs from a regular file and can affect end-of-file handling.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Pseudolocalization">
    <rdfs:label xml:lang="en">pseudolocalization</rdfs:label>
    <skos:prefLabel xml:lang="en">pseudolocalization</skos:prefLabel>
    <skos:definition xml:lang="en">Transforming source text into a synthetic locale to expose layout and localization defects.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/globalization.md" />
    <skos:scopeNote xml:lang="en">Synthetic text is not a human-language translation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextDirection" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PullThroughCache">
    <rdfs:label xml:lang="en">pull-through cache</rdfs:label>
    <skos:prefLabel xml:lang="en">pull-through cache</skos:prefLabel>
    <skos:definition xml:lang="en">A registry mirror that fetches and retains upstream content in response to local pull requests.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RegistryMirror" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#QEMU">
    <rdfs:label xml:lang="en">QEMU</rdfs:label>
    <skos:prefLabel xml:lang="en">QEMU</skos:prefLabel>
    <skos:definition xml:lang="en">A machine emulator and virtualizer used in VM backends, device emulation, and image tooling.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/host/ubuntu.kvm/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/host-macos.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Quantity">
    <rdfs:label xml:lang="en">quantity</rdfs:label>
    <skos:prefLabel xml:lang="en">quantity</skos:prefLabel>
    <skos:definition xml:lang="en">A measured or configured magnitude with an explicit unit and scope.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-perf.md" />
    <skos:scopeNote xml:lang="en">Do not treat values from different scopes or units as directly interchangeable.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#QueryExecution">
    <rdfs:label xml:lang="en">query execution</rdfs:label>
    <skos:prefLabel xml:lang="en">query execution</skos:prefLabel>
    <skos:definition xml:lang="en">Running an accepted query under the configured database role and result bounds.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:expectedOutput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#QueryResult" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#QueryResult">
    <rdfs:label xml:lang="en">query result</rdfs:label>
    <skos:prefLabel xml:lang="en">query result</skos:prefLabel>
    <skos:definition xml:lang="en">The rows and columns returned by an accepted database query.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">No actual result rows are part of the ontology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#TextSQLDomainEntity" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RateLimitFailure">
    <rdfs:label xml:lang="en">rate-limit failure</rdfs:label>
    <skos:prefLabel xml:lang="en">rate-limit failure</skos:prefLabel>
    <skos:definition xml:lang="en">A dependency refuses or delays a request because an allowed request rate or quota is exceeded.</skos:definition>
    <y:context xml:lang="en">Text-to-SQL example</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DependencyFailure" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Reachability">
    <rdfs:label xml:lang="en">reachability</rdfs:label>
    <skos:prefLabel xml:lang="en">reachability</skos:prefLabel>
    <skos:definition xml:lang="en">The ability to communicate with a target over a specified path and protocol at the time of observation.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/network.md" />
    <skos:scopeNote xml:lang="en">Reachability, service readiness, and workload correctness are separate claims.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Situation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ReadOnlyRole">
    <rdfs:label xml:lang="en">read-only database role</rdfs:label>
    <skos:prefLabel xml:lang="en">read-only database role</skos:prefLabel>
    <skos:definition xml:lang="en">A database authorization profile granting only the selected reads required by an application.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/db/schema.sql" />
    <skos:scopeNote xml:lang="en">Column-level grants provide a separate enforcement layer from application SQL checks.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ReadinessProbe">
    <rdfs:label xml:lang="en">readiness probe</rdfs:label>
    <skos:prefLabel xml:lang="en">readiness probe</skos:prefLabel>
    <skos:definition xml:lang="en">A check determining whether an application is ready to receive traffic or the next operation.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/kubernetes.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev-project/blob/ee1f65d0b5f53e2632dc0e3439b5707609659f77/example/text-to-sql/README.md" />
    <skos:scopeNote xml:lang="en">Readiness is different from merely having a running process.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HealthProbe" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ReadinessVerdict">
    <rdfs:label xml:lang="en">readiness verdict</rdfs:label>
    <skos:prefLabel xml:lang="en">readiness verdict</skos:prefLabel>
    <skos:definition xml:lang="en">A recorded conclusion about whether prerequisites support a next operation, with the available evidence and uncertainty.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/system-diagnostic.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:scopeNote xml:lang="en">A successful tool invocation is not automatically a positive readiness verdict.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecloneProject">
    <rdfs:label xml:lang="en">reclone project</rdfs:label>
    <skos:prefLabel xml:lang="en">reclone project</skos:prefLabel>
    <skos:definition xml:lang="en">Rebuilding a project checkout under the configured recovery policy after a recoverable checkout problem.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Not a substitute for supplying missing repository permission.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryAction" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>reclone_project</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#ReconnectRecommendation">
    <rdfs:label xml:lang="en">reconnect</rdfs:label>
    <skos:prefLabel xml:lang="en">reconnect</skos:prefLabel>
    <skos:definition xml:lang="en">Advice to reestablish a transport or service connection.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecoveryRecommendation" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>reconnect</y:codeToken>
    <y:codeVocabulary>recoveryRecommendation</y:codeVocabulary>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecoveryAction">
    <rdfs:label xml:lang="en">recovery action</rdfs:label>
    <skos:prefLabel xml:lang="en">recovery action</skos:prefLabel>
    <skos:definition xml:lang="en">An actual bounded operation intended to restore a failed prerequisite or execution path.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Distinct from a suggestion, a recorded outcome, and repeated evidence of the same incident.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#addressesIncident" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecoveryLedger">
    <rdfs:label xml:lang="en">recovery ledger</rdfs:label>
    <skos:prefLabel xml:lang="en">recovery ledger</skos:prefLabel>
    <skos:definition xml:lang="en">Persistent records of recovery attempts and their results, used to enforce per-fingerprint limits.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">If the ledger cannot be safely maintained, a bounded repair must not proceed without its accounting.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IncidentFingerprint" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecoveryRecommendation">
    <rdfs:label xml:lang="en">recovery recommendation</rdfs:label>
    <skos:prefLabel xml:lang="en">recovery recommendation</skos:prefLabel>
    <skos:definition xml:lang="en">An advisory category identifying a possible next response to a failure.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <skos:scopeNote xml:lang="en">Not proof that the response is authorized, implemented, or executed.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecoveryState">
    <rdfs:label xml:lang="en">recovery state</rdfs:label>
    <skos:prefLabel xml:lang="en">recovery state</skos:prefLabel>
    <skos:definition xml:lang="en">The recorded stage or result of recovery handling, such as advised, declined, applied, failed, or exhausted.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#State" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecurringHostIncident">
    <rdfs:label xml:lang="en">recurring host incident</rdfs:label>
    <skos:prefLabel xml:lang="en">recurring host incident</skos:prefLabel>
    <skos:definition xml:lang="en">A host incident repeating a previously recognized problem pattern.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">The repeated pattern can affect the same host or another host; no host identity, dated event, or occurrence count is instantiated.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HostIncident" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#RecurringIncident" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#RecurringIncident">
    <rdfs:label xml:lang="en">recurring incident</rdfs:label>
    <skos:prefLabel xml:lang="en">recurring incident</skos:prefLabel>
    <skos:definition xml:lang="en">An incident that repeats a previously recognized problem pattern rather than merely duplicating its evidence record.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/failure-schema.md" />
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/d599dce7428757e444aaa22b089e8c600fead64c/docs/pool-admin.md" />
    <skos:scopeNote xml:lang="en">Recurrence is optional and can span hosts or cycles; fingerprint equality supports grouping but does not prove a common root cause.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#recursAfter" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Incident" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Registry">
    <rdfs:label xml:lang="en">container registry</rdfs:label>
    <skos:prefLabel xml:lang="en">container registry</skos:prefLabel>
    <skos:definition xml:lang="en">A service that stores and distributes container manifests and blobs addressed by repository, tag, or digest.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
