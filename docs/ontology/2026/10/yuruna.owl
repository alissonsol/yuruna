  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#PoolIntent">
    <rdfs:label xml:lang="en">pool configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">pool configuration</skos:prefLabel>
