  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdFulfillment">
    <rdfs:label xml:lang="en">fulfillment</rdfs:label>
    <skos:prefLabel xml:lang="en">fulfillment</skos:prefLabel>
    <skos:definition xml:lang="en">Execution of the seller's delivery or service commitment for an accepted order.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">The prototype moves an order to settled only after ledger confirmation.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#fulfillsOrder" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdOrder" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdHashChain">
    <rdfs:label xml:lang="en">audit hash chain</rdfs:label>
    <skos:prefLabel xml:lang="en">audit hash chain</skos:prefLabel>
    <skos:definition xml:lang="en">Linked evidence rows whose payload hashes and chain head support integrity verification.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">An explicit empty chain can be valid; missing evidence is not an empty chain.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdIdempotentReplay">
    <rdfs:label xml:lang="en">idempotent business replay</rdfs:label>
    <skos:prefLabel xml:lang="en">idempotent business replay</skos:prefLabel>
    <skos:definition xml:lang="en">Repeating an identical business write without creating additional orders, instructions, refunds, notifications, or attribution where the contract guarantees it.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">Guarantees are operation-specific; memory-only coordinator handles have different restart behavior from persisted service records.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#IdempotentOperation" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdIntegrationGrant">
    <rdfs:label xml:lang="en">integration grant</rdfs:label>
    <skos:prefLabel xml:lang="en">integration grant</skos:prefLabel>
    <skos:definition xml:lang="en">A seller's authorization for a connector to perform selected tenant capabilities.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdConsentGrant" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdConnector" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdIntegrationPartner">
    <rdfs:label xml:lang="en">integration partner</rdfs:label>
    <skos:prefLabel xml:lang="en">integration partner</skos:prefLabel>
    <skos:definition xml:lang="en">The role connecting external seller systems under explicit supply-side grants.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">No buyer-data integration interface is implied.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdParticipantRole" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdInventory">
    <rdfs:label xml:lang="en">inventory</rdfs:label>
    <skos:prefLabel xml:lang="en">inventory</skos:prefLabel>
    <skos:definition xml:lang="en">The seller's stock and availability data used to avoid matching unavailable offers.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">The implemented inventory update contract uses monotonic source versions and rejects conflicting replay.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdInventoryVersion" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdInventoryVersion">
    <rdfs:label xml:lang="en">inventory source version</rdfs:label>
    <skos:prefLabel xml:lang="en">inventory source version</skos:prefLabel>
    <skos:definition xml:lang="en">The nonnegative monotonic version identifying the source position of an inventory update.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">Equal-version identical replay is allowed; equal-version different stock is a conflict.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Identifier" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>delta_ts</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdLifecycleEvidence">
    <rdfs:label xml:lang="en">matching lifecycle evidence</rdfs:label>
    <skos:prefLabel xml:lang="en">matching lifecycle evidence</skos:prefLabel>
    <skos:definition xml:lang="en">Evidence for the ordered creation, attestation, execution or abortion, and destruction of a matching environment.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/contracts/service-behavior.md" />
    <skos:scopeNote xml:lang="en">The auditor rejects missing or out-of-order lifecycle evidence.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#DiagnosticEvidence" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdHashChain" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdMandate">
    <rdfs:label xml:lang="en">mandate</rdfs:label>
    <skos:prefLabel xml:lang="en">mandate</skos:prefLabel>
    <skos:definition xml:lang="en">A grant allowing a delegate to act for a principal within specified scope, budget, closing authority, and expiry.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdConsentGrant" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#authorizesDelegate" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDelegate" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#representsPrincipal" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdPrincipal" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:codeToken>mandate</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdMatch">
    <rdfs:label xml:lang="en">match</rdfs:label>
    <skos:prefLabel xml:lang="en">match</skos:prefLabel>
    <skos:definition xml:lang="en">A result associating a private need with an offer that satisfies its applicable constraints.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">A proposed match is not automatically an accepted order or settled transaction.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#matchesNeed" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdNeed" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#matchesOffer" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdOffer" />
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdMatchingFabric">
    <rdfs:label xml:lang="en">matching fabric</rdfs:label>
    <skos:prefLabel xml:lang="en">matching fabric</skos:prefLabel>
    <skos:definition xml:lang="en">The coordinating and execution infrastructure that brings offers to a permitted matching environment and returns results.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SystemElement" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdNeed">
    <rdfs:label xml:lang="en">need</rdfs:label>
    <skos:prefLabel xml:lang="en">need</skos:prefLabel>
    <skos:definition xml:lang="en">A buyer's requested outcome together with constraints used to select fitting offers.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">No actual need content is retained in this ontology.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#requestedByBuyer" />
        <owl:someValuesFrom rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdBuyer" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdNeedConstraint" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdNeedConstraint">
    <rdfs:label xml:lang="en">need constraint</rdfs:label>
    <skos:prefLabel xml:lang="en">need constraint</skos:prefLabel>
    <skos:definition xml:lang="en">A requirement such as budget, location, deadline, or exclusion that a matching offer must satisfy.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Policy" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdNeedEnvelope">
    <rdfs:label xml:lang="en">need envelope</rdfs:label>
    <skos:prefLabel xml:lang="en">need envelope</skos:prefLabel>
    <skos:definition xml:lang="en">The opaque need representation passed into the prototype matching flow.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/design.md" />
    <skos:scopeNote xml:lang="en">Opaque handling in the prototype is not evidence of implemented end-to-end cryptographic sealing.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdNeed" />
    <y:implementationStatus xml:lang="en">Prototype; stronger isolation or cryptographic guarantees described in design are not established by the implementation.</y:implementationStatus>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdOffer">
    <rdfs:label xml:lang="en">offer</rdfs:label>
    <skos:prefLabel xml:lang="en">offer</skos:prefLabel>
    <skos:definition xml:lang="en">A seller's description of a deliverable product or service with terms, attributes, and availability.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/poc/db/schema.sql" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDomainEntity" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
