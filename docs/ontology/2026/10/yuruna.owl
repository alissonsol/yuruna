    <y:expectedInput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HelmChart" />
    <y:expectedInput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#HelmValues" />
    <y:expectedOutput rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#ApplicationWorkload" />
    <y:codeToken>Set-Workload.ps1</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WorkloadTestPhase">
    <rdfs:label xml:lang="en">workload test phase</rdfs:label>
    <skos:prefLabel xml:lang="en">workload test phase</skos:prefLabel>
    <skos:definition xml:lang="en">The sequence group used to deploy or validate application behavior after its prerequisites.</skos:definition>
    <y:context xml:lang="en">Yuruna</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/test-sequences.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Process" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:codeToken>workload</y:codeToken>
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#WriterLease">
    <rdfs:label xml:lang="en">writer lease</rdfs:label>
    <skos:prefLabel xml:lang="en">writer lease</skos:prefLabel>
    <skos:definition xml:lang="en">A time-bounded claim used to coordinate which service instance should perform shared-storage writes.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/download-agent.md" />
    <skos:altLabel xml:lang="en">single-writer lease</skos:altLabel>
    <skos:scopeNote xml:lang="en">The download agent uses it to reduce duplicate work; content-addressed generation handling supplies the underlying correctness safeguards.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#InformationArtifact" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
    <y:relatedConcept rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#SingleFlightDownload" />
  </owl:Class>
  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#Zot">
    <rdfs:label xml:lang="en">Zot</rdfs:label>
    <skos:prefLabel xml:lang="en">Zot</skos:prefLabel>
    <skos:definition xml:lang="en">The OCI registry software used in the caching service's image-distribution and pull-through paths.</skos:definition>
    <y:context xml:lang="en">Shared</y:context>
    <dcterms:source rdf:resource="https://github.com/alissonsol/yurunadev/blob/49bf4c9df89aa5ec604b892d06c3b0840a0e6465/docs/caching.md" />
    <rdfs:subClassOf rdf:resource="https://yuruna.com/ontology/2026/10/yuruna#Registry" />
    <y:evidenceBasis xml:lang="en">Source-defined concept; no occurrence asserted.</y:evidenceBasis>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://yuruna.com/ontology/2026/10/yuruna#hostedBy">
    <rdfs:label xml:lang="en">hosted by</rdfs:label>
    <skos:prefLabel xml:lang="en">hosted by</skos:prefLabel>
