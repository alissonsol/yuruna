  <owl:Class rdf:about="https://yuruna.com/ontology/2026/10/yuruna#AmisAdDemandInsight">
    <rdfs:label xml:lang="en">demand insight</rdfs:label>
    <skos:prefLabel xml:lang="en">demand insight</skos:prefLabel>
    <skos:definition xml:lang="en">An aggregate view of demand intended to inform offers, campaigns, and resource capacity.</skos:definition>
    <y:context xml:lang="en">AmisAd</y:context>
    <dcterms:source rdf:resource="https://github.com/alius-git/amisad.dev/blob/ba9f52ff8965883dc7f8f6c1626c8fa1fef6d533/plan/applications.md" />
    <skos:scopeNote xml:lang="en">Design privacy thresholds must not be interpreted as validated guarantees of every prototype report.</skos:scopeNote>
