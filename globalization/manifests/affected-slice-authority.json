    {
      "wireCode": "repository_access.unprobed",
      "path": "test/modules/Test.HostCondition.Mac.psm1",
      "matchCount": 2,
      "reason": "The macOS TCC grant state uses the same generic word but is not a repository-access protocol consumer."
