{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuruna.com/schema/yuruna.project-locale-source-hashes/v1",
  "title": "Project translation source-hash sidecar",
  "type": "object",
  "required": ["schema", "hashAlgorithm", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "yuruna.project-locale-source-hashes/v1" },
    "hashAlgorithm": { "const": "sha256-utf8-nfc-scalar-v1" },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["path", "fieldPath", "locale", "sourceHash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "fieldPath": { "type": "string", "pattern": "^/", "maxLength": 1024 },
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
        "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "origin": { "const": "machine" }
      }
    }
  }
}
