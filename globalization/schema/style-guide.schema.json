{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuruna.com/schema/yuruna.style-guide/v1",
  "title": "Yuruna locale style guide",
  "type": "object",
  "required": ["schema", "locale", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "yuruna.style-guide/v1" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "rules": { "type": "array", "minItems": 10, "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["id", "topic", "guidance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 80 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 120 },
        "guidance": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "origin": { "const": "machine" }
      }
    }
  }
}
