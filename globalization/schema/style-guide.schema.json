{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuruna.com/schema/yuruna.style-guide/v1",
  "title": "Yuruna locale style guide",
  "type": "object",
  "required": ["schema", "locale", "status", "terminologySource", "approvals", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "yuruna.style-guide/v1" },
    "locale": { "const": "pt-BR" },
    "status": { "enum": ["draft", "approved"] },
    "terminologySource": {
      "type": "object",
      "required": ["path", "hashAlgorithm", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "const": "globalization/terminology/pt-BR.terms.json" },
        "hashAlgorithm": { "const": "sha256-file-bytes-v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "approvals": {
      "type": "object",
      "required": ["translator", "independentReviewer"],
      "additionalProperties": false,
      "properties": {
        "translator": { "$ref": "#/definitions/approval" },
        "independentReviewer": { "$ref": "#/definitions/approval" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "approvals": {
            "properties": {
              "translator": { "properties": { "status": { "const": "approved" } } },
              "independentReviewer": { "properties": { "status": { "const": "approved" } } }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "approval": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "approvedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
        "approvedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "evidence": { "$ref": "#/definitions/evidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": { "required": ["approvedBy", "approvedAt", "evidence"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["approvedBy"] },
                { "required": ["approvedAt"] },
                { "required": ["evidence"] }
              ]
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["releaseVersion"],
      "additionalProperties": false,
      "properties": {
        "releaseVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "topic", "guidance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 80 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 120 },
        "guidance": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
