{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuruna.com/schema/yuruna.terminology/v1",
  "title": "Yuruna locale terminology source",
  "type": "object",
  "required": ["schema", "locale", "terms", "retiredNameRulings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "yuruna.terminology/v1" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "terms": { "type": "array", "minItems": 11, "items": { "$ref": "#/definitions/term" } },
    "retiredNameRulings": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/definitions/retiredNameRuling" }
    }
  },
  "definitions": {
    "term": {
      "type": "object",
      "required": ["sourceTerm", "meaning", "sourceHeadings", "decision"],
      "additionalProperties": false,
      "properties": {
        "sourceTerm": { "type": "string", "minLength": 1, "maxLength": 100 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sourceHeadings": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "decision": { "$ref": "#/definitions/termDecision" }
      }
    },
    "termDecision": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["translated", "retained", "explained"] },
        "targetTerm": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "origin": { "const": "machine" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["translated", "explained"] } } },
          "then": { "required": ["targetTerm"] } },
        { "if": { "properties": { "status": { "const": "explained" } } },
          "then": { "required": ["rationale"] } },
        { "if": { "properties": { "status": { "const": "retained" } } },
          "then": { "not": { "required": ["targetTerm"] } } }
      ]
    },
    "retiredNameRuling": {
      "type": "object",
      "required": ["retired", "current", "translationPolicy"],
      "additionalProperties": false,
      "properties": {
        "retired": { "type": "string", "minLength": 1, "maxLength": 200 },
        "current": { "type": "string", "minLength": 1, "maxLength": 200 },
        "translationPolicy": { "const": "preserve-exact-english" }
      }
    }
  }
}
