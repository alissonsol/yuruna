{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuruna.com/schema/yuruna.tooling-decision/v1",
  "title": "Yuruna localization tooling decisions",
  "description": "Recorded answers to questions about how localization work reaches people outside this repository. A provisional answer is one nobody with the authority to give it has given yet.",
  "type": "object",
  "required": ["schema", "note", "xliff"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "yuruna.tooling-decision/v1" },
    "note": { "type": "string", "minLength": 1 },
    "xliff": { "$ref": "#/definitions/decision" }
  },
  "definitions": {
    "decision": {
      "type": "object",
      "required": ["decision", "provisional", "decidedOn", "decidedBy", "rationale", "replacedBy"],
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["Required", "NotRequired"] },
        "provisional": { "type": "boolean" },
        "decidedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "decidedBy": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "replacedBy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
