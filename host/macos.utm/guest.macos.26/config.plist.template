		<dict>
			<key>Mode</key>
			<string>Shared</string>
			<key>MacAddress</key>
			<string>__MAC_ADDRESS__</string>
		</dict>
	</array>
	<!-- REGION: Serial -->
	<key>Serial</key>
	<array/>
