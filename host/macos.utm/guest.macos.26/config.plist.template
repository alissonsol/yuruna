<plist version="1.0">
<dict>
	<key>Backend</key>
	<string>Apple</string>
	<key>ConfigurationVersion</key>
	<integer>4</integer>
	<!-- REGION: Information -->
	<key>Information</key>
	<dict>
		<key>Icon</key>
		<string>macOS</string>
		<key>IconCustom</key>
		<false/>
		<key>Name</key>
		<string>__VM_NAME__</string>
		<key>UUID</key>
		<string>__VM_UUID__</string>
	</dict>
	<!-- REGION: System -->
	<key>System</key>
	<dict>
		<key>Architecture</key>
		<string>aarch64</string>
		<key>CPUCount</key>
		<integer>__CPU_COUNT__</integer>
		<key>MemorySize</key>
		<integer>__MEMORY_SIZE__</integer>
