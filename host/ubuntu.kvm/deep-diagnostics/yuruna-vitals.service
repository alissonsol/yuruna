[Unit]
Description=Yuruna deep diagnostics: host vitals into the kernel log every 10 seconds

[Service]
Type=simple
ExecStart=/usr/local/lib/yuruna/deep-diagnostics/yuruna-vitals.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
