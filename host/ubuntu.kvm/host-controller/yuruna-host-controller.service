[Unit]
Description=Yuruna host controller
StartLimitIntervalSec=0

[Service]
Type=simple
User=@ACCOUNT@
SupplementaryGroups=libvirt kvm
ExecStart=/bin/sh @SHIM@
Restart=always
RestartSec=5
KillMode=process
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
