#cloud-config
# LICENSEURI https://yuruna.link/license
# Copyright (c) 2019-2026 by Alisson Sol et al.
#vim:syntax=yaml
# NoCloud user-data for Amazon Linux 2023 (parity with hyperv/kvm/utm siblings).
# chpasswd default expire=true is LOAD-BEARING: it fires the first-login Current/New/Retype prompt.
users:
  - default
  - name: USERNAME_PLACEHOLDER
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - SSH_AUTHORIZED_KEY_PLACEHOLDER
# --- REGION: https://yuruna.link/vmconfig#ssh_authorized_keys-at-top-level
ssh_authorized_keys:
  - SSH_AUTHORIZED_KEY_PLACEHOLDER
# --- REGION: https://yuruna.link/vmconfig#chpasswd-list-schema
chpasswd:
  list: |
    USERNAME_PLACEHOLDER:PLAINTEXT_PASSWORD_PLACEHOLDER
ssh_pwauth: true

# --- REGION: https://yuruna.link/vmconfig#hv_balloon-denylist
write_files:
  - path: /etc/modprobe.d/denylist-hv-balloon.conf
    content: |
      blacklist hv_balloon
    permissions: '0644'
  # --- REGION: https://yuruna.link/vmconfig#install-yuruna-lib
  - path: /usr/local/lib/yuruna/yuruna-retry.sh
    encoding: base64
    content: YURUNA_RETRY_LIB_BASE64_PLACEHOLDER
    permissions: '0644'
  - path: /usr/local/lib/yuruna/yuruna-versions.sh
    encoding: base64
    content: YURUNA_VERSIONS_BASE64_PLACEHOLDER
    permissions: '0644'
  - path: /usr/local/lib/yuruna/fetch-and-execute.sh
    encoding: base64
    content: YURUNA_FAE_BASE64_PLACEHOLDER
    permissions: '0755'
  - path: /usr/local/lib/yuruna/yuruna-network.sh
    encoding: base64
    content: YURUNA_NETWORK_BASE64_PLACEHOLDER
    permissions: '0755'
  - path: /usr/local/lib/yuruna/yuruna-host-locate.sh
    encoding: base64
    content: YURUNA_HOST_LOCATE_BASE64_PLACEHOLDER
    permissions: '0755'
  # --- REGION: https://yuruna.link/vmconfig#host-address-refresh-timer
  # fetch-and-execute repairs the host address at the top of each step, which
  # leaves one window open: a step that runs for many minutes can watch the
  # host renumber underneath it and has no way back. The timer closes that
  # window for everything else in the guest -- the project's own scripts, the
  # perf checkpoints, the log uploads -- none of which pass through the fetch
  # path and all of which read the same host.env.
  #
  # Affordable at this cadence because the resolver probes before it asks:
  # while the address is still good the minute's work is one LAN round trip
  # and no writes. A oneshot rather than a daemon -- there is no state to
  # carry between ticks, and a oneshot cannot wedge.
  - path: /etc/systemd/system/yuruna-host-locate.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh Yuruna host coordinates if the host has changed address
      # Ordered INTO the network-online barrier rather than after it. Anything
      # in this guest that needs the host waits on that target, so finishing
      # before it is what guarantees those consumers never read a stale
      # address -- and it does so without this unit naming any of them, which
      # is the whole point of the indirection.
      #
      # After the wait-online services (whichever the image ships; ordering
      # against an absent unit is a no-op) so this runs with an address in
      # hand rather than before DHCP has answered.
      After=network.target NetworkManager-wait-online.service systemd-networkd-wait-online.service
      Before=network-online.target

      [Service]
      Type=oneshot
      # A resolver that cannot finish must not hold the boot open. Every call
      # inside is already wall-clock bounded; this is the backstop for the day
      # one of them is not.
      TimeoutStartSec=30
      ExecStart=/usr/local/lib/yuruna/yuruna-host-locate.sh

      [Install]
      WantedBy=network-online.target
  - path: /etc/systemd/system/yuruna-host-locate.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic Yuruna host coordinate refresh

      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=60s
      AccuracySec=5s

      [Install]
      WantedBy=timers.target
  # --- REGION: https://yuruna.link/definition#defining-the-two-source-scheme-for-framework-and-project-urls
  # git does NOT read GH_TOKEN (a gh(1) convention); without this GIT_ASKPASS shim a private
  # clone hangs on a username prompt -- "Private repositories" in the REGION topic above.
  - path: /usr/local/lib/yuruna/git-askpass.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      case "$1" in
          Username*) echo "x-access-token" ;;
          *)         echo "${GH_TOKEN}" ;;
      esac

runcmd:
  - rmmod hv_balloon 2>/dev/null || true
  # --- REGION: https://yuruna.link/vmconfig#login-session-budget
  - bash -c 'sed -i -E "/^[#[:space:]]*LOGIN_TIMEOUT/d" /etc/login.defs && echo "LOGIN_TIMEOUT 180" >> /etc/login.defs'
  # --- REGION: https://yuruna.link/vmconfig#enable-sshd-on-first-boot
  - systemctl enable --now sshd || true
  # --- REGION: https://yuruna.link/vmconfig#al2023-framebuffer-console
  - systemctl enable --now getty@tty1.service || true
  - chvt 1 2>/dev/null || true
  - bash -c 'setterm --blank 0 --powersave off --cursor on > /dev/tty1 2>/dev/null || true'
# === YURUNA_OVERLAY_RUNCMD_CONSOLEBLANK ===
  # --- REGION: https://yuruna.link/vmconfig#console-quiet
# === YURUNA_OVERLAY_RUNCMD_QUIET_LOGLEVEL ===
  # --- REGION: https://yuruna.link/vmconfig#gnome-auto-open-terminal-on-login
  - mkdir -p /etc/xdg/autostart
  - |
    cat > /etc/xdg/autostart/open-terminal.desktop << 'DESKTOP'
    [Desktop Entry]
    Type=Application
    Name=Open Terminal
    Exec=ptyxis --new-window
    X-GNOME-Autostart-enabled=true
    NoDisplay=true
    DESKTOP
  # --- REGION: https://yuruna.link/vmconfig#yuruna-host-coordinates
  # Baked host+repo coordinates a hand-run fetch-and-execute falls back to; the runner's per-step E_FB_REPO/E_FB_REF override these.
  #
  # The last two keys are a different kind of coordinate: an ADDRESS goes
  # stale the moment the host renumbers, so they carry the two identities
  # that do not. YURUNA_HOST_ID names the host independently of where it
  # currently answers, and the caching-proxy address is pinned by MAC
  # reservation, which makes it the one address a guest can be born knowing.
  # Together they let yuruna-host-locate repair the address above instead of
  # the guest being stranded by it. Either one empty (no pool directory in
  # this lab) simply leaves the baked address as the only answer, which is
  # where every guest was before.
  - mkdir -p /etc/yuruna
  - |
    cat > /etc/yuruna/host.env << 'EOF'
    YURUNA_STATUS_SERVICE_IP=YURUNA_STATUS_SERVICE_IP_PLACEHOLDER
    YURUNA_STATUS_SERVICE_PORT=YURUNA_STATUS_SERVICE_PORT_PLACEHOLDER
    YURUNA_GITHUB_REPO=YURUNA_GITHUB_REPO_PLACEHOLDER
    YURUNA_GITHUB_REF=YURUNA_GITHUB_REF_PLACEHOLDER
    YURUNA_FRAMEWORK_URL=YURUNA_FRAMEWORK_URL_PLACEHOLDER
    YURUNA_PROJECT_URL=YURUNA_PROJECT_URL_PLACEHOLDER
    YURUNA_HOST_ID=YURUNA_HOST_ID_PLACEHOLDER
    YURUNA_CACHING_PROXY_SERVICE_IP=YURUNA_CACHING_PROXY_SERVICE_IP_PLACEHOLDER
    EOF
  - bash -c 'grep -q yuruna-host /etc/hosts || echo "YURUNA_STATUS_SERVICE_IP_PLACEHOLDER yuruna-host" >> /etc/hosts'
  - systemctl enable --now yuruna-host-locate.service yuruna-host-locate.timer || true
  # --- REGION: https://yuruna.link/definition#defining-the-two-source-scheme-for-framework-and-project-urls
  # --- REGION: https://yuruna.link/network#why-git-never-prompts-here
  # Never let git ask a question. There is no terminal to answer it: this guest
  # is driven by OCR of a console, so a credential prompt is not a failure but a
  # HANG, and the step's whole timeout is spent before anyone learns the clone
  # could not authenticate.
  #
  # Written unconditionally, and separately from the token below, because the two
  # have opposite conditions. A token being present is what makes a private clone
  # succeed; a token being ABSENT is what makes it prompt. Gating the
  # prompt-suppression on the token installs it in exactly the case that does not
  # need it and omits it in the case that does.
  - |
    cat > /etc/profile.d/yuruna-git-noprompt.sh << 'EOF'
    export GIT_TERMINAL_PROMPT=0
    export GIT_ASKPASS=/usr/local/lib/yuruna/git-askpass.sh
    EOF
    chmod 0644 /etc/profile.d/yuruna-git-noprompt.sh
    printf 'GIT_TERMINAL_PROMPT=0\nGIT_ASKPASS=/usr/local/lib/yuruna/git-askpass.sh\n' >> /etc/environment
  # Token for private framework/project URLs, delivered on the seed ISO (never the OCR'd console, never HTTP); written to /etc/profile.d (login shells) and ~/.bashrc (the runner's interactive shell), skipped when unset.
  - |
    if [ -n 'GH_TOKEN_PLACEHOLDER' ]; then
    cat > /etc/profile.d/yuruna-github.sh << 'EOF'
    export GH_TOKEN="GH_TOKEN_PLACEHOLDER"
    export GIT_ASKPASS=/usr/local/lib/yuruna/git-askpass.sh
    export GIT_TERMINAL_PROMPT=0
    EOF
    chmod 0644 /etc/profile.d/yuruna-github.sh
    cat >> /home/USERNAME_PLACEHOLDER/.bashrc << 'EOF'
    export GH_TOKEN="GH_TOKEN_PLACEHOLDER"
    export GIT_ASKPASS=/usr/local/lib/yuruna/git-askpass.sh
    export GIT_TERMINAL_PROMPT=0
    EOF
    chown USERNAME_PLACEHOLDER:USERNAME_PLACEHOLDER /home/USERNAME_PLACEHOLDER/.bashrc
    fi
  # --- REGION: https://yuruna.link/vmconfig#wget-no_proxy
  - |
    cat >> /etc/wgetrc << 'EOF'
    no_proxy = YURUNA_STATUS_SERVICE_IP_PLACEHOLDER
    EOF
  # --- REGION: https://yuruna.link/vmconfig#timezone-via-ip-geolocation-and-ntp
  - timedatectl set-ntp true
  - |
    # Best-effort timezone from geo-IP; explicit branches so a failure names its
    # cause (curl missing / fetch error / empty response / timedatectl reject).
    set +e
    if ! command -v curl >/dev/null 2>&1; then
      echo "Yuruna => Timezone sync skipped: curl not available" >&2
    else
      GEOTZ=$(curl -s --max-time 10 "http://ip-api.com/line?fields=timezone")
      CRC=$?
      if [ "$CRC" -ne 0 ]; then
        echo "Yuruna => Timezone sync failed: geo-IP fetch error (curl rc=$CRC; network or API)" >&2
      elif [ -z "$GEOTZ" ]; then
        echo "Yuruna => Timezone sync failed: empty geo-IP response" >&2
      elif timedatectl set-timezone "$GEOTZ"; then
        echo "Yuruna => Timezone set to $GEOTZ" >&2
      else
        echo "Yuruna => Timezone sync failed: timedatectl rejected $GEOTZ" >&2
      fi
    fi
# === YURUNA_OVERLAY_POWER_STATE ===
