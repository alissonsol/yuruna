          echo "yuruna: zot syncs from Docker Hub with the seeded account credential -- pulls meter against that account, not against this egress IP"
        else
          echo "== YURUNA: /etc/zot/sync-credentials.json could not be handed to the zot account -- zot cannot read its own credential and will not start =="
        fi
        ;;
      2)
        echo "yuruna: no Docker Hub account in the seed; zot syncs anonymously against the ~100 pulls/hour this egress IP shares with every guest"
        ;;
      *)
        echo "== YURUNA: could not reconcile /etc/zot/sync-credentials.json with /etc/zot/config.json (exit $RC) -- zot will not start while credentialsFile names a file it cannot read =="
        ;;
