                "gridPos": { "h": 10, "w": 24, "x": 0, "y": 49 },
                "datasource": { "type": "loki", "uid": "yuruna-loki" },
                "targets": [
                  { "refId": "A", "expr": "{pool=\"$pool\", src=\"event\"} | json", "datasource": { "type": "loki", "uid": "yuruna-loki" } }
