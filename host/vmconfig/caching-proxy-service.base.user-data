    # config pointing at a file that is gone. Rewriting the whole document is
    # safe because json preserves member and array order, and the order of
    # registries[] IS the upstream routing table.
    if sync.pop('credentialsFile', None) is not None:
        tmp = cfg_path + '.tmp'
        with open(tmp, 'w') as fh:
            json.dump(cfg, fh, indent=2)
            fh.write('\n')
