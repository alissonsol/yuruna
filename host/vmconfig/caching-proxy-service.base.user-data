              },
              {
                "id": 9,
                "type": "logs",
                "title": "Cycle status transitions across the pool (24h)",
                "description": "One line each time a host's cycle changes state (running -> pass/fail), from the status.json poll: hostId, cycleStartUtc, overallStatus and a baseUrl for drill-down. The cycle-level audit trail behind the table and timeline above. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
                "gridPos": { "h": 9, "w": 24, "x": 0, "y": 59 },
                "datasource": { "type": "loki", "uid": "yuruna-loki" },
                "targets": [
