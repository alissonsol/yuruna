    # uncaught exception as 1, which is why the fallback is not spelled 1).
    python3 - "$CRED" /etc/zot/config.json <<'EOF_HUB_CRED'
    import json, os, sys
    cred_path, cfg_path = sys.argv[1], sys.argv[2]
    try:
        with open(cred_path) as fh:
            entry = json.load(fh).get('registry-1.docker.io') or {}
    except (OSError, ValueError):
        entry = {}
    if entry.get('username') and entry.get('password'):
        sys.exit(0)
    with open(cfg_path) as fh:
        cfg = json.load(fh)
    sync = cfg.get('extensions', {}).get('sync', {})
