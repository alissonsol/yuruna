    # embed a control character in the linker flag.
    CPS_VERSION="$(wget $YR_FLAGS --no-cache --timeout=15 --tries=3 -q -O - "${YR_BASE}VERSION" 2>/dev/null | head -n1 | tr -d '[:space:]' || true)"
    [ -n "$CPS_VERSION" ] || CPS_VERSION=dev
    if [ "$CPS_OK" -eq 1 ] && /usr/bin/go build -ldflags "-X main.version=$CPS_VERSION" -o caching-proxy-service . ; then
