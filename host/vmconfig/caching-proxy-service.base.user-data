#vim:syntax=yaml
# --- REGION: https://yuruna.link/vmconfig/caching-proxy-service
# --- REGION: https://yuruna.link/429f3d06-0033
hostname: yuruna-caching-proxy-service
# --- REGION: https://yuruna.link/429f3d06-0034
users:
  - name: caching-proxy-service-admin
    gecos: caching-proxy-service debug user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # --- REGION: https://yuruna.link/429f3d06-000d
    plain_text_passwd: PASSWORD_PLACEHOLDER
    ssh_authorized_keys:
      - SSH_AUTHORIZED_KEY_PLACEHOLDER
chpasswd:
  expire: false
  users:
    - name: caching-proxy-service-admin
      password: PASSWORD_PLACEHOLDER
      type: text
ssh_pwauth: true
# --- REGION: https://yuruna.link/429f3d06-0035
