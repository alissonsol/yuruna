                "options": { "showTime": true, "showLabels": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true }
              },
              {
                "id": 16,
                "type": "table",
                "title": "Incidents by failure class (window)",
                "description": "Per-host incidents over the dashboard time range, grouped by the dominant failure class carried ON the incident object (dominantClass on the src=incident open line). Distinct from 'Failures by class & severity' above, which counts step_failure events regardless of whether they formed an incident -- this counts the incidents themselves. Sorted by count. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 68 },
                "datasource": { "type": "loki", "uid": "yuruna-loki" },
                "targets": [
                  { "refId": "A", "expr": "sum by (dominantClass) (count_over_time({pool=\"$pool\", src=\"incident\"} | json | event=\"incident_open\" [$__range]))", "instant": true, "format": "table", "datasource": { "type": "loki", "uid": "yuruna-loki" } }
