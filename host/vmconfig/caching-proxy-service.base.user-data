  # --- REGION: https://yuruna.link/429f3d06-0079
  - |
    # Seed on the pool NAS, where the apache alias above points and where the
    # pool-control-service VM can also write. Skipped entirely when the share is not
    # mounted: creating the repo under an unmounted mountpoint would put it on
    # local disk, and the NAS mounting later would shadow it -- stranding any
    # intent written in between.
    INTENT_GIT=/mnt/ypool-nas/pool-intent.git
    if ! mountpoint -q /mnt/ypool-nas 2>/dev/null; then
      echo "yuruna: /mnt/ypool-nas not mounted; skipping pool intent seeding (the route 404s until it is)." >&2
    elif [ ! -d "$INTENT_GIT/refs" ]; then
      install -d -o www-data -g www-data /var/lib/yuruna || true
      git init --bare --initial-branch=main "$INTENT_GIT" || true
      # cifs maps every file's mode from the mount options, so git would see a
      # permission change on each file it wrote back.
      git -C "$INTENT_GIT" config core.fileMode false || true
      # Refresh the dumb-HTTP indexes after EVERY push via git's built-in rather than a
      # post-update hook: a hook on cifs never becomes executable (the mount fixes
      # modes), so info/refs would go stale the moment the pool-control-service UI
      # wrote intent, and runners would keep fetching the previous refs.
      git -C "$INTENT_GIT" config receive.updateServerInfo true || true
      TMP_SEED=$(mktemp -d)
      git -C "$TMP_SEED" init -q --initial-branch=main || true
      # schemaVersion 2, matching pools.schema.yml's `const: 2`. A store seeded
      # at 1 READS fine -- nothing validates on read -- and then fails every
      # write with "Expected 2 at /schemaVersion", so the store looks healthy
      # until the first admin CLI tries to save.
      printf 'schemaVersion: 2\npools: []\n' > "$TMP_SEED/pools.yml"
      git -C "$TMP_SEED" add -A || true
      git -C "$TMP_SEED" -c user.name=yuruna -c user.email=pool@yuruna.local commit -q -m 'seed pool intent' || true
      git -C "$TMP_SEED" push -q "$INTENT_GIT" HEAD:main || true
      rm -rf "$TMP_SEED"
      git -C "$INTENT_GIT" update-server-info || true
      # No chown: the cifs mount assigns ownership from its uid/gid options, so
      # a chown here is at best a no-op and can re-impose an owner-only ACL that
      # locks out the pool-control-service VM writing the same share.
      echo "yuruna: pool intent store seeded at $INTENT_GIT"
    fi
    a2enconf yuruna-pool-intent || true
    systemctl reload apache2 || systemctl restart apache2 || true
