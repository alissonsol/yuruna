#vim:syntax=yaml
# --- REGION: https://yuruna.link/vmconfig/caching-proxy-service
# --- REGION: https://yuruna.link/vmconfig/caching-proxy-service#squid-cache-hostname-vs-template-name
hostname: yuruna-caching-proxy-service
# --- REGION: https://yuruna.link/vmconfig/caching-proxy-service#users-replace-cloud-image-default-with-a-per-vm-admin-account
users:
  - name: caching-proxy-service-admin
    gecos: caching-proxy-service debug user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # --- REGION: https://yuruna.link/vmconfig#unlocked-account-needs-plain_text_passwd
    plain_text_passwd: PASSWORD_PLACEHOLDER
    ssh_authorized_keys:
      - SSH_AUTHORIZED_KEY_PLACEHOLDER
chpasswd:
  expire: false
  users:
    - name: caching-proxy-service-admin
      password: PASSWORD_PLACEHOLDER
      type: text
ssh_pwauth: true
# --- REGION: https://yuruna.link/vmconfig/caching-proxy-service#grafana-apt-repo-inline-gpg-key
