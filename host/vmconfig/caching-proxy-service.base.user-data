    # republishes as caching_proxy_recent_requests. Loopback: the parser also
    # listens on the LAN, but a hop between two daemons on one box has no
    # reason to leave it.
    CACHING_PROXY_PARSER_URL=http://127.0.0.1:9302
    EOF
        echo "yuruna: caching-proxy-service ($CPS_VERSION) built and installed at /usr/local/bin/caching-proxy-service"
    else
        echo "== YURUNA: caching-proxy-service build failed -- the proxy still serves traffic, but the pool cannot ask this VM about itself and the offline / no-upstream switches stay SSH-only. Source attempted: ${YR_SRC}. =="
    fi
