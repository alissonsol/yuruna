    PA_VERSION="$(wget $YR_FLAGS --no-cache --timeout=15 --tries=3 -q -O - "${YR_BASE}VERSION" 2>/dev/null | head -n1 | tr -d '[:space:]' || true)"
    [ -n "$PA_VERSION" ] || PA_VERSION=dev
