    echo "== YURUNA: caching-proxy-service readiness =="
    for svc in squid apache2 grafana-server prometheus prometheus-node-exporter loki promtail zot; do
      printf '  %-16s %s\n' "$svc" "$(systemctl is-active "$svc" 2>/dev/null || echo inactive)"
    done
    # The canary's first reading, echoed where the boot log already answers
    # "did this VM come up right". A registry that serves /v2/ but not manifests
    # passes every other line of this summary. Residency is carried too: a
    # freshly built cache holds none of the images a guest pulls, and that is a
    # property of the boot worth stating rather than discovering mid-provision.
    # The residency alternative matches leading whitespace by shape rather than
    # by count: the page nests those lines under a set header, and a fixed
    # indent here silently stops matching the moment that nesting changes.
    if [ -r /var/www/html/cache-health ]; then
      grep -E '^zot (/v2/|manifest|resident-tag|guest-path)|^ +resident ' /var/www/html/cache-health | sed 's/^/  /'
    fi
    for hp in 3128 3129 80 3000 9090 3100 5000; do
      if ss -ltn 2>/dev/null | grep -q ":$hp "; then st=listening; else st="NOT LISTENING"; fi
      printf '  port %-5s %s\n' "$hp" "$st"
    done
    [ -f /etc/squid/ssl_cert/ca.pem ] || echo "  MISSING /etc/squid/ssl_cert/ca.pem"
    [ -d /var/lib/squid/ssl_db ]      || echo "  MISSING /var/lib/squid/ssl_db"
