                { "matcher": { "id": "byName", "options": "target" }, "properties": [ { "id": "custom.hidden", "value": true } ] },
                { "matcher": { "id": "byName", "options": "goPath" }, "properties": [ { "id": "custom.hidden", "value": true } ] },
                { "matcher": { "id": "byName", "options": "hostIdDashed" }, "properties": [ { "id": "custom.hidden", "value": true } ] }
