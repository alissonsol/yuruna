package_update: true
packages:
  # --- REGION: https://yuruna.link/429f3d06-0036
  - squid-openssl
  # --- REGION: https://yuruna.link/429f3d06-0037
  - apache2
  # --- REGION: https://yuruna.link/429f3d06-0038
  - prometheus
  # Host-level CPU/memory/disk/network: answers "is the box starved or is the
  # service blocked?" -- the first question a stalled cache raises.
  - prometheus-node-exporter
  - grafana
  - loki
  - promtail
  # --- REGION: https://yuruna.link/429f3d06-0039
  - acl
  - golang-go
  # --- REGION: https://yuruna.link/429f3d06-003a
  - net-tools       # ifconfig, netstat, route, arp
  - iputils-ping    # ping, ping6
  # --- REGION: https://yuruna.link/429f3d06-003b
  - openssl
  # --- REGION: https://yuruna.link/429f3d06-003c
  - unattended-upgrades
  # --- REGION: https://yuruna.link/429f3d06-003d
  - cifs-utils
  - sqlite3
  # jq: parse the config service JSON (NAS creds) without shell-quoting the password.
  - jq
  # === YURUNA_OVERLAY_HOST_AGENT_PKG ===
write_files:
  # --- REGION: https://yuruna.link/4220a755-004c
  - path: /etc/ssh/sshd_config.d/60-yuruna-keepalive.conf
    permissions: '0644'
    owner: root:root
    content: |
      ClientAliveInterval 15
      ClientAliveCountMax 4
      TCPKeepAlive yes
  # === YURUNA_OVERLAY_NIC_OFFLOAD ===
  # --- REGION: https://yuruna.link/429f3d06-003e
  - path: /etc/apt/apt.conf.d/80-yuruna-retries
    permissions: '0644'
    owner: root:root
    content: |
      Acquire::Retries "5";
      Acquire::Retries::Delay-Max "60";
      // Wait for a busy dpkg/apt lock instead of failing instantly: this seed
      // installs unattended-upgrades and arms the apt-daily timers, which can
      // hold the lock during first boot.
      DPkg::Lock::Timeout "300";
  # --- REGION: https://yuruna.link/429f3d06-003f
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: '0644'
    owner: root:root
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";
  # --- REGION: https://yuruna.link/429f3d06-0040
  - path: /etc/apache2/conf-available/yuruna-pool-intent.conf
    permissions: '0644'
    owner: root:root
    content: |
      Alias /pool-intent.git /mnt/ypool-nas/pool-intent.git
      <Directory /mnt/ypool-nas/pool-intent.git>
          Options +Indexes
          Require ip 127.0.0.1
          Require ip 10.0.0.0/8
          Require ip 172.16.0.0/12
          Require ip 192.168.0.0/16
      </Directory>
  # --- REGION: https://yuruna.link/429f3d06-0037
  - path: /etc/apache2/conf-available/yuruna-landing.conf
    permissions: '0644'
    owner: root:root
    content: |
      # --- REGION: https://yuruna.link/42f6b05f-0044
      # Bare :80 serves the landing page: an index of this lab's dashboards and
      # extension services, each linked only where it is actually reachable.
      #
      # It PROXIES rather than redirects, and that is the whole design. The page
      # is served by the caching-proxy-service daemon on 9310, which is not in
      # the host port-map set (Get-CachingProxyServiceExposedPort) -- a redirect
      # would hand the browser an address it cannot reach whenever the VM is
      # behind a port map rather than bridged. Proxying keeps the operator on
      # :80, which IS mapped everywhere.
      #
      # Not a redirect straight into a Grafana dashboard either. Grafana is a
      # single-page app: a browser too old to run it lands on a blank screen
      # with nothing to say why. The landing page is plain server-rendered
      # HTML with no script at all, so it renders on anything.
      #
      # ProxyPreserveHost, so the daemon sees the address the OPERATOR typed and
      # can build links from it; without it every link would point at 127.0.0.1.
      ProxyRequests Off
      ProxyPreserveHost On
      # <Directory>, not server level: mod_rewrite rules are NOT inherited into
      # <VirtualHost>, and Ubuntu serves :80 from the stock 000-default vhost --
      # a server-level rule parses cleanly and then never fires. In this context
      # the match is relative to the directory, so the empty string is '/'.
      #
      # The pattern stays anchored to '/' and '/index.html'. Everything else
      # under this root is a real file the lab depends on -- the squid CA, the
      # Prometheus text exporters, cache-health, the pool-intent git tree -- and
      # a broader rule would proxy those into a daemon that has never heard of
      # them.
      <Directory /var/www/html>
          RewriteEngine On
          RewriteRule ^(index\.html)?$ http://127.0.0.1:9310/landing [P,L]
      </Directory>
      # The daemon being down must read as an error on the landing page alone,
      # not as a proxy that retries forever while the operator waits.
      ProxyTimeout 5
  # --- REGION: https://yuruna.link/429f3d06-0041
  - path: /etc/squid/conf.d/yuruna.conf
    permissions: '0644'
    owner: root:root
    content: |
      # yuruna caching-proxy-service -- generic HTTP proxy/cache for test-VM installs.
      # NOTE: do NOT declare `http_port 3128` here -- see the topic above.

      # Permit only RFC1918 sources. The host switch/bridge/NAT hands out
      # 172.16/12, 192.168/16, or 10/8 depending on platform; all covered.
      acl yuruna_local src 10.0.0.0/8
      acl yuruna_local src 172.16.0.0/12
      acl yuruna_local src 192.168.0.0/16

      # --- REGION: Cache purge (PURGE method for RFC1918 operators)
      # Must precede `http_access allow yuruna_local` (first-match-wins); otherwise the
      # generic allow matches PURGE-from-yuruna_local first, making the explicit deny dead code.
      acl yuruna_purge method PURGE
      http_access allow yuruna_purge yuruna_local
      http_access deny yuruna_purge

      http_access allow yuruna_local

      # --- REGION: https://yuruna.link/429f3d06-0042
      # cache_replacement_policy MUST appear before cache_dir (squid binds
      # the policy at cache_dir parse time; a later override has no effect).
      cache_replacement_policy heap LFUDA
      memory_replacement_policy heap GDSF

      # 384 GB of the 512 GB VM disk (sizing math in the snapshot-cache-tuning topic).
      cache_dir ufs /var/spool/squid 393216 16 256
      # Ceiling covers every install image yuruna provisions (~64 GB worst case).
      # INCLUSIVE -- anything strictly larger is silently NOT cached.
      maximum_object_size 65 GB
      maximum_object_size_in_memory 32 MB
      # Swap is masked -- tune VM RAM + cache_mem + zot together (budget
      # math in the snapshot-cache-tuning topic above). Substituted rather than
      # literal because the VM's RAM is not fixed: a standalone host carries the
      # cache beside the stash and the download agent, and the pair has to move
      # together or the smaller VM OOMs with no swap to absorb it.
      cache_mem SQUID_CACHE_MEM_PLACEHOLDER

      # Never release unless forced -- evict only when disk >99% full,
      # stopping at 98%.
      cache_swap_high 99
      cache_swap_low  98

      # Don't cache failures (404, 5xx). A transient blip must not become
      # a poisoned 504 returned forever for an object squid could fetch
      # successfully next time.
      negative_ttl 0 seconds

      # Suppresses REVALIDATION, not fetching. A stored object is served
      # without asking the origin whether it changed; a cache MISS still
      # falls through to upstream. The name reads like an egress kill
      # switch and is not one -- the switch that actually refuses upstream
      # is /etc/squid/conf.d/yuruna-no-upstream.conf, written on demand by
      # the operator (see the no-upstream topic). Keeping this on is what
      # holds revalidation traffic off the metered upstreams.
      offline_mode on

      # Expose the RUNTIME config on /squid-internal-mgr/config for
      # squid-meta-exporter.sh; the stock `localhost manager` ACL keeps it off the LAN.
      cachemgr_passwd none config

      # --- REGION: https://yuruna.link/429f3d06-0043
      # Never abort a partial download -- the next client still gets a hit.
      quick_abort_min -1 KB
      # Bound upstream inactivity (squid's default is 15 minutes); matches the
      # guests' apt Acquire::http::Timeout.
      read_timeout 2 minutes
      # One origin fetch for N concurrent identical requests; the rest ride along.
      collapsed_forwarding on
      # Fetch the FULL object on a first `Range:` request, so resumed downloads
      # populate the cache instead of streaming through it.
      range_offset_limit none

      # Package files are content-addressable (version in URL), so a new
      # version is a different URL -- no value revalidating what we have.
      # override/ignore flags keep squid serving regardless of origin or
      # intermediate cache-control hints (no-store, must-revalidate,
      # private, reload-from-client). 525600 min = 1 year.
      refresh_pattern -i \.deb$      525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i \.udeb$     525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i \.tar\.xz$  525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i \.tar\.gz$  525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i \.tar\.bz2$ 525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i \.iso$      525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      # Apt metadata (InRelease, Packages.*) moves -- poll origin each time.
      refresh_pattern -i /InRelease$                    0 0%  60
      refresh_pattern -i /Release$                      0 0%  60
      refresh_pattern -i /Release\.gpg$                 0 0%  60
      refresh_pattern -i /Packages(\.gz|\.xz|\.bz2)?$   0 0%  60
      refresh_pattern -i /Sources(\.gz|\.xz|\.bz2)?$    0 0%  60
      # dep11 Components-<arch>.yml drifts faster than catch-all LM-factor on
      # dev pockets; mismatched InRelease vs dep11 -> "Hash Sum mismatch".
      refresh_pattern -i /dep11/.+\.yml(\.gz|\.xz)?$    0 0%  60

      # --- REGION: Container registry caching (OCI + Docker v2)
      # --- REGION: https://yuruna.link/429f3d06-0042
      # Digest-pinned URLs only (the `sha256:` path segment is immutable);
      # tag-based manifest URLs are governed by the gate below -- tags ARE mutable.
      refresh_pattern -i /(manifests|blobs)/sha256:[0-9a-f]+ 525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private

      # --- REGION: https://yuruna.link/42f6b05f-0021
      # Freshness floor on tag -> digest resolution, the metered operation.
      # Reaches only registries that answer a manifest without a bearer token
      # (Docker Hub always sends one, so Hub is NOT governed here). Deliberately
      # not host-scoped, so a registry added upstream is covered the day it appears.
      refresh_pattern -i /v2/.+/manifests/[^/]+$        60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400

      # Blob bodies are already persisted by the OCI cache that fetched them;
      # storing a second copy here buys no hit and spends cache_dir against
      # the install images it is sized for. Manifests -- small, and the thing
      # the gate above exists to keep -- are unaffected.
      acl yuruna_oci_blob urlpath_regex /v2/.+/blobs/
      store_miss deny yuruna_oci_blob

      # Registry bearer tokens are short-lived credentials, and a replayed one
      # is both a stale-auth failure and a credential living longer than its
      # issuer intended. Token mints are not metered; there is nothing to save
      # here and something to lose.
      acl yuruna_registry_auth dstdomain auth.docker.io auth.ghcr.io
      cache deny yuruna_registry_auth

      # Not every registry mints on a separate auth host: the gcr.io family,
      # mirror.gcr.io included, advertises a realm on its OWN domain, where the
      # rule above cannot reach it without also refusing to cache that host's
      # manifests. Matching the path keeps the credential uncacheable and leaves
      # the rest of the host alone. Neither endpoint sends Cache-Control, so
      # without this squid is free to apply its heuristic to a 200 that happens
      # to contain a bearer token. Deliberately not host-scoped, for the same
      # reason as the freshness floor above.
      acl yuruna_registry_token_path urlpath_regex ^/v2/token
      cache deny yuruna_registry_token_path

      # --- REGION: OpenTofu / Terraform provider + binary caching
      # --- REGION: https://yuruna.link/42f6b05f-0013
      refresh_pattern -i \.zip$                                            525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i ^https?://registry\.opentofu\.org/                525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i ^https?://releases\.opentofu\.org/                525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i ^https?://packages\.opentofu\.org/                525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i ^https?://get\.opentofu\.org/                     525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private

      # --- REGION: GitHub release binary caching
      # --- REGION: https://yuruna.link/429f3d06-0044
      # Release assets are immutable per tag; whole-host match so non-extensioned
      # binaries (raw `kubectl`, `helm`) are covered too.
      refresh_pattern -i ^https?://github\.com/[^/]+/[^/]+/releases/download/ 525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      refresh_pattern -i ^https?://objects\.githubusercontent\.com/        525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private

      # --- REGION: Helm chart + repo index caching
      # --- REGION: https://yuruna.link/429f3d06-0044
      # `.tgz` is NOT matched by the `\.tar\.gz$` pattern above; chart packages
      # are version-tagged and immutable, so pin the full year.
      refresh_pattern -i \.tgz$                                            525600 100% 525600 override-expire override-lastmod ignore-reload ignore-no-store ignore-private
      # `helm repo update` index.yaml: short freshness window, scoped to known
      # helm-repo hosts so unrelated YAML is not over-cached.
      refresh_pattern -i ^https?://kubernetes\.github\.io/.*/index\.yaml$  60     20%  60
      refresh_pattern -i ^https?://charts\.jetstack\.io/.*/index\.yaml$    60     20%  60

      # --- REGION: https://yuruna.link/42f6b05f-0014
      # One-hour freshness floor for metered version-lookup endpoints. Each host
      # needs its own entry: these URLs carry a query string, and the stock
      # `refresh_pattern -i (/cgi-bin/|\?) 0 0% 0` parsed after this file would
      # otherwise claim them under first-match-wins and pin them to zero freshness.
      refresh_pattern -i ^https?://api\.github\.com/                       60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400
      refresh_pattern -i ^https?://www\.powershellgallery\.com/            60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400
      refresh_pattern -i ^https?://dl\.filippo\.io/                        60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400
      refresh_pattern -i ^https?://api\.snapcraft\.io/                     60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400
      refresh_pattern -i ^https?://contracts\.canonical\.com/              60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400
      refresh_pattern -i ^https?://livepatch\.canonical\.com/              60 100% 60 override-expire override-lastmod ignore-reload ignore-no-store ignore-private store-stale max-stale=86400

      logfile_rotate 2

      # --- REGION: https://yuruna.link/42f6b05f-003a
      # --- REGION: https://yuruna.link/42f6b05f-003b
      acl step1 at_step SslBump1
      http_port 3129 ssl-bump generate-host-certificates=on tls-cert=/etc/squid/ssl_cert/ca.pem tls-key=/etc/squid/ssl_cert/ca.key
      sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/squid/ssl_db -M 4MB
      sslcrtd_children 5
      ssl_bump peek step1
      ssl_bump bump all

      acl yuruna_proxy_senders src 10.0.0.0/8
      acl yuruna_proxy_senders src 172.16.0.0/12
      acl yuruna_proxy_senders src 192.168.0.0/16
      acl yuruna_proxy_senders src 127.0.0.1/32
      acl yuruna_proxy_senders src ::1/128
      proxy_protocol_access allow yuruna_proxy_senders
      proxy_protocol_access deny all
      http_port 3138 require-proxy-header
      http_port 3139 require-proxy-header ssl-bump generate-host-certificates=on tls-cert=/etc/squid/ssl_cert/ca.pem tls-key=/etc/squid/ssl_cert/ca.key

      # --- REGION: https://yuruna.link/429f3d06-0045
      logformat yuruna %ts.%03tu %6tr %>a %Ss/%03>Hs %<st %rm %ru %[un %Sh/%<a %mt "%{User-Agent}>h"
      # Match the exporter by src, not urlpath: a urlpath ACL floods cache.log
      # on every request-less log event (CONNECT tunnels, TLS-bump errors).
      acl yuruna_selfscrape src 127.0.0.1/32 ::1/128
      access_log stdio:/var/log/squid/yuruna_access.log yuruna !yuruna_selfscrape
      # Loopback traffic goes to its own file (same format), not discarded: it
      # would clutter the client log, but without it the VM's own egress leaves
      # no trace and a stalled local service cannot be told from a stalled client.
      access_log stdio:/var/log/squid/yuruna_loopback.log yuruna yuruna_selfscrape
  # --- REGION: https://yuruna.link/42f6b05f-0016
  # The page a refused fetch returns. Squid resolves an unlocalized template
  # name from this directory, so no error_directory override is needed -- and
  # overriding it would replace the whole stock set, not add to it.
  - path: /usr/share/squid/errors/templates/ERR_YURUNA_NO_UPSTREAM
    permissions: '0644'
    owner: root:root
    content: |
      <html><head><title>Upstream fetch refused</title></head>
      <body>
      <h1>Upstream fetch refused</h1>
      <p>This cache is in no-upstream mode. The object below is not stored
      locally, and this cache will not fetch it.</p>
      <p><b>%U</b></p>
      <p>To let it through, run <code>sudo yuruna-no-upstream off</code> on the
      caching-proxy VM, re-run the fetch, then turn it back on.</p>
      </body></html>
  - path: /usr/local/sbin/yuruna-no-upstream
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # Turns the cache into a true island: stored objects are served, and
      # anything else is refused rather than fetched.
      #
      # This is a separate switch from `offline_mode`, which despite the name
      # only suppresses revalidation -- a miss under offline_mode still goes
      # to the origin. Refusing the miss is what makes the cache's content
      # the whole of what the lab can see, which is the point of the mode:
      # an upstream that cannot be reached cannot spend a metered quota and
      # cannot fail a provisioning run in a new way.
      #
      # Off by default. The cost of leaving it on is that the first pull of
      # anything not already stored fails, and in a lab that provisions
      # long-tail images on demand that is a frequent event, not a rare one.
      set -euo pipefail
      CONF=/etc/squid/conf.d/yuruna-no-upstream.conf
      case "${1:-status}" in
        on)
          # Staged and parsed before it is allowed to take effect. A squid
          # that FATALs on a bad drop-in does not fall back to the previous
          # config -- it fails to start and takes the whole lab's proxy with
          # it, so the validation has to happen while the running daemon is
          # still untouched.
          TMP=$(mktemp)
          trap 'rm -f "$TMP"' EXIT
          cat > "$TMP" <<'EOF_NOUP'
      # Refuse anything not already stored. 503 rather than 403 on purpose:
      # the retry helpers classify 4xx as permanent and stop, which would turn
      # a mode meant to be switched off and retried into an aborted run.
      acl yuruna_no_upstream_status http_status 503
      miss_access deny all
      deny_info 503:ERR_YURUNA_NO_UPSTREAM all
      reply_header_add Retry-After 3600 yuruna_no_upstream_status
      EOF_NOUP
          install -m 0644 -o root -g root "$TMP" "$CONF"
          if ! squid -k parse >/dev/null 2>&1; then
              rm -f "$CONF"
              echo "yuruna-no-upstream: refused -- squid rejected the config; left unchanged" >&2
              exit 1
          fi
          squid -k reconfigure
          echo "yuruna-no-upstream: ON (misses refused with 503)"
          ;;
        off)
          rm -f "$CONF"
          squid -k reconfigure
          echo "yuruna-no-upstream: OFF (misses fetched from origin)"
          ;;
        status)
          if [ -f "$CONF" ]; then echo "on"; else echo "off"; fi
          ;;
        *)
          echo "usage: yuruna-no-upstream [on|off|status]" >&2
          exit 2
          ;;
      esac
  # --- REGION: https://yuruna.link/429f3d06-0046
  - path: /etc/default/prometheus
    permissions: '0644'
    owner: root:root
    content: |
      # 30d retention + 2GB size-cap safety net; /var/lib/prometheus is on the
      # VM root fs, so a VM rebuild still resets history.
      ARGS="--web.listen-address=127.0.0.1:9090 --storage.tsdb.retention.time=30d --storage.tsdb.retention.size=2GB"
  - path: /etc/default/prometheus-node-exporter
    permissions: '0644'
    owner: root:root
    content: |
      # Loopback only, matching prometheus itself: the LAN reaches these numbers
      # through Grafana's datasource proxy, and the node exporter's default bind
      # would otherwise publish host inventory to every guest.
      ARGS="--web.listen-address=127.0.0.1:9100"
  - path: /etc/prometheus/prometheus.yml
    permissions: '0644'
    owner: root:root
    content: |
      global:
        scrape_interval: 15s
      scrape_configs:
        - job_name: prometheus
          static_configs:
            - targets: ['localhost:9090']
        - job_name: squid
          static_configs:
            - targets: ['localhost:9301']
        # zot OCI pull-through cache. Built-in /metrics endpoint on the
        # service port. See write_files /etc/zot/config.json below.
        - job_name: zot
          static_configs:
            - targets: ['localhost:5000']
        # Squid metadata: timer-driven script publishes /var/www/html/squid-meta (Prom text format, gauges squid_listening + squid_offline_mode_configured); Prometheus scrapes it via Apache so the offline-mode signal survives even when squid is down.
        - job_name: squid_meta
          metrics_path: /squid-meta
          static_configs:
            - targets: ['localhost:80']
        # zot metadata: canary that TIMES a manifest request and reads the shared
        # pull budget, served via Apache like squid-meta -- zot's own /metrics keeps
        # answering in milliseconds while the sync path behind it is stalled, so the
        # subject cannot be the reporter. The timer, not the 15s scrape, paces the probe.
        - job_name: zot_meta
          metrics_path: /zot-meta
          static_configs:
            - targets: ['localhost:80']
        # Host CPU/memory/disk/network for the VM itself.
        - job_name: node
          static_configs:
            - targets: ['localhost:9100']
        # pool-aggregator-service: multi-host pool collector on :9400 (TLS via proxy-CA leaf when present -- served alongside plain HTTP on the same port for the browser deep-links -- else plain HTTP only). Loopback scrape uses insecure_skip_verify -- peer authentication is moot on 127.0.0.1 and it works whether the leaf SAN lists localhost or only IPs.
        - job_name: pool-aggregator-service
          scheme: https
          tls_config:
            insecure_skip_verify: true
          static_configs:
            - targets: ['localhost:9400']
  # --- REGION: https://yuruna.link/429f3d06-0047
  - path: /etc/loki/config.yml
    permissions: '0644'
    owner: root:root
    content: |
      auth_enabled: false
      server:
        http_listen_address: 127.0.0.1
        http_listen_port: 3100
        grpc_listen_address: 127.0.0.1
        grpc_listen_port: 9096
      common:
        instance_addr: 127.0.0.1
        path_prefix: /var/lib/loki
        storage:
          filesystem:
            chunks_directory: /var/lib/loki/chunks
            rules_directory: /var/lib/loki/rules
        replication_factor: 1
        ring:
          kvstore:
            store: inmemory
      schema_config:
        configs:
          - from: 2024-01-01
            store: tsdb
            object_store: filesystem
            schema: v13
            index:
              prefix: index_
              period: 24h
      limits_config:
        # 30d default covers transitions (src=cycle) and incidents (src=incident) --
        # the count_over_time Pass/Fail source plus incident history; per-step events
        # (src=event) keep the shorter 7d window below.
        retention_period: 720h
        retention_stream:
          - selector: '{src="event"}'
            priority: 1
            period: 168h
      compactor:
        working_directory: /var/lib/loki/compactor
        retention_enabled: true
        delete_request_store: filesystem
  # --- REGION: https://yuruna.link/429f3d06-0048
  - path: /etc/promtail/config.yml
    permissions: '0644'
    owner: root:root
    content: |
      server:
        http_listen_address: 127.0.0.1
        http_listen_port: 9080
        grpc_listen_port: 0
      positions:
        filename: /var/lib/promtail/positions.yaml
      clients:
        - url: http://127.0.0.1:3100/loki/api/v1/push
      scrape_configs:
        - job_name: squid
          static_configs:
            - targets:
                - localhost
              labels:
                job: squid
                # Tail only squid's custom yuruna_access.log (adds a quoted
                # User-Agent column; see the yuruna.conf logformat comment);
                # the stock access.log keeps its default format.
                __path__: /var/log/squid/yuruna_access.log
          pipeline_stages:
            - regex:
                expression: '^(?P<ts>\d+\.\d+)\s+\d+\s+'
            - timestamp:
                source: ts
                format: Unix
        # Egress originated ON this VM (its own probes and any local service
        # pointed at the proxy), split out of the client log by the squid ACL.
        # Separate job label so it never dilutes {job="squid"} client analysis.
        - job_name: squid_loopback
          static_configs:
            - targets:
                - localhost
              labels:
                job: squid_loopback
                __path__: /var/log/squid/yuruna_loopback.log
          pipeline_stages:
            - regex:
                expression: '^(?P<ts>\d+\.\d+)\s+\d+\s+'
            - timestamp:
                source: ts
                format: Unix
        # Ship zot's JSONL /var/log/zot/zot.log to Loki as job=zot so {job="zot"} queries work in Explore; no dashboard consumes the stream today (community Zot dashboard is Prom-only).
        - job_name: zot
          static_configs:
            - targets:
                - localhost
              labels:
                job: zot
                __path__: /var/log/zot/zot.log
          pipeline_stages:
            - json:
                expressions:
                  ts: time
                  path: path
            - timestamp:
                source: ts
                format: RFC3339Nano
            # Sentinel first: promtail's drop stage skips entries whose source key
            # is absent, and zot's sync lines carry no `path` at all.
            - template:
                source: path
                template: '{{ or .path "NO_HTTP_PATH" }}'
            # Only the self-scrape is noise. Lines with no HTTP path are the
            # sync extension's own -- the upstream retry/failure record for a
            # pull-through miss. They are the ONLY evidence of why a manifest
            # request took tens of seconds, since the request itself is logged
            # as a success once it finally answers, and they are rare enough
            # that keeping them costs nothing.
            - drop:
                source: path
                value: /metrics
                drop_counter_reason: metrics_poll
  # --- REGION: https://yuruna.link/429f3d06-0049
  - path: /etc/systemd/system/promtail.service.d/yuruna.conf
    permissions: '0644'
    owner: root:root
    content: |
      [Service]
      SupplementaryGroups=proxy zot
  # --- REGION: https://yuruna.link/429f3d06-004a
  - path: /usr/local/bin/squid-meta-exporter.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # Yuruna squid meta exporter: probes runtime config via cachemgr, writes /var/www/html/squid-meta (Prom text format); driven by squid-meta-exporter.timer.
      set +e
      TMP=$(mktemp)
      trap 'rm -f "$TMP"' EXIT

      OFFLINE=0
      # RUNTIME config via cachemgr, not the on-disk file, which may not be applied yet.
      if curl -fsS -m 3 --noproxy '*' http://127.0.0.1:3128/squid-internal-mgr/config 2>/dev/null \
            | grep -qE '^offline_mode[[:space:]]+on[[:space:]]*$'; then
          OFFLINE=1
      fi

      LISTENING=0
      if ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE '(^|:)3128$'; then
          LISTENING=1
      fi

      # Can MISSES be filled? Direct (this VM IS the proxy); 5s = "not reachable".
      INTERNET=0
      if curl -fsS --noproxy '*' -m 5 -o /dev/null https://www.google.com/generate_204 2>/dev/null; then
          INTERNET=1
      fi

      cat > "$TMP" <<EOF_METRICS
      # HELP squid_offline_mode_configured 1 if the running squid daemon has 'offline_mode on' (queried via /squid-internal-mgr/config)
      # TYPE squid_offline_mode_configured gauge
      squid_offline_mode_configured $OFFLINE
      # HELP squid_listening 1 if squid is bound to its proxy port (3128)
      # TYPE squid_listening gauge
      squid_listening $LISTENING
      # HELP squid_internet_reachable 1 if HTTPS to https://www.google.com/generate_204 succeeds within 5s (no proxy)
      # TYPE squid_internet_reachable gauge
      squid_internet_reachable $INTERNET
      EOF_METRICS

      install -m 0644 "$TMP" /var/www/html/squid-meta
  - path: /etc/systemd/system/squid-meta-exporter.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Yuruna squid metadata exporter (offline_mode + listening probe)
      After=apache2.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/squid-meta-exporter.sh
  - path: /etc/systemd/system/squid-meta-exporter.timer
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Run squid-meta-exporter every 30 seconds
      [Timer]
      OnBootSec=20s
      OnUnitActiveSec=30s
      AccuracySec=5s
      Unit=squid-meta-exporter.service
      [Install]
      WantedBy=timers.target
  # --- REGION: https://yuruna.link/429f3d06-004b
  - path: /usr/local/bin/zot-meta-exporter.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # Yuruna zot meta exporter: times the cache's MANIFEST path (not just its
      # liveness), reads the shared Docker Hub budget, and publishes both as Prom
      # text at /var/www/html/zot-meta plus a human-readable /var/www/html/cache-health.
      # Driven by zot-meta-exporter.timer. Served by apache, not zot, so the
      # numbers survive the very failure they describe.
      set +e
      TMP=$(mktemp)
      TMP_TXT=$(mktemp)
      TMP_UP=$(mktemp)
      TMP_UP_TXT=$(mktemp)
      # Carries the Docker Hub credential into the budget probe below. Created
      # with the other temps so the trap covers it: it holds an access token, and
      # a run that dies partway must not leave that token in /tmp.
      TMP_NETRC=$(mktemp)
      TMP_PW=$(mktemp)
      trap 'rm -f "$TMP" "$TMP_TXT" "$TMP_UP" "$TMP_UP_TXT" "$TMP_NETRC" "$TMP_PW"' EXIT

      ZOT='http://127.0.0.1:5000'
      # Addressed by TAG, not digest: only a tag re-runs the on-demand upstream
      # sync, which is the leg that stalls. dotnet/sdk resolves against the
      # scoped mcr.microsoft.com entry, which meters nothing -- a repo falling
      # through to the Docker Hub catch-all would put this probe on the one
      # metered budget in the lab.
      CANARY_REPO='dotnet/sdk'
      CANARY_TAG='10.0'
      # Spelled out: a manifest request stating no preference gets the registry's
      # default, which for a multi-arch tag is not the index a real pull resolves.
      ACCEPT='application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.docker.distribution.manifest.v2+json'
      # Two deadlines, deliberately different: PROBE_MAX bounds this probe (it
      # must outlive the stall to measure it), CLIENT_PATIENCE is the
      # response-header deadline a real dockerd pull actually gives up at.
      PROBE_MAX=120
      CLIENT_PATIENCE=30

      V2_UP=0
      if curl -fsS -m 10 --noproxy '*' -o /dev/null "${ZOT}/v2/" 2>/dev/null; then
          V2_UP=1
      fi

      # http_code and time_total are printed on the timeout path too, so a probe
      # that never answers still yields the elapsed number rather than a blank.
      READ=$(curl -s -o /dev/null --noproxy '*' -m "$PROBE_MAX" -I \
                  -H "Accept: ${ACCEPT}" \
                  -w '%{http_code} %{time_total}' \
                  "${ZOT}/v2/${CANARY_REPO}/manifests/${CANARY_TAG}" 2>/dev/null)
      MANIFEST_CODE=$(printf '%s' "$READ" | awk '{print $1+0}')
      MANIFEST_SECONDS=$(printf '%s' "$READ" | awk '{printf "%.3f", $2+0}')
      [ -n "$MANIFEST_SECONDS" ] || MANIFEST_SECONDS=0
      MANIFEST_OK=0
      [ "$MANIFEST_CODE" = "200" ] && MANIFEST_OK=1
      # Compared in awk because the elapsed time is fractional and the shell's
      # test builtin rejects a non-integer operand outright: -le on "30.412"
      # errors instead of answering, which under set +e would leave the verdict
      # silently at 0 for every reading that carries a decimal.
      MANIFEST_UNDER_PATIENCE=0
      if [ "$MANIFEST_OK" = 1 ] && awk -v s="$MANIFEST_SECONDS" -v p="$CLIENT_PATIENCE" 'BEGIN{exit !(s<=p)}'; then
          MANIFEST_UNDER_PATIENCE=1
      fi

      # Upstream leg, measured WITHOUT spending pull budget: /v2/ answers 401 on
      # every registry here and costs no quota, so this separates "the internet
      # is slow from this VM" from "zot is slow" without becoming a second
      # consumer of the limit the gauge below reports.
      UPSTREAMS='registry-1.docker.io mirror.gcr.io registry.k8s.io ghcr.io quay.io gcr.io public.ecr.aws mcr.microsoft.com'
      for U in $UPSTREAMS; do
          R=$(curl -s -o /dev/null --noproxy '*' -m 10 -w '%{http_code} %{time_total}' "https://${U}/v2/" 2>/dev/null)
          C=$(printf '%s' "$R" | awk '{print $1+0}')
          T=$(printf '%s' "$R" | awk '{printf "%.3f", $2+0}')
          # Any HTTP status proves the leg: 401 is the healthy answer for an
          # unauthenticated /v2/, and treating only 200 as up would report every
          # registry down.
          OK=0
          [ "$C" -gt 0 ] 2>/dev/null && OK=1
          # Appended per probe rather than accumulated in a shell variable: a
          # metric line must start at column 0, and an embedded newline inside a
          # variable carries this file's own indentation into the payload.
          printf 'yuruna_upstream_reachable{registry="%s"} %s\n' "$U" "$OK" >> "$TMP_UP"
          printf 'yuruna_upstream_latency_seconds{registry="%s"} %s\n' "$U" "$T" >> "$TMP_UP"
          if [ "$OK" = 1 ]; then
              printf '  %-24s %ss (HTTP %s)\n' "$U" "$T" "$C" >> "$TMP_UP_TXT"
          else
              printf '  %-24s UNREACHABLE\n' "$U" >> "$TMP_UP_TXT"
          fi
      done

      # The shared Docker Hub budget. HEAD on ratelimitpreview/test reads the
      # counters without spending one. Read at most hourly and cached to disk in
      # between -- the counters describe a one-hour window, so a faster cadence
      # only mints extra tokens against the upstream this file exists to spare.
      # Between reads the previous values are republished, so the gauge keeps a
      # value rather than dropping to zero and painting an exhausted budget.
      HUB_STATE=/var/lib/yuruna/zot-meta-hub.env
      HUB_MIN_INTERVAL=3300
      HUB_PROBE_OK=0
      HUB_LIMIT=0
      HUB_REMAINING=0
      HUB_FRESH=1
      mkdir -p "$(dirname "$HUB_STATE")" 2>/dev/null
      if [ -r "$HUB_STATE" ]; then
          # shellcheck disable=SC1090
          . "$HUB_STATE" 2>/dev/null || true
          HUB_AGE=$(( $(date +%s) - ${HUB_STAMP:-0} ))
          [ "$HUB_AGE" -lt "$HUB_MIN_INTERVAL" ] && HUB_FRESH=0
      fi
      # Declared for both branches: the human-readable section below reads these
      # to say which budget it is describing.
      HUB_AUTHENTICATED=0
      HUB_TOKEN_AUTHENTICATED=0
      if [ "$HUB_FRESH" = 0 ]; then
          HUB_PROBE_OK=${HUB_STATE_PROBE_OK:-0}
          HUB_LIMIT=${HUB_STATE_LIMIT:-0}
          HUB_REMAINING=${HUB_STATE_REMAINING:-0}
          HUB_AUTHENTICATED=${HUB_STATE_AUTHENTICATED:-0}
          HUB_TOKEN_AUTHENTICATED=${HUB_STATE_TOKEN_AUTHENTICATED:-0}
      fi
      if [ "$HUB_FRESH" = 1 ]; then
      # Which budget the counters below describe. Hub meters an authenticated sync
      # against the account and an anonymous one against the egress IP, and the two
      # allowances differ in both size and in who else is spending them, so a
      # remaining count means nothing until the mode is stated alongside it.
      # The file is absent whenever the lab configured no account.
      HUB_CRED_FILE=/etc/zot/sync-credentials.json
      HUB_USER=''
      HUB_PASS=''
      if [ -r "$HUB_CRED_FILE" ]; then
          HUB_USER=$(sed -n 's/.*"username"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HUB_CRED_FILE" | head -1)
          HUB_PASS=$(sed -n 's/.*"password"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HUB_CRED_FILE" | head -1)
      fi
      HUB_AUTHENTICATED=0
      [ -n "$HUB_USER" ] && [ -n "$HUB_PASS" ] && HUB_AUTHENTICATED=1
      HUB_TOKEN_AUTHENTICATED=0
      HUB_TOKEN=''
      # Extracted with sed rather than jq: this probe has to keep reporting on a
      # boot where package installation is incomplete, and one field out of a
      # flat object does not justify the dependency.
      if [ "$HUB_AUTHENTICATED" = 1 ]; then
          # A token minted with the account reports the account's budget, which is
          # the one zot's pulls actually spend. Strictly best-effort: a rotated or
          # revoked credential must cost the reading its precision, not its
          # existence, so any failure falls through to the anonymous request and
          # the page says which budget it ended up reporting.
          #
          # Passed through a 0600 file rather than on the command line: argv is
          # readable by every account on this VM through /proc, and the whole
          # point of the credential's mode is that the token is not.
          printf 'machine auth.docker.io login %s password %s\n' "$HUB_USER" "$HUB_PASS" > "$TMP_NETRC"
          HUB_TOKEN=$(curl -fsS --noproxy '*' -m 10 --netrc-file "$TMP_NETRC" \
              'https://auth.docker.io/token?service=registry.docker.io&scope=repository:ratelimitpreview/test:pull' 2>/dev/null \
              | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
          : > "$TMP_NETRC"
          [ -n "$HUB_TOKEN" ] && HUB_TOKEN_AUTHENTICATED=1
      fi
      if [ -z "$HUB_TOKEN" ]; then
          HUB_TOKEN=$(curl -fsS --noproxy '*' -m 10 \
              'https://auth.docker.io/token?service=registry.docker.io&scope=repository:ratelimitpreview/test:pull' 2>/dev/null \
              | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
      fi
      if [ -n "$HUB_TOKEN" ]; then
          HUB_HDRS=$(curl -fsS --noproxy '*' -m 10 -I \
              -H "Authorization: Bearer ${HUB_TOKEN}" \
              'https://registry-1.docker.io/v2/ratelimitpreview/test/manifests/latest' 2>/dev/null | tr -d '\r')
          if [ -n "$HUB_HDRS" ]; then
              # Header shape is `ratelimit-limit: 100;w=3600` -- the window suffix
              # is dropped, leaving the count.
              HUB_L=$(printf '%s\n' "$HUB_HDRS" | awk 'tolower($1)=="ratelimit-limit:"{split($2,a,";"); print a[1]+0; exit}')
              HUB_R=$(printf '%s\n' "$HUB_HDRS" | awk 'tolower($1)=="ratelimit-remaining:"{split($2,a,";"); print a[1]+0; exit}')
              if [ -n "$HUB_L" ] && [ -n "$HUB_R" ]; then
                  HUB_PROBE_OK=1
                  HUB_LIMIT=$HUB_L
                  HUB_REMAINING=$HUB_R
              fi
          fi
      fi
      # Only a successful read is persisted: a cached failure would republish for
      # the rest of the hour, and an unread budget renders as zero -- the same
      # shape as exhaustion.
      if [ "$HUB_PROBE_OK" = 1 ]; then
          umask 077
          cat > "$HUB_STATE" <<EOF_HUB_STATE
      HUB_STAMP=$(date +%s)
      HUB_STATE_PROBE_OK=$HUB_PROBE_OK
      HUB_STATE_LIMIT=$HUB_LIMIT
      HUB_STATE_REMAINING=$HUB_REMAINING
      HUB_STATE_AUTHENTICATED=$HUB_AUTHENTICATED
      HUB_STATE_TOKEN_AUTHENTICATED=$HUB_TOKEN_AUTHENTICATED
      EOF_HUB_STATE
      fi
      fi

      ZOT_FREE=$(df -P /var/lib/zot 2>/dev/null | awk 'NR==2{print $4*1024}')
      SQUID_FREE=$(df -P /var/spool/squid 2>/dev/null | awk 'NR==2{print $4*1024}')
      [ -n "$ZOT_FREE" ]   || ZOT_FREE=0
      [ -n "$SQUID_FREE" ] || SQUID_FREE=0

      # --- REGION: Warm-set residency
      # The canary above walks a tag a scheduled poll keeps resident, so it
      # measures the upstream leg and stays fast while an image the lab does NOT
      # hold is still being copied. Residency is the reading that shows that
      # case, and it can only be observed by the job that requests the images a
      # guest actually pulls -- measuring it here would spend a full cold sync
      # per probe, every ten minutes.
      PW_META=/var/lib/yuruna/prewarm-meta.env
      PW_ROWS=/var/lib/yuruna/prewarm-rows.tsv
      PW_PROGRESS=/var/lib/yuruna/prewarm-progress
      YURUNA_PREWARM_LAST_RUN=""
      YURUNA_PREWARM_K8S_MINOR=""
      YURUNA_PREWARM_K8S_PATCH=""
      YURUNA_PREWARM_FLANNEL_TAG=""
      YURUNA_PREWARM_RESOLVE_SRC=""
      YURUNA_PREWARM_K8S_RESOLVED=1
      YURUNA_PREWARM_CNI_RESOLVED=1
      YURUNA_PREWARM_WATERMARK=0
      YURUNA_PREWARM_WATERMARK_REF=""
      # Machine-written by zot-prewarm.sh alone; no operator free text reaches it.
      [ -r "$PW_META" ] && . "$PW_META" 2>/dev/null
      PW_HAVE=0
      K8S_TOTAL=0; K8S_HELD=0; CNI_TOTAL=0; CNI_HELD=0
      K8S_LOCAL=0; K8S_COLDSYNC=0; CNI_LOCAL=0; CNI_COLDSYNC=0
      PW_SLOW_SEC=""; PW_SLOW_REF=""
      if [ -r "$PW_ROWS" ]; then
          PW_HAVE=1
          # A row reaching "cold" completed its fetch: the content moved and is
          # now held. Only timeout/failed rows are images a guest would still
          # have to wait for.
          #
          # Held and resident are two different facts and are counted apart
          # here, because one number cannot answer both questions a reader has.
          # "Held" is what a guest about to pull cares about. "Answered from
          # storage" is what says whether the cache was already stocked when the
          # run asked: a set reported entirely held, every image of which the run
          # had to copy in, was cold for the whole of that run -- and a guest
          # pulling during it waited out every one of those copies.
          K8S_TOTAL=$(awk -F'\t' '$1=="k8s"{n++} END{print n+0}' "$PW_ROWS")
          K8S_HELD=$(awk  -F'\t' '$1=="k8s" && ($5=="resident"||$5=="cold"){n++} END{print n+0}' "$PW_ROWS")
          K8S_LOCAL=$(awk -F'\t' '$1=="k8s" && $5=="resident"{n++} END{print n+0}' "$PW_ROWS")
          K8S_COLDSYNC=$(awk -F'\t' '$1=="k8s" && $5=="cold"{n++} END{print n+0}' "$PW_ROWS")
          CNI_TOTAL=$(awk -F'\t' '$1=="cni"{n++} END{print n+0}' "$PW_ROWS")
          CNI_HELD=$(awk  -F'\t' '$1=="cni" && ($5=="resident"||$5=="cold"){n++} END{print n+0}' "$PW_ROWS")
          CNI_LOCAL=$(awk -F'\t' '$1=="cni" && $5=="resident"{n++} END{print n+0}' "$PW_ROWS")
          CNI_COLDSYNC=$(awk -F'\t' '$1=="cni" && $5=="cold"{n++} END{print n+0}' "$PW_ROWS")
          PW_SLOW=$(awk -F'\t' 'BEGIN{m=-1}
              ($5=="resident"||$5=="cold") && ($4+0)>m { m=$4+0; r=$2 }
              END{ if (m>=0) printf "%.3f\t%s", m, r }' "$PW_ROWS")
          PW_SLOW_SEC=$(printf '%s' "$PW_SLOW" | cut -f1)
          PW_SLOW_REF=$(printf '%s' "$PW_SLOW" | cut -f2)
          : > "$TMP_PW"
          awk -F'\t' '{ printf "yuruna_prewarm_manifest_seconds{set=\"%s\",image=\"%s\",state=\"%s\"} %s\n", $1, $2, $5, $4 }' \
              "$PW_ROWS" >> "$TMP_PW"
      fi
      PW_MISSING=$(( (K8S_TOTAL - K8S_HELD) + (CNI_TOTAL - CNI_HELD) ))
      # A run in flight is worth naming: an operator looking at residency while
      # the cache is mid-sync would otherwise read a complete set as proof that
      # a guest failing right now met a warm cache.
      PW_INFLIGHT_REF=""
      PW_INFLIGHT_SEC=0
      if [ -r "$PW_PROGRESS" ]; then
          PW_INFLIGHT_REF=$(cut -f2 "$PW_PROGRESS" 2>/dev/null)
          PW_INFLIGHT_T0=$(cut -f1 "$PW_PROGRESS" 2>/dev/null)
          case "$PW_INFLIGHT_T0" in
              ''|*[!0-9]*) PW_INFLIGHT_REF="" ;;
              *) PW_INFLIGHT_SEC=$(( $(date +%s) - PW_INFLIGHT_T0 )) ;;
          esac
      fi
      PW_LAST_EPOCH=0
      if [ -n "$YURUNA_PREWARM_LAST_RUN" ]; then
          PW_LAST_EPOCH=$(date -u -d "$YURUNA_PREWARM_LAST_RUN" +%s 2>/dev/null || echo 0)
      fi

      # --- REGION: Guest-path canary
      # The request a guest's containerd actually issues, which the canary above
      # does not make. That one asks for dotnet/sdk:10.0 with no ns=, so zot
      # resolves the upstream by walking its registry list in file order, and the
      # entry it lands on has a scheduled poll keeping that tag's content
      # current: the on-demand sync it triggers finds nothing to copy and settles
      # as a fast no-op. A guest sends GET with ns=<upstream>, and for the
      # control-plane set that upstream is registry.k8s.io, whose only entry is
      # on-demand with no poll behind it. That leg runs in the tens of seconds
      # whenever the sync has anything to check, against the 30s a pull waits
      # for response headers -- close enough to the deadline that it has to be
      # timed rather than inferred from a line that never walks it.
      #
      # Asked only for an image the last warm run recorded as held, which keeps
      # this a revalidation rather than a copy: probing an image the cache does
      # not hold would spend a full cold sync on every timer tick. ns= also pins
      # the upstream, so the request cannot fall through to the Docker Hub
      # catch-all and spend the one metered budget in the lab -- and
      # registry.k8s.io meters nothing, so the revalidation itself is free.
      GP_REF=""
      GP_HAVE=0
      GP_CODE=0
      GP_SECONDS=0
      GP_OK=0
      GP_UNDER_PATIENCE=0
      if [ -r "$PW_ROWS" ]; then
          GP_REF=$(awk -F'\t' '($5=="resident"||$5=="cold") && $2 ~ /^registry\.k8s\.io\// {print $2; exit}' "$PW_ROWS")
      fi
      if [ -n "$GP_REF" ]; then
          GP_HAVE=1
          GP_UPSTREAM=${GP_REF%%/*}
          GP_REST=${GP_REF#*/}
          GP_TAG=${GP_REST##*:}
          GP_REPO=${GP_REST%:*}
          # GET, not HEAD: a pull reads the index body and follows it, and a
          # cache that answers the head of a manifest it cannot then produce
          # would pass a HEAD-only probe.
          GP_READ=$(curl -s -o /dev/null --noproxy '*' -m "$PROBE_MAX" \
                        -H "Accept: ${ACCEPT}" \
                        -w '%{http_code} %{time_total}' \
                        "${ZOT}/v2/${GP_REPO}/manifests/${GP_TAG}?ns=${GP_UPSTREAM}" 2>/dev/null)
          GP_CODE=$(printf '%s' "$GP_READ" | awk '{print $1+0}')
          GP_SECONDS=$(printf '%s' "$GP_READ" | awk '{printf "%.3f", $2+0}')
          [ -n "$GP_SECONDS" ] || GP_SECONDS=0
          [ "$GP_CODE" = "200" ] && GP_OK=1
          # Same awk comparison as the canary above, for the same reason: the
          # shell's test builtin errors outright on a fractional operand.
          if [ "$GP_OK" = 1 ] && awk -v s="$GP_SECONDS" -v p="$CLIENT_PATIENCE" 'BEGIN{exit !(s<=p)}'; then
              GP_UNDER_PATIENCE=1
          fi
      fi

      cat > "$TMP" <<EOF_METRICS
      # HELP yuruna_zot_v2_up 1 if zot answers GET /v2/ within 10s (liveness only -- says nothing about the manifest path)
      # TYPE yuruna_zot_v2_up gauge
      yuruna_zot_v2_up $V2_UP
      # HELP yuruna_zot_manifest_ok 1 if a HEAD of the canary tag returned 200 within the probe cap
      # TYPE yuruna_zot_manifest_ok gauge
      yuruna_zot_manifest_ok $MANIFEST_OK
      # HELP yuruna_zot_manifest_ok_under_client_patience 1 if the canary returned 200 AND did so within the response-header deadline a real pull applies; 0 whenever a pull against this manifest would have been abandoned, however healthy the answer eventually was
      # TYPE yuruna_zot_manifest_ok_under_client_patience gauge
      yuruna_zot_manifest_ok_under_client_patience $MANIFEST_UNDER_PATIENCE
      # HELP yuruna_zot_manifest_latency_seconds Elapsed time of a HEAD on the canary tag, asked for without ns= and kept current by a scheduled poll, so the sync it re-runs finds nothing to copy; the ns= form a guest sends is yuruna_zot_guest_path_latency_seconds
      # TYPE yuruna_zot_manifest_latency_seconds gauge
      yuruna_zot_manifest_latency_seconds{repo="$CANARY_REPO",tag="$CANARY_TAG"} $MANIFEST_SECONDS
      # HELP yuruna_zot_guest_path_probe_available 1 if the last warm run left a held registry.k8s.io image to ask for; 0 means the three readings below are absent, not failing
      # TYPE yuruna_zot_guest_path_probe_available gauge
      yuruna_zot_guest_path_probe_available $GP_HAVE
      # HELP yuruna_zot_guest_path_ok 1 if a GET of that image's manifest carrying ns= returned 200 within the probe cap
      # TYPE yuruna_zot_guest_path_ok gauge
      yuruna_zot_guest_path_ok $GP_OK
      # HELP yuruna_zot_guest_path_ok_under_client_patience 1 if that request also answered within the response-header deadline a real pull applies
      # TYPE yuruna_zot_guest_path_ok_under_client_patience gauge
      yuruna_zot_guest_path_ok_under_client_patience $GP_UNDER_PATIENCE
      # HELP yuruna_zot_guest_path_latency_seconds Elapsed time of a GET carrying ns= against an on-demand upstream with no scheduled poll behind it, which is the request containerd issues for every image a guest pulls
      # TYPE yuruna_zot_guest_path_latency_seconds gauge
      yuruna_zot_guest_path_latency_seconds{image="$GP_REF"} $GP_SECONDS
      # HELP yuruna_zot_manifest_probe_timeout_seconds Cap applied to both canary probes; a latency at this value means the probe never answered
      # TYPE yuruna_zot_manifest_probe_timeout_seconds gauge
      yuruna_zot_manifest_probe_timeout_seconds $PROBE_MAX
      # HELP yuruna_zot_manifest_client_patience_seconds Response-header deadline a real pull applies; latency past this value fails the pull whatever the cache answers afterwards
      # TYPE yuruna_zot_manifest_client_patience_seconds gauge
      yuruna_zot_manifest_client_patience_seconds $CLIENT_PATIENCE
      # HELP yuruna_upstream_reachable 1 if the registry answered GET /v2/ with any HTTP status within 10s
      # TYPE yuruna_upstream_reachable gauge
      # HELP yuruna_upstream_latency_seconds Round trip of an unauthenticated GET /v2/ against the registry (spends no pull budget)
      # TYPE yuruna_upstream_latency_seconds gauge
      EOF_METRICS

      cat "$TMP_UP" >> "$TMP"

      cat >> "$TMP" <<EOF_METRICS2
      # HELP yuruna_dockerhub_ratelimit_probe_ok 1 if the Docker Hub rate-limit headers were read successfully
      # TYPE yuruna_dockerhub_ratelimit_probe_ok gauge
      yuruna_dockerhub_ratelimit_probe_ok $HUB_PROBE_OK
      # HELP yuruna_dockerhub_ratelimit_limit Pull budget in force for this cache, per the ratelimit-limit header: the account's when the sync is authenticated, otherwise the anonymous one for this egress IP
      # TYPE yuruna_dockerhub_ratelimit_limit gauge
      yuruna_dockerhub_ratelimit_limit $HUB_LIMIT
      # HELP yuruna_dockerhub_ratelimit_remaining Pulls left in the current window; an anonymous window is shared by every guest behind this egress IP
      # TYPE yuruna_dockerhub_ratelimit_remaining gauge
      yuruna_dockerhub_ratelimit_remaining $HUB_REMAINING
      # HELP yuruna_zot_storage_free_bytes Free space on the filesystem holding /var/lib/zot
      # TYPE yuruna_zot_storage_free_bytes gauge
      yuruna_zot_storage_free_bytes $ZOT_FREE
      # HELP yuruna_squid_cache_free_bytes Free space on the filesystem holding the squid cache_dir
      # TYPE yuruna_squid_cache_free_bytes gauge
      yuruna_squid_cache_free_bytes $SQUID_FREE
      # HELP yuruna_prewarm_state_available 1 if a warm run has recorded residency for the image sets a guest pulls; 0 means the counts below are absent, not zero
      # TYPE yuruna_prewarm_state_available gauge
      yuruna_prewarm_state_available $PW_HAVE
      # HELP yuruna_prewarm_images_total Images in a set a guest pulls, resolved from the guest's own sources (kubeadm's own list, flannel's applied manifest)
      # TYPE yuruna_prewarm_images_total gauge
      yuruna_prewarm_images_total{set="k8s"} $K8S_TOTAL
      yuruna_prewarm_images_total{set="cni"} $CNI_TOTAL
      # HELP yuruna_prewarm_images_resident Images of that set the cache HOLDS -- those that answered from local storage plus those the last warm run copied in; every shortfall is an upstream copy a guest waits out inside its own step budget
      # TYPE yuruna_prewarm_images_resident gauge
      yuruna_prewarm_images_resident{set="k8s"} $K8S_HELD
      yuruna_prewarm_images_resident{set="cni"} $CNI_HELD
      # HELP yuruna_prewarm_images_cold_synced Images of that set the last warm run had to copy from upstream rather than find in storage; they are held now, but the cache was cold for them when that run started and a guest pulling during it waited out each copy
      # TYPE yuruna_prewarm_images_cold_synced gauge
      yuruna_prewarm_images_cold_synced{set="k8s"} $K8S_COLDSYNC
      yuruna_prewarm_images_cold_synced{set="cni"} $CNI_COLDSYNC
      # HELP yuruna_prewarm_cold_sync_watermark_seconds Slowest fetch that moved content at the currently resolved versions -- what a guest pays per image when the set is not held
      # TYPE yuruna_prewarm_cold_sync_watermark_seconds gauge
      yuruna_prewarm_cold_sync_watermark_seconds $YURUNA_PREWARM_WATERMARK
      # HELP yuruna_prewarm_last_run_timestamp_seconds Unix time the last warm run finished; a stale value means the residency counts describe an older state of the cache
      # TYPE yuruna_prewarm_last_run_timestamp_seconds gauge
      yuruna_prewarm_last_run_timestamp_seconds $PW_LAST_EPOCH
      # HELP yuruna_prewarm_inflight_seconds Seconds the warm run has been on its current image; 0 when no run is in flight
      # TYPE yuruna_prewarm_inflight_seconds gauge
      yuruna_prewarm_inflight_seconds $PW_INFLIGHT_SEC
      # HELP yuruna_prewarm_manifest_seconds Elapsed time of the warm request per image, on the same path a pull walks
      # TYPE yuruna_prewarm_manifest_seconds gauge
      EOF_METRICS2

      cat "$TMP_PW" >> "$TMP"

      install -m 0644 "$TMP" /var/www/html/zot-meta

      # Same numbers as plain text. Reachable with curl from any guest and from a
      # browser with no Grafana session, which is what a first look needs when
      # the question is whether to debug the guest or the cache.
      {
          echo "yuruna caching-proxy health -- $(date -u +%Y-%m-%dT%H:%M:%SZ)"
          echo
          echo "zot /v2/ liveness            : $( [ "$V2_UP" = 1 ] && echo up || echo DOWN )"
          # A zero status code means the probe hit its cap with no answer at all,
          # which reads as a nonsense HTTP status unless it is spelled out.
          if [ "$MANIFEST_CODE" = "0" ]; then
              echo "zot manifest ${CANARY_REPO}:${CANARY_TAG} : NO ANSWER within ${PROBE_MAX}s"
          else
              echo "zot manifest ${CANARY_REPO}:${CANARY_TAG} : HTTP ${MANIFEST_CODE} in ${MANIFEST_SECONDS}s (cap ${PROBE_MAX}s)"
          fi
          # The verdict the line above cannot give: it reports the answer the
          # probe waited out under a cap set far wider than any client's, so a
          # reader sees "HTTP 200" for a manifest no pull can survive.
          # Named for what it measures. A scheduled poll keeps this tag's content
          # resident, so its revalidation settles as a fast no-op and the reading
          # reports the UPSTREAM LEG only. It cannot show a cold image arriving,
          # and a line that reads "OK for a real pull" while a guest is stalled
          # on an image the cache does not hold sends the operator to the guest.
          if [ "$MANIFEST_UNDER_PATIENCE" = 1 ]; then
              echo "zot resident-tag revalidation: OK -- answered inside the ${CLIENT_PATIENCE}s a pull waits for response headers"
          else
              echo "zot resident-tag revalidation: FAILING -- a pull gives up after ${CLIENT_PATIENCE}s, whatever the cache answers later"
          fi
          echo "  A cache that answers /v2/ instantly can still take minutes here."
          echo "  Pulls fail around the ${CLIENT_PATIENCE}s mark: dockerd stops waiting for response headers."
          echo "  Scope: ${CANARY_REPO}:${CANARY_TAG} is asked for WITHOUT ns=, so the upstream is picked by"
          echo "  walking the registry list, and a scheduled poll keeps that tag's content current -- the"
          echo "  sync it triggers has nothing to copy. This line times a revalidation of content already"
          echo "  held. It walks neither a cold copy nor the ns= form a guest sends: the next line does."
          # The request a guest's containerd actually issues, on the upstream
          # that has no scheduled poll behind it. Reported as its own line
          # because the two readings can disagree, and the one above is the
          # optimistic half: it stays fast while this leg is what a pull gives
          # up on.
          if [ "$GP_HAVE" = 0 ]; then
              echo "zot guest-path request       : not probed -- no warm run has left a held registry.k8s.io image to ask for"
          elif [ "$GP_CODE" = "0" ]; then
              echo "zot guest-path request       : did not answer inside ${PROBE_MAX}s for ${GP_REF}"
          else
              echo "zot guest-path request       : HTTP ${GP_CODE} in ${GP_SECONDS}s for ${GP_REF} (cap ${PROBE_MAX}s)"
          fi
          if [ "$GP_HAVE" = 1 ]; then
              if [ "$GP_UNDER_PATIENCE" = 1 ]; then
                  echo "  OK -- answered inside the ${CLIENT_PATIENCE}s a pull waits for response headers."
              else
                  echo "  FAILING -- a pull of that image gives up after ${CLIENT_PATIENCE}s, whatever the cache answers later."
              fi
              echo "  Scope: GET /v2/<repo>/manifests/<tag>?ns=registry.k8s.io, the form containerd sends."
              echo "  ns= pins the upstream, and that upstream is on-demand with no poll behind it, so this"
              echo "  walks the sync leg the line above skips. Asked only for an image the last warm run"
              echo "  left held, so it revalidates and never pays a cold copy on this ten-minute cadence."
          fi
          echo "  What a COLD image costs is the warm-set section below."
          echo
          # The cold path, measured on the images the lab actually pulls.
          if [ "$PW_HAVE" = 1 ] && [ "$K8S_TOTAL" = 0 ] && [ "$CNI_TOTAL" = 0 ]; then
              # A run that resolved no set at all is a different state from a run
              # that found every image held, and "0 of 0" reads as the latter.
              echo "Warm sets                    : the last run resolved no image set."
              echo "  Version lookup failed and there was no earlier set to fall back on, so"
              echo "  nothing is being kept warm and a guest pulling now meets a cold cache."
          elif [ "$PW_HAVE" = 1 ]; then
              echo "Warm sets, last warmed ${YURUNA_PREWARM_LAST_RUN:-never} (versions resolved via ${YURUNA_PREWARM_RESOLVE_SRC:-unknown}):"
              echo "  Kubernetes image set (${YURUNA_PREWARM_K8S_PATCH:-unresolved}, pinned minor ${YURUNA_PREWARM_K8S_MINOR:-unknown}):"
              # The count is images the cache HOLDS, so the word held is on the
              # line carrying it: a row that arrived cold completed its copy and
              # is held now, and reporting that number as residency alone tells
              # a reader the cache was stocked when it was not. The split below
              # each count is the half that says which.
              if [ "$K8S_TOTAL" -gt 0 ] && [ "$K8S_HELD" -lt "$K8S_TOTAL" ]; then
                  echo "    resident                 : ${K8S_HELD} of ${K8S_TOTAL} held   <-- a kubeadm init pays $((K8S_TOTAL - K8S_HELD)) cold sync(s)"
              else
                  echo "    resident                 : ${K8S_HELD} of ${K8S_TOTAL} held"
              fi
              echo "      answered from storage  : ${K8S_LOCAL}"
              echo "      copied in by that run  : ${K8S_COLDSYNC}"
              echo "  CNI image set (flannel ${YURUNA_PREWARM_FLANNEL_TAG:-unresolved}):"
              if [ "$CNI_TOTAL" -gt 0 ] && [ "$CNI_HELD" -lt "$CNI_TOTAL" ]; then
                  echo "    resident                 : ${CNI_HELD} of ${CNI_TOTAL} held   <-- the CNI rollout pays $((CNI_TOTAL - CNI_HELD)) cold sync(s)"
              else
                  echo "    resident                 : ${CNI_HELD} of ${CNI_TOTAL} held"
              fi
              echo "      answered from storage  : ${CNI_LOCAL}"
              echo "      copied in by that run  : ${CNI_COLDSYNC}"
              if [ "$((K8S_COLDSYNC + CNI_COLDSYNC))" -gt 0 ]; then
                  echo "  A copied-in image was NOT held when that run asked for it -- the run paid the cold"
                  echo "  sync itself. It is held now, but a guest pulling during that window waited it out."
              fi
              if [ -n "$PW_SLOW_SEC" ]; then
                  echo "  slowest in last warm       : ${PW_SLOW_SEC}s (${PW_SLOW_REF})"
              fi
              # Carried across runs at these versions: once a set is warm every
              # later reading is sub-second, and the number worth keeping is what
              # the cache charged when it was NOT.
              if [ "${YURUNA_PREWARM_WATERMARK:-0}" != "0" ]; then
                  echo "  cold-sync watermark        : ${YURUNA_PREWARM_WATERMARK}s (${YURUNA_PREWARM_WATERMARK_REF})"
              fi
              if [ -n "$PW_INFLIGHT_REF" ]; then
                  echo "  warm run in flight         : ${PW_INFLIGHT_REF} (fetching ${PW_INFLIGHT_SEC}s) -- counts above predate it"
              fi
              if [ "${YURUNA_PREWARM_K8S_RESOLVED:-1}" = "0" ] || [ "${YURUNA_PREWARM_CNI_RESOLVED:-1}" = "0" ]; then
                  echo "  NOTE: the last run could not re-resolve one or both sets and reused the previous list."
              fi
              if [ "$PW_MISSING" -gt 0 ]; then
                  echo "  A guest step budgeted at 1800s will not finish while a set is short: each"
                  echo "  missing image is copied from upstream while the guest waits on its manifest."
              fi
          else
              echo "Warm sets                    : no warm run has recorded residency yet."
              echo "  Until zot-prewarm has run, nothing here reports how long a COLD image takes"
              echo "  to arrive, and the revalidation line above cannot show it."
          fi
          echo
          # Mode first, because the count is unreadable without it: the same number
          # means "the lab's own allowance" (authenticated) or "shared by every
          # guest behind this IP" (anonymous). The account NAME stays out on
          # purpose -- apache serves this page to the LAN with no login, and naming
          # it would publish half of a credential. The name lives in
          # /etc/zot/sync-credentials.json, readable by root and zot alone.
          if [ "$HUB_TOKEN_AUTHENTICATED" = 1 ]; then
              echo "Docker Hub sync              : authenticated with the seeded account -- budget below is that account's"
          elif [ "$HUB_AUTHENTICATED" = 1 ]; then
              echo "Docker Hub sync              : seeded account credential refused by auth.docker.io -- budget below is the anonymous one"
          else
              echo "Docker Hub sync              : anonymous -- budget below is per egress IP, shared by every guest behind this cache"
          fi
          if [ "$HUB_PROBE_OK" = 1 ]; then
              echo "Docker Hub budget            : ${HUB_REMAINING} of ${HUB_LIMIT} left"
          else
              echo "Docker Hub budget            : unreadable (auth or egress problem)"
          fi
          echo
          echo "Upstream registries (GET /v2/, no pull budget spent):"
          cat "$TMP_UP_TXT"
          echo
          echo "Free space: /var/lib/zot ${ZOT_FREE} bytes, squid cache ${SQUID_FREE} bytes"
      } > "$TMP_TXT"
      install -m 0644 "$TMP_TXT" /var/www/html/cache-health
  - path: /etc/systemd/system/zot-meta-exporter.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Yuruna zot metadata exporter (manifest canary + upstream budget)
      After=apache2.service zot.service
      [Service]
      Type=oneshot
      # Stated rather than left to the systemd default, which is far below what
      # this script can legitimately take: two manifest probes capped at 120s
      # each, eight upstream reads at 10s, and the hub budget reads. A run
      # killed at the default deadline never reaches the install that publishes
      # the page, so /var/www/html/cache-health silently keeps the previous
      # run's readings -- and it stalls exactly when the cache is stalling,
      # which is when a reader most needs the numbers to be current. Set above
      # the worst case and well under the timer's 10-minute period, so a wedged
      # run is still reaped before the next one is due.
      TimeoutStartSec=360
      ExecStart=/usr/local/bin/zot-meta-exporter.sh
  - path: /etc/systemd/system/zot-meta-exporter.timer
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Run zot-meta-exporter every 10 minutes
      [Timer]
      # Slower than the 30s squid probe: the canary walks a full mutable-tag
      # revalidation, too heavy for a 30-second loop. Not a budget question --
      # the canary's upstream meters nothing, and the one metered read in the
      # script rate-limits itself to hourly internally.
      OnBootSec=90s
      OnUnitActiveSec=10min
      AccuracySec=30s
      Unit=zot-meta-exporter.service
      [Install]
      WantedBy=timers.target
  # --- REGION: https://yuruna.link/429f3d06-004c
  - path: /usr/local/bin/zot-prewarm.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # Yuruna zot prewarm: keeps the image sets a Kubernetes guest pulls
      # resident in this cache, and times every fetch so the health page can
      # report the path a real pull walks.
      #
      # zot resolves a TAG by re-running the on-demand upstream sync before any
      # local-storage check, and when the content is not already held that sync
      # copies the whole multi-arch index before the manifest request is
      # answered. A guest meeting that cold pays minutes per image inside a step
      # budget sized for a warm cache. Warming on a timer moves the cost off the
      # critical path.
      #
      # Timing it HERE is also the only reading that can show the cold path. A
      # tag a scheduled poll keeps resident answers from local storage in
      # milliseconds however badly a cold sync is behaving, so a canary pinned to
      # such a tag reports green by construction -- it measures the upstream leg
      # and nothing about how long an image the lab does not hold takes to
      # arrive.
      set +e
      umask 022

      STATE_DIR=/var/lib/yuruna
      SET_FILE="$STATE_DIR/prewarm-set.tsv"
      ROWS_FILE="$STATE_DIR/prewarm-rows.tsv"
      META_FILE="$STATE_DIR/prewarm-meta.env"
      LOCK_FILE="$STATE_DIR/prewarm.lock"
      ZOT='http://127.0.0.1:5000'

      # Per-image ceiling. Wide on purpose: it exists to stop a wedged upstream
      # pinning this unit forever, not to express what is acceptable. A cold
      # multi-arch control-plane image legitimately takes minutes, and cutting it
      # short would abandon a sync the next run then has to start over.
      PREWARM_MAX=900
      # Above this, the request moved content rather than revalidating a tag the
      # cache already held: local storage answers in milliseconds, so a reading
      # in whole seconds already means the upstream leg ran.
      COLD_FLOOR=5
      # Spelled out for the same reason the exporter spells it out: a manifest
      # request stating no preference gets the registry's default, which for a
      # multi-arch tag is not the index a real pull resolves.
      ACCEPT='application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.docker.distribution.manifest.v2+json'

      install -d -m 0755 "$STATE_DIR" 2>/dev/null

      # Serialize. Two overlapping runs would race on the state files and double
      # the upstream work for no benefit; a long cold run overlapping the next
      # timer tick is the normal case, not an exceptional one.
      exec 9>"$LOCK_FILE"
      if ! flock -n 9; then
          echo "zot-prewarm: another run holds the lock; skipping this tick"
          exit 0
      fi

      # --- REGION: Resolve what to keep warm
      # Every input below is read from the same source the guest reads, so the
      # warm set cannot drift from the set a guest pulls. Naming versions in this
      # file instead would create a second pin that goes stale silently, and the
      # staleness would only surface as a cold cache during a provisioning run.
      #
      # All resolution fetches go direct. Routing them through this VM's own
      # ssl-bump listener would make a source fetch depend on the proxy it is
      # meant to keep stocked.
      YR_BASE="https://raw.githubusercontent.com/alissonsol/yuruna/refs/heads/main/"
      YR_SRC="github"
      # Safe to source: host.env is host-baked IP/PORT only, never operator free text.
      if [ -r /etc/yuruna/host.env ]; then
          . /etc/yuruna/host.env
          YR_H="${YURUNA_STATUS_SERVICE_IP:-}"
          YR_P="${YURUNA_STATUS_SERVICE_PORT:-}"
          if [ -n "$YR_H" ] && [ -n "$YR_P" ] && \
             curl -fsS --noproxy '*' -m 5 -o /dev/null "http://${YR_H}:${YR_P}/livecheck" 2>/dev/null; then
              YR_BASE="http://${YR_H}:${YR_P}/yuruna-repo/"
              YR_SRC="local host status service"
          fi
      fi

      # Parsed with a line regex rather than sourced: the versions file is a
      # contract of plain `export KEY=value` lines precisely so a consumer never
      # has to execute it to read one value out.
      K8S_MINOR=""
      VERSIONS_TXT=$(curl -fsSL --noproxy '*' -m 20 "${YR_BASE}automation/yuruna-versions.sh" 2>/dev/null)
      if [ -n "$VERSIONS_TXT" ]; then
          K8S_MINOR=$(printf '%s\n' "$VERSIONS_TXT" \
              | sed -n 's/^export YURUNA_K8S_MINOR=\([0-9][0-9.]*\).*$/\1/p' | head -n1)
      fi

      K8S_PATCH=""
      if [ -n "$K8S_MINOR" ]; then
          K8S_PATCH=$(curl -fsSL --noproxy '*' -m 20 \
              "https://dl.k8s.io/release/stable-${K8S_MINOR}.txt" 2>/dev/null | tr -d '\r\n')
      fi

      # kubeadm's image set cannot be derived from the Kubernetes version:
      # coredns, pause and etcd carry tags of their own, baked into the binary
      # and moved on their own schedule. Running the same binary the guest runs
      # is the only way to get the list right -- a tag glob would silently miss
      # three of the seven images, and those three would then be the ones
      # arriving cold.
      DEB_ARCH=$(dpkg --print-architecture 2>/dev/null || echo amd64)
      K8S_REFS=""
      if [ -n "$K8S_PATCH" ]; then
          KUBEADM_BIN="$STATE_DIR/kubeadm-${K8S_PATCH}-${DEB_ARCH}"
          if [ ! -x "$KUBEADM_BIN" ]; then
              if curl -fsSL --noproxy '*' -m 600 -o "${KUBEADM_BIN}.part" \
                      "https://dl.k8s.io/release/${K8S_PATCH}/bin/linux/${DEB_ARCH}/kubeadm" 2>/dev/null; then
                  chmod 0755 "${KUBEADM_BIN}.part" && mv -f "${KUBEADM_BIN}.part" "$KUBEADM_BIN"
              else
                  rm -f "${KUBEADM_BIN}.part"
              fi
          fi
          if [ -x "$KUBEADM_BIN" ]; then
              # Filtered to lines that look like a registry reference so a future
              # kubeadm printing a banner or a deprecation note cannot inject a
              # bogus entry into the warm set.
              K8S_REFS=$("$KUBEADM_BIN" config images list --kubernetes-version "$K8S_PATCH" 2>/dev/null \
                  | grep -E '^[a-z0-9][a-z0-9.-]*\.[a-z]+/[a-z0-9][^[:space:]]*:[^[:space:]]+$')
          fi
          # One binary per version is the point of the cache; keeping every
          # version ever pinned is not.
          find "$STATE_DIR" -maxdepth 1 -name 'kubeadm-*' ! -name "kubeadm-${K8S_PATCH}-${DEB_ARCH}" -delete 2>/dev/null
      fi

      # Flannel tracks latest rather than a pin, so its tag is resolved exactly
      # the way the guest resolves it -- follow the release redirect, then read
      # the image names out of the manifest the guest applies. Same two hops,
      # same answer, no third place to keep in step.
      FLANNEL_TAG=$(curl -fsSI --noproxy '*' -m 20 \
          "https://github.com/flannel-io/flannel/releases/latest" 2>/dev/null \
          | tr -d '\r' | awk 'tolower($1)=="location:"{n=split($2,a,"/"); print a[n]}')
      CNI_REFS=""
      if [ -n "$FLANNEL_TAG" ]; then
          CNI_REFS=$(curl -fsSL --noproxy '*' -m 30 \
              "https://raw.githubusercontent.com/flannel-io/flannel/${FLANNEL_TAG}/Documentation/kube-flannel.yml" 2>/dev/null \
              | awk '$1=="image:"{print $2}' | sort -u)
      fi

      # A resolution outage must degrade to warming the PREVIOUS set, never to
      # warming nothing: the images a guest needs did not change because github
      # was briefly unreachable, and an empty set would quietly stop protecting
      # the very run about to pull them. Carried per set, so one upstream being
      # down does not discard the other's resolution.
      # The flag records whether THIS run resolved the set, not whether it ended
      # up with a list: a run that resolved nothing and had nothing to fall back
      # on must not report itself as current.
      K8S_RESOLVED=1
      [ -z "$K8S_REFS" ] && K8S_RESOLVED=0
      if [ "$K8S_RESOLVED" = 0 ] && [ -r "$SET_FILE" ]; then
          K8S_REFS=$(awk -F'\t' '$1=="k8s"{print $2}' "$SET_FILE")
      fi
      CNI_RESOLVED=1
      [ -z "$CNI_REFS" ] && CNI_RESOLVED=0
      if [ "$CNI_RESOLVED" = 0 ] && [ -r "$SET_FILE" ]; then
          CNI_REFS=$(awk -F'\t' '$1=="cni"{print $2}' "$SET_FILE")
      fi

      SET_TMP=$(mktemp)
      ROWS_TMP=$(mktemp)
      META_TMP=$(mktemp)
      PROGRESS_FILE="$STATE_DIR/prewarm-progress"
      # The progress marker is removed on ANY exit, including a kill mid-sync: a
      # marker outliving its run would report a fetch still in flight forever,
      # and "the cache is busy, wait" is the one line here an operator acts on
      # by NOT re-running.
      trap 'rm -f "$SET_TMP" "$ROWS_TMP" "$META_TMP" "$PROGRESS_FILE"' EXIT
      for r in $K8S_REFS; do printf 'k8s\t%s\n' "$r" >> "$SET_TMP"; done
      for r in $CNI_REFS; do printf 'cni\t%s\n' "$r" >> "$SET_TMP"; done
      [ -s "$SET_TMP" ] && install -m 0644 "$SET_TMP" "$SET_FILE"

      # --- REGION: Warm the set and time it
      warm_one() {
          W_SET=$1
          W_REF=$2
          W_UPSTREAM=${W_REF%%/*}
          W_REST=${W_REF#*/}
          W_TAG=${W_REST##*:}
          W_REPO=${W_REST%:*}
          # ns= names the upstream this repository belongs to. It is the same
          # parameter containerd's hosts.toml form sends on every pull, and it is
          # how zot picks which registry entry to sync from. Without it zot walks
          # its list in file order, where Docker Hub is the `**` catch-all -- so
          # warming a registry.k8s.io image would spend one of the metered Docker
          # Hub lookups the whole lab shares, on an image Hub never served.
          printf '%s\t%s\n' "$(date +%s)" "$W_REF" > "$PROGRESS_FILE"
          W_T0=$(date +%s.%N)
          W_CODE=$(curl -s -o /dev/null --noproxy '*' -m "$PREWARM_MAX" \
                        -H "Accept: ${ACCEPT}" -w '%{http_code}' \
                        "${ZOT}/v2/${W_REPO}/manifests/${W_TAG}?ns=${W_UPSTREAM}" 2>/dev/null)
          W_T1=$(date +%s.%N)
          W_SEC=$(awk -v a="$W_T0" -v b="$W_T1" 'BEGIN{printf "%.3f", b-a}')
          if [ "$W_CODE" = "200" ]; then
              # Compared in awk because the elapsed time is fractional and the
              # shell's test builtin errors outright on a non-integer operand.
              if awk -v s="$W_SEC" -v f="$COLD_FLOOR" 'BEGIN{exit !(s<f)}'; then
                  W_STATE=resident
              else
                  W_STATE=cold
              fi
          elif [ "$W_CODE" = "000" ] || [ -z "$W_CODE" ]; then
              W_STATE=timeout
          else
              W_STATE=failed
          fi
          printf '%s\t%s\t%s\t%s\t%s\n' "$W_SET" "$W_REF" "${W_CODE:-000}" "$W_SEC" "$W_STATE" >> "$ROWS_TMP"
      }

      for r in $K8S_REFS; do warm_one k8s "$r"; done
      for r in $CNI_REFS; do warm_one cni "$r"; done
      rm -f "$PROGRESS_FILE"
      install -m 0644 "$ROWS_TMP" "$ROWS_FILE"

      # The watermark answers what a resident/total count cannot: how long a
      # guest waits when the set is NOT held. Kept per resolved version and
      # reset when that version moves, because how long an older image set took
      # to arrive says nothing about the current one.
      PREV_WATERMARK=0
      PREV_WATERMARK_REF=""
      YURUNA_PREWARM_WATERMARK=""
      YURUNA_PREWARM_WATERMARK_REF=""
      YURUNA_PREWARM_K8S_PATCH=""
      YURUNA_PREWARM_FLANNEL_TAG=""
      # Machine-written by this script alone, so sourcing carries no operator
      # free text into the shell.
      [ -r "$META_FILE" ] && . "$META_FILE" 2>/dev/null
      if [ "${YURUNA_PREWARM_K8S_PATCH:-}" = "$K8S_PATCH" ] && \
         [ "${YURUNA_PREWARM_FLANNEL_TAG:-}" = "$FLANNEL_TAG" ]; then
          PREV_WATERMARK=${YURUNA_PREWARM_WATERMARK:-0}
          PREV_WATERMARK_REF=${YURUNA_PREWARM_WATERMARK_REF:-}
      fi
      WATERMARK_ROW=$(awk -F'\t' -v prev="$PREV_WATERMARK" -v prevref="$PREV_WATERMARK_REF" '
          BEGIN { m = prev + 0; ref = prevref }
          $5 == "cold" && ($4 + 0) > m { m = $4 + 0; ref = $2 }
          END { printf "%.0f\t%s", m, ref }' "$ROWS_FILE")
      WATERMARK=$(printf '%s' "$WATERMARK_ROW" | cut -f1)
      WATERMARK_REF=$(printf '%s' "$WATERMARK_ROW" | cut -f2)

      {
          echo "YURUNA_PREWARM_LAST_RUN=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          echo "YURUNA_PREWARM_K8S_MINOR=${K8S_MINOR}"
          echo "YURUNA_PREWARM_K8S_PATCH=${K8S_PATCH}"
          echo "YURUNA_PREWARM_FLANNEL_TAG=${FLANNEL_TAG}"
          echo "YURUNA_PREWARM_RESOLVE_SRC=${YR_SRC}"
          echo "YURUNA_PREWARM_K8S_RESOLVED=${K8S_RESOLVED}"
          echo "YURUNA_PREWARM_CNI_RESOLVED=${CNI_RESOLVED}"
          echo "YURUNA_PREWARM_WATERMARK=${WATERMARK}"
          echo "YURUNA_PREWARM_WATERMARK_REF=${WATERMARK_REF}"
      } > "$META_TMP"
      install -m 0644 "$META_TMP" "$META_FILE"

      # Refresh the published page immediately rather than waiting out the
      # exporter's next tick: the reading this run just produced is the one an
      # operator asks for after a provisioning failure, and a ten-minute gap is
      # long enough for them to read the previous state and conclude the cache
      # was fine.
      [ -x /usr/local/bin/zot-meta-exporter.sh ] && /usr/local/bin/zot-meta-exporter.sh
      exit 0
  - path: /etc/systemd/system/zot-prewarm.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Yuruna zot prewarm (keep the guest image sets resident, and time the cold path)
      After=network-online.target zot.service apache2.service
      Wants=network-online.target
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/zot-prewarm.sh
      # A cold multi-arch set legitimately runs into the tens of minutes, and
      # systemd's default start timeout would kill it mid-sync -- leaving the
      # cache with partial content and the next run repeating the same work.
      TimeoutStartSec=3h
  - path: /etc/systemd/system/zot-prewarm.timer
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Warm the guest image sets in zot every 6 hours
      [Timer]
      # 6h matches the scheduled sync entries in zot's own config: both exist to
      # keep content resident, and running them on different cadences would only
      # make the health page disagree with the registry about how current it is.
      # OnBootSec is short because a cache that just rebooted holds nothing a
      # guest starting now can use, and the first cycle after a rebuild is
      # exactly when a cold set costs a run.
      OnBootSec=3min
      OnUnitActiveSec=6h
      AccuracySec=1min
      # A host powered off across the interval must warm on the next boot rather
      # than wait out a full period it already slept through.
      Persistent=true
      Unit=zot-prewarm.service
      [Install]
      WantedBy=timers.target
  # --- REGION: https://yuruna.link/429f3d06-004d
  - path: /etc/systemd/system/squid-exporter.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Squid Prometheus exporter (boynux/squid-exporter)
      After=network-online.target squid.service
      Wants=network-online.target squid.service
      [Service]
      Type=simple
      User=nobody
      Group=nogroup
      ExecStart=/usr/local/bin/squid-exporter -listen 127.0.0.1:9301 -squid-hostname localhost -squid-port 3128
      Restart=on-failure
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
  # --- REGION: https://yuruna.link/429f3d06-004e
  - path: /etc/systemd/system/grafana-server.service.d/yuruna.conf
    permissions: '0644'
    owner: root:root
    content: |
      [Service]
      Environment=GF_AUTH_ANONYMOUS_ENABLED=true
      Environment=GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
  # --- REGION: https://yuruna.link/429f3d06-004f
  - path: /etc/grafana/provisioning/datasources/yuruna.yaml
    permissions: '0644'
    owner: root:root
    content: |
      apiVersion: 1
      datasources:
        - name: Prometheus
          uid: yuruna-prometheus
          type: prometheus
          access: proxy
          url: http://localhost:9090
          isDefault: true
          editable: false
        - name: Loki
          uid: yuruna-loki
          type: loki
          access: proxy
          url: http://localhost:3100
          editable: false
  # --- REGION: https://yuruna.link/429f3d06-0050
  - path: /usr/local/bin/yuruna-rewrite-zot-dashboard.py
    permissions: '0755'
    owner: root:root
    content: |
      #!/usr/bin/env python3
      """Rebind the grafana.com zot dashboard to yuruna-prometheus, prune
      panels/vars zot doesn't emit, pin uid+title; stdin->stdout."""
      import json, re, sys
      d = json.load(sys.stdin)

      # 1) Rebind every datasource reference to our Prometheus.
      def rebind(obj):
          if isinstance(obj, dict):
              ds = obj.get('datasource')
              if isinstance(ds, dict) and ds.get('uid') == '$DS_PROMETHEUS':
                  ds['uid'] = 'yuruna-prometheus'
              elif isinstance(ds, str) and ds == '$DS_PROMETHEUS':
                  obj['datasource'] = {'type': 'prometheus', 'uid': 'yuruna-prometheus'}
              for v in obj.values(): rebind(v)
          elif isinstance(obj, list):
              for v in obj: rebind(v)
      rebind(d)

      # 2) Drop the DS_PROMETHEUS template variable (now hard-bound).
      tlist = d.get('templating', {}).get('list', [])
      d['templating']['list'] = [v for v in tlist
          if not (v.get('type') == 'datasource' and v.get('name') == 'DS_PROMETHEUS')]

      # --- REGION: https://yuruna.link/429f3d06-0051
      # 3) Drop panels whose metric doesn't exist on zot v2.x. Add further names here.
      BAD_METRICS = ('zot_scheduler_workers_tasks_duration_seconds_bucket',)
      def uses_bad_metric(p):
          for t in p.get('targets', []):
              expr = t.get('expr', '') or ''
              if any(m in expr for m in BAD_METRICS): return True
          return False
      panels = [p for p in d.get('panels', []) if not uses_bad_metric(p)]
      # Same scrub for template variables querying the same dead metric.
      def var_uses_bad_metric(v):
          q = v.get('query')
          if isinstance(q, dict): q = q.get('query', '') or ''
          return isinstance(q, str) and any(m in q for m in BAD_METRICS)
      d['templating']['list'] = [v for v in d['templating']['list']
          if not var_uses_bad_metric(v)]

      # 4) Drop orphaned rows left behind when their only child panel was pruned.
      def prune_orphan_rows(plist):
          out = []
          for i, p in enumerate(plist):
              if p.get('type') != 'row':
                  out.append(p); continue
              has_child = False
              for q in plist[i+1:]:
                  if q.get('type') == 'row': break
                  has_child = True; break
              if has_child: out.append(p)
          return out
      d['panels'] = prune_orphan_rows(panels)

      # 5) Inline $storageName: one backend here, so a dropdown only hides the data.
      def inline_var(obj, needle, replacement):
          if isinstance(obj, dict):
              if isinstance(obj.get('expr'), str):
                  obj['expr'] = obj['expr'].replace(needle, replacement)
              for v in obj.values(): inline_var(v, needle, replacement)
          elif isinstance(obj, list):
              for v in obj: inline_var(v, needle, replacement)
      inline_var(d, 'storageName="$storageName"', 'storageName=~".+"')
      d['templating']['list'] = [v for v in d['templating']['list']
          if v.get('name') != 'storageName']
      # "Storage lock latency" (panel 47) stays blank under Grafana 13; replace it
      # with a histogram_quantile timeseries. Match on query, not id, to survive
      # an upstream re-numbering.
      def panel_targets_lock_latency(p):
          for t in p.get('targets', []) or []:
              if 'zot_storage_lock_latency_seconds_bucket' in (t.get('expr','') or ''):
                  return True
          return False
      DS = {"type": "prometheus", "uid": "yuruna-prometheus"}
      def lock_pctile_target(p):
          q = {'P50': '0.5', 'P90': '0.9', 'P99': '0.99'}[p]
          return {
              "refId": p, "datasource": DS, "editorMode": "code", "range": True,
              "legendFormat": "{{lockType}} " + p,
              "expr": ("histogram_quantile(" + q + ", sum(rate(zot_storage_lock_latency_seconds_bucket"
                       "{storageName=~\".+\"}[5m])) by (le, lockType))"),
          }
      for i, p in enumerate(d['panels']):
          if panel_targets_lock_latency(p):
              d['panels'][i] = {
                  "id": p.get('id'),
                  "type": "timeseries",
                  "title": "/var/lib/zot -- lock latency (P50 / P90 / P99)",
                  "gridPos": p.get('gridPos', {"h": 8, "w": 24, "x": 0, "y": 150}),
                  "datasource": DS,
                  "pluginVersion": "13.0.1",
                  "targets": [lock_pctile_target(x) for x in ('P50', 'P90', 'P99')],
                  "fieldConfig": {
                      "defaults": {
                          "unit": "s", "decimals": 4,
                          "color": {"mode": "palette-classic"},
                          "custom": {
                              "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10,
                              "spanNulls": False, "showPoints": "never",
                              "axisPlacement": "auto",
                              "scaleDistribution": {"type": "linear"},
                              "hideFrom": {"tooltip": False, "viz": False, "legend": False},
                              "stacking": {"mode": "none", "group": "A"},
                              "thresholdsStyle": {"mode": "off"},
                          },
                          "mappings": [],
                          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": None}]},
                      },
                      "overrides": [],
                  },
                  "options": {
                      "legend": {"showLegend": True, "displayMode": "table",
                                 "placement": "bottom",
                                 "calcs": ["lastNotNull", "max", "mean"]},
                      "tooltip": {"mode": "multi", "sort": "desc"},
                  },
              }

      # 5.5) format=time_series on a heatmap target renders "No data" under Grafana 13.
      for p in d['panels']:
          if p.get('type') == 'heatmap':
              for t in p.get('targets', []) or []:
                  t['format'] = 'heatmap'
              # Titles keep an orphan $storageName after step 5 dropped the variable.
              if isinstance(p.get('title'), str) and '$storageName' in p['title']:
                  p['title'] = p['title'].replace('$storageName', '/var/lib/zot')

      # 5.6) $__interval can collapse to one sample per window; $__rate_interval cannot.
      def fix_rate_interval(obj):
          if isinstance(obj, dict):
              if isinstance(obj.get('expr'), str):
                  obj['expr'] = obj['expr'].replace('[$__interval]', '[$__rate_interval]')
              for v in obj.values(): fix_rate_interval(v)
          elif isinstance(obj, list):
              for v in obj: fix_rate_interval(v)
      fix_rate_interval(d)

      # 5.7) A multi+all variable in `=` position matches the literal "GET|HEAD"; use `=~`.
      multi_all_vars = [v['name'] for v in d.get('templating', {}).get('list', [])
                        if v.get('multi') and v.get('includeAll')]
      def fix_multi_equality(obj):
          if isinstance(obj, dict):
              if isinstance(obj.get('expr'), str):
                  e = obj['expr']
                  for vname in multi_all_vars:
                      e = re.sub(
                          r'([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"\$' + re.escape(vname) + r'"',
                          r'\1=~"$' + vname + '"', e)
                  obj['expr'] = e
              for v in obj.values(): fix_multi_equality(v)
          elif isinstance(obj, list):
              for v in obj: fix_multi_equality(v)
      fix_multi_equality(d)

      # 6) Stable identity, then strip import-only fields.
      d['uid'] = 'yuruna-zot-official'
      d['title'] = 'Zot (official, Grafana ID 20501)'
      # The 'community' tag is this board's provenance, declared by the step that
      # installs it rather than guessed downstream. The uid cannot carry it: this
      # line rewrites the uid into the yuruna- namespace precisely so the board
      # has a stable identity, which makes uid useless for telling ours from
      # upstream. The brand stamper reads this tag.
      d['tags'] = sorted(set((d.get('tags') or []) + ['yuruna', 'community']))
      for k in ('id', '__inputs', '__elements', '__requires'):
          d.pop(k, None)
      json.dump(d, sys.stdout, indent=2)
  # --- REGION: https://yuruna.link/429f3d06-0052
  - path: /etc/grafana/provisioning/dashboards/yuruna.yaml
    permissions: '0644'
    owner: root:root
    content: |
      apiVersion: 1
      providers:
        - name: yuruna
          folder: ''
          type: file
          disableDeletion: true
          updateIntervalSeconds: 30
          options:
            path: /var/lib/grafana/dashboards
  # --- REGION: https://yuruna.link/429f3d06-0053
  # The rule is a PRODUCT of two conditions: an unread budget publishes
  # remaining=0 too, so gating on the probe gauge keeps a refused credential or
  # broken egress from being announced as exhaustion.
  # No contact point is provisioned (delivery is a no-op until one exists), but
  # the rule still turns a number somebody has to notice into a condition with
  # a state, a start time, and history, attached to its panel.
  - path: /etc/grafana/provisioning/alerting/yuruna.yaml
    permissions: '0644'
    owner: root:root
    content: |
      apiVersion: 1
      groups:
        - orgId: 1
          name: yuruna-cache
          folder: Yuruna
          # Far slower than the 15s scrape: the budget is re-read at most hourly
          # and republished from disk in between, so a tighter evaluation only
          # re-examines a value that cannot have moved.
          interval: 5m
          rules:
            - uid: yuruna-hub-pull-budget-exhausted
              title: Docker Hub pull budget exhausted
              condition: C
              data:
                - refId: A
                  relativeTimeRange:
                    from: 600
                    to: 0
                  datasourceUid: yuruna-prometheus
                  model:
                    refId: A
                    datasource:
                      type: prometheus
                      uid: yuruna-prometheus
                    instant: true
                    range: false
                    # `== bool` on both halves keeps this a 1/0 series that
                    # always exists. Written as a plain `and` the vector would
                    # be EMPTY in the healthy case, which alerting cannot tell
                    # apart from an exporter that stopped publishing -- the
                    # quiet failure this rule exists to prevent.
                    expr: (yuruna_dockerhub_ratelimit_remaining == bool 0) * (yuruna_dockerhub_ratelimit_probe_ok == bool 1)
                - refId: C
                  relativeTimeRange:
                    from: 600
                    to: 0
                  datasourceUid: __expr__
                  model:
                    refId: C
                    type: threshold
                    datasource:
                      type: __expr__
                      uid: __expr__
                    expression: A
                    conditions:
                      - evaluator:
                          type: gt
                          params:
                            - 0.5
              # Long enough to ride out a single failed evaluation, short enough
              # to land well inside the one-hour window the budget resets on.
              for: 10m
              # An absent series means the exporter is gone, which is a different
              # fault with a different fix; it surfaces as NoData rather than
              # borrowing this rule's summary.
              noDataState: NoData
              execErrState: Error
              isPaused: false
              labels:
                severity: warning
              annotations:
                __dashboardUid__: yuruna-cache-health
                __panelId__: "2"
                summary: Docker Hub pull budget for this egress IP is exhausted
                description: >-
                  zot's on-demand sync is being refused upstream. Guests never
                  see the 429: a repository already in local storage keeps
                  serving from cache, while anything NOT yet cached returns a
                  bare 404 manifest-unknown, which reads like a misspelled image
                  name and sends the reader hunting in the wrong place. Look for
                  repositories resolving against the Docker Hub catch-all in
                  registries[] -- a tag-addressed pull re-runs the upstream sync
                  on every single request, so a handful of guests looping on one
                  image holds the hourly allowance at zero indefinitely.
  # --- REGION: https://yuruna.link/429f3d06-0054
  - path: /etc/yuruna/host.env
    permissions: '0644'
    owner: root:root
    content: |
      YURUNA_STATUS_SERVICE_IP=YURUNA_STATUS_SERVICE_IP_PLACEHOLDER
      YURUNA_STATUS_SERVICE_PORT=YURUNA_STATUS_SERVICE_PORT_PLACEHOLDER
      YURUNA_HOST_ID=YURUNA_HOST_ID_PLACEHOLDER
      YURUNA_CACHING_PROXY_SERVICE_IP=127.0.0.1
  # --- REGION: https://yuruna.link/429f3d06-002a
  # This VM resolves its host through the pool directory like every other
  # guest -- the difference is that the directory is running on THIS machine,
  # so the address it asks is loopback. That is not the loopback case the
  # resolver refuses: the refusal applies to an ANSWER (a host advertising
  # 127.0.0.1 is advertising the reader's own box), never to the directory
  # being consulted. Hard-coded rather than seeded because it is a fact about
  # where the aggregator runs, not about where this lab put its cache.
  - path: /usr/local/lib/yuruna/yuruna-host-locate.sh
    encoding: base64
    content: YURUNA_HOST_LOCATE_BASE64_PLACEHOLDER
    permissions: '0755'
  - path: /etc/systemd/system/yuruna-host-locate.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh Yuruna host coordinates if the host has changed address
      After=network.target NetworkManager-wait-online.service systemd-networkd-wait-online.service
      Before=network-online.target

      [Service]
      Type=oneshot
      TimeoutStartSec=30
      ExecStart=/usr/local/lib/yuruna/yuruna-host-locate.sh

      [Install]
      WantedBy=network-online.target
  - path: /etc/systemd/system/yuruna-host-locate.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic Yuruna host coordinate refresh

      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=60s
      AccuracySec=5s

      [Install]
      WantedBy=timers.target
  # --- REGION: https://yuruna.link/429f3d06-005e
  - path: /etc/yuruna/host-config/config.env
    permissions: '0644'
    owner: root:root
    content: |
      YURUNA_CONFIG_SERVICE_PORT=YURUNA_CONFIG_SERVICE_PORT_PLACEHOLDER
      YURUNA_CONFIG_SERVICE_SAN=yuruna-host-config
  - path: /etc/yuruna/host-config/ca.crt
    permissions: '0644'
    owner: root:root
    encoding: b64
    content: 'YURUNA_CONFIG_SERVICE_CA_CERT_BASE64_PLACEHOLDER'
  - path: /etc/yuruna/host-config/client.crt
    permissions: '0644'
    owner: root:root
    encoding: b64
    content: 'YURUNA_CONFIG_SERVICE_CLIENT_CERT_BASE64_PLACEHOLDER'
  - path: /etc/yuruna/host-config/client.key
    permissions: '0600'
    owner: root:root
    encoding: b64
    content: 'YURUNA_CONFIG_SERVICE_CLIENT_KEY_BASE64_PLACEHOLDER'
  - path: /usr/local/bin/yuruna-config-fetch.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/sh
      # Fetch one NAS credential set (stash|pool) over mTLS; on a version change
      # (or when not mounted) rewrite the 0600 cifs credentials file and remount.
      set -u
      NAME="${1:-stash}"
      CDIR=/etc/yuruna/host-config
      # host.env holds only host-baked coordinates (no operator free-text), so sourcing
      # is safe; operator-supplied env files must instead be sed-extracted.
      [ -r /etc/yuruna/host.env ] && . /etc/yuruna/host.env
      [ -r "$CDIR/config.env" ] && . "$CDIR/config.env"
      HOST_IP="${YURUNA_STATUS_SERVICE_IP:-}"
      HOST_PORT="${YURUNA_STATUS_SERVICE_PORT:-8080}"
      PORT="${YURUNA_CONFIG_SERVICE_PORT:-8443}"
      SAN="${YURUNA_CONFIG_SERVICE_SAN:-yuruna-host-config}"
      # Per-name mount point, credentials file and mount mode; this fetch is the
      # SINGLE owner of each mount + credential pair.
      case "$NAME" in
        stash) MOUNT=/mnt/ystash-nas; CRED=/etc/yuruna/host-config/stash.cifs.cred; MODEOPT=,ro ;;
        pool)  MOUNT=/mnt/ypool-nas;  CRED=/etc/yuruna/ypool-nas.cifs.cred;          MODEOPT= ;;
        *)     MOUNT="/mnt/$NAME";     CRED="/etc/yuruna/host-config/$NAME.cifs.cred"; MODEOPT=,ro ;;
      esac
      # Breadcrumb so "configured but not mounting" is diagnosable without SSH.
      STATUS="/var/www/html/config-fetch-$NAME-status"
      note() { printf 'last_attempt=%s name=%s mounted=%s detail=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NAME" "$(mountpoint -q "$MOUNT" 2>/dev/null && echo 1 || echo 0)" "$1" > "$STATUS" 2>/dev/null || true; logger -t yuruna-config "$NAME: $1"; }
      [ -n "$HOST_IP" ] || { note "no-host-ip (seed lacks host coordinates)"; exit 0; }
      [ -s "$CDIR/client.crt" ] && [ -s "$CDIR/client.key" ] && [ -s "$CDIR/ca.crt" ] || { note "no-client-cert (mTLS materials absent)"; exit 0; }
      command -v curl >/dev/null 2>&1 || { note "curl-missing"; exit 0; }
      command -v jq   >/dev/null 2>&1 || { note "jq-missing"; exit 0; }
      # Retry burst: at guest boot the host config service may not be accepting yet
      # (host bring-up races VM boot); idempotent, so harmless on the hourly path.
      JSON=''
      i=1
      while [ "$i" -le 5 ]; do
        JSON="$(curl -sS --max-time 20 --cacert "$CDIR/ca.crt" --cert "$CDIR/client.crt" --key "$CDIR/client.key" --connect-to "$SAN:$PORT:$HOST_IP:$PORT" "https://$SAN:$PORT/v1/nas/$NAME" 2>/dev/null)" && [ -n "$JSON" ] && break
        JSON=''; i=$((i+1)); [ "$i" -le 5 ] && sleep 10
      done
      if [ -z "$JSON" ]; then
        # Distinguish "host unreachable at the baked IP (stale after a host DHCP
        # change)" from "host up but the config service is down/refusing".
        if curl -s --max-time 5 -o /dev/null "http://$HOST_IP:$HOST_PORT/livecheck" 2>/dev/null; then
          note "config-service-down-at-$HOST_IP:$PORT (host reachable; start the config service)"
        else
          note "host-unreachable-at-$HOST_IP (baked host IP may be stale; rebuild the VM or fix host networking)"
        fi
        exit 0
      fi
      NETPATH="$(printf '%s' "$JSON" | jq -r '.networkPath // empty')"
      # A NAS name only the host can resolve (New-LocalLabStorage points ypool-nas
      # at the host's loopback) fails the mount with cifs_mount -111; fall back to
      # the known-good host IP the config service just answered on.
      IPOPT=""
      NAS_HOST="$(printf '%s' "$NETPATH" | sed -nE 's#^//([^/]+)/.*#\1#p')"
      if [ -n "$NAS_HOST" ] && ! getent hosts "$NAS_HOST" >/dev/null 2>&1 && [ -n "$HOST_IP" ]; then
        IPOPT=",ip=$HOST_IP"
      fi
      NAS_USER="$(printf '%s' "$JSON" | jq -r '.username // empty')"
      NAS_PASS="$(printf '%s' "$JSON" | jq -r '.password // empty')"
      VERSION="$(printf '%s' "$JSON" | jq -r '.version // empty')"
      [ -n "$NETPATH" ] && [ -n "$NAS_USER" ] && [ -n "$NAS_PASS" ] && [ -n "$VERSION" ] || { note "incomplete-payload (NAS not configured or vault credential unset)"; exit 0; }
      umask 077
      # printf %s writes the password literally -- no shell re-parsing -- so vault
      # special characters survive into the cifs credentials file intact.
      printf 'username=%s\npassword=%s\n' "$NAS_USER" "$NAS_PASS" > "$CRED"
      chmod 600 "$CRED" 2>/dev/null || true
      VERF="$CDIR/$NAME.version"
      PREV=''
      [ -r "$VERF" ] && PREV="$(cat "$VERF" 2>/dev/null)"
      mkdir -p "$MOUNT" 2>/dev/null || true
      CHANGED=0
      [ "$VERSION" != "$PREV" ] && CHANGED=1
      mountpoint -q "$MOUNT" 2>/dev/null || CHANGED=1
      if [ "$CHANGED" = "1" ]; then
        mountpoint -q "$MOUNT" 2>/dev/null && timeout 30 umount "$MOUNT" >/dev/null 2>&1
        # MODEOPT is ,ro for stash (read-only scan) and empty (read-write) for pool.
        # NO iocharset=utf8: nls_utf8 is absent on the minimal cloud kernel and the
        # mount fails with error(79); the on-disk names are ASCII.
        timeout 60 mount -t cifs "$NETPATH" "$MOUNT" -o "credentials=$CRED,vers=3.0,uid=0,gid=0,nofail$MODEOPT$IPOPT" >/dev/null 2>&1 || true
        printf '%s' "$VERSION" > "$VERF" 2>/dev/null || true
      fi
      if mountpoint -q "$MOUNT" 2>/dev/null; then note "mounted (credential current)"; else note "mount-failed (NAS unreachable or wrong credential)"; fi
      exit 0
  - path: /etc/systemd/system/yuruna-config-fetch@.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Yuruna Host Config fetch (%i) over mTLS
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/yuruna-config-fetch.sh %i
      StandardOutput=journal
      StandardError=journal
  - path: /etc/systemd/system/yuruna-config-fetch@.timer
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Run Yuruna Host Config fetch (%i) at boot and hourly
      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=1h
      AccuracySec=15s
      Unit=yuruna-config-fetch@%i.service
      [Install]
      WantedBy=timers.target
  # --- REGION: https://yuruna.link/429f3d06-0055
  - path: /var/lib/grafana/dashboards/pool.json
    permissions: '0644'
    owner: root:root
    content: |
      {
        "uid": "yuruna-pool",
        "title": "Yuruna hosts",
        "tags": ["yuruna", "pool"],
        "schemaVersion": 39,
        "version": 10,
        "editable": true,
        "refresh": "30s",
        "timezone": "utc",
        "time": { "from": "now-24h", "to": "now" },
        "templating": {
          "list": [
            {
              "name": "pool",
              "type": "constant",
              "query": ".+",
              "current": { "text": ".+", "value": ".+" },
              "hide": 2
            },
            {
              "name": "aggregator",
              "type": "constant",
              "query": "AGGREGATOR_BASE_PLACEHOLDER",
              "current": { "text": "AGGREGATOR_BASE_PLACEHOLDER", "value": "AGGREGATOR_BASE_PLACEHOLDER" },
              "hide": 2
            }
          ]
        },
        "panels": [
          {
            "id": 18,
            "type": "stat",
            "title": "Lab token",
            "description": "The lab connection token and the collector's health. Blue when enrollment is open: a joining host redeems the 6-character code (pwsh test/lab/Set-LabToken.ps1 -LabToken CODE); the code is select-and-copy text -- there is no need to retype it. It omits i, l, o, 0 and 1, and a code you have just read stays valid for about three minutes, so there is no need to rush it. Red when the collector behind this dashboard has stopped: every panel may be stale. Gray when the token exchange is off. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" },
            "targets": [
              { "refId": "A", "expr": "yuruna_pool_lab_token{pool=~\".+\"}", "instant": true, "legendFormat": "{{token}}", "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } },
              { "refId": "B", "expr": "absent(yuruna_pool_collector_up) * 0", "instant": true, "legendFormat": "Collector down", "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "name" },
            "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "noValue": "off", "thresholds": { "mode": "absolute", "steps": [ { "color": "#6b7280", "value": null }, { "color": "red", "value": 0 }, { "color": "blue", "value": 1 } ] } }, "overrides": [] }
          },
          {
            "id": 2,
            "type": "stat",
            "title": "Hosts total",
            "description": "Distinct pool hosts seen within the aggregator's host TTL (24h by default, -host-ttl), keyed on the stable hostId (reachable or not). Driven by yuruna_pool_hosts_total from the pool-aggregator-service. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" },
            "targets": [
              { "refId": "A", "expr": "sum(yuruna_pool_hosts_total) or vector(0)", "instant": true, "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
            "fieldConfig": { "defaults": {}, "overrides": [] }
          },
          {
            "id": 19,
            "type": "stat",
            "title": "Success%",
            "description": "Share of terminal cycles lab-wide that passed, within the selected time range (top-right). Counted from the same log as the Pool hosts table's Pass and Fail columns, so they cannot disagree. Shows 'n/a' when no cycle finished in range -- deliberately not 100%, so an idle pool cannot look healthy. Red below 95%, amber below 100%, green at 100%. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
            "datasource": { "type": "loki", "uid": "yuruna-loki" },
            "targets": [
              { "refId": "A", "expr": "100 * ((sum(count_over_time({pool=~\".+\"} | json | overallStatus=\"pass\" [$__range])) or (sum(count_over_time({pool=~\".+\"} | json | overallStatus=~\"pass|fail\" [$__range])) * 0)) / sum(count_over_time({pool=~\".+\"} | json | overallStatus=~\"pass|fail\" [$__range])))", "instant": true, "datasource": { "type": "loki", "uid": "yuruna-loki" } }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
            "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "noValue": "n/a", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 95 }, { "color": "green", "value": 100 } ] } }, "overrides": [] }
          },
          {
            "id": 4,
            "type": "stat",
            "title": "Failed cycles",
            "description": "Cycles that finished 'fail' across the whole LAB within the dashboard's selected time range (top-right) -- the sum of the table's Fail column. Counted from the Loki transition log (exact; reaches back to Loki retention, unlike a Prometheus counter window). Green when zero; red when any. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
            "datasource": { "type": "loki", "uid": "yuruna-loki" },
            "targets": [
              { "refId": "A", "expr": "sum(count_over_time({pool=~\".+\"} | json | overallStatus=\"fail\" [$__range]))", "instant": true, "datasource": { "type": "loki", "uid": "yuruna-loki" } }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
            "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
          },
          {
            "id": 20,
            "type": "stat",
            "title": "Total cycles",
            "description": "Terminal cycles lab-wide within the selected time range: the table's Pass plus Fail, and the denominator behind Success%. A still-running cycle has no terminal status and is not counted. The dashboard is lab-wide -- per-pool figures live on the pool-control board. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
            "datasource": { "type": "loki", "uid": "yuruna-loki" },
            "targets": [
              { "refId": "A", "expr": "sum(count_over_time({pool=~\".+\"} | json | overallStatus=~\"pass|fail\" [$__range]))", "instant": true, "datasource": { "type": "loki", "uid": "yuruna-loki" } }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
            "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0" }, "overrides": [] }
          },
          {
            "id": 21,
            "type": "stat",
            "title": "Addresses in use",
            "description": "MEASURED count of IPv4 addresses the lab holds now: the proxy's observed clients plus registered hosts' addresses, deduplicated. A FLOOR, not a ceiling -- whatever is invisible to both sources is not counted. It says nothing about the DHCP pool: scope size and free leases live on the DHCP server; read those before concluding exhaustion. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" },
            "targets": [
              { "refId": "A", "expr": "yuruna_pool_lab_addresses_in_use", "instant": true, "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
            "fieldConfig": { "defaults": { "decimals": 0, "noValue": "n/a" }, "overrides": [] }
          },
          {
            "id": 17,
            "type": "table",
            "title": "Extension hosts",
            "description": "Hosts self-reporting an extension function (e.g. stash, pool-control, download-agent) -- the same Host ID namespace as Pool hosts. The Extension link opens that service's UI, already unlocked unless the proxy mints no token. Extension-only hosts have no status page: open hosts from the Pool hosts table instead. Click a Host ID for its full GUID form. Details: <a href=\"https://yuruna.link/hosts-dashboard\" target=\"_blank\" rel=\"noopener\">Hosts dashboard</a> guide.",
            "gridPos": { "h": 4, "w": 24, "x": 0, "y": 22 },
            "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" },
            "targets": [
              { "refId": "A", "expr": "yuruna_pool_host_extension{pool=~\".+\"}", "instant": true, "format": "table", "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } }
            ],
            "transformations": [
              {
                "id": "organize",
                "options": {
                  "excludeByName": { "Time": true, "pool": true, "__name__": true, "job": true, "instance": true, "Value": true, "Value #A": true },
                  "renameByName": { "hostId": "Host ID", "area": "Extension" },
                  "indexByName": { "hostId": 0, "area": 1, "hostIdDashed": 2 }
                }
              }
            ],
