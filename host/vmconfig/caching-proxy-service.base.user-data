    # takes tens of minutes, and holding cloud-init open for it would delay the
    # ready banner (and any host waiting on it) behind work that is useful
    # whenever it lands. The timer's OnBootSec picks it up a few minutes from
    # here, which still puts it ahead of the first guest.
    systemctl enable --now zot-prewarm.timer || true
