        install -m 0644 /dev/null /etc/yuruna/caching-proxy-service.env
        cat > /etc/yuruna/caching-proxy-service.env << EOF
    # Local mode reads squid on loopback and applies switches; remote mode uses --mode=remote with a non-loopback --squid-addr.
    CACHING_PROXY_HTTP_ADDR=0.0.0.0:9310
    CACHING_PROXY_MODE=local
    CACHING_PROXY_SQUID_ADDR=127.0.0.1:3128
    CACHING_PROXY_REGISTRY_URL=http://127.0.0.1:5000
    CACHING_PROXY_META_URL=http://127.0.0.1
    CACHING_PROXY_SHARE_ROOT=/var/lib/yuruna
    CACHING_PROXY_AGGREGATOR_URL=$CPS_AGG
