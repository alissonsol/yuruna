#cloud-config
# LICENSEURI https://yuruna.link/license
# Copyright (c) 2019-2026 by Alisson Sol et al.
#vim:syntax=yaml
# See https://yuruna.link/429f3d06
# See https://yuruna.link/4268e4cb
# See https://yuruna.link/42e220c4-0006
# --- REGION: hostname
hostname: yuruna-download-agent-service
# --- REGION: users
# See https://yuruna.link/429f3d06-0034
users:
  - name: download-agent-service-admin
    gecos: download-agent service user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # See https://yuruna.link/429f3d06-000d
    plain_text_passwd: PASSWORD_PLACEHOLDER
    ssh_authorized_keys:
      - SSH_AUTHORIZED_KEY_PLACEHOLDER
# --- REGION: chpasswd
chpasswd:
  expire: false
  users:
    - name: download-agent-service-admin
      password: PASSWORD_PLACEHOLDER
      type: text
# --- REGION: ssh_pwauth
ssh_pwauth: true
# --- REGION: package_update
package_update: true
# --- REGION: packages
packages:
  # cifs-utils: the bring-up script's pool-NAS SMB3 mount (that script installs golang-go itself).
  - cifs-utils
  # Network tools support console and SSH diagnostics.
  # --- REGION: https://yuruna.link/429f3d06-003a
  - net-tools
  - iputils-ping
  # === YURUNA_OVERLAY_HOST_AGENT_PKG ===
# --- REGION: write_files
write_files:
  # --- REGION: https://yuruna.link/4220a755-004c
  - path: /etc/ssh/sshd_config.d/60-yuruna-keepalive.conf
    permissions: '0644'
    owner: root:root
    content: |
      ClientAliveInterval 15
      ClientAliveCountMax 4
      TCPKeepAlive yes
  # Pool coordinates, sed-read (`s/^KEY=//p`) by the bring-up script, so values are
  # UNQUOTED here (unlike stash's single-quoted env; the host bake refuses single
  # quotes). poolStorageNetworkPath/poolStorageNetworkUser match Test.PoolStorage networkStorage.
  - path: /etc/yuruna/pool.env
    permissions: '0644'
    owner: root:root
    content: |
      YURUNA_AGGREGATOR_URL=YURUNA_AGGREGATOR_URL_PLACEHOLDER
      YURUNA_POOL_NETWORK_PATH=POOL_NAS_NETWORK_PATH_PLACEHOLDER
      YURUNA_POOL_NETWORK_IP=POOL_NAS_NETWORK_IP_PLACEHOLDER
      YURUNA_POOL_NETWORK_USER=POOL_NAS_NETWORK_USER_PLACEHOLDER
  # cifs credentials (0600 root) for the bring-up script's pool-NAS mount; the
  # networkUser is the single pool-NAS account -- scope it storage-only on the NAS.
  - path: /etc/yuruna/pool-nas.cifs.cred
    permissions: '0600'
    owner: root:root
    content: |
      username=POOL_NAS_NETWORK_USER_PLACEHOLDER
      password=POOL_NAS_PASSWORD_PLACEHOLDER
  # --- REGION: https://yuruna.link/42fffc2c-000d
  - path: /etc/yuruna/globalization.env
    owner: root:root
    permissions: '0644'
    content: |
      YURUNA_LANGUAGE=YURUNA_LANGUAGE_PLACEHOLDER
      YURUNA_ALLOW_PSEUDO_LOCALE=YURUNA_ALLOW_PSEUDO_LOCALE_PLACEHOLDER

  # --- REGION: https://yuruna.link/429f3d06-0029
  # Empty IP/PORT falls back to the public github mirror for the framework fetch.
  - path: /etc/yuruna/host.env
    permissions: '0644'
    owner: root:root
    content: |
      YURUNA_HOST_ID=YURUNA_HOST_ID_PLACEHOLDER
      YURUNA_STATUS_SERVICE_IP=YURUNA_STATUS_SERVICE_IP_PLACEHOLDER
      YURUNA_STATUS_SERVICE_PORT=YURUNA_STATUS_SERVICE_PORT_PLACEHOLDER
      YURUNA_CACHING_PROXY_SERVICE_IP=YURUNA_CACHING_PROXY_SERVICE_IP_PLACEHOLDER
      YURUNA_GITHUB_REPO=YURUNA_GITHUB_REPO_PLACEHOLDER
      YURUNA_GITHUB_REF=YURUNA_GITHUB_REF_PLACEHOLDER
  # Pass Go-format durations verbatim; an empty cache IP selects direct origin downloads.
  - path: /etc/yuruna/download-agent.env
    permissions: '0600'
    owner: root:root
    content: |
      DOWNLOAD_AGENT_SCAN_INTERVAL=DOWNLOAD_AGENT_SCAN_INTERVAL_PLACEHOLDER
      DOWNLOAD_AGENT_FRESHNESS=DOWNLOAD_AGENT_FRESHNESS_PLACEHOLDER
      DOWNLOAD_AGENT_PREFETCH_LEAD=DOWNLOAD_AGENT_PREFETCH_LEAD_PLACEHOLDER
      DOWNLOAD_AGENT_AUTO_SEED=DOWNLOAD_AGENT_AUTO_SEED_PLACEHOLDER
      YURUNA_CACHE_PROXY_IP=YURUNA_CACHE_PROXY_IP_PLACEHOLDER
  # Operator note; the env files above carry the live coordinates.
  - path: /etc/yuruna/README.download-agent-service
    permissions: '0644'
    owner: root:root
    content: |
      Download-agent service VM. /etc/yuruna/pool.env + host.env + download-agent.env +
      pool-nas.cifs.cred are written by New-VM.ps1 into the seed. The bring-up script
      reads them. The board's "Unlock actions" prompt takes the 6-character Lab
      token shown on the Yuruna hosts dashboard; the daemon validates it against
      the pool aggregator, so nothing about it is stored on this VM.
  # --- REGION: https://yuruna.link/429f3d06-002a
  # This VM is provisioned once and runs for weeks, so it accumulates host
  # renumbers a per-cycle test guest never sees.
  - path: /usr/local/lib/yuruna/yuruna-host-locate.sh
    encoding: base64
    content: YURUNA_HOST_LOCATE_BASE64_PLACEHOLDER
    permissions: '0755'
  - path: /etc/systemd/system/yuruna-host-locate.service
    permissions: '0644'
    content: |
      # --- REGION: [Unit]
      [Unit]
      Description=Refresh Yuruna host coordinates if the host has changed address
      After=network.target NetworkManager-wait-online.service systemd-networkd-wait-online.service
      Before=network-online.target

      # --- REGION: [Service]
      [Service]
      Type=oneshot
      TimeoutStartSec=30
      ExecStart=/usr/local/lib/yuruna/yuruna-host-locate.sh

      # --- REGION: [Install]
      [Install]
      WantedBy=network-online.target
  - path: /etc/systemd/system/yuruna-host-locate.timer
    permissions: '0644'
    content: |
      # --- REGION: [Unit]
      [Unit]
      Description=Periodic Yuruna host coordinate refresh

      # --- REGION: [Timer]
      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=60s
      AccuracySec=5s

      # --- REGION: [Install]
      [Install]
      WantedBy=timers.target
# --- REGION: runcmd
runcmd:
  # === YURUNA_OVERLAY_RUNCMD_HOST_AGENT ===
  # sshd is already up by the time write_files lands, so the drop-in above needs
  # a reload to take effect on this boot rather than only on the next one.
  - systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  # --- REGION: https://yuruna.link/429f3d06-002a
  - systemctl enable --now yuruna-host-locate.service yuruna-host-locate.timer || true
  # --- REGION: Install the proxy CA
  # See https://yuruna.link/4268e4cb
  - |
    set +e
    CACHE_IP=$(sed -nE 's/^YURUNA_CACHE_PROXY_IP=(.*)$/\1/p' /etc/yuruna/download-agent.env 2>/dev/null | head -n1)
    CA_PEM=/etc/yuruna/yuruna-squid-ca.crt
    if [ -n "$CACHE_IP" ]; then
      if wget --no-proxy -q --tries=2 --timeout=10 -O "$CA_PEM" "http://$CACHE_IP/yuruna-squid-ca.crt" &&
         [ -s "$CA_PEM" ] && grep -q 'BEGIN CERTIFICATE' "$CA_PEM"; then
        chmod 0644 "$CA_PEM"
        # Also trust it system-wide so the go toolchain and wget agree with the
        # daemon about the bumped chain.
        install -m 0644 "$CA_PEM" /usr/local/share/ca-certificates/yuruna-squid-ca.crt
        update-ca-certificates >/dev/null 2>&1
        echo "yuruna download-agent-service: squid CA installed from http://$CACHE_IP/yuruna-squid-ca.crt"
      else
        # wget leaves a zero-byte file behind on failure, and a zero-byte PEM
        # would be handed to the daemon as a valid --proxy-ca.
        rm -f "$CA_PEM"
        echo "yuruna download-agent-service: no squid CA at http://$CACHE_IP/; the daemon downloads direct." >&2
      fi
    fi
  # See https://yuruna.link/42fffc2c-0013
  # --- REGION: Fetch the framework
  - |
    set +e
    HF=/etc/yuruna/host.env
    YR_HOST=$(sed -nE 's/^YURUNA_STATUS_SERVICE_IP=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
    YR_PORT=$(sed -nE 's/^YURUNA_STATUS_SERVICE_PORT=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
    DEST=/home/download-agent-service-admin/yuruna
    MIRROR_URL=https://github.com/alissonsol/yuruna
    FETCH_DIR=$(mktemp -d "${DEST}.fetch.XXXXXX") || FETCH_DIR=''
    # --- REGION: yuruna_accept_framework
    # Only a validated tree may replace a previously usable checkout.
    yuruna_accept_framework() {
      [ -f "$FETCH_DIR/tree/VERSION" ] && [ -s "$FETCH_DIR/tree/VERSION" ] || return 1
      [ ! -e "$FETCH_DIR/previous" ] || return 1
      if [ -e "$DEST" ]; then mv "$DEST" "$FETCH_DIR/previous" || return 1; fi
      if mv "$FETCH_DIR/tree" "$DEST"; then rm -rf "$FETCH_DIR/previous"; return 0; fi
      if [ -e "$FETCH_DIR/previous" ]; then
        mv "$FETCH_DIR/previous" "$DEST" || echo "yuruna: previous checkout retained at $FETCH_DIR/previous after restore failed." >&2
      fi
      return 1
    }
    OK=0
    SRC=mirror
    SRC_URL="$MIRROR_URL"
    # --- REGION: https://yuruna.link/42e220c4-0006
    ATTEMPT=1
    while [ "$ATTEMPT" -le 6 ]; do
      if [ -n "$YR_HOST" ] && [ -n "$YR_PORT" ] && wget -q --no-proxy --tries=1 --timeout=5 -O /dev/null "http://$YR_HOST:$YR_PORT/livecheck"; then
        # Check the transfer separately; tar can succeed after wget fails.
        if [ -n "$FETCH_DIR" ] &&
           wget --no-proxy --timeout=30 --tries=1 -qO "$FETCH_DIR/archive.tar.gz" "http://$YR_HOST:$YR_PORT/yuruna-archive.tar.gz" &&
           mkdir -p "$FETCH_DIR/tree" && tar -xzf "$FETCH_DIR/archive.tar.gz" -C "$FETCH_DIR/tree" && yuruna_accept_framework; then
          OK=1; SRC=host; SRC_URL="http://$YR_HOST:$YR_PORT"
          echo "yuruna download-agent-service: framework extracted from host $SRC_URL"
          break
        fi
        if [ -n "$FETCH_DIR" ]; then rm -rf "$FETCH_DIR/tree"; fi
      fi
      if [ "$ATTEMPT" -lt 6 ]; then sleep 10; fi
      # Re-read the coordinates every attempt: waiting is only worth anything if
      # the address the resolver has since corrected is the one the retry uses.
      YR_HOST=$(sed -nE 's/^YURUNA_STATUS_SERVICE_IP=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      YR_PORT=$(sed -nE 's/^YURUNA_STATUS_SERVICE_PORT=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      ATTEMPT=$((ATTEMPT + 1))
    done
    # The seed identity is trusted; the LAN supplies only its exact Git objects.
    if [ "$OK" -eq 0 ] && [ -n "$FETCH_DIR" ]; then
      YR_PROXY=$(sed -nE 's/^YURUNA_CACHING_PROXY_SERVICE_IP=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      YR_REPO=$(sed -nE 's/^YURUNA_GITHUB_REPO=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      YR_SHA=$(sed -nE 's/^YURUNA_GITHUB_REF=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      if printf '%s\n' "$YR_PROXY" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9.-]*$' &&
         printf '%s\n' "$YR_REPO" | grep -Eq '^[A-Za-z0-9_-][A-Za-z0-9_.-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*$' &&
         printf '%s\n' "$YR_SHA" | grep -Eq '^[0-9a-f]{40}$'; then
        LAN_URL="http://$YR_PROXY/git/$YR_REPO.git"
        rm -rf "$FETCH_DIR/tree"
        if mkdir -p "$FETCH_DIR/empty-home" && git init --quiet "$FETCH_DIR/tree" &&
           env -i PATH="$PATH" HOME="$FETCH_DIR/empty-home" XDG_CONFIG_HOME="$FETCH_DIR/empty-home" \
             GIT_CONFIG_COUNT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null \
             GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= SSH_ASKPASS= GCM_INTERACTIVE=never \
             timeout --kill-after=5 120 git -C "$FETCH_DIR/tree" -c http.proxy= -c credential.helper= \
             -c http.extraHeader= -c http.followRedirects=false fetch --quiet --depth 1 --no-tags -- "$LAN_URL" "$YR_SHA" &&
           git -C "$FETCH_DIR/tree" checkout --quiet --detach FETCH_HEAD &&
           [ "$(git -C "$FETCH_DIR/tree" rev-parse HEAD)" = "$YR_SHA" ]; then
          printf '%s\n' "$YR_SHA" > "$FETCH_DIR/tree/.yuruna-revision"
          printf 'https://github.com/%s.git\n' "$YR_REPO" > "$FETCH_DIR/tree/.yuruna-origin"
          rm -rf "$FETCH_DIR/tree/dev-only" "$FETCH_DIR/tree/docs"
          if yuruna_accept_framework; then OK=1; SRC=lan-mirror; SRC_URL="$LAN_URL"; fi
        fi
        [ "$OK" -eq 1 ] || rm -rf "$FETCH_DIR/tree"
      fi
    fi
    if [ "$OK" -eq 0 ]; then
      echo "yuruna download-agent-service: host status service did not serve the framework after 6 attempts; cloning the public mirror instead -- this daemon will run PUBLISHED code, which is older than the host's enlistment." >&2
      if [ -n "$FETCH_DIR" ] &&
         git -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=60 clone --depth 1 "$MIRROR_URL" "$FETCH_DIR/tree" && yuruna_accept_framework; then OK=1; fi
    fi
    # See https://yuruna.link/42fffc2c-0013
    # Record source provenance for the unprivileged seed account's readiness probe.
    if [ "$OK" -eq 1 ]; then
      mkdir -p /etc/yuruna
      {
        echo "source=$SRC"
        echo "url=$SRC_URL"
        if [ "$SRC" = lan-mirror ]; then echo "commit=$YR_SHA"; fi
        echo "version=$(head -n1 "$DEST/VERSION" 2>/dev/null | tr -d '[:space:]')"
        echo "fetchedAt=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      } > /etc/yuruna/framework-source
      chmod 0644 /etc/yuruna/framework-source
    fi
    if [ -n "$FETCH_DIR" ] && [ ! -e "$FETCH_DIR/previous" ]; then rm -rf "$FETCH_DIR"; fi
    chown -R download-agent-service-admin:download-agent-service-admin "$DEST" 2>/dev/null || true
    [ "$OK" -eq 1 ] || echo "yuruna download-agent-service: could not obtain the framework source; run the bring-up manually." >&2
  # PowerShell, for the Windows 11 family only -- best effort, never fails the build.
  # --- REGION: https://yuruna.link/429f3d06-008a
  - |
    set +e
    if command -v pwsh >/dev/null 2>&1; then
      echo "yuruna download-agent-service: pwsh already present ($(pwsh --version 2>/dev/null))."
    else
      PS_OK=0
      # Microsoft's prod apt repo first; the candidate is CHECKED, not assumed,
      # with the distro-independent release tarball as the fallback.
      VERSION_ID=''
      . /etc/os-release 2>/dev/null
      if [ -n "$VERSION_ID" ] &&
         wget --no-proxy -q --tries=2 --timeout=20 -O /tmp/packages-microsoft-prod.deb \
           "https://packages.microsoft.com/config/ubuntu/$VERSION_ID/packages-microsoft-prod.deb"; then
        dpkg -i /tmp/packages-microsoft-prod.deb >/dev/null 2>&1
        apt-get update -y >/dev/null 2>&1
        if apt-cache policy powershell 2>/dev/null | grep -qE 'Candidate: *[0-9]'; then
          DEBIAN_FRONTEND=noninteractive apt-get install -y powershell >/dev/null 2>&1 && PS_OK=1
          [ "$PS_OK" -eq 1 ] && echo "yuruna download-agent-service: PowerShell installed from packages.microsoft.com (ubuntu $VERSION_ID)."
        else
          echo "yuruna download-agent-service: packages.microsoft.com has no powershell candidate for ubuntu $VERSION_ID; falling back to the release tarball." >&2
        fi
      fi
      rm -f /tmp/packages-microsoft-prod.deb
      if [ "$PS_OK" -eq 0 ]; then
        PS_ARCH=''
        case "$(uname -m)" in
          x86_64)  PS_ARCH=x64 ;;
          aarch64) PS_ARCH=arm64 ;;
        esac
        command -v curl >/dev/null 2>&1 || DEBIAN_FRONTEND=noninteractive apt-get install -y curl >/dev/null 2>&1
        # Resolve latest-stable by following /releases/latest, not the GitHub
        # API: unauthenticated API calls are capped at 60/hr lab-wide.
        PS_TAG=$(curl -fsSLI -o /dev/null -w '%{url_effective}' --retry 3 --retry-delay 5 \
                 https://github.com/PowerShell/PowerShell/releases/latest 2>/dev/null)
        PS_TAG="${PS_TAG##*/}"
        if [ -n "$PS_ARCH" ] && echo "$PS_TAG" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
          PS_VER="${PS_TAG#v}"
          PS_PKG="powershell-$PS_VER-linux-$PS_ARCH.tar.gz"
          if curl -fsSL --retry 3 --retry-delay 5 -o /tmp/powershell.tar.gz \
               "https://github.com/PowerShell/PowerShell/releases/download/$PS_TAG/$PS_PKG"; then
            # Install only verified bytes; optional Windows tooling can remain unavailable.
            # --- REGION: https://yuruna.link/429f3d06-008b
            PS_VERDICT=unverified
            if curl -fsSL --retry 2 --retry-delay 5 -o /tmp/pwsh-hashes.sha256 \
                 "https://github.com/PowerShell/PowerShell/releases/download/$PS_TAG/hashes.sha256"; then
              PS_B2=$(od -An -tx1 -N2 /tmp/pwsh-hashes.sha256 2>/dev/null | tr -d ' \n')
              PS_HASH_OK=0
              if [ "$PS_B2" = "fffe" ] || [ "$PS_B2" = "feff" ]; then
                if iconv -f UTF-16 -t UTF-8 /tmp/pwsh-hashes.sha256 > /tmp/pwsh-hashes.utf8 2>/dev/null &&
                   tr -d '\r' < /tmp/pwsh-hashes.utf8 > /tmp/pwsh-hashes.norm; then
                  PS_HASH_OK=1
                fi
              else
                tr -d '\r' < /tmp/pwsh-hashes.sha256 > /tmp/pwsh-hashes.norm && PS_HASH_OK=1
              fi
              if [ "$PS_HASH_OK" -eq 1 ]; then
                PS_WANT=$(LC_ALL=C awk -v p="$PS_PKG" '$2==p || $2=="*"p {print $1; exit}' /tmp/pwsh-hashes.norm 2>/dev/null)
                PS_GOT=$(sha256sum /tmp/powershell.tar.gz 2>/dev/null | awk '{print $1}')
                if [ "${#PS_WANT}" -eq 64 ] && [ "${#PS_GOT}" -eq 64 ]; then
                  case "$PS_WANT$PS_GOT" in
                    *[!0-9a-fA-F]*) ;;
                    *)
                      PS_WANT=$(printf '%s' "$PS_WANT" | tr '[:upper:]' '[:lower:]')
                      PS_GOT=$(printf '%s' "$PS_GOT" | tr '[:upper:]' '[:lower:]')
                      [ "$PS_WANT" = "$PS_GOT" ] && PS_VERDICT=verified || PS_VERDICT=mismatch
                      ;;
                  esac
                fi
              fi
            fi
            rm -f /tmp/pwsh-hashes.sha256 /tmp/pwsh-hashes.utf8 /tmp/pwsh-hashes.norm
            if [ "$PS_VERDICT" != "verified" ]; then
              echo "yuruna download-agent-service: PowerShell $PS_VER tarball SHA-256 verification failed ($PS_VERDICT); NOT installed." >&2
            else
              mkdir -p /opt/microsoft/powershell/7
              if tar zxf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7 &&
                 chmod +x /opt/microsoft/powershell/7/pwsh &&
                 ln -sf /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh; then
                PS_OK=1
                echo "yuruna download-agent-service: PowerShell $PS_VER ($PS_ARCH, $PS_VERDICT) installed from the release tarball."
              fi
            fi
          fi
          rm -f /tmp/powershell.tar.gz
        fi
      fi
      [ "$PS_OK" -eq 1 ] || echo "yuruna download-agent-service: no PowerShell could be installed; the Windows 11 family stays unavailable." >&2
    fi
  # Fido, pinned + hash-verified. FIDO_PS1 must stay a path the daemon searches
  # when --fido-script is empty, or the family goes silently unavailable.
  # --- REGION: https://yuruna.link/429f3d06-008c
  - |
    set +e
    FIDO_URL=https://raw.githubusercontent.com/pbatard/Fido/v1.71/Fido.ps1
    FIDO_SHA256=6481e40d3cf100c79b281942d0d1c7f6d111397be296fec867a56cbe368ebdf9
    FIDO_PS1=/etc/yuruna/Fido.ps1
    rm -f "$FIDO_PS1"
    if wget --no-proxy -q --tries=3 --timeout=30 -O "$FIDO_PS1" "$FIDO_URL" && [ -s "$FIDO_PS1" ]; then
      FIDO_GOT=$(sha256sum "$FIDO_PS1" 2>/dev/null | awk '{print $1}')
      if [ "$FIDO_GOT" = "$FIDO_SHA256" ]; then
        # --- REGION: https://yuruna.link/429f3d06-008c
        sed -i 's/^\$winver = Get-Platform-Version$/$winver = 10.0/' "$FIDO_PS1"
        if grep -q '^\$winver = 10\.0$' "$FIDO_PS1"; then
          echo "yuruna download-agent-service: Fido platform gate disabled for Linux pwsh."
        else
          echo "yuruna download-agent-service: Fido platform-gate patch did not apply; resolves will refuse with exit 147." >&2
        fi
        chmod 0644 "$FIDO_PS1"
      else
        rm -f "$FIDO_PS1"
        echo "yuruna download-agent-service: Fido SHA-256 mismatch (pinned v1.71: want $FIDO_SHA256, got $FIDO_GOT); NOT installed." >&2
      fi
    else
      rm -f "$FIDO_PS1"
      echo "yuruna download-agent-service: could not fetch $FIDO_URL." >&2
    fi
    if command -v pwsh >/dev/null 2>&1 && [ -s "$FIDO_PS1" ]; then
      echo "yuruna download-agent-service: Windows 11 family ENABLED (best effort) -- $(pwsh --version 2>/dev/null) with verified Fido v1.71 at $FIDO_PS1."
    else
      echo "yuruna download-agent-service: Windows 11 family UNAVAILABLE (pwsh: $(command -v pwsh || echo none), Fido: $([ -s "$FIDO_PS1" ] && echo "$FIDO_PS1" || echo none)); hosts keep the Windows 11 path they use today." >&2
    fi
  # --- REGION: Build and start the service
  - |
    set +e
    SCRIPT=/home/download-agent-service-admin/yuruna/guest/ubuntu.server.26/ubuntu.server.26.download-agent-service.sh
    if [ -f "$SCRIPT" ]; then
      bash "$SCRIPT" || echo "yuruna download-agent-service: bring-up script exited non-zero; see cloud-init-output.log." >&2
    else
      echo "yuruna download-agent-service: bring-up script not found at $SCRIPT (framework not fetched?)." >&2
    fi
