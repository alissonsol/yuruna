# instance-id is a CONSTANT here, not the VM name: cloud-init treats a changed
# instance-id as a new instance and re-runs the per-instance modules. This seed
# relies on that constancy, so runcmd gets exactly one attempt in the life of
# the VM.
instance-id: yuruna-download-agent-service
local-hostname: yuruna-download-agent-service
