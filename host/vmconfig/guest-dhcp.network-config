# Netplan guests only; keep this file off Amazon Linux seeds.
# --- REGION: version
version: 2
# --- REGION: ethernets
ethernets:
  yuruna-en:
    match:
      name: "en*"
    dhcp4: true
    dhcp6: true
    dhcp-identifier: mac
    # netplan renders this as networkd KeepConfiguration=, which installs the DHCP address with an infinite kernel lifetime so a guest clock anomaly cannot expire it while the lease is valid.
    critical: true
  yuruna-eth:
    match:
      name: "eth*"
    dhcp4: true
    dhcp6: true
    dhcp-identifier: mac
    # netplan renders this as networkd KeepConfiguration=, which installs the DHCP address with an infinite kernel lifetime so a guest clock anomaly cannot expire it while the lease is valid.
    critical: true
