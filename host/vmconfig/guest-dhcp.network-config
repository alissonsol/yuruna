# Netplan guests only; keep this file off Amazon Linux seeds.
# --- REGION: version
version: 2
# --- REGION: ethernets
ethernets:
  # critical pins the kernel address lifetime open: a guest clock jump
  # otherwise expires the DHCP address before the lease does.
  yuruna-en:
    match:
      name: "en*"
    dhcp4: true
    dhcp6: true
    dhcp-identifier: mac
    critical: true
  yuruna-eth:
    match:
      name: "eth*"
    dhcp4: true
    dhcp6: true
    dhcp-identifier: mac
    critical: true
