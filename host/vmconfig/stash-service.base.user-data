#cloud-config
# LICENSEURI https://yuruna.link/license
# Copyright (c) 2019-2026 by Alisson Sol et al.
#vim:syntax=yaml
# --- REGION: https://yuruna.link/vmconfig
# --- REGION: https://yuruna.link/stash-guide
# Stash-service VM: mount the stash share (ystash-nas), fetch the framework, then run
# the bring-up script that builds + launches the daemon (binds :22 SCP/SFTP sink + :80
# browser UI/API; the cloud image runs no host firewall). `users:` without `- default`
# suppresses the ubuntu cloud-image user.
hostname: yuruna-stash-service
users:
  - name: stash-admin
    gecos: stash-service user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # --- REGION: https://yuruna.link/vmconfig#unlocked-account-needs-plain_text_passwd
    plain_text_passwd: PASSWORD_PLACEHOLDER
    ssh_authorized_keys:
      - SSH_AUTHORIZED_KEY_PLACEHOLDER
chpasswd:
  expire: false
  users:
    - name: stash-admin
      password: PASSWORD_PLACEHOLDER
      type: text
ssh_pwauth: true
package_update: true
packages:
  # cifs-utils: stash-share SMB3 mount (the bring-up script installs golang-go + libcap2-bin itself).
  - cifs-utils
  # Network debugging tools for interactive triage via console/SSH.
  - net-tools
  - iputils-ping
  # === YURUNA_OVERLAY_HOST_AGENT_PKG ===
write_files:
  # --- REGION: https://yuruna.link/network#why-sshd-notices-a-client-that-left
  - path: /etc/ssh/sshd_config.d/60-yuruna-keepalive.conf
    permissions: '0644'
    owner: root:root
    content: |
      ClientAliveInterval 15
      ClientAliveCountMax 4
      TCPKeepAlive yes
  # ystash-nas coordinates for the share backing the stash. Values single-quoted (the
  # host bake refuses a value carrying a single quote); read by the bring-up script
  # via sed-extraction, never sourced.
  - path: /etc/yuruna/ystash-nas.env
    permissions: '0644'
    owner: root:root
    content: |
      YSTASH_NAS_NETWORK_PATH='YSTASH_NAS_NETWORK_PATH_PLACEHOLDER'
      YSTASH_NAS_NETWORK_IP='YSTASH_NAS_NETWORK_IP_PLACEHOLDER'
      YSTASH_NAS_NETWORK_USER='YSTASH_NAS_NETWORK_USER_PLACEHOLDER'
      YSTASH_NAS_HOST_ID='YSTASH_NAS_HOST_ID_PLACEHOLDER'
      YSTASH_NAS_MOUNT='/mnt/ystash-nas'
  # cifs credentials (0600 root). The networkUser is the single NAS account
  # (host drain + this guest mount alike); scope it storage-only on the NAS.
  - path: /etc/yuruna/ystash-nas.cifs.cred
    permissions: '0600'
    owner: root:root
    content: |
      username=YSTASH_NAS_NETWORK_USER_PLACEHOLDER
      password=YSTASH_NAS_PASSWORD_PLACEHOLDER
  # --- REGION: https://yuruna.link/vmconfig#yuruna-host-coordinates
  # Empty IP/PORT falls back to the public github mirror for the framework fetch.
  - path: /etc/yuruna/host.env
    permissions: '0644'
    owner: root:root
    content: |
      YURUNA_STATUS_SERVICE_IP=YURUNA_STATUS_SERVICE_IP_PLACEHOLDER
      YURUNA_STATUS_SERVICE_PORT=YURUNA_STATUS_SERVICE_PORT_PLACEHOLDER
      YURUNA_HOST_ID=YURUNA_HOST_ID_PLACEHOLDER
      YURUNA_CACHING_PROXY_SERVICE_IP=YURUNA_CACHING_PROXY_SERVICE_IP_PLACEHOLDER
  # Pool-aggregator service base URL the stash daemon announces to (and resolves remote
  # hosts through). Single-quoted like ystash-nas.env; empty (no caching-proxy service
  # known at bake time) leaves the daemon's aggregator-dependent features off.
  - path: /etc/yuruna/pool.env
    permissions: '0644'
    owner: root:root
    content: |
      YURUNA_AGGREGATOR_URL='YURUNA_AGGREGATOR_URL_PLACEHOLDER'
  # --- REGION: https://yuruna.link/vmconfig#bring-up-driven-by-systemd-not-runcmd
  - path: /usr/local/lib/yuruna/stash-bringup.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # Yuruna stash service bring-up, driven by the systemd unit below.

      # --- REGION: https://yuruna.link/vmconfig#stash-nas-cifs-mount-options
      # 1) Mount the stash share, persistent via fstab.
      set +e
      ENVF=/etc/yuruna/ystash-nas.env
      NETPATH=$(sed -nE "s/^YSTASH_NAS_NETWORK_PATH='(.*)'\$/\1/p" "$ENVF" 2>/dev/null | head -n1)
      NETIP=$(sed -nE "s/^YSTASH_NAS_NETWORK_IP='(.*)'\$/\1/p" "$ENVF" 2>/dev/null | head -n1)
      HOST_ID=$(sed -nE "s/^YSTASH_NAS_HOST_ID='(.*)'\$/\1/p" "$ENVF" 2>/dev/null | head -n1)
      MOUNT=$(sed -nE "s/^YSTASH_NAS_MOUNT='(.*)'\$/\1/p" "$ENVF" 2>/dev/null | head -n1); MOUNT=${MOUNT:-/mnt/ystash-nas}
      if [ -n "$NETPATH" ] && [ -n "$HOST_ID" ]; then
        mkdir -p "$MOUNT"
        SVC_UID=$(id -u stash-admin); SVC_GID=$(id -g stash-admin)
        # Open modes and the absent iocharset are load-bearing; see the topic above.
        OPTS="credentials=/etc/yuruna/ystash-nas.cifs.cred,vers=3.0,uid=$SVC_UID,gid=$SVC_GID,file_mode=0666,dir_mode=0777,noperm,nofail,_netdev"
        # ip= lets cifs connect when the guest can't resolve a bare NetBIOS name.
        [ -n "$NETIP" ] && OPTS="$OPTS,ip=$NETIP"
        if ! grep -q " $MOUNT cifs " /etc/fstab 2>/dev/null; then
          printf '%s %s cifs %s 0 0\n' "$NETPATH" "$MOUNT" "$OPTS" >> /etc/fstab
        fi
        systemctl daemon-reload
        mountpoint -q "$MOUNT" || timeout 60 mount "$MOUNT" || true
        if mountpoint -q "$MOUNT"; then
          # No chown: with 0777/0666 the tree is already pool-accessible, and a
          # chown on a mode-mapped cifs mount can re-impose an owner-only ACL.
          mkdir -p "$MOUNT/stash/$HOST_ID"
          echo "yuruna stash: stash share mounted at $MOUNT; StashFolder $MOUNT/stash/$HOST_ID"
        else
          echo "yuruna stash: share '$NETPATH' did not mount at $MOUNT; the daemon will buffer locally until it does." >&2
        fi
      else
        echo "yuruna stash: stash storage not configured in the seed; the daemon will use local fallback storage." >&2
      fi

      # --- REGION: https://yuruna.link/extensions-api#which-framework-snapshot-a-service-vm-is-built-from
      # 2) Fetch the framework from the host status service (coordinates sed-read from
      #    host.env, NOT sourced), falling back to a github clone so a bring-up works
      #    off-LAN. The fallback is not equivalent: the version is stamped at compile
      #    time and never re-read.
      set +e
      HF=/etc/yuruna/host.env
      YR_HOST=$(sed -nE 's/^YURUNA_STATUS_SERVICE_IP=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      YR_PORT=$(sed -nE 's/^YURUNA_STATUS_SERVICE_PORT=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
      DEST=/home/stash-admin/yuruna
      MIRROR_URL=https://github.com/alissonsol/yuruna
      mkdir -p "$DEST"
      OK=0
      SRC=mirror
      SRC_URL="$MIRROR_URL"
      # Retried rather than decided on one answer. The host coordinates are baked at
      # seed time and corrected in-guest by yuruna-host-locate, so at this point in a
      # first boot "unreachable" is routinely a host that has renumbered and not been
      # re-read yet -- and the cost of believing it is the wrong codebase, permanently.
      # Bounded so an off-LAN bring-up, where nothing will ever answer, still finishes.
      ATTEMPT=1
      while [ "$ATTEMPT" -le 6 ]; do
        if [ -n "$YR_HOST" ] && [ -n "$YR_PORT" ] && wget -q --no-proxy --tries=1 --timeout=5 -O /dev/null "http://$YR_HOST:$YR_PORT/livecheck"; then
          # -s "$DEST/VERSION" is the extraction's success condition, not tar's exit
          # status: the archive arrives through a pipe, so a transfer cut partway
          # leaves tar reporting success over a truncated tree.
          if wget --no-proxy -qO- "http://$YR_HOST:$YR_PORT/yuruna-archive.tar.gz" | tar -xz -C "$DEST" && [ -s "$DEST/VERSION" ]; then
            OK=1; SRC=host; SRC_URL="http://$YR_HOST:$YR_PORT"
            echo "yuruna stash: framework extracted from host $SRC_URL"
            break
          fi
        fi
        if [ "$ATTEMPT" -lt 6 ]; then sleep 10; fi
        # Re-read the coordinates every attempt: waiting is only worth anything if
        # the address the resolver has since corrected is the one the retry uses.
        YR_HOST=$(sed -nE 's/^YURUNA_STATUS_SERVICE_IP=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
        YR_PORT=$(sed -nE 's/^YURUNA_STATUS_SERVICE_PORT=(.*)$/\1/p' "$HF" 2>/dev/null | head -n1)
        ATTEMPT=$((ATTEMPT + 1))
      done
      if [ "$OK" -eq 0 ]; then
        echo "yuruna stash: host status service did not serve the framework after 6 attempts; cloning the public mirror instead -- this daemon will run PUBLISHED code, which is older than the host's enlistment." >&2
        rm -rf "$DEST"
        git clone --depth 1 "$MIRROR_URL" "$DEST" && OK=1
      fi
      # Record which source won. Without this the answer survives only in this log,
      # and the bring-up script on the host is left inferring it from a version
      # number that cannot distinguish "older mirror" from "older host enlistment".
      # World-readable on purpose: it is read back as the unprivileged seed account.
      mkdir -p /etc/yuruna
      {
        echo "source=$SRC"
        echo "url=$SRC_URL"
        echo "version=$(head -n1 "$DEST/VERSION" 2>/dev/null | tr -d '[:space:]')"
        echo "fetchedAt=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      } > /etc/yuruna/framework-source
      chmod 0644 /etc/yuruna/framework-source
      chown -R stash-admin:stash-admin "$DEST" 2>/dev/null || true
      [ "$OK" -eq 1 ] || echo "yuruna stash: could not obtain the framework source; run the bring-up manually." >&2

      # 3) Build + launch the daemon (the script provisions VM-local dirs,
      #    writes the systemd unit, and starts it).
      set +e
      SCRIPT=/home/stash-admin/yuruna/guest/ubuntu.server.26/ubuntu.server.26.stash-service.sh
      if [ -f "$SCRIPT" ]; then
        bash "$SCRIPT" || echo "yuruna stash: bring-up script exited non-zero; see cloud-init-output.log." >&2
      else
        echo "yuruna stash: bring-up script not found at $SCRIPT (framework not fetched?)." >&2
      fi

      # The unit's ConditionPathExists gate reads this: present means converged, absent
      # means the next boot tries again.
      if [ -x /usr/local/bin/stash-service ]; then
        echo "yuruna stash: bring-up complete; /usr/local/bin/stash-service is installed."
        exit 0
      fi
      echo "yuruna stash: bring-up did NOT install /usr/local/bin/stash-service; the next boot will retry." >&2
      exit 1

  - path: /etc/systemd/system/yuruna-stash-bringup.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Yuruna stash service bring-up (idempotent; converges a half-built VM)
      Documentation=https://yuruna.link/stash-guide
      Wants=network-online.target
      After=network-online.target cloud-init.service
      # The whole point of the unit: once the daemon is installed this skips
      # instantly, so a healthy boot pays nothing and only a VM that still needs
      # work does any.
      ConditionPathExists=!/usr/local/bin/stash-service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/lib/yuruna/stash-bringup.sh
      # The first run compiles the Go daemon. systemd's default 90s start timeout
      # would kill it partway through and leave exactly the half-built VM this unit
      # exists to converge.
      TimeoutStartSec=1800
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target
  # --- REGION: https://yuruna.link/vmconfig#host-address-refresh-timer
  # This VM is provisioned once and runs for weeks, so it accumulates host
  # renumbers a per-cycle test guest never sees.
  - path: /usr/local/lib/yuruna/yuruna-host-locate.sh
    encoding: base64
    content: YURUNA_HOST_LOCATE_BASE64_PLACEHOLDER
    permissions: '0755'
  - path: /etc/systemd/system/yuruna-host-locate.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh Yuruna host coordinates if the host has changed address
      After=network.target NetworkManager-wait-online.service systemd-networkd-wait-online.service
      Before=network-online.target

      [Service]
      Type=oneshot
      TimeoutStartSec=30
      ExecStart=/usr/local/lib/yuruna/yuruna-host-locate.sh

      [Install]
      WantedBy=network-online.target
  - path: /etc/systemd/system/yuruna-host-locate.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic Yuruna host coordinate refresh

      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=60s
      AccuracySec=5s

      [Install]
      WantedBy=timers.target
runcmd:
  # sshd is already up by the time write_files lands, so the drop-in above needs
  # a reload to take effect on this boot rather than only on the next one.
  - systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  - systemctl enable --now yuruna-host-locate.service yuruna-host-locate.timer || true
  # --- REGION: https://yuruna.link/vmconfig#host-agent-runs-first
  # 0) Host-side guest agent FIRST, so host discovery never waits on the steps below.
  # === YURUNA_OVERLAY_RUNCMD_HOST_AGENT ===
  # 1) Hand the bring-up to systemd. `enable` is what survives a boot that dies
  #    mid-build; `--now` runs this first attempt without waiting for a reboot.
  - systemctl daemon-reload
  - systemctl enable --now yuruna-stash-bringup.service
