# yaml-language-server: $schema=../../schemas/users.schema.yml

# Yuruna authentication: logical-username -> corporate-identity mapping.
#
# Default behavior (all corporate.* / vaultKey / localOsPasswordRef
# fields empty) keeps the harness operating exactly as before: each
# logical user is its own local OS account with a vault-auto-generated
# password.
#
# To integrate with a corporate directory (AD / Entra / SSSD-against-
# LDAP / ...):
#   1. Populate `corporate.domain` + `corporate.sam` (or `corporate.upn`)
#      so sequence-login steps render the right identity via the
#      ${loginUser} substitution.
#   2. Set `vaultKey` to the vault.yml entry that holds the corporate
#      password (e.g. "corp.alisson.sol"); pre-populate that vault
#      entry manually. Test-Config.ps1 blocks the cycle if the entry
#      is missing -- the vault never auto-generates for a populated
#      vaultKey.
#   3. Leave `localOsPasswordRef` empty unless you specifically want
#      the local OS account on the test VM to share its password with
#      the corporate identity (default is decoupled: the local account
#      receives a fresh auto-gen secret that nobody needs to know).
#
# Add new entries here whenever a sequence introduces a new logical
# username. With `strict: true` (recommended), Test-Config.ps1 fails
# the cycle on the first undeclared name -- this is intentional, so
# the production AD path stays exercised on every dev cycle.

strict: false

users:

  # Default Yuruna test users -- one per bundled guest OS. Out of the
  # box, no corporate mapping; cloud-init creates these as local OS
  # accounts with vault-auto-generated passwords (today's behavior).

  yuuser24:
    localOsUser: yuuser24
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  yuuser26:
    localOsUser: yuuser26
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  yauser1:
    localOsUser: yauser1
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  ywuser1:
    localOsUser: ywuser1
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  # Administrators of the service VMs a host brings up. Each VM family has
  # its OWN account so the vault entries are independent: a shared name
  # means one vault password, and the most recently built VM invalidates
  # the console credential of the others. Declared here so strict mode
  # does not refuse the cycle when a sequence references them.
  #
  # Cross-cycle persistence of the cache VM's password is owned by
  # Test.CachingProxyService (yuruna-caching-proxy-service.yml under status/runtime/).
  caching-proxy-service-admin:
    localOsUser: caching-proxy-service-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  pool-control-service-admin:
    localOsUser: pool-control-service-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  stash-admin:
    localOsUser: stash-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  # Lab shared bearer token. NOT a login user: this logical entry holds the
  # shared secret that gates the pool-aggregator-service's POST /ingest write route
  # and keys the control proofs for the status-service /control/* routes.
  # Leave vaultKey EMPTY (default) to keep the host un-enrolled -- push stays
  # disabled and control stays loopback-only. The convenient way to populate
  # it is `pwsh test/Set-LabToken.ps1 -LabToken <code>` with the code from
  # the dashboard's "Lab token" tile (it sets vaultKey and stores the token
  # in one step); building the caching-proxy service mints and stores one
  # automatically when none exists. The vault never auto-generates for a
  # populated vaultKey, so the token stays lab-owned; every pool host and the
  # proxy must hold the SAME value. (Hosts provisioned under the earlier
  # 'pool-auth-token' logical name keep working: every reader falls back to
  # that entry when this one is empty.)
  lab-auth-token:
    localOsUser: ""
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  # --- REGION: Example: a workload-defined logical user mapped to a corporate AD identity
  # Uncomment and adapt when a `workload.*.yml` declares
  # `variables.username: webuser`.
  #
  # webuser:
  #   localOsUser: webuser
  #   corporate:
  #     domain: "CORP"
  #     sam:    "alisson.sol"
  #     # upn:  "alisson.sol@corp.example.com"      # alternative form
  #   vaultKey:           "corp.alisson.sol"
  #   localOsPasswordRef: ""                         # decoupled: local
  #                                                  # OS account gets
  #                                                  # auto-gen secret
