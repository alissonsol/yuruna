# yaml-language-server: $schema=../../schemas/users.schema.yml

# Yuruna authentication: logical-username -> corporate-identity mapping.
#
# With all corporate.* / vaultKey / localOsPasswordRef fields empty
# (the default), each logical user is its own local OS account with a
# vault-auto-generated password.
#
# To integrate with a corporate directory (AD / Entra / SSSD-against-
# LDAP / ...):
#   1. Populate `corporate.domain` + `corporate.sam` (or `corporate.upn`)
#      so sequence-login steps render the right identity via the
#      ${loginUser} substitution.
#   2. Set `vaultKey` to the vault.yml entry holding the corporate
#      password (e.g. "corp.alisson.sol") and pre-populate that entry
#      manually. Test-Config.ps1 blocks the cycle if it is missing --
#      the vault never auto-generates for a populated vaultKey.
#   3. Leave `localOsPasswordRef` empty unless the local OS account on
#      the test VM should share its password with the corporate
#      identity. The default is decoupled: the local account receives
#      a fresh auto-gen secret that nobody needs to know.
#
# Add an entry here whenever a sequence introduces a new logical
# username. With `strict: true` (recommended), Test-Config.ps1 fails
# the cycle on the first undeclared name -- intentional, so the
# production AD path stays exercised on every dev cycle.

strict: false

users:

  # Default Yuruna test users -- one per bundled guest OS. Out of the
  # box, no corporate mapping: cloud-init creates these as local OS
  # accounts with vault-auto-generated passwords.

  yuuser24:
    localOsUser: yuuser24
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  yuuser26:
    localOsUser: yuuser26
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  yauser1:
    localOsUser: yauser1
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  ywuser1:
    localOsUser: ywuser1
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  # Administrators of the service VMs a host brings up. Each VM family has its
  # OWN account so the vault entries stay independent: with a shared name there
  # is one vault password, and the most recently built VM invalidates the console
  # credential of the others. Declared here so strict mode does not refuse a
  # cycle that references them. Cross-cycle persistence of the cache VM's password
  # is owned by Test.CachingProxyService (status/runtime/yuruna-caching-proxy-service.yml).
  caching-proxy-service-admin:
    localOsUser: caching-proxy-service-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  pool-control-service-admin:
    localOsUser: pool-control-service-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  stash-admin:
    localOsUser: stash-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  download-agent-service-admin:
    localOsUser: download-agent-service-admin
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  # Lab shared bearer token. NOT a login user: this entry holds the shared secret
  # that gates the pool-aggregator-service's POST /ingest write route and keys the
  # control proofs for the status-service /control/* routes. Leave vaultKey EMPTY
  # (default) to keep the host un-enrolled -- push stays disabled and control stays
  # loopback-only. To populate it, run `pwsh test/Set-LabToken.ps1 -LabToken <code>`
  # with the code from the dashboard's "Lab token" tile; that sets vaultKey and
  # stores the token in one step. Building the caching-proxy service mints one
  # automatically when none exists. The vault never auto-generates for a populated
  # vaultKey, so the token stays lab-owned; every pool host and the proxy must hold
  # the SAME value. Hosts holding the legacy 'pool-auth-token' entry keep working:
  # every reader falls back to it when this one is empty.
  lab-auth-token:
    localOsUser: ""
    corporate:   { domain: "", sam: "", upn: "" }
    vaultKey:           ""
    localOsPasswordRef: ""

  # --- REGION: Example: a workload-defined logical user mapped to a corporate AD identity
  # Uncomment and adapt when a `workload.*.yml` declares
  # `variables.username: webuser`.
  #
  # webuser:
  #   localOsUser: webuser
  #   corporate:
  #     domain: "CORP"
  #     sam:    "alisson.sol"
  #     # upn:  "alisson.sol@corp.example.com"      # alternative form
  #   vaultKey:           "corp.alisson.sol"
  #   localOsPasswordRef: ""                         # decoupled: local
  #                                                  # OS account gets
  #                                                  # auto-gen secret
