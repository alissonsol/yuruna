          "title": "Available memory per host",
          "description": "Physical memory each pool host has free, read from the metrics exporter running on the host itself; only hosts that run one appear. Series are keyed on hostId -- the identity the tables above use -- so a host keeps one line across an address change.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
          "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" },
          "targets": [
            { "refId": "A", "expr": "windows_memory_available_bytes{pool=\"$pool\"}", "legendFormat": "{{hostId}}", "range": true, "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } }
