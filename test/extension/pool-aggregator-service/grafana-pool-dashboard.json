        },
        {
          "id": 24,
          "type": "timeseries",
          "title": "Commit headroom per host",
          "description": "Commit limit minus committed bytes: how much more memory a host can still promise before an allocation is refused outright. A virtual machine asks for its whole allocation at once, so this floor -- not free physical memory -- is what such a request is measured against, and it moves while the paging file is being resized.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
          "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" },
          "targets": [
            { "refId": "A", "expr": "windows_memory_commit_limit{pool=\"$pool\"} - windows_memory_committed_bytes{pool=\"$pool\"}", "legendFormat": "{{hostId}}", "range": true, "datasource": { "type": "prometheus", "uid": "yuruna-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "min", "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        }
