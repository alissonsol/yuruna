# --- REGION: [Unit]
[Unit]
Description=Yuruna pool-aggregator-service (read-only multi-host pool view)
Documentation=https://yuruna.link/pool-aggregator-service
After=network-online.target squid.service loki.service prometheus.service
Wants=network-online.target

# --- REGION: [Service]
[Service]
Type=simple
Environment=YURUNA_LANGUAGE=auto YURUNA_ALLOW_PSEUDO_LOCALE=false
EnvironmentFile=-/etc/yuruna/globalization.env
User=proxy
Group=proxy
StateDirectory=pool-aggregator-service
# See https://yuruna.link/42fffc2c-001b for host TTL, archive lifetime and unit reloads.
# See https://yuruna.link/42fffc2c-001e for TLS and rotating Lab token exchange.
# Optional TLS and token files gate those features; the daemon can serve plain HTTP.
# Reset ExecStart before overriding it in a Type=simple drop-in.
ExecStart=/usr/local/bin/pool-aggregator-service --language=${YURUNA_LANGUAGE} --allow-pseudo-locale=${YURUNA_ALLOW_PSEUDO_LOCALE} -tls-cert /etc/squid/ssl_cert/pool-aggregator-service.crt -tls-key /etc/squid/ssl_cert/pool-aggregator-service.key -auth-token-file /etc/yuruna/internal-auth.key -host-ttl 24h -lab-token-rotate 60s -pool-archive-root /mnt/ypool-nas/hosts -handover-state-file /var/lib/pool-aggregator-service/handovers.json
Restart=on-failure
RestartSec=5
# Auto-discovers pool members by reading the squid access log (proxy owns it,
# 0640 -- the unit only needs to read it), probing each recent client IP's
# status service, and pushing to Loki on loopback; serves :9400 (TLS + plain HTTP
# on the one port when the leaf is present) including the authenticated POST
# /ingest push surface. Disk reads are the squid log, the TLS leaf, the auth token,
# and -- read-only, for the /archive/ route -- the pool share under /mnt/ypool-nas.
# The host handover ledger is the only durable write and lives in StateDirectory.
ReadOnlyPaths=/var/log/squid
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

# --- REGION: [Install]
[Install]
WantedBy=multi-user.target
