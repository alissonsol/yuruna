[Unit]
Description=Yuruna pool-aggregator-service (read-only multi-host pool view)
Documentation=https://yuruna.link/pool-aggregator-service
After=network-online.target squid.service loki.service prometheus.service
Wants=network-online.target

[Service]
Type=simple
User=proxy
Group=proxy
# -tls-cert/-tls-key activate TLS on :9400 (proxy-CA leaf minted in cloud-init),
# served ALONGSIDE plain HTTP on the same port: the dashboard's /go/* deep-links
# are plain-http (they only redirect the operator's browser to plain-http host
# status pages), while token-bearing clients keep TLS. Flags absent/empty ->
# plain HTTP only. -auth-token-file gates POST /ingest and feeds the
# lab-token exchange; absent/empty -> /ingest disabled and no lab code minted. All
# three flags are always present and self-gate on the files, so an unconfigured
# proxy degrades to plain HTTP with /ingest disabled.
#
# -lab-token-rotate is how often the dashboard's 6-char lab connection token
# changes (0 disables the Lab token tile and POST /api/v1/lab-token). The exchange
# accepts the current code plus its two predecessors, so the redeemable life of a
# displayed code is up to three rotation periods.
#
# -host-ttl is how long a host stays on the dashboard after its last contact. It is
# stated here rather than left implicit so the knob is where an operator looks for it.
# To change it:  edit the value, then
#     systemctl daemon-reload && systemctl restart pool-aggregator-service
# daemon-reload is NOT optional -- a bare restart re-execs systemd's CACHED unit and the
# old value silently stays in force. A non-positive value falls back to the 24h default.
# On a live VM a drop-in (systemctl edit pool-aggregator-service) survives a hand edit being
# overwritten, but this unit is Type=simple, so the drop-in MUST reset ExecStart first or
# systemd refuses to load the service entirely:
#     [Service]
#     ExecStart=
#     ExecStart=/usr/local/bin/pool-aggregator-service ... -host-ttl 6h
# Either way cloud-init reinstalls this file from the repo, so the repo edit is durable.
# The flag only exists in binaries built from the commit that introduced it: adding it to
# an older proxy's unit makes the binary exit "flag provided but not defined" and
# Restart=on-failure turns that into a crash loop. Check with
# `/usr/local/bin/pool-aggregator-service -h | grep host-ttl` before adding it by hand.
# Per-cycle dedup state is kept an hour past the TTL (so a returning host cannot
# double-count), and dashboard deep links keep resolving over at least 24h, so shortening
# this cannot break links the dashboard still shows. It does NOT expire cumulative
# pass/fail counters, and it does not evict a host that keeps being re-seeded from the
# presence feed -- forget-host does that.
ExecStart=/usr/local/bin/pool-aggregator-service -tls-cert /etc/squid/ssl_cert/pool-aggregator-service.crt -tls-key /etc/squid/ssl_cert/pool-aggregator-service.key -auth-token-file /etc/yuruna/lab-auth.token -host-ttl 24h -lab-token-rotate 60s
Restart=on-failure
RestartSec=5
# Auto-discovers pool members by reading the squid access log (proxy owns it,
# 0640 -- the unit only needs to read it), probing each recent client IP's
# status service, and pushing to Loki on loopback; serves :9400 (TLS + plain HTTP
# on the one port when the leaf is present) including the authenticated POST
# /ingest push surface. The only disk reads are the squid log + the TLS leaf +
# the auth token; state is in memory.
ReadOnlyPaths=/var/log/squid
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
