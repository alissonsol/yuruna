{
  "schema": "yuruna.git-mirror.native-recipes/v1",
  "recipes": [
    {
      "id": "GM-PROXY-OWNER-FIRST",
      "platform": "*",
      "commands": [
        {
          "source": "candidate",
          "path": "tools/Invoke-GitMirrorNativeProvision.ps1",
          "arguments": [
            "-Scenario",
            "GM-PROXY-OWNER-FIRST",
            "-TargetRoot",
            "${TargetRoot}",
            "-OldRoot",
            "${OldRoot}",
            "-UpstreamsPath",
            "${UpstreamsPath}",
            "-CandidateTree",
            "${CandidateTree}",
            "-ProfilePath",
            "${ProvisionProfilePath}",
            "-OutputPath",
            "${ProvisionEvidencePath}",
            "-DisposableTarget"
          ],
          "timeoutSeconds": 7200
        }
      ],
      "observations": [
        {
          "name": "provisionedCompatibility",
          "kind": "json",
          "path": "${ProvisionEvidencePath}",
          "property": "passed",
          "expected": true,
          "before": false,
          "retain": true
        }
      ]
    },
