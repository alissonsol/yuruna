      "id": "GM-MIRROR-FIRST-HOST-OFFLINE",
      "platform": "*",
      "commands": [
        {
          "source": "candidate",
          "path": "tools/Invoke-GitMirrorNativeRoute.ps1",
          "arguments": [
            "-Scenario",
            "GM-MIRROR-FIRST-HOST-OFFLINE",
            "-ConfigPath",
            "${ConfigPath}",
            "-UpstreamsPath",
            "${UpstreamsPath}",
            "-FrameworkTree",
            "${CandidateTree}",
            "-OutputPath",
            "${RouteEvidenceRoot}/GM-MIRROR-FIRST-HOST-OFFLINE.json",
            "-DisposableTarget"
          ],
          "timeoutSeconds": 900
        }
      ],
      "observations": [
        {
          "name": "measuredRoute",
          "kind": "json",
          "path": "${RouteEvidenceRoot}/GM-MIRROR-FIRST-HOST-OFFLINE.json",
          "property": "passed",
          "expected": true,
          "before": false,
          "retain": true
        },
        {
          "name": "operatorConfigPreserved",
          "kind": "json",
          "path": "${RouteEvidenceRoot}/GM-MIRROR-FIRST-HOST-OFFLINE.json",
          "property": "configPreserved",
          "expected": true,
          "before": false
        }
      ],
      "prepareOrigins": true
