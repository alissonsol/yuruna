{
  "schema": "yuruna.git-mirror.native-recipes/v1",
  "recipes": [
    {
      "id": "GM-WORKER-KILL-MIDFETCH",
      "platform": "linux-x64",
      "commands": [{"source": "candidate", "path": "tools/Invoke-GitMirrorNativeWorker.ps1", "arguments": ["-Action", "KillMidFetch", "-ProxyHost", "${ProxyHost}", "-SshKeyPath", "${ProxySshKeyPath}", "-RunId", "${RunId}", "-Repository", "${MirrorRepository}", "-Ref", "${MirrorRef}", "-OutputPath", "${WorkerEvidencePath}"], "timeoutSeconds": 380}],
      "observations": [{"name": "recoveredMarkedFetch", "kind": "json", "path": "${WorkerEvidencePath}", "property": "passed", "expected": true, "before": false, "retain": true}]
    },
    {
      "id": "GM-POPULATION-LARGEST",
      "platform": "linux-x64",
      "commands": [{"source": "candidate", "path": "tools/Invoke-GitMirrorNativeWorker.ps1", "arguments": ["-Action", "Populate", "-ProxyHost", "${ProxyHost}", "-SshKeyPath", "${ProxySshKeyPath}", "-RunId", "${RunId}", "-Repository", "${LargestRepository}", "-Ref", "${MirrorRef}", "-OutputPath", "${WorkerEvidencePath}"], "timeoutSeconds": 2000}],
      "observations": [{"name": "largestPopulation", "kind": "json", "path": "${WorkerEvidencePath}", "property": "passed", "expected": true, "before": false, "retain": true}]
    },
    {
      "id": "GM-NO-UPSTREAM-SWITCH",
      "prepareOrigins": true,
      "platform": "linux-x64",
      "commands": [{"source": "candidate", "path": "tools/Invoke-GitMirrorNativeWorker.ps1", "arguments": ["-Action", "NoUpstream", "-ProxyHost", "${ProxyHost}", "-SshKeyPath", "${ProxySshKeyPath}", "-RunId", "${RunId}", "-Repository", "${MirrorRepository}", "-Ref", "${MirrorRef}", "-OutputPath", "${WorkerEvidencePath}"], "timeoutSeconds": 190}],
      "observations": [{"name": "switchBlocksWorker", "kind": "json", "path": "${WorkerEvidencePath}", "property": "passed", "expected": true, "before": false, "retain": true}]
    }
  ]
}
