configService:
  enabled: true
  port: 8443
guestSequence:
- guest.amazon.linux.2023
- guest.ubuntu.server.24
- guest.ubuntu.server.26
logLevel: Information
networkStorage:
  poolStorageLocalPath: ""
  poolStorageNetworkPath: ""
  poolStorageNetworkUser: ""
  stashStorageLocalPath: ""
  stashStorageNetworkPath: ""
  stashStorageNetworkUser: ""
notification:
  failuresBeforeAlert: 2
  successesBeforeRearm: 5
pool:
  enabled: false
  intentGitUrl: ""
  localClonePath: ""
  networkReplicate: false
  pullTimeoutSeconds: 30
repositories:
  frameworkUrl: https://github.com/alissonsol/yuruna
  ghToken: ""
  projectUrl: https://github.com/alissonsol/yuruna-project
statusService:
  enabled: true
  port: 8080
testCycle:
  # Auto-remediation: after a cycle fails, run the recovery handler chosen from
  # last_failure.json before the next spawn, up to maxAttemptsPerCycle tries per
  # consecutive-failure streak. Default off -- a host opts in.
  autoRemediation:
    enabled: false
    maxAttemptsPerCycle: 2
  cycleDelaySeconds: 300
  # Circuit breaker: skip a guest that keeps failing the same way, so it stops
  # burning a full provision+deploy every cycle. After failuresToQuarantine
  # consecutive failures of the SAME failureClass, the guest is skipped for up
  # to skipCycles cycles or until a framework/project commit changes (whichever
  # comes first), emitting a guest_quarantined event + a dashboard flag. Set
  # enabled:false to disable.
  guestQuarantine:
    enabled: true
    failuresToQuarantine: 3
    skipCycles: 5
  # Per-step performance log: one JSONL row per step under
  # status/perf/cycles/, which is what the status page's Perf chart renders.
  # Collection is automatic for every cycle; this knob only exists to turn it
  # off for a host. It is deliberately host-level, not per project, so one
  # project's runner config cannot stop a machine from collecting. An absent
  # key reads as enabled.
  perfLog:
    enabled: true
  recentDisplayCount: 30
  stopOnFailure: false
  stepTimeoutSeconds: 2700
  # Tighter watchdog bound for the runner's PREAMBLE -- process start through
  # host detection, the caching-proxy gate and its port-map refresh, and the
  # status-service start, i.e. everything before the first sequence step. None
  # of it is legitimately slow, so a stall there means the runner is wedged
  # (a sudo or credential prompt on the inherited terminal with nobody present
  # is the case this exists for) and waiting out stepTimeoutSeconds means 45
  # minutes of a green dashboard over a host doing nothing.
  # Set to 0 to opt out: stepTimeoutSeconds then applies everywhere, which is
  # the behaviour from before this knob existed. Raise it instead if a host
  # has a genuinely slow preamble.
  preambleTimeoutSeconds: 600
  # Warm-resume checkpointing: on an eligible transient workload failure
  # (network_timeout / wait_timeout / instrumentation_failure / host_io_blocked),
  # re-run the failed sequence from its last-good step on the same live VM
  # instead of tearing the guest down and redoing the whole install. Up to
  # maxAttempts in-place tries; on exhaustion it falls back to the normal
  # teardown + cold re-provision. Emits a warm_resume event. enabled:false
  # disables it.
  warmResume:
    enabled: true
    maxAttempts: 2
vmCommunication:
  charDelayMs: 10
  pollSeconds: 5
  timeoutSeconds: 180
  vncPort: 5900
vmImage:
  alwaysRedownload: false
  refreshSeconds: 604800
vmStart:
  bootDelaySeconds: 15
  cachingProxyIp: ""
  startTimeoutSeconds: 120
  testVmNamePrefix: test-
  # Extra VM-name prefixes the cycle sweep may stop and delete, for a
  # project whose VMs are promoted out of the test-VM namespace (a
  # snapshot id becomes the VM name, so those guests no longer carry
  # testVmNamePrefix and would otherwise survive every cycle and block
  # the next one). testVmNamePrefix is always swept and does not need
  # repeating here. Prefixes match literally, never as wildcards; an
  # empty entry is ignored rather than matching every VM on the host.
  cleanupVmNamePrefixes: []
