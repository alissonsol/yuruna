{
  "schema": "yuruna.american-spelling/v1",
  "description": "Data for tools/Test-AmericanSpelling.ps1. \"words\" maps each British spelling the check refuses to its American form; a name or prose word matches when one of its subwords (split on camelCase, PascalCase, snake_case, kebab-case and digits, then lowercased) is a key. \"locales\" lists the non-English locale tags and \"localePaths\" the path globs, with {locale} standing for each tag, where translated text lives; those paths are not checked, while an English-authored file that only carries a tag in its name is. \"skip\" lists path globs that are not checked, each with its reason. \"exceptions\" lists text the check ignores in the files its path glob matches (and only in the repository named by \"repo\", when present): the token is removed from a line, and from each name in the file's path, before it is checked, so a British word elsewhere on the same line is still reported. Add an exception only for a name an external standard or protocol fixes, or for text that lists British forms on purpose, and say why. See AGENTS.md, Write durable comments and documentation.",
  "locales": [
    "he-IL",
    "pt-BR",
    "qps-Ploc",
    "qps-Plocm",
    "zh-CN"
  ],
  "localePaths": [
    "docs/{locale}/**",
    "globalization/catalogs/{locale}/**",
    "dev-only/localization-pro/risk/{locale}.txt",
    "**/{locale}.*.js",
    "**/locales/{locale}.json",
    "**/*.{locale}.resx"
  ],
  "skip": [
    {
      "path": "dev-only/review.history/**",
      "reason": "Closed records keep the wording they were written with."
    },
    {
      "path": "docs/sbom/**",
      "reason": "Generated SBOM records quote package metadata written by others."
    },
    {
      "path": "globalization/generated/**",
      "reason": "Generated from the message catalogs; the en-US catalog is checked at its source."
    },
    {
      "path": "**/internal/catalog/**",
      "reason": "Go catalogs embedded from the compiled message catalogs of every locale."
    }
  ],
  "exceptions": [
    {
      "path": "**",
      "token": "notifications/cancelled",
      "reason": "Model Context Protocol method name; the protocol specification fixes its spelling."
    },
    {
      "repo": "yuruna",
      "path": "dev-only/prompts/review.before.release.txt",
      "token": "\\b(colours?|colour(ed|ing|ful)|behaviours?|behavioural|favour(s|ed|ing|ite|ites|able)?|honour(s|ed)?|labour(s|ed)?|neighbour(s|ing|hood)?|flavours?|humour|rumours?|endeavours?|armour|centres?|centred|metres?|litres?|fibres?|theatres?|licences?|defences?|offences?|pretence|catalogues?|catalogued|analys(e|ed|ing)|paralys(e|ed|ing)|cancell(ed|ing)|travell(ed|ing|er|ers)|modell(ed|ing|er|ers)|labell(ed|ing)|signall(ed|ing)|levell(ed|ing)|fuell(ed|ing)|marshall(ed|ing)|channell(ed|ing)|tunnell(ed|ing)|judgements?|acknowledgements?|grey|greyed|whilst|amongst|learnt|spelt|fulfil|fulfils|fulfilment|enrol|enrols|enrolment|artefacts?|programmes?|aluminium|ageing|practis(e|ed|es|ing)|(organi|initiali|normali|recogni|seriali|deseriali|summari|synchroni|optimi|prioriti|customi|minimi|maximi|utili|authori|finali|categori|standardi|saniti|visuali|virtuali|paralleli|speciali|stabili|locali|internationali|emphasi|apologi|reali|critici|memori|containeri|tokeni|capitali|centrali|materiali|randomi|parametri|templati|digiti|moderni|harmoni|legali|mobili|neutrali|personali|rationali|symboli|synthesi|triviali)s(e|ed|es|ing|ation|ations|er|ers))\\b",
      "reason": "The step 4.2 search pattern lists the British forms that the language pass looks for."
    },
    {
      "path": "docs/ontology/**/yuruna.owl",
      "token": "non-fulfilment of a requirement",
      "reason": "Verbatim ISO/IEC 27000 definition of nonconformity; the standard is written in British English."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.SequenceEngineConsoleVerdict.Tests.ps1",
      "token": "synchronise: no selectable sources",
      "reason": "chronyd log message quoted verbatim from a captured guest serial console; chrony fixes its spelling."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "cancelledCount",
      "reason": "Fixture name the suite proves the check reports."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "cancelled_at",
      "reason": "Fixture name the suite proves the check reports."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "CancelledKind",
      "reason": "Fixture name the suite proves the check reports."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "TestNormalisedX",
      "reason": "Fixture name the suite proves the check reports."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "colour",
      "reason": "Fixture name the suite proves the check reports."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "initialise-config",
      "reason": "Fixture name the suite proves the check reports."
    },
    {
      "repo": "yuruna",
      "path": "test/modules/Test.AmericanSpelling.Tests.ps1",
      "token": "normalised-dir",
      "reason": "Fixture directory name the suite proves the check reports."
    }
  ],
