#
# Yuruna pre-commit hook -- block a commit that would put a UTF-8/UTF-16 BOM or
# a non-ASCII byte into the irm|iex / curl|bash bootstrap installers or the
# first-run guest scripts. Those are parsed byte-for-byte on a fresh host
# before any BOM-tolerant shell exists, so a stray BOM aborts first-install at
# line 1 (feedback_bootstrap_installer_no_bom). Mirrors the per-cycle gate in
# Test-Config.ps1.
#
# Activated per-clone via core.hooksPath = tools/githooks (set in
# .gitconfig.yuruna, which the install scripts include). Advisory by design: a
# contributor without pwsh is skipped with a warning, and
# `git commit --no-verify` bypasses it. The release script's hard gate is the
# authoritative backstop for the published artifact.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
gate="$repo_root/tools/Test-AsciiNoBom.ps1"
[ -f "$gate" ] || exit 0

if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh not found; skipping the ASCII/BOM gate (install PowerShell 7 to enable it)." >&2
    exit 0
fi

if ! pwsh -NoProfile -ExecutionPolicy Bypass -File "$gate" -Quiet; then
    echo "" >&2
    echo "pre-commit: ASCII/BOM gate failed (see tools/Test-AsciiNoBom.ps1 output above)." >&2
    echo "  A BOM or non-ASCII byte in a bootstrap / first-run script breaks first-install." >&2
    echo "  Fix the flagged file(s), or bypass with 'git commit --no-verify' (discouraged)." >&2
    exit 1
fi

# Second pass: no file anywhere may carry a BOM. A BOM is invisible in every
# editor, survives copy/paste between projects, and rides into byte-for-byte
# consumers -- the signed install.sha256, heredoc bodies, the guest scripts the
# status service serves verbatim. Non-ASCII bytes are fine outside the bootstrap
# set, so this pass checks only for the BOM. -Staged keeps it to what is about
# to be committed; the whole tree is ~1000 files and this runs on every commit.
if ! pwsh -NoProfile -ExecutionPolicy Bypass -File "$gate" -BomOnly -Staged -Quiet; then
    echo "" >&2
    echo "pre-commit: a staged file carries a byte-order mark (see above)." >&2
    echo "  Rewrite it as BOM-less UTF-8, or bypass with 'git commit --no-verify'." >&2
    exit 1
fi

# Third pass (WARN only): retired names. Each spelling below was replaced by a
# current one; a copy/paste from an old cycle log, an archived doc, or another
# machine's checkout is how they come back, and they come back silently because
# nothing fails -- the code reads the current name and quietly uses a default.
# Warn rather than block: an archived artifact or a migration note may legitimately
# quote the old spelling, and only the author can tell those apart.
#
# The retired SCRIPT PATHS below matter more than they look: several consumers
# treat a missing script as "skip with a warning" rather than an error -- the
# ASCII gate above, Test-Config.ps1's copy of it, and the runner's per-cycle
# child. A stale path there does not fail, it silently stops running the thing.
# Format: <retired>|<current>
retired_names='
test/Test-AsciiNoBom.ps1|tools/Test-AsciiNoBom.ps1
test/Invoke-TestCycleRunner.ps1|test/modules/Invoke-TestCycleRunner.ps1
test/Start-CachingProxyServiceVM.ps1|test/service/Start-CachingProxyServiceVM.ps1
test/Stop-CachingProxyServiceVM.ps1|test/service/Stop-CachingProxyServiceVM.ps1
test/Start-DownloadAgentServiceVM.ps1|test/service/Start-DownloadAgentServiceVM.ps1
test/Stop-DownloadAgentServiceVM.ps1|test/service/Stop-DownloadAgentServiceVM.ps1
test/Start-PoolControlServiceVM.ps1|test/service/Start-PoolControlServiceVM.ps1
test/Stop-PoolControlServiceVM.ps1|test/service/Stop-PoolControlServiceVM.ps1
test/Start-StashServiceVM.ps1|test/service/Start-StashServiceVM.ps1
test/Stop-StashServiceVM.ps1|test/service/Stop-StashServiceVM.ps1
test/Start-ConfigService.ps1|test/service/Start-ConfigService.ps1
test/Stop-ConfigService.ps1|test/service/Stop-ConfigService.ps1
test/Start-StatusService.ps1|test/service/Start-StatusService.ps1
test/Stop-StatusService.ps1|test/service/Stop-StatusService.ps1
test/Set-PoolDesiredState.ps1|test/pool/Set-PoolDesiredState.ps1
test/Set-PoolTestSet.ps1|test/pool/Set-PoolTestSet.ps1
test/Test-PoolIntent.ps1|test/pool/Test-PoolIntent.ps1
test/Sync-PoolDashboardOnProxy.ps1|test/pool/Sync-PoolDashboardOnProxy.ps1
test/Test-TesseractOcr.ps1|test/check/Test-TesseractOcr.ps1
test/Test-WinRtOcr.ps1|test/check/Test-WinRtOcr.ps1
test/Add-HostToPool.ps1|test/pool/Add-HostToPool.ps1
test/Get-PoolIntent.ps1|test/pool/Get-PoolIntent.ps1
test/Get-PoolStatus.ps1|test/pool/Get-PoolStatus.ps1
test/New-Pool.ps1|test/pool/New-Pool.ps1
test/Remove-Pool.ps1|test/pool/Remove-Pool.ps1
test/Remove-PoolHost.ps1|test/pool/Remove-PoolHost.ps1
test/Remove-HostFromPool.ps1|test/pool/Remove-HostFromPool.ps1
test/Set-PoolTestSetDefinition.ps1|test/pool/Set-PoolTestSetDefinition.ps1
test/Convert-ToPoolWorker.ps1|test/pool/Convert-ToPoolWorker.ps1
test/Move-CachingProxyService.ps1|test/service/Move-CachingProxyService.ps1
test/Repair-CachingProxyServiceForwarder.ps1|test/service/Repair-CachingProxyServiceForwarder.ps1
test/Clear-LocalLabStorage.ps1|test/lab/Clear-LocalLabStorage.ps1
test/New-Lab.ps1|test/lab/New-Lab.ps1
test/New-LocalLabStorage.ps1|test/lab/New-LocalLabStorage.ps1
test/Set-LabToken.ps1|test/lab/Set-LabToken.ps1
test/Enable-TestAutomation.ps1|test/lab/Enable-TestAutomation.ps1
test/Disable-TestAutomation.ps1|test/lab/Disable-TestAutomation.ps1
test/Sync-HostConfiguration.ps1|test/lab/Sync-HostConfiguration.ps1
test/Remove-OrphanedVMFiles.ps1|test/lab/Remove-OrphanedVMFiles.ps1
status server|status service
stash appliance|stash service
HostConfigService|ConfigService
Test-Sequence.ps1|Debug-TestSequence.ps1
Invoke-TestSequence.ps1|Debug-TestSequence.ps1
Invoke-TestRunner.ps1|Start-TestRunner.ps1
Invoke-TestInnerRunner|Invoke-TestRunnerInnerLoop
stepTimeoutMinutes|stepTimeoutSeconds
refreshHours|refreshSeconds
characterDelayMs|charDelayMs
shouldStopOnFailure|stopOnFailure
autoRemediationEnabled|autoRemediation.enabled
isEnabled|enabled
GH_TOKEN:|ghToken:
cachingProxyIP|cachingProxyIp
poolLocalPath|poolStorageLocalPath
poolNetworkPath|poolStorageNetworkPath
stashLocalPath|stashStorageLocalPath
stashNetworkPath|stashStorageNetworkPath
test.config.html|config.html
hostinfo.html|diagnostics.html
host.html|diagnostics.html
perf.html|performance.html
YURUNA_HOST_IP|YURUNA_STATUS_SERVICE_IP
YURUNA_HOST_PORT|YURUNA_STATUS_SERVICE_PORT
stash-server|stash-service
'
# Exclude the three files that carry retired names BY DEFINITION -- this hook's
# own list, the migration table it mirrors, and the private history under
# dev-only/ -- or every commit reports them and the pass becomes noise.
staged=$(git diff --cached --name-only --diff-filter=ACM |
    grep -v -e '^tools/githooks/pre-commit$' \
            -e '^test/modules/Test\.ConfigNaming\.psm1$' \
            -e '^dev-only/')
if [ -n "$staged" ]; then
    printf '%s\n' "$retired_names" | while IFS='|' read -r old new; do
        [ -n "$old" ] || continue
        # A retired spelling inside a ${...} shell expansion is not a use of the
        # retired thing. `${GH_TOKEN:-}` reads the environment variable of that
        # name -- current and correct -- but contains the literal `GH_TOKEN:`
        # that names the retired CONFIG KEY, so a substring match reports it on
        # every commit touching the fetch path and the pass turns into noise
        # nobody reads. Requiring the character before the match to be anything
        # but `{` drops that form and keeps every other one: a yaml key at line
        # start still matches through `^`, and a bare `$YURUNA_HOST_IP` still
        # matches because `$` is not `{`.
        #
        # The spelling is escaped into the regex rather than passed to -F, so a
        # path entry like test/pool/New-Pool.ps1 keeps matching only itself and not
        # any character in place of the dots.
        esc=$(printf '%s' "$old" | sed 's/[][\.*+?(){}|^$\\]/\\&/g')
        hits=$(printf '%s\n' "$staged" | tr '\n' '\0' |
            xargs -0 grep -l -E -- "(^|[^{])$esc" 2>/dev/null)
        if [ -n "$hits" ]; then
            echo "pre-commit: retired name '$old' (use '$new') in:" >&2
            printf '  %s\n' $hits >&2
        fi
    done
fi

# Fourth pass: derived catalog artifacts. The compiled catalog set and the
# runtime copies that carry it are generated from the sources under
# globalization/, and a commit that edits a source without regenerating them
# leaves no local trace -- nothing reads the stale copy until the release gate
# rejects the candidate pair minutes into a publish run, by which time the
# author has moved on and the drift has to be reconstructed from a gate report.
# Both checks together cost about a second, so pay it here.
#
# This pass blocks where the retired-name pass only warns: an artifact either
# matches the sources it was generated from or it does not, so there is no
# author judgment to defer to. It reads the working tree rather than the index,
# because the generators have no staged mode -- the same tradeoff the whole-tree
# ASCII pass above makes.
#
# Order matters: the embed reads what the compiler produced, so a stale compile
# would make the embed report a difference that regenerating the embed alone
# cannot settle.
if git diff --cached --name-only --diff-filter=ACM | grep -q '^globalization/'; then
    compile_gate="$repo_root/tools/Invoke-CatalogCompile.ps1"
    embed_gate="$repo_root/tools/Invoke-CatalogEmbed.ps1"
    if [ -f "$compile_gate" ] &&
        ! pwsh -NoProfile -ExecutionPolicy Bypass -File "$compile_gate" -Check -Quiet; then
        echo "" >&2
        echo "pre-commit: the compiled catalog set is stale (see above)." >&2
        echo "  Run 'pwsh tools/Invoke-CatalogCompile.ps1 -Update', stage what it writes," >&2
        echo "  or bypass with 'git commit --no-verify' (discouraged)." >&2
        exit 1
    fi
    if [ -f "$embed_gate" ] &&
        ! pwsh -NoProfile -ExecutionPolicy Bypass -File "$embed_gate" -Check -Quiet; then
        echo "" >&2
        echo "pre-commit: a runtime copy no longer matches the catalog sources (see above)." >&2
        echo "  Run 'pwsh tools/Invoke-CatalogEmbed.ps1', stage what it writes," >&2
        echo "  or bypass with 'git commit --no-verify' (discouraged)." >&2
        exit 1
    fi
fi

# Fifth pass: the two whole-tree records. The translation-surface census counts
# the prose in the tree, and the suite baseline names every suite the runner
# discovers. Both are regenerated rather than written, and a change that moves
# one of them without re-recording it leaves no local trace: the author's
# commit succeeds, and the drift surfaces minutes into someone's release run as
# a gate row nobody can attribute to a change made days earlier.
#
# Blocks, for the same reason the catalog pass does -- a record either
# reproduces from the tree or it does not, and no author judgment sits in
# between.
staged_any=$(git diff --cached --name-only --diff-filter=ACMRD |
    grep -v -e '^globalization/manifests/domain-inventory\.json$' \
        -e '^test/modules/suite-baseline\.json$')
if [ -n "$staged_any" ]; then
    inventory_gate="$repo_root/tools/Invoke-DomainInventory.ps1"
    # Every staged path triggers this rather than a curated list of the paths
    # the census counts. That list already exists inside the tool, and a second
    # copy here would be one nobody updates -- the cost of getting it wrong is
    # a census that silently stops being checked, against a few seconds of
    # running it on a commit that could not have changed it.
    project_root="$repo_root/../yuruna-project"
    if [ -f "$inventory_gate" ] && [ -d "$project_root" ]; then
        if ! pwsh -NoProfile -ExecutionPolicy Bypass -File "$inventory_gate" -Check \
            -ProjectRoot "$project_root" >/dev/null 2>&1; then
            echo "" >&2
            pwsh -NoProfile -ExecutionPolicy Bypass -File "$inventory_gate" -Check \
                -ProjectRoot "$project_root" >&2 2>&1
            echo "pre-commit: the translation-surface census no longer reproduces from this tree." >&2
            echo "  Run 'pwsh tools/Invoke-DomainInventory.ps1 -Update -ProjectRoot ../yuruna-project'," >&2
            echo "  stage globalization/manifests/domain-inventory.json," >&2
            echo "  or bypass with 'git commit --no-verify' (discouraged)." >&2
            exit 1
        fi
    fi
fi

# The suite baseline has two failure shapes and only one of them is cheap to
# see from here.
#
# A suite that appeared or vanished is a set difference, and the baseline gate
# answers it in about a second. A suite that gained or lost tests is not: the
# recorded per-suite count is only compared against a real run, so nothing
# short of executing the suites can tell. The hook says so rather than
# pretending to check it -- a staged test file is the one moment the author
# knows whether their edit changed a count.
staged_tests=$(git diff --cached --name-only --diff-filter=ACMRD |
    grep -E '^(test|host)/modules/.*\.Tests\.ps1$')
if [ -n "$staged_tests" ]; then
    baseline_gate="$repo_root/tools/Test-SuiteBaseline.ps1"
    if [ -f "$baseline_gate" ] &&
        ! pwsh -NoProfile -ExecutionPolicy Bypass -File "$baseline_gate" -Quiet; then
        echo "" >&2
        echo "pre-commit: the suite baseline no longer names what the runner discovers." >&2
        echo "  Run 'pwsh tools/Invoke-TestSuite.ps1 -UpdateBaseline' from a PASSING run," >&2
        echo "  stage test/modules/suite-baseline.json," >&2
        echo "  or bypass with 'git commit --no-verify' (discouraged)." >&2
        exit 1
    fi
    if ! git diff --cached --name-only --diff-filter=ACM |
        grep -q '^test/modules/suite-baseline\.json$'; then
        echo "pre-commit: a test file changed without re-recording the suite baseline." >&2
        echo "  If the edit added or removed a test, the recorded count is now wrong and only" >&2
        echo "  a full run will notice. Re-record with" >&2
        echo "  'pwsh tools/Invoke-TestSuite.ps1 -UpdateBaseline' and stage the result." >&2
    fi
fi
exit 0
